{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「請進。」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「可以聊一下嗎？」", "text_idx": 212, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2429", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「沒關係。」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以為是像平常一樣來閱讀，但今天櫻乃沒有拿著書。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 4, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2430", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "進來房間後，櫻乃一直盯著我看。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「妳有什麼話想對我說嗎？」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………嗯。」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2431", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沉默了一會後，櫻乃點頭。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「煩惱的事？」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 10, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。大概，是人生最大的煩惱。」", "text_idx": 216, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2432", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「最大……很不得了呢。」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 12, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，所以……來找葛格。」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2433", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那個，跟妳最近常常看手機有關係嗎？」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 14, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「你注意到了？」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2434", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 16, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……關係，或許有一點點。」", "text_idx": 203, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2435", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是這樣啊。」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "人生最大嗎……", "text_idx": 262, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「吶，櫻乃，雖然我可能不是可靠的哥哥──」", "text_idx": 213, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃扯了扯著我的袖子。", "text_idx": 288, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「沒有那種事。」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2436", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我從來沒有覺得葛格不可靠。」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2437", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……謝謝妳，櫻乃。」", "text_idx": 202, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為妹妹有煩惱，我卻只能看著……」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 25, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「因為是葛格喔。」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2438", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……什麼意思呢？", "text_idx": 190, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「可以稍微，聽我說嗎……？」", "text_idx": 211, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2439", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「這種事當然沒問題。」", "text_idx": 252, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2440", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然我這樣回答了，但櫻乃仍沉默了一陣子。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 31, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我說啊……」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2441", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 32, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我不知道該朝哪裡去。」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2442", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 33, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「之前雖然知道，但現在變得不知道了。」", "text_idx": 209, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2443", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "什麼意思呢？", "text_idx": 263, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過，現在的櫻乃並不是要求答案。", "text_idx": 261, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，然後呢？」", "text_idx": 221, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我傾聽櫻乃緩緩述說的話語。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 38, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「想法明明一直、一直沒有改變，但是，或許不改變不行了……」", "text_idx": 231, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2444", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 39, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「明明必須做點什麼，但是什麼都辦不到……」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2445", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 40, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「心好像迷路了一樣。」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2446", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「迷路啊……」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 42, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯。」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2447", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃現在說的事情，我想我大概連一半都沒有聽懂。", "text_idx": 290, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過，我想支持她的想法不會改變。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我去找到就好了。」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……像那個時候一樣。」", "text_idx": 193, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那個時候？」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2448", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「找到迷路的櫻乃。」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……葛格還記得啊。」", "text_idx": 200, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2449", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不可能忘記的。」", "text_idx": 204, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「說的也是……給你，添了很多麻煩。」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2450", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是那樣喔，櫻乃。」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不是嗎？」", "text_idx": 205, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2451", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我很高興喔。」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「高興？」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2452", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因為那一天，我確實成為櫻乃的「葛格」了。", "text_idx": 266, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過這不能跟櫻乃說。", "text_idx": 259, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為身為葛格第一個找到妹妹。」", "text_idx": 226, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 59, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2453", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 60, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「說的也是。葛格總是能找到我。」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2454", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 61, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不管什麼時候，只要等著就會來接我。」", "text_idx": 207, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2455", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 62, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為妳是我重要的妹妹。」", "text_idx": 223, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 63, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……謝謝你。」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2456", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃沒有再多說什麼。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概……沒有其他能說的，或是想說的都說完了吧。", "text_idx": 269, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 66, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2457", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃凝視著我。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好久沒去了……要去看看嗎？」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我下意識就這樣說了。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 70, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那個時候的場所？」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2458", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 72, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2459", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "剛才談話時想起來了。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "從家裡走過去也沒有很遠。", "text_idx": 273, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 75, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯，去看。」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2460", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在我們出生前就存在的街道。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "已經幾年、幾十年沒有改變的風景。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "路燈微弱地照亮延伸到遠處的道路。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這個地方，夜晚的黑暗遠比光芒更深沉。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……現在來還是覺得很暗呢。」", "text_idx": 199, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 81, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，黑漆漆。」", "text_idx": 222, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2461", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "走在身旁的櫻乃稍微靠近我一點。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 83, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不過，以前就是這樣了？」", "text_idx": 208, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "憑著記憶慢慢走著。", "text_idx": 276, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老舊的街景，兩旁是氣派的房子。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 86, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯。」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2462", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "循著記憶前進。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那個時候，我拼了命。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "心臟好像要裂開一樣痛，幾乎喘不過氣，但是我仍然沒有停下腳步。", "text_idx": 275, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一直找、一直找、一直找。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我還記得發現櫻乃時自己才終於安心。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……櫻乃當時在的地方是更前面一點吧？」", "text_idx": 198, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 93, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。繼續往前走，牆壁有點凹陷的地方。」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2463", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因為很暗，我們自然地靠著彼此。", "text_idx": 265, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沿著延伸的牆壁慢慢往前走。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概……是在這附近。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就在我這麼想的時候。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 98, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 214, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2464", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃發出聲音，停下腳步。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 100, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……是這裡呢。」", "text_idx": 197, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2465", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "牆壁與牆壁之間，一個狹小凹陷的場所。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 102, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，是這樣。」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃就坐在這裡動也不動。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 104, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那個時候……我還小。」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2466", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……是啊。」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我對這裡有特別的感情。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 107, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那一天，我們在這裡成為了兄妹。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或許是為了確認這件事，所以我才會想來。", "text_idx": 282, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 109, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「葛格，剛才的事……我可以繼續說嗎？」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2467", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 110, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「妳人生最大的煩惱？」", "text_idx": 228, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 111, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2468", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 112, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，妳願意說的話。」", "text_idx": 218, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 113, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我希望你聽。」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2469", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 114, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道了，那……告訴我吧？」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 283, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 115, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2470", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她抬起頭深呼吸一口氣。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然後筆直地看著我。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 118, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我……有了喜歡的人。」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 285, "voice": "sk2471", "char_id": "桜乃"}]}
