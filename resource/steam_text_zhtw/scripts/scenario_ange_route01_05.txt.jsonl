{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎呀……」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "星期日，我正在幫忙櫻乃摺剛曬好的衣服。", "text_idx": 378, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是我的手機，不好意思衣服還沒摺完。」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 3, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「沒關係，只剩下幾件就結束了。」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0726", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「咦？瀨名同學……打給我真稀奇。」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "『喂，我是瀨名……』", "text_idx": 355, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 373, "voice": "ar3785", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "電話那一頭的瀨名同學，聲音聽起來莫名地有種緊迫感。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……怎麼了？」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她聲音中的情緒，加上不是打給櫻乃而是打給我這點讓我覺得很奇怪。", "text_idx": 367, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 11, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "『呃、那個……』", "text_idx": 352, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 373, "voice": "ar3786", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "『安潔……有去你家嗎？』", "text_idx": 356, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 373, "voice": "ar3787", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？沒有，她沒有來……」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 14, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "『是嗎……那就好。』", "text_idx": 358, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 373, "voice": "ar3788", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 15, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "『但是小心一點。』", "text_idx": 351, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "愛理", "alt_speaker_idx": 373, "voice": "ar3789", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……小心一點？", "text_idx": 267, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "『就這樣。抱歉假日還打給你。』", "text_idx": 357, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 373, "voice": "ar3790", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學只說了這些，然後就掛斷電話了。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 19, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「愛理怎麼了？」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0728", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……她說小心安潔。」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0729", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「？」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0730", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「到底怎麼了？」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 24, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「打回去問問看。」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0731", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃放下摺好的我的內褲，拿出手機。", "text_idx": 382, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 26, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「哇！」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0732", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "此時，櫻乃的手機正好響起。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 28, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「紗凪學姊。」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0733", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「乾同學？」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 30, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「喂。」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0734", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 31, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……沒有來。」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0735", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃看了我一眼。", "text_idx": 383, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……乾同學也是為了安潔打來的嗎？", "text_idx": 266, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到、到底發生什麼事了？", "text_idx": 363, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我回撥給瀨名同學看看好了……」", "text_idx": 319, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喔哇！？」", "text_idx": 305, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這次換我的手機響起，上面顯示的名字是天羽學姊。", "text_idx": 394, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂……該不會是為了安潔的事？」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 39, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "『哇！？瓜生君你怎麼知道？』", "text_idx": 353, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 393, "voice": "mu0339", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃，因為我跟櫻乃從剛才就一直接到聯絡……」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 41, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "『啊，原來是這樣……啊哈哈，辛苦了。』", "text_idx": 354, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 393, "voice": "mu0340", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 42, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "『真困擾呢，雖然很感謝那份心意。』", "text_idx": 359, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 393, "voice": "mu0341", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喔、喔喔……呃，其實我們還不知道發生了什麼……」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 44, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊，媽媽在叫我了。那就明天見囉，掰掰瓜生君。」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 393, "voice": "mu0342", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽學姊好像以為我們也知道是怎麼回事，很乾脆就掛斷了電話。", "text_idx": 366, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看向櫻乃……她也結束了通話，放下手機。", "text_idx": 375, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎、怎麼了？」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我也不清楚。」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0738", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 50, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「總之安潔好像不太妙。」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0739", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「你那邊呢？」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0740", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……講到一半就掛了……果然也是跟安潔有關，真困擾啊……」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0741", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「？？？」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0742", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我跟櫻乃一起歪著頭，百思不得其解。", "text_idx": 376, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到底是出了什麼事情呢，安潔……", "text_idx": 364, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "此時，門鈴聲響起。", "text_idx": 385, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們兩兄妹連忙下樓。", "text_idx": 374, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 61, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「葛格，該不會？」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0743", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 62, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「應該就是了吧……」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 64, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「我是安潔！」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0821", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "果然。", "text_idx": 379, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 66, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「有沒有什麼需要本人安潔服務的事情呢～？」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0822", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一打開門，就看到活力充沛的安潔，說話時還小跳步了一下。", "text_idx": 362, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 68, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「不管是什麼都可以喔，請不要客氣儘管說！」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0823", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……也就是說，安潔妳剛才到處去問有沒有需要女僕服務嗎……」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 70, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「剛才做了很多奇怪的想像。」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0744", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 71, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那個安潔是長這樣的嗎？之類的……」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0745", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 72, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「妳以為安潔是妖怪嗎！？」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0824", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 73, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「真人？」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0746", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 74, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔，被妳這麼一說，反而沒什麼自信了……」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0825", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 75, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥，好像是真人。」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0747", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 76, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「剛才那句話才確定是真人啊……」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0826", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，長相也沒有問題……」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "總之，還好實情是這樣。", "text_idx": 392, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不過，為什麼這種程度的事會讓瀨名同學和天羽學姊都困擾呢？", "text_idx": 265, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 80, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「總之先進來吧。」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0748", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 81, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「好！打擾了～」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0827", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在門口已經站得夠久了，我們讓安潔進來家中……", "text_idx": 365, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 83, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「哇～哇～好棒的住宅喔～在這裡好像能做很多工作呢！」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0828", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "對於第一次拜訪的我家，安潔的雙眼閃閃發亮。", "text_idx": 370, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃，有什麼要做的嗎？」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 86, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「沒有。」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0749", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 87, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「欸欸！？」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0829", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "平淡的回答。", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 89, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「衣服也已經摺完了。」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0750", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「晚飯的準備……天還這麼亮，現在做太早了。」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 91, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「而且哥哥也仔細地打掃過家裡了。」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0751", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，這麼說來上午的時候我打掃了浴室和廁所呢。」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 93, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「謝謝你。」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0752", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 94, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「怎麼這樣～安潔的、安潔的工作……」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0830", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "結果讓她進來好像也沒什麼意義，這不禁讓我感到有點抱歉。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不過安潔不會因為這點小事就灰心。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 97, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「但是！經由本人安潔的觀察，這個家裡面還有許多可以做的工作喔！」", "text_idx": 279, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0831", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 98, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「比如說那邊的廚房！安潔覺得只要改變一下布置就能變得更有效率喔！」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0832", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 99, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「說到這裡，那就立刻──」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0833", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 100, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不可以改變。」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0753", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 101, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「！」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0834", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "往廚房跑去的安潔在櫻乃的制止下緊急煞車。", "text_idx": 372, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 103, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「這個狀態就好，我比較習慣。」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0754", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 104, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「欸欸～如果把飯勺稍微～」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0835", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 105, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不可以。」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0755", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 106, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0836", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 107, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那、那就那就，把那邊的換氣扇的油汙清理一下……」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0837", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 108, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……如果我們擅自清理換氣扇，媽媽會生氣。」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0756", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不知道為什麼她最喜歡清換氣扇了……她不在家的時候也會再三提醒我們不可以碰。」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 110, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔啊～」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0838", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 111, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「這、這樣的話，打掃房間還是什麼安潔都會做……」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0839", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 112, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不是自己掃的話不自在。」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0757", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我的房間也已經掃到一塵不染了……」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 114, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊！？」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0840", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 115, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那安潔來確認打掃完的地方吧！如果有要加強的部分安潔會負起責任……」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0841", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 116, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「安潔。」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0758", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 117, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是、是的。」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0842", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 118, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我們家不用沒關係。」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0759", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 119, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「嗚啊啊啊～每個人的家都這麼說～～」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0843", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我想也是。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 121, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安潔有這個心意是很好，但是積極過頭老實說不知道該怎麼反應比較好。", "text_idx": 369, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學、天羽學姊，或許乾同學也是，不知道該怎麼辦所以就請她離開了……", "text_idx": 386, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 123, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔、唔，打擾你們了……」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 368, "voice": "ag0844", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 124, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "結果安潔就處於不完全燃燒的狀態……應該說連燒都沒燒就離開了。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 125, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「安潔在結女裡沒有要做的事情了嗎？」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "櫻乃", "alt_speaker_idx": 381, "voice": "sk0760", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……這我也不清楚。」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 377, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這股滿出來的幹勁，大概是昨天被我鼓勵出來的吧……", "text_idx": 395, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "無、無話可說……", "text_idx": 388, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
