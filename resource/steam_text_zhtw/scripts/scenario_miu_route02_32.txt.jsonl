{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 119, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「那個重要的人。」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0234", "char_id": "結子"}]}
