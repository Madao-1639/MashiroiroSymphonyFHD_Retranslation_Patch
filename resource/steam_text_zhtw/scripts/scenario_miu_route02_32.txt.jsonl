{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 0, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……之後就剩下這些孩子們而已了。」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2419", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 2, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「讓這些兔子回到大自然後，就不要再救助動物了。」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2420", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「這是什麼意思？」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 4, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2421", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊。」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 6, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……到這個月底，我想關閉這個社團。」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2422", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「！？」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 8, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「抱歉喔，這麼晚才告訴你。」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2423", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎麼、突然……」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 10, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「其實我以前就這麼決定了。」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2424", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 12, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「好不容易招齊了社員……擅自決定我很抱歉。」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2425", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是因為熊喵的事嗎？", "text_idx": 324, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "還是有其他原因？", "text_idx": 337, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但無論如何，這是社長美羽學姊決定的事。我沒有插嘴的資格。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那樣……」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不行，不要說。說了也只會讓學姊困擾而已。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "…………", "text_idx": 227, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「學姊，那樣真的好嗎？」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 21, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2426", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……果然不該說的。", "text_idx": 228, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不想看到學姊露出那種表情……", "text_idx": 317, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 24, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……嗯～是喔。學姊那樣說。」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1658", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「妳這麼輕易就接受了？」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 26, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「因為學姊都說要結束了，我們這些社員也只能聽從吧？」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1659", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以為紗凪會跟我一起阻止學姊的。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但她的反應卻是這麼冷漠。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "為什麼她能如此輕易就接受？", "text_idx": 327, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明是做了那麼多努力一路守護過來的社團……", "text_idx": 323, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 32, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「幹嘛？一臉不滿的表情。」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1660", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「紗凪無所謂嗎？這樣下去社團就要沒有了。」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 34, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1661", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「大家一起貼海報、招社員……還幫貓找領養飼主，做了那麼多事情。」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……你啊，不懂重要的是什麼欸。」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1662", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪嘆口氣環顧社團教室，然後拿起一個原本要給熊喵吃的貓罐頭。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 39, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「你知道為什麼美羽學姊要那麼拼命打工直到自己倒下嗎？」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1663", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 40, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「你沒有覺得不可思議嗎？這個社團救助的動物們的伙食費是從哪裡來的。」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1664", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被她這麼一說，我只想得到一個答案。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……沒有所謂的社團經費吧。」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 44, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「沒錯，都是美羽學姊打工賺來的。」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1665", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 45, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「雖然我也想幫忙，但是她不准……」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1666", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 47, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊畢業之後，誰要代替她？」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1667", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪把貓罐頭丟給我，接著說。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 49, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「其實，美羽學姊想拜託你當社長。」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1668", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「但是，她沒能說出口。」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1669", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 51, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「學姊不久前來找我道歉了。」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1671", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「她說雖然希望社團繼續經營，但還是沒辦法。」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1672", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 53, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「當然，我也反對過了。如果缺社長，我或新吾來當就好了。」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1673", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 54, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……但是她說不行。你知道是為什麼嗎？」", "text_idx": 231, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1674", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是……」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 56, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1675", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「因為她重視我們。」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1676", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 58, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「因為比起任何人她最重視新吾……」", "text_idx": 260, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1677", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「所以美羽學姊才沒有拜託你當社長。」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1678", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 61, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「三年來，她都一個人邊工作邊守護這個社團。」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1679", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 62, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「如果要讓我或新吾承擔這個責任，她寧可被叫成偽善者也要結束社團。」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1680", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 63, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「比起被救助的動物們，她更愛我們。」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1681", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 64, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「我也只能接受了不是嗎？那樣的她居然主動說要關閉社團……」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1682", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……敵不過那個人呢。」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 67, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「這是當然的啊。因為是我憧憬的人。像你這種人要跟她平起平坐，還早一百億年呢！」", "text_idx": 305, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1683", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把貓罐頭放回架上，在心中做出了決定。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不會讓社團就這樣消失。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我該做的事只有一件。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「紗凪覺得這樣就好嗎？」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「什麼？」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1684", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就這樣單方面享受美羽學姊的愛。」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 74, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1685", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪勾起嘴角，拍拍我的肩膀。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 76, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「果然啊。」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1686", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 322, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 78, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1687", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 79, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「你是個好男人呢。」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "紗凪", "alt_speaker_idx": 328, "voice": "sn1688", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 80, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「唔呼呼，花鈴、朵萌，來這邊～」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0212", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 81, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "「喵嗯～」「喵嗚～」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "花鈴／朵萌", "alt_speaker_idx": 335, "voice": "go078", "char_id": "汎用"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 82, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2427", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 83, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「美羽也一起玩吧？花鈴，去叫美羽過來。」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0213", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 84, "speaker": "カリン", "flag": 64, "pages": [{"page": 0, "text": "「喵嗚～」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "花鈴", "alt_speaker_idx": 334, "voice": "kr0009", "char_id": "カリン"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 85, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「妳看妳看，花鈴在說希望妳一起玩喔～」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0214", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 86, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……吶，媽媽。」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2428", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 87, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「怎麼了？哎呀、不行喔，朵萌真是的……」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0215", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2429", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 89, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「媽媽不會害怕養貓嗎？」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2430", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 90, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「害怕？」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0216", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「因為比起我們，貓咪會很早就死掉喔？」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2431", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 92, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「就算非常疼愛牠們，最後也只剩下悲傷的回憶……」", "text_idx": 279, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2432", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 93, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「即使如此，為什麼媽媽又養貓了呢？」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2433", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 94, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0217", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 95, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「這個嘛。的確分離是很悲傷的事……」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0218", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 96, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「但是，跟這些孩子們一起度過的時光，是會一直一直留在心中的寶物……」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0219", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 97, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2434", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 98, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「等到有一天妳當母親的時候……一定就會懂了。」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0220", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 99, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「欸……」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2435", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 100, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「孩子總有一天會離開父母……能跟妳像這樣相處的時間，也不多了吧。」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0221", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 101, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「妳遇見了很棒的人。接下來妳會跟那個人一起創造回憶。」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0222", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 102, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「就像妳帶給我許多的回憶一樣……」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0223", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 103, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2436", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 104, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「妳說的沒錯，花鈴和朵萌總有一天會離開我。」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0224", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 105, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「但是，跟這些孩子們的回憶，會一直留在媽媽心中……不對，是必須留下才行。」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0225", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 106, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「所以，沒錯，妳也別忘記喔。」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0226", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 107, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「！？」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2437", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 108, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「因為熊喵小姐一定也會記得妳的……」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0227", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 109, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「妳也不能忘記熊喵小姐喔？」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0228", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 110, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「可別說一起度過的時光只剩下悲傷那種話喔？」", "text_idx": 252, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0229", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 111, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「媽媽……」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2438", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 112, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「抱歉喔。沒能為妳做些像母親會做的事情。」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0230", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 113, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「但是媽媽是愛妳的。今後也會一直愛著喔！」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0231", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 114, "speaker": "カリン", "flag": 64, "pages": [{"page": 0, "text": "「喵嗚～」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "花鈴", "alt_speaker_idx": 334, "voice": "kr0011", "char_id": "カリン"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 115, "speaker": "ドモン", "flag": 64, "pages": [{"page": 0, "text": "「喵嗚～」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "朵萌", "alt_speaker_idx": 325, "voice": "dm0010", "char_id": "ドモン"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 116, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「唔呼呼，花鈴和朵萌說也愛美羽呢。」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "結子", "alt_speaker_idx": 332, "voice": "yk0232", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 117, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 333, "voice": "mu2439", "char_id": "みう"}]}
