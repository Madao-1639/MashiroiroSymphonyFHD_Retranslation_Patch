{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 0, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「歡迎回來～歡迎回來～」", "text_idx": 454, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0688", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「今天也在呢。」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0669", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 2, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「早啊，安潔～」", "text_idx": 444, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0259", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 3, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊……！」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0689", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一看見我們，手上拿著竹掃帚的安潔就跑了過來。", "text_idx": 487, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 5, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「首先是隼太同學，歡迎回來！」", "text_idx": 481, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0690", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 6, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「喔～哈哈，果然安潔的招呼聽了很舒服很棒呢！」", "text_idx": 405, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0260", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 7, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「喔喔，安潔很舒服嗎？」", "text_idx": 404, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0691", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 8, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「啊啊，今天把回各務台的事安排晚一點真是太正確了。果然早晨就是需要安潔啊～」", "text_idx": 401, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0261", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 9, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「安潔就像咖啡一樣的存在呢！」", "text_idx": 425, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0692", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的確是會讓人精神一振的女孩。", "text_idx": 507, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隼太含閒聊的招呼（？）結束後，安潔轉向了櫻乃。", "text_idx": 544, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃學妹，歡迎回來～」", "text_idx": 451, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0693", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 13, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「早安，星期五很開心呢。」", "text_idx": 445, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0670", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是的！非常開心～光是想起來安潔就好像要脫皮了。」", "text_idx": 449, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0694", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「現在是冬天，保養肌膚很重要。」", "text_idx": 458, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0671", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 16, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「正是如此呢。那麼還是控制一下脫皮好了。」", "text_idx": 455, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0695", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 408, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0672", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 18, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「中午再去找你們玩喔。」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0673", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 19, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「好的，安潔會等著。」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0696", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 20, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「……這兩個人的對話明明超脫常軌，但又能確實溝通真厲害啊。」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0262", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真的。是安潔厲害還是櫻乃厲害呢？", "text_idx": 528, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "接著安潔轉向我。", "text_idx": 518, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我回來了，安潔早安。」", "text_idx": 439, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 24, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「歡迎回來，新吾同學。」", "text_idx": 453, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0697", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 25, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0698", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 414, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 27, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……欸嘿。」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0699", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 28, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「～♪～～♪」", "text_idx": 483, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0700", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……妳今天心情很好呢。」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也笑了。", "text_idx": 512, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她對我沒有說其他話，取而代之的是燦爛的笑容和輕盈的腳步。", "text_idx": 505, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就好像在說對我不需要多餘的言詞……", "text_idx": 510, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「新吾同學感覺怎麼樣呢？」", "text_idx": 443, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0701", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我今天也心情很好喔。」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沒錯，連我都雀躍起來了。", "text_idx": 523, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為一早就看見了心情很好的安潔。」", "text_idx": 417, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 37, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0702", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 38, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「對新吾就只有簡單的招呼啊。」", "text_idx": 427, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0263", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 39, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「是我們贏了。」", "text_idx": 447, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0674", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 40, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，新吾同學輸了。怎麼辦呢？」", "text_idx": 392, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0703", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為心情好所以沒關係。」", "text_idx": 418, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 42, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「真是心胸寬大呢～」", "text_idx": 462, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0704", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們開玩笑地聊了幾句，情緒也越來越開心了。", "text_idx": 514, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "可以感受到安潔比起以前又更和我們打成一片了。", "text_idx": 493, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 45, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那麼安潔要繼續執行早晨的任務了。大家待會見～」", "text_idx": 478, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0705", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，加油喔。待會見。」", "text_idx": 410, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──我們的好心情不只有在校門口。", "text_idx": 370, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 48, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「感覺……好自然喔。」", "text_idx": 433, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0706", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在等早上班會開始的時候，安潔在我耳邊輕聲說。", "text_idx": 502, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我立刻就明白她的意思。我點了點頭，視線看向前方。", "text_idx": 517, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 51, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好期待考試的結果全部發下來的時刻。」", "text_idx": 419, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3731", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「真是的，沒問題的啦。絕～對比這群渣蟲考得更好！」", "text_idx": 463, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0214", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 53, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「喔～真敢說～那我真的開始期待了！」", "text_idx": 406, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0264", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 54, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「也是，對於教你們念書的我來說，當然希望你們都考到好成績。」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3732", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 55, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「唔……壓力好大……」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0215", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除去不是同班的另外兩人（和一隻），上週慶祝會的成員們今天也像這樣談天說笑著。", "text_idx": 542, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 57, "speaker": "結女生徒Ａ", "flag": 64, "pages": [{"page": 0, "text": "「瀨名同學今天也跟瓜生君他們在一起呢……」", "text_idx": 457, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "結女學生A", "alt_speaker_idx": 531, "voice": "ja0053", "char_id": "結女生徒Ａ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 58, "speaker": "結女生徒Ｃ", "flag": 64, "pages": [{"page": 0, "text": "「瓜生君、椋梨君，待會也要跟我們說話喔～」", "text_idx": 459, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "結女學生C", "alt_speaker_idx": 533, "voice": "jc0048", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到我們討論得熱烈，班上同學也加入了。", "text_idx": 527, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，待會就過去那邊喔～」", "text_idx": 411, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 61, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「感謝您的指名！」", "text_idx": 435, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0265", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 62, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "「我們才是～」", "text_idx": 438, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "全員", "alt_speaker_idx": 490, "voice": "go065", "char_id": "汎用"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 63, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……變得很受歡迎呢，這兩個人。」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3733", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 64, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「真是的，這群公的有哪裡好啊……光是說話就感覺到貞操危機了，對吧？」", "text_idx": 464, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0216", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 65, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，完全融入對話中的小紗同學就算這麼說也……」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0707", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 66, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不過不管是瓜生君還是椋梨君，不會在聊到一半就跑走這點值得稱讚。」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3734", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 67, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「討厭～哈哈哈，當然啦！」", "text_idx": 471, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "隼太", "alt_speaker_idx": 543, "voice": "ht0266", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「妳覺得我們是那種人嗎？」", "text_idx": 424, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「要是覺得就不會像這樣跟你們說話了。那麼，接下來──」", "text_idx": 470, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3735", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──的確非常地「自然」呢。", "text_idx": 372, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學的變化已經在大家心裡留下了印象，受此影響，結女的學生們已經對我們抱持友善的態度了。", "text_idx": 524, "plain": null, "plain_idx": null, "len": 45, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 72, "speaker": "各務台男子Ａ", "flag": 64, "pages": [{"page": 0, "text": "「妳看了嗎？昨天那集！」", "text_idx": 423, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "各務台男生A", "alt_speaker_idx": 497, "voice": "da0042", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 73, "speaker": "結女生徒Ｂ", "flag": 64, "pages": [{"page": 0, "text": "「看了看了！那兩個人之後到底會怎麼樣啊……！」", "text_idx": 461, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "結女學生B", "alt_speaker_idx": 532, "voice": "jb0030", "char_id": "結女生徒Ｂ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 74, "speaker": "各務台女子Ａ", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈，沒想到會有跟結女的大小姐們熱烈討論連續劇的這一天到來啊～」", "text_idx": 399, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "各務台女生A", "alt_speaker_idx": 495, "voice": "sa0039", "char_id": "各務台女子Ａ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不只是我們。教室中不分男女，大家都聊得很開心。", "text_idx": 488, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在一個月前完全無法想像的，極其普通的男女混校的氣氛。", "text_idx": 499, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "進入１１月以後，我們２－Ｔ就像這樣，和１０月完全不一樣了。", "text_idx": 541, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「怎、怎麼了？瓜生君。」", "text_idx": 430, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3736", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊啊、沒有……嗯，只是有點。」", "text_idx": 400, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 80, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「反正一定是在想色情的事吧？男生就是這樣啦，啊～討厭討厭！」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0217", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 81, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0708", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在我們這群人中，能敏銳察覺到轉變的人似乎只有我和安潔。", "text_idx": 500, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──新吾同學跟安潔有某方面很相似。", "text_idx": 371, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "嗯，這種視線也是「某方面」的其中之一吧。", "text_idx": 498, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在經常相處的同學中，會對這女孩特別感到夥伴意識果然不是沒有原因的……", "text_idx": 503, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 86, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「接續星期五，又全員到齊了呢。」", "text_idx": 442, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0311", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到了午休時間，學姊和熊喵、櫻乃也加入了我們。大家圍著桌子。", "text_idx": 491, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……雖然想這麼說，但椋梨君回各務台了吧？」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0312", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，剛才回去的。好像有必須在今天完成的工作。」", "text_idx": 409, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身處這種特殊情況下的學生會長真辛苦。", "text_idx": 539, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯～椋梨君真可惜……可以幫忙轉告他下次再一起嗎？」", "text_idx": 415, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0313", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道了，那傢伙會很高興的。」", "text_idx": 440, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 93, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「總之，有好好地送他出門了喔！」", "text_idx": 466, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0709", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 94, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「安潔的『請慢走』，用在椋梨君回各務台的時候一點違和感也沒有，真好呢。」", "text_idx": 426, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3737", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 95, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「要是椋梨那混帳可以就這樣不回來，渣蟲的數量減少就更好了……」", "text_idx": 469, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0218", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 96, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「隼太學長回來的話就增加了。」", "text_idx": 480, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0675", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 97, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「可怕！」", "text_idx": 386, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0219", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 98, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「而且還會把作物啃得亂七八糟呢。」", "text_idx": 467, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0710", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 99, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「蝗蟲嗎？」", "text_idx": 468, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3738", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 100, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「椋梨君真厲害呢，小熊喵。」", "text_idx": 450, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0314", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 101, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕～嚕～」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 525, "voice": "pn0097", "char_id": "ぱんにゃ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的朋友漸漸變成謎之生命體了。", "text_idx": 516, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "總之，雖然少了一個人，但大家還是氣氛融洽地吃著午餐。", "text_idx": 537, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 104, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「慶祝會好開心呢～」", "text_idx": 436, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0315", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "中心人物果然還是天羽學姊。", "text_idx": 489, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這個人的天然屬性所營造出的和平時空，與這種午飯時光實在非常契合。", "text_idx": 540, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「謝謝。聽學姊這麼說，提案就有價值了。」", "text_idx": 472, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 108, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「不，我也要說謝謝喔。」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0316", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 109, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「小愛理，妳說過那是第一次對吧？其實那樣的慶祝會我也是第一次呢。」", "text_idx": 428, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0317", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 110, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊……是這樣嗎？」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3739", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 111, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，所以才更覺得開心，對吧？」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0318", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 112, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「這、這個……是啊……」", "text_idx": 474, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3740", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 113, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「愛理害羞了。」", "text_idx": 432, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0676", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 114, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「這樣的愛理很稀有呢。美羽學姊，多說一點！」", "text_idx": 475, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0220", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 115, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「妳們喔！」", "text_idx": 422, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3741", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到因為瀨名同學的反應而起鬨的女生們，天羽學姊笑得更開心了。", "text_idx": 526, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 117, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「如果能那麼開心的話，就算每個禮拜都考試也可以呢。」", "text_idx": 421, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0319", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 118, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那那那是什麼恐怖的事情！」", "text_idx": 477, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0711", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 119, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「拜、拜託請不要那樣……」", "text_idx": 441, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0221", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 120, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，我倒覺得無所謂喔？慶祝會的參加者只有我跟學姊了嗎？」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3742", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 121, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「是我錯了啦愛理～！」", "text_idx": 448, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0222", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是個會反擊的女孩呢。", "text_idx": 506, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「希望下次還有機會能跟大家一起慶祝。」", "text_idx": 429, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 124, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯♪好期待期末考的來臨呢。」", "text_idx": 407, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0320", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 125, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，真期待呢，兩位。」", "text_idx": 390, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3743", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 126, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「唔唔唔……」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0223", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 127, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「明明期中考的結果都還沒有發回來……」", "text_idx": 446, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0712", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "純真無邪的天羽學姊，以及被自己拋的梗逼到絕境的乾同學＆安潔。", "text_idx": 529, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 129, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊，對了。大家聽我說，今天……」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0321", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽學姊拿出了一個袋子。", "text_idx": 504, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 131, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「鏘～有餅乾喔！」", "text_idx": 479, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0322", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 132, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「喔喔！？是、是美羽學姊親手做的嗎！？」", "text_idx": 403, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0224", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 133, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯，欸嘿嘿，因為媽媽在做餅乾，所以我也順便一起做了。」", "text_idx": 413, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0323", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 134, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「想說今天大家也會聚在一起，所以就帶來了。大家願意的話飯後來吃吧？」", "text_idx": 431, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "美羽", "alt_speaker_idx": 538, "voice": "mu0324", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 135, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「當然願意了～！！」", "text_idx": 460, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "紗凪", "alt_speaker_idx": 530, "voice": "sn0225", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 136, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在漸漸恢復和樂的氣氛中──", "text_idx": 501, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 137, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔唔……還是一樣這麼優秀的體貼方式，美羽學姊……！」", "text_idx": 394, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0713", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 138, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有安潔一個人被敗北感打擊到了。", "text_idx": 492, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……安潔，那我們去準備配點心的茶吧？」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 140, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我對她說。", "text_idx": 515, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 141, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──不知道為什麼，比起其他人的反應，我更快注意到安潔的情緒。", "text_idx": 369, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 142, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「欸……啊……」", "text_idx": 452, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0714", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我來幫忙。茶點餐具放在那邊對吧？」", "text_idx": 437, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 144, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊……是、是的。」", "text_idx": 396, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0715", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 145, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那安潔和新吾同學去準備茶喔。請各位稍等一下～」", "text_idx": 476, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0716", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 146, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「走吧，新吾同學！」", "text_idx": 473, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 508, "voice": "ag0717", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 147, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安潔恢復了笑容，充滿活力地站了起來。", "text_idx": 509, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 148, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 408, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 519, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也笑了，跟她一起。", "text_idx": 513, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 150, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3745", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 151, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「真稀奇呢，那女孩。」", "text_idx": 465, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3746", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 152, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「？」", "text_idx": 482, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0678", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 153, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「沒事，什麼都沒有。」", "text_idx": 456, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3747", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 154, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「感謝地等茶來吧。」", "text_idx": 434, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 511, "voice": "ar3748", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 155, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 408, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 521, "voice": "sk0679", "char_id": "桜乃"}]}
