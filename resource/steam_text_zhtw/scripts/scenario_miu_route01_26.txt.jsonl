{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 0, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……葛格，你好憔悴。」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 339, "voice": "sk1297", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是、是嗎？」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 2, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「昨天發生什麼事了嗎？」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 339, "voice": "sk1298", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是……」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其實，發生了無法對別人說起的事。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "可以說是出乎意料吧。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沒想到美羽學姊的那個模樣……", "text_idx": 341, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一想起這件事，我直到天亮都沒睡著。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看起來憔悴也是這個理由。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 9, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……葛格，你臉好紅。」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 339, "voice": "sk1299", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我、我什麼都沒有看到啦！」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 11, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 339, "voice": "sk1300", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是和櫻乃聊天都這副德行，我好害怕跟美羽學姊見面時的自己。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我現在得想辦法保持平常心……", "text_idx": 332, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 14, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1186", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;「唔啊！？」", "text_idx": 6, "plain": "「唔啊！？」", "plain_idx": 258, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我做了最差勁的反應。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "應該說，根本不可能保持平常心啦。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 18, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……早、早安。」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1187", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安！」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 20, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥，你破音了。」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 339, "voice": "sk1301", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喉、喉嚨好像有點怪怪的，咳嗯！」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我輕咳一聲，盡量和學姊保持距離。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 23, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「是空氣太乾燥了嗎……新吾君，你還好嗎？」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1188", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「！？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她一口氣縮短距離，直視著我的臉。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊的香氣飄到我的鼻尖。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨天的畫面彷彿又要浮現在腦海，我連忙別開視線。", "text_idx": 337, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 28, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「把窗戶打開通風一下吧？」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1189", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊、這樣就好了沒關係！」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「是嗎？」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1190", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "每次和學姊對上眼神，我就說不出話來。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "意識過頭了吧我……", "text_idx": 323, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 34, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……我去看外面的兔子。」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 339, "voice": "sk1302", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好，慢走。」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我面帶笑容目送櫻乃離開。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 37, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1191", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但我突然意識到，現在變成和美羽學姊兩人獨處了。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "和平常不同，我想不到任何可以聊的話題。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 40, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「今、今天天氣真好呢。」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1192", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就是說啊。」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們各自做著不同的工作，聲音中的情緒莫名高亢。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然後，立刻就沉默。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "當美羽學姊背對我時，緊張感才稍微緩解。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真的得想想辦法才行，這個狀況……", "text_idx": 349, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也不希望跟學姊之間氣氛一直這麼尷尬。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「新吾君，那個啊。」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1193", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%123;「唔哇啊────！？」", "text_idx": 5, "plain": "「唔哇啊────！？」", "plain_idx": 256, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 49, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1194", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突如其來的重播讓我整個人驚慌失措。", "text_idx": 350, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不行了，連幻覺都……", "text_idx": 309, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 52, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「你沒事吧，新吾君？」", "text_idx": 252, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1195", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊、沒事，抱歉……」", "text_idx": 260, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "即使重播結束，我依然沒辦法直視學姊的臉。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我甚至開始覺得社團教室的空氣變得稀薄。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 56, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……那個，昨天抱歉喔。」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1196", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸……」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「我想跟貓咪們一起洗澡……但是朵萌和花鈴卻到處亂跑……」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1197", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 59, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「然後追牠們的時候跟新吾君撞個正著，我嚇了一跳，連遮擋都忘記了……」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1198", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我、我才要說對不起。」", "text_idx": 279, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我對自己的嘴笨絕望到懷疑起自己是不是日本人了。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然此時的狀況我也只能道歉。", "text_idx": 358, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「對了，這個。你忘記拿手機了對吧？」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1199", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 64, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「掉在我房間裡……」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1200", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「謝、謝謝妳！」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「我、我完全沒有亂看喔！」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1201", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 67, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「亂看別人的手機太差勁了，而且新吾君跟女孩子傳很多郵件也是你的自由。」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1202", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「看了也沒什麼有趣的。跟我傳郵件的異性，也就只有櫻乃而已。」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……是這樣啊，太好了。」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1203", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊啊、我在說什麼啊。不是那樣的，我不是那個意思！」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1204", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以為美羽學姊很冷靜，但此時的她看起來相當混亂。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 73, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「真的很抱歉喔。昨天讓你看到了不想看的東西……」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1205", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我、我什麼都沒看到喔！因為昨天的記憶我幾乎都不記得了。」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 75, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「感覺很討厭吧。看到那種乾癟的模樣……」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1206", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么会！妳一點也不乾癟！」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隔著衣服看起來，想像不出學姊的胸部原來那麼大，肌膚又白又透亮。", "text_idx": 356, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然日本人大部分是屁股比較大的葫蘆型身材，但學姊卻不是那樣。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的身材雖然嬌小，但該凸的地方都有凸非常勻稱……", "text_idx": 319, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 80, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……新吾君果然看到了。」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1207", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊啊、不是的！我沒有看，那是我的妄想！」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "現在不是冷靜分析學姊身材的時候了。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過事到如今，還說自己沒有看也太假了。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……對不起，我不會再說謊了。」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那個……我看到了。」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看得還挺清楚。這句就不要說出來了吧。", "text_idx": 347, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是那個問題嗎？", "text_idx": 308, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「唔唔，早知道就多練練腹肌了……」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 354, "voice": "mu1208", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不是那個問題吧？", "text_idx": 231, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唉……」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好絕望。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "對用手機挑戰了一次能否用念力顯影的自己。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然全裸是不行的吧？那是一種對理性的直接攻擊啊。", "text_idx": 351, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且對方還是那個美羽學姊。", "text_idx": 355, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一般來說絕對遙不可及的高嶺之花。", "text_idx": 306, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不對，現在也還是那樣。所以我才會看了那個人的裸體後挑戰起念寫啊。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……身為人類，我大概完蛋了。」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "當我開始這樣自言自語時，已經是末期了。", "text_idx": 345, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 99, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「唉……」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1259", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 100, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？怎麼了，嘆那麼大口氣……」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以為找到同伴，但是她的表情看起來沒有半點煩惱的樣子。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 102, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「我這麼幸福是可以的嗎……」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1260", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「發生什麼好事了嗎？」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 104, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「嗯。昨天跟新吾一起洗澡了♪」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1261", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;「噗！？」", "text_idx": 7, "plain": "「噗！？」", "plain_idx": 268, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 106, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……我先說清楚，是貓咪新吾喔！」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1262", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「這、這個我知道啦。」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但內心還是動搖了。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 109, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「泡在熱水裡的新吾好可愛喔～」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1263", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 110, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「用那種沒有我就活不下去的眼神看著我喔！」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1264", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 111, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「真是的～我才是沒有新吾就活不下去了呢。」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1265", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 112, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「什麼嘛。看你們聊得這麼熱鬧，居然是對瓜生君告白？」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "愛理", "alt_speaker_idx": 324, "voice": "ar4333", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 113, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「才、才不是！我說的是貓咪新吾！」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1266", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 114, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「喔……」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 324, "voice": "ar4334", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 115, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……幹嘛啦，哼什麼哼。」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1267", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 116, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 324, "voice": "ar4335", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 117, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「什麼事？」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 118, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……這種人哪裡好？」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 324, "voice": "ar4336", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 119, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 336, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 120, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「愛理，妳沒事吧？從剛才就盡說一些意義不明的話。」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1268", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 121, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「意義不明的是紗凪吧。」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 324, "voice": "ar4337", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 122, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1269", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學聳了聳肩，我跟紗凪互看一眼。", "text_idx": 342, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 124, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「你不要看我啦，好噁心。」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "紗凪", "alt_speaker_idx": 352, "voice": "sn1270", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 125, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "結果，我也只能聳肩苦笑了。", "text_idx": 353, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
