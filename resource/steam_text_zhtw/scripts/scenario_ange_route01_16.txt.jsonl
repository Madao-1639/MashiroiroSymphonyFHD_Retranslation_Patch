{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安～」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 1, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「大家早安！」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1606", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們走進教室。", "text_idx": 402, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 3, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，早安♪」", "text_idx": 319, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4003", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔！」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在教室迎接我們的，是已經全員到齊的朋友們。", "text_idx": 394, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 6, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「大、大家都來了呢……」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1607", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我跟愛理從昨晚就在一起。」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "櫻乃", "alt_speaker_idx": 416, "voice": "sk0908", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 8, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「原來如此，一起過夜了呀。」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1608", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「喂、不要用那種讓人遐想的說法啦！」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4004", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「總、總而言之……我已經聽櫻乃說了，所以忍不住就全員集合等著你們。」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4005", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 11, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「是說，你們一起進來了欸？」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "隼太", "alt_speaker_idx": 428, "voice": "ht0324", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊嗯……」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 13, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「欸嘿……」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1609", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們都露出無法掩飾的害羞笑容。", "text_idx": 403, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我想說從校門一起走到教室。」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 16, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「主人約安潔一起走……」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1610", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 17, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「咦？不去管其他進學校的學生嗎？」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 425, "voice": "mu0408", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為……」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我紅著臉說。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安潔是我的女僕嘛。」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除此之外的話就不說了。", "text_idx": 427, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的理由都濃縮在這一句裡。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "互相喜歡的男女，同時還是「主人與女僕」。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這是我們之間相處的模式，昨天已經坦承相見確認心意了。", "text_idx": 426, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就這樣，哈哈。」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 26, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……♪」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 425, "voice": "mu0409", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽學姊笑了。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其他人也都露出別有含意的笑容。", "text_idx": 389, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "當然也有人顯得不太能接受。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「但、但是，大家從櫻乃那裡聽說了多少？」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 31, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵呵……這個嘛～」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4006", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「成為了跟一般人不一樣的情侶呢。」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4007", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「不、不是的不是的愛理同學！」", "text_idx": 305, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1611", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，不是情侶嗎？」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4008", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 35, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「請不要欺負安潔……」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1612", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學善意的戲弄讓安潔的臉通紅一片。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沒有比這個反應更肯定的答案了。", "text_idx": 417, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都興奮起來。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 39, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「唔哈哈哈，很敢講欸主人～！」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 428, "voice": "ht0325", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……因為大家都這樣聚在一起了，我也只能坦白……」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 41, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「主、主人又在介意別人……」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1613", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不行嗎？」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 43, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……真是的，拿主人您沒辦法呢。」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1614", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「看來安潔不在您身邊是不行的。」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1615", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是啊，已經變成這樣了。」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 46, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「唔……你們兩個……」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4009", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「立刻就像夫婦一樣。」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 416, "voice": "sk0909", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 48, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔欸欸！？討、討厭啦那種事……」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1616", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生君看似因為我們才坦白，其實只是情緒放鬆了吧……」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4010", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是的！安潔心跳加速了！」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1617", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 51, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「呵呵～這就是戀愛使人盲目呢～」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 425, "voice": "mu0410", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「啊啊已經無法挽回了……」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "紗凪", "alt_speaker_idx": 422, "voice": "sn0355", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 53, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「是說安潔！？妳已經被下手了！？不只心靈連身體都無法挽回了嗎！？」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "紗凪", "alt_speaker_idx": 422, "voice": "sn0356", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 54, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「沒沒沒沒沒沒有被下手喔！當然什麼都沒有做！」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1618", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈……」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把手放到安潔頭上。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 57, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1619", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安潔的臉頰瞬間就紅了。", "text_idx": 399, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就是這樣……」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我環視大家。", "text_idx": 406, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "現在的我真的是放鬆了吧。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是這也是因為和安潔在一起的緣故。", "text_idx": 388, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因為我想親近安潔，所以變得和以前不同也是理所當然的。", "text_idx": 393, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "類似豁出去的氣勢，我害羞但驕傲地說著。", "text_idx": 430, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我，感覺自己終於真正意義上地成為『主人』了。」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 66, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1620", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 67, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「安潔也感覺終於成為真正的女僕了……主人……」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1621", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 68, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……這樣啊。」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4011", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學和大家都笑了。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 70, "speaker": "各務台男子Ａ", "flag": 64, "pages": [{"page": 0, "text": "「所以……」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "各務台男生A", "alt_speaker_idx": 392, "voice": "da0045", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 71, "speaker": "結女生徒Ｃ", "flag": 64, "pages": [{"page": 0, "text": "「這段閃光劇場要持續到什麼時候啊！？」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "結女學生C", "alt_speaker_idx": 423, "voice": "jc0054", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們受到了來自教室裡四面八方的尖銳視線，雖然早就預料到了。", "text_idx": 401, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……即使這樣也沒關係。現在的我真的徹底放鬆了。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 74, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「欸嘿嘿。」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1622", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要能看到安潔這個開心的笑容。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "時間來到了放學後。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 77, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那麼主人，安潔要去做學校的工作了！」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1623", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，加油。」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 79, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「欸嘿……」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1624", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 80, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「或許沒辦法去校門口送您離開，但是主人回家路上請務必小心慢走喔！」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1625", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 81, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……安潔會一直祈求主人平安的。」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1626", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也是。……安潔，過來一下。」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 83, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是……」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1627", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「摸摸摸～」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 85, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呼哇哇……哇嗯……」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1628", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 86, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那、那個主人，雖然安潔感覺輕飄飄的，可是安潔沒有做什麼值得稱讚的事情……」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1629", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。可是我想這麼做。」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 88, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1630", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……因為安潔很可愛。」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 90, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔唔～～」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1631", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 91, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯～？」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 92, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「胸口揪得緊緊的……嗯嗯、主人、主人、主人……」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1632", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「讓人摸起來很有成就感呢，安潔。」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 94, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「謝謝妳……」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1633", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 95, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那個、那個、主人……？」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1634", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，怎麼了？」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 97, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「安潔是主人的人……欸嘿！」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1635", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我也是。」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我是安潔喜歡的人，安潔的主人。」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最後再摸了一下，我收回手，凝視著她的眼睛。", "text_idx": 414, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我已經明白這是什麼意思了。」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 102, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是的……主人。」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1636", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 103, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是的，我的主人。」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1637", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安潔反復地說著。", "text_idx": 398, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我露出微笑。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，安潔加油喔。」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 107, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「好的！那麼安潔就暫時離開。安潔要出發了，主人！」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安潔", "alt_speaker_idx": 397, "voice": "ag1638", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──我們都知道對方希望自己做什麼。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雙方的心意契合而成的軸心，讓我們兩人緊密地連結在一起。", "text_idx": 429, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我們已經和之前不同了。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 111, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以，接下來──", "text_idx": 411, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 112, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「嘻嘻嘻～♪」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "隼太", "alt_speaker_idx": 428, "voice": "ht0326", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……唔哇，你看到了！？」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 114, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「被閃光彈攻擊了，真的。」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4012", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 115, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「一想到剛才的閃光今後還會變得更誇張，不免覺得有些可怕啊！」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "隼太", "alt_speaker_idx": 428, "voice": "ht0327", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 116, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「太危險了，要快點隔離才行。」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4013", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 117, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「所以已經沒事了，瓜生君？」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4014", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……還有一件事。」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 119, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「怎麼？」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4015", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我好像真的喜歡上安潔了。」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 121, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那種事情看了就知道了。」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4016", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 122, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈……嗯，抱歉。」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「走吧。」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 412, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 124, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "愛理", "alt_speaker_idx": 400, "voice": "ar4017", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 125, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「好～」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "隼太", "alt_speaker_idx": 428, "voice": "ht0328", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 126, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我感覺得到自己的臉頰羞得有些發燙，不過仍堅定地邁向自己該做的事情。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
