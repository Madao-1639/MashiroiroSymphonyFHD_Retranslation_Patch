{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安。」", "text_idx": 406, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 1, "speaker": "各務台男子Ａ", "flag": 64, "pages": [{"page": 0, "text": "「早～瓜生。」", "text_idx": 408, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "各務台男生A", "alt_speaker_idx": 451, "voice": "da0026", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 2, "speaker": "結女生徒Ｃ", "flag": 64, "pages": [{"page": 0, "text": "「瓜生君，早安～」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "結女學生C", "alt_speaker_idx": 487, "voice": "jc0026", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，早安。」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我一邊跟同學們打招呼，一邊朝自己的座位走去。", "text_idx": 463, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "確實做好這種小事，是維持良好氣氛的捷徑。", "text_idx": 483, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就跟勤快打掃房間是一樣的道理。", "text_idx": 459, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯嗯……」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我點了點頭肯定自己，正要坐下。", "text_idx": 468, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生。」", "text_idx": 415, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0793", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……來。」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "聽到瀨名喊我，動作瞬間停止。", "text_idx": 493, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安……怎麼了？」", "text_idx": 405, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她一臉嚴肅的表情……", "text_idx": 453, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "該不會是昨天學園長那件事？", "text_idx": 495, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我在心裡猜測。", "text_idx": 464, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過。", "text_idx": 444, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「我挑了幾本參考書來。」", "text_idx": 399, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0794", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名從書包裡拿出大量參考書，通通疊在我的桌上。", "text_idx": 476, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……欸？」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「離班會還有一點時間吧？這段時間也善加利用吧。」", "text_idx": 437, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0795", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這個情況……", "text_idx": 496, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是、是要念書嗎？」", "text_idx": 411, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 23, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「這不是當然的嗎？昨天你說了希望我再教你念書對吧，瓜生？」", "text_idx": 429, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0796", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我那句「妳還願意再教我念書嗎」瀨名非～常認真地聽進去了。", "text_idx": 467, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過，這個量也太……", "text_idx": 445, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "的確教念書是我拜託她的，而她也說過我「很好教」所以想繼續教我也能理解。", "text_idx": 482, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是好不容易才擺脫期中考，立刻又要專心念書實在很疲憊……", "text_idx": 448, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 29, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0797", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「坐下。」", "text_idx": 386, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0798", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好。」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嗯，很好。」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0799", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "當我表現出「很有教導的價值」的反應時，瀨名開心並且滿意地笑了。", "text_idx": 480, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好吧……能讓她這樣笑也不錯。", "text_idx": 455, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 35, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那首先就從這本開始吧。」", "text_idx": 433, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0800", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「麻煩妳了……」", "text_idx": 438, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過，那些話昨天才剛說出口而已，今天就行動了。", "text_idx": 446, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名愛理這個女孩子，在好與不好的意義上都認真得驚人啊……", "text_idx": 477, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "應該說，是我太低估她的認真了。", "text_idx": 462, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在第一與第二節課中間的下課時間。", "text_idx": 452, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 41, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生，休息時間也善加利用吧。」", "text_idx": 417, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0801", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……欸？」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「你在發什麼呆啊！廁所上完了吧？那就快點回去了！」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0802", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔哇、我、我知道了啦不用拉我……！」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 45, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊！？女、女僕看到了！愛理同學和新吾同學之間還不錯的氣氛！」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0328", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 46, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「誰要對瓜生下手啊！我是被他拜託教他念書的！」", "text_idx": 426, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0803", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "第二和第三節之間的下課時間。", "text_idx": 485, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 48, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「早安啊～先去各務台再來這裡實在好麻煩喔～」", "text_idx": 407, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0168", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「錯了，老師剛才說的話沒有認真聽嗎？剛剛才說過這裡是重點的啊。」", "text_idx": 435, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0804", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 50, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「新吾被盤問了！」", "text_idx": 403, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0169", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 51, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「盤問是什麼意思啊！只是稍微複習一下剛才的課程而已！」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0805", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「實際上是那樣沒錯。」", "text_idx": 392, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……『實際上』是什麼意思啊瓜生！」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0806", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃，我想說從旁人角度看起來也是那樣。」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 55, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「明明考試才剛結束而已欸？唉～比起那個新吾新吾，我剛才來學校的途中看到了～」", "text_idx": 409, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0170", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 56, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0807", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 57, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生，你過來我的座位一下。」", "text_idx": 418, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0808", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名突然站起來，一把抓住我的手拉走。", "text_idx": 478, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「咦？」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 60, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「要閒聊到什麼時候？不要說蠢話了快過來……！」", "text_idx": 425, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0809", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈哈，隼太，待會再說給我聽吧～」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 62, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0171", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 63, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「被帶走了。」", "text_idx": 424, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0329", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 64, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「……不是盤問而是洗腦嗎？新吾那傢伙根本百依百順嘛！」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0172", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 65, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「根據安潔的機密情報，剛才的下課時間也是那樣喔！」", "text_idx": 413, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0330", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 66, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「愛理那傢伙，真的墮落了呢……男人那種東西不要去管就好了，而且還偏偏是瓜生。」", "text_idx": 396, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "紗凪", "alt_speaker_idx": 486, "voice": "sn0118", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 67, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「因為安潔非常在意，今後也要關注才行。」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0331", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 68, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「我也是～好像挺有趣的感覺～跟考試前的氣氛都不同了。」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0173", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 69, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「就是這樣，那麼小紗同學再見囉～」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0332", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 70, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「喂、喂！我也不能錯過朋友遭受男人的魔爪啦……！」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "紗凪", "alt_speaker_idx": 486, "voice": "sn0119", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 71, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「不是錯放嗎？」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0333", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「那種地方就該錯過啦！」", "text_idx": 432, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "紗凪", "alt_speaker_idx": 486, "voice": "sn0120", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 73, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「那麼課就上到這邊……」", "text_idx": 434, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0096", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "第三節課結束了。", "text_idx": 484, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 75, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「八塚老師！」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0810", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 76, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「是！」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0097", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 77, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「為什麼新吾君被瀨名同學拉著過來呢！？」", "text_idx": 414, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0098", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「剛才的內容有問題想問。」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0811", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「看到學生突然被拉過來，老師可能會以為是發生什麼事了……但就是這麼回事。」", "text_idx": 421, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老師會驚訝也能理解。", "text_idx": 490, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 81, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「啊、好的，是這樣啊。問問題當然可以……畢竟我是老師嘛。」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0099", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明白原因後，萬智老師也接受這個狀況了。", "text_idx": 471, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 83, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「其實我偶爾會沒有自信……像現在被瀨名同學叫住，我就擔心是不是剛才的課程有說錯的地方……」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 45, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0100", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沒想到居然進入沮喪模式了。", "text_idx": 474, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 85, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生，說點什麼安慰她！」", "text_idx": 419, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0812", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？欸……啊……」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「萬、萬智老師的那種地方，我還挺喜歡的喔！」", "text_idx": 423, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 88, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「！！」", "text_idx": 439, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0101", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 89, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「是、是嗎？真是困擾呢欸嘿、討厭啦～這樣子老師不就會想讓你們盡管問了嘛～」", "text_idx": 410, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "萬智", "alt_speaker_idx": 494, "voice": "mc0102", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 90, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "%51;「只要瓜生在，八塚老師就很好說話。如果只有我一個人她就會膽戰心驚的樣子……」", "text_idx": 9, "plain": "「只要瓜生在，八塚老師就很好說話。如果只有我一個人她就會膽戰心驚的樣子……」", "plain_idx": 357, "len": 38, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0813", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 91, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好，那就麻煩妳了，八塚老師。要好好問到懂喔瓜生！」", "text_idx": 390, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0814", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──然後，午休時間。", "text_idx": 341, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 93, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「我吃飽了。」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0815", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 94, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好了，瓜生。」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0816", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，果然在這裡也要念嗎？」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 96, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「這不是當然的嗎？你以為我是為什麼才把念書的用具都帶來啊？」", "text_idx": 428, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0817", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名一臉理所當然的表情。", "text_idx": 475, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這半天下來，只要稍微有空檔時間她就會盯著我念書……", "text_idx": 497, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有這樣就算了，但是……", "text_idx": 449, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 100, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「開始了開始了！」", "text_idx": 436, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0334", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 101, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「哇啊，真的在念書呢～小熊喵。」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 489, "voice": "mu0208", "char_id": "みう"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 102, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕！」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 479, "voice": "pn0074", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 103, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「連在這裡都念書喔……愛理已經不行了，失去她太遺憾了……」", "text_idx": 430, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "紗凪", "alt_speaker_idx": 486, "voice": "sn0121", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 104, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「放棄得太早了吧！哈哈哈，女人的友情真是虛幻啊～」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "隼太", "alt_speaker_idx": 498, "voice": "ht0174", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就像這樣，大家都在旁邊看。", "text_idx": 457, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就我個人來說，這種情況就像把大家晾在一邊，我很難靜下心來念書。", "text_idx": 458, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 107, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……瓜生，現在念書好嗎？」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0818", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 108, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「既然如此，就加入大家的聊天啦！」", "text_idx": 404, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0819", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然我覺得自己沒有表現出來，但瀨名還是看穿我的心思，她不悅地轉向旁邊。", "text_idx": 501, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 110, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不想念的話就說清楚啊……」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0820", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 111, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她小聲抱怨著，很不滿地嘟起嘴。", "text_idx": 454, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 112, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看得出來她是真心想督促我念書。", "text_idx": 465, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──她完全不在意周遭的氣氛。但是她的存在感卻會改變氣氛。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而她的「存在」，此時此刻是專注在我一個人身上……", "text_idx": 491, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 115, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……念吧。麻煩妳了，瀨名。」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而我無法忽視她的那份心意。", "text_idx": 492, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然念書這件事是我主動提起的，但除此之外她很少會這麼積極丟球給我。", "text_idx": 500, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以雖然對大家很不好意思……我不能錯過這個好機會。", "text_idx": 469, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 119, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好！既然如此我就不會客氣了！」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0822", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈……還是請妳手下留情啊。」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 121, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「那我們就保持安靜吧。」", "text_idx": 431, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 489, "voice": "mu0209", "char_id": "みう"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 122, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，抱歉，不用介意我們的。」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然只要我們換個地方就能解決，但我覺得那樣做會讓大家心裡有疙瘩，結果還是只能留在原地。", "text_idx": 499, "plain": null, "plain_idx": null, "len": 43, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 124, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「就算你那樣說還是很礙眼啊。跟美羽學姊相處的快樂時光，才不想看到那種認真念書的傢伙呢。」", "text_idx": 394, "plain": null, "plain_idx": null, "len": 44, "alt_speaker": "紗凪", "alt_speaker_idx": 486, "voice": "sn0122", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 125, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「喂，紗凪！不要把參考書拿走啦！」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0823", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「抱歉喔，還我們吧！」", "text_idx": 401, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 127, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「唔喔手不要伸過來啦你這隻糰子蟲！還給你就是了敢碰我就殺了你喔！」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "紗凪", "alt_speaker_idx": 486, "voice": "sn0123", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 128, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈……來，瀨名。」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 129, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊……謝謝。」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0824", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 130, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「不過，還是會想和你們聊天呢～關於這點怎麼樣呢熊喵小姐，就動物來說！」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0335", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 131, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕……」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 479, "voice": "pn0075", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 132, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嗚嚕、嗚嚕～」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "熊喵", "alt_speaker_idx": 479, "voice": "pn0076", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 133, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「喔喔！熊喵小姐也表現出希望心愛的新吾同學陪牠玩的感覺！」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "安潔", "alt_speaker_idx": 456, "voice": "ag0336", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 134, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕！」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 479, "voice": "pn0077", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 135, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「咿……喂、不要再過來了！」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0825", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 136, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「來，不好意思喔熊喵。天羽學姊麻煩妳了。」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 137, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「好～小熊喵來這邊～呵呵，過了這麼久小愛理還是不習慣呢～」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 489, "voice": "mu0210", "char_id": "みう"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 138, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「至少，代理的瓜生～」", "text_idx": 422, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 473, "voice": "sk0398", "char_id": "桜乃"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 139, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嗚嚕～」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 479, "voice": "pn0078", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 140, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「謝謝妳櫻乃。那麼，瀨名……」", "text_idx": 427, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 141, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「唔、嗯。」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0826", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 142, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就這樣，在大家的干擾下瀨名繼續教我念書。", "text_idx": 460, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 143, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0827", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 144, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「所以，瓜生，這裡有一個特別的解題訣竅喔。」", "text_idx": 400, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0828", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 145, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喔，那我要筆記下來。」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 470, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 146, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「很正確的態度。嗯，仔細記下來吧。呵呵，順便連這題也一起教你好了。」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "愛理", "alt_speaker_idx": 461, "voice": "ar0829", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 147, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我越是接球，瀨名就丟得越起勁。", "text_idx": 466, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "當然我也一顆不漏地都接下了。", "text_idx": 481, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然我還不知道她為什麼會對我這麼積極熱心……", "text_idx": 502, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但感覺並不壞，畢竟我也是男生嘛。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
