{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 119, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊，回去後也要複習喔♪」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 405, "voice": "ar5593", "char_id": "愛理"}]}
