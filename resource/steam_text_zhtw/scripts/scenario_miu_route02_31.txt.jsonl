{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 0, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「新吾君你啊……」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2240", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 199, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 2, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2241", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎麼了？」", "text_idx": 209, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 4, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……不，沒什麼♪」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2242", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天也和學姊牽著手走路。", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "像平常一樣閒聊。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "距離畢業典禮，還有半個月。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是我們之間，仍沒有聊過這個話題。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「社團活動結束後，可以去學姊的家嗎？」", "text_idx": 222, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 11, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯，當然可以喔～」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2243", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊笑著勾上我的手臂。", "text_idx": 247, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的動作就像在求助一樣。", "text_idx": 242, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 14, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「好久沒有兩個人獨處了呢。」", "text_idx": 204, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0201", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃，我也差不多該回去……」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 16, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「別那樣說嘛，稍微聊一下吧？」", "text_idx": 193, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0202", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……唉。」", "text_idx": 186, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放學後我來到學姊家打擾，但是美羽學姊臨時接到打工的通知，所以出門了。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊在對我客氣吧。", "text_idx": 243, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她叫我不必介意儘管坐，出門前還準備了點心給我吃。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 21, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「我覺得應該對新吾同學道謝。」", "text_idx": 212, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0203", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 23, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「謝謝你總是為美羽著想。」", "text_idx": 226, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0204", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不會，沒什麼的……」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 25, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「都是多虧了新吾同學喔。美羽才能像那樣笑著……」", "text_idx": 228, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0205", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我心中總是很迷惘。", "text_idx": 256, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "自己做的事是正確的嗎？", "text_idx": 273, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我是不是應該多安慰學姊一點……", "text_idx": 257, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……真的是那樣嗎？」", "text_idx": 190, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 31, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0206", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我覺得，自己是不是反而給學姊造成壓力了……」", "text_idx": 214, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近美羽學姊完全不提熊喵的事了。", "text_idx": 262, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那天以來，也沒有再流過眼淚。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知道這究竟是不是好事。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 36, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「沒關係的。因為最後，還是那孩子要做決定。」", "text_idx": 221, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0207", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 38, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「美羽一定很想跟熊喵小姐一起生活吧。」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0208", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 39, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「但那是無法實現的事。她自己也知道……」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0209", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 41, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「新吾同學，今後也請你多陪在那孩子身邊。」", "text_idx": 216, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0210", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「只要那樣就好了嗎？」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 43, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "結子", "alt_speaker_idx": 269, "voice": "yk0211", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到結子小姐的笑容，我什麼話都說不出來了。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……你跟媽媽說話了嗎？」", "text_idx": 185, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2244", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「稍微聊了一下而已。」", "text_idx": 223, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「這樣啊……太好了♪」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2245", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "結果，我一直待到學姊回來。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老實說，被結子小姐全力誘惑差一點就要栽了。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 50, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「我覺得我媽媽一定在打新吾君的主意。」", "text_idx": 213, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2246", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 51, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「打我的主意？」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 52, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯。因為有時候吃飯吃到一半，她會突然嘆氣然後喃喃自語。」", "text_idx": 200, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2247", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 53, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「唉……好想教新吾君人妻的魅力。」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2248", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……剛才她一臉認真對我說同樣的話了。", "text_idx": 181, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "當然，這件事我說不出口。", "text_idx": 266, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 57, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「要小心我媽媽喔。不可以輸給人妻什麼的！」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2249", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天的學姊比平常還要撒嬌。", "text_idx": 233, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們的視線一對上，她就湊上來親吻我。", "text_idx": 254, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啾、嗯……啾……嗯嗯、啾……」", "text_idx": 198, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2250", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊就這樣把我壓倒，騎到我身上來。", "text_idx": 244, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們唇舌交纏了好一會。", "text_idx": 253, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「新吾君是我一個人的新吾君喔……」", "text_idx": 218, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2251", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊表現出的獨佔慾讓我胸口發熱。", "text_idx": 248, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 65, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……新吾君，要一直在我身邊喔。」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2252", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就算這份感情是因為跟熊喵分離而產生的也沒關係。", "text_idx": 249, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我會一直在妳身邊。」", "text_idx": 211, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我毫不猶豫地回答。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「新吾君，你醒著嗎？」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2408", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「醒著。」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2409", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們這樣依偎著彼此多久了呢？", "text_idx": 255, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "關掉燈，靜靜地感受只屬於兩人的時間。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然，學姊小聲地嘆了口氣。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 75, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎麼了嗎？」", "text_idx": 208, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 76, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2410", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 77, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯，那個，我想謝謝你。」", "text_idx": 202, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2411", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 79, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「小熊喵的事，你什麼都沒有問我對吧？」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2412", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 81, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「我啊，其實不希望讓小熊喵回到媽媽的身邊。」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2413", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 82, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「很過分吧？說要救助動物，結果卻想讓牠待在自己身邊……」", "text_idx": 207, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2414", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知道該怎麼回應。", "text_idx": 251, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我只是摸了摸學姊的頭髮。", "text_idx": 259, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 85, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……狗狗或貓咪，為什麼壽命都比人類短呢？」", "text_idx": 189, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2415", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 87, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「小熊喵……」", "text_idx": 205, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2416", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊的聲音顫抖，她咬住自己的手背。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她小的時候，疼愛的貓因為生病死去。", "text_idx": 241, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "應該是想起當時的事了吧。", "text_idx": 250, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要跟動物一起生活，就一定會遭遇別離。", "text_idx": 238, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "狗也是，貓也是。", "text_idx": 265, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "還有，熊喵也是。", "text_idx": 276, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 94, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉喔。」", "text_idx": 187, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2417", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為學姊太善良了。」", "text_idx": 203, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 261, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 96, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 197, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 271, "voice": "mu2418", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在我的撫摸下，學姊開始壓抑地哭了起來。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……熊喵知道嗎？", "text_idx": 182, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有一個這麼思念牠的人。", "text_idx": 263, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有一個這麼愛牠的人。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊的心意，有傳達給牠嗎？", "text_idx": 245, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管是對熊喵展露的笑容。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "還是拼命做好的尾巴飾品。", "text_idx": 275, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "全部。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "全部都會逐漸被牠遺忘嗎……", "text_idx": 237, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
