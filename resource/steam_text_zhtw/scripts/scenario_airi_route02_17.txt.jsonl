{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 0, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "華美的袖子輕快地飛舞。", "text_idx": 227, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 1, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「新吾，再說一次。」", "text_idx": 189, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3718", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「愛理很適合穿和服呢……」", "text_idx": 185, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 3, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，新吾同學被強迫誇獎了～」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安潔", "alt_speaker_idx": 208, "voice": "ag0607", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「愛理其實很喜歡被誇的嘛。」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我摸摸她害羞的臉。", "text_idx": 214, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過……愛理穿和服的樣子真的是漂亮得驚人。", "text_idx": 201, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 7, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「說想看的人是新吾嘛。所以就很用心地穿這一身……」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3719", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 8, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈，這不好好誇一下可不行呢～」", "text_idx": 174, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 225, "voice": "mu0307", "char_id": "みう"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 9, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「原來如此。」", "text_idx": 168, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 219, "voice": "sk0654", "char_id": "桜乃"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 10, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「愛理，很適合。看起來就很喜慶。」", "text_idx": 187, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "櫻乃", "alt_speaker_idx": 219, "voice": "sk0655", "char_id": "桜乃"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 11, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「好奇妙的誇法！！」", "text_idx": 181, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "紗凪", "alt_speaker_idx": 224, "voice": "sn0211", "char_id": "紗凪"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「但是愛理同學很開心是無庸置疑的。啊啊，新年快樂呢……」", "text_idx": 166, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "安潔", "alt_speaker_idx": 208, "voice": "ag0608", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 13, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯嗯，和服真的很適合正月很棒呢。小熊喵也來說，新年快樂～」", "text_idx": 178, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "美羽", "alt_speaker_idx": 225, "voice": "mu0308", "char_id": "みう"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 14, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕嚕嚕、嚕嚕嚕～～♪」", "text_idx": 179, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "熊喵", "alt_speaker_idx": 222, "voice": "pn0096", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "正月的早晨。", "text_idx": 220, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我跟愛理約了大家一同前往瀨名家的住宅。", "text_idx": 216, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「新吾，這下子媽媽絕對會吃驚的吧。」", "text_idx": 190, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3720", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為愛理很漂亮啊。」", "text_idx": 180, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 19, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嗯♪」", "text_idx": 176, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3721", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 20, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「隨口就在放閃呢～」", "text_idx": 197, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 208, "voice": "ag0609", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「很喜慶。」", "text_idx": 183, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 219, "voice": "sk0656", "char_id": "桜乃"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 22, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「而且媽媽應該以為今天只有我跟新吾而已！」", "text_idx": 193, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3722", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 23, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「哎呀～按照這個發展，我們其實應該看一下場面氣氛婉拒的才對吧～」", "text_idx": 172, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "隼太", "alt_speaker_idx": 228, "voice": "ht0254", "char_id": "隼太"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天大家一起前往愛理的老家，不是只為了跟學園長拜年而已。", "text_idx": 202, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "愛理還要跟學園長談結束一個人生活，回家住的事。", "text_idx": 210, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是。", "text_idx": 203, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那種氣氛，無視就好了。」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 28, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "全員", "alt_speaker_idx": 204, "voice": "go063", "char_id": "汎用"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "聽到我這麼話，大家都驚訝地瞪圓了眼睛。", "text_idx": 226, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3723", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我和愛理相視而笑。", "text_idx": 213, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「沒錯，那種氣氛不用管，新吾跟大家都是。」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3724", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 33, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「媽媽是個跟熱鬧的正月無緣的人。所以希望大家一起去，讓她嚇一跳。」", "text_idx": 182, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3725", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「要談的事情等嚇完之後再說……哈哈，會不會太厚臉皮了？不過畢竟是正月。」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 35, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥哥，愛理。」", "text_idx": 163, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 219, "voice": "sk0658", "char_id": "桜乃"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 36, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「啊～」", "text_idx": 175, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "隼太", "alt_speaker_idx": 228, "voice": "ht0256", "char_id": "隼太"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我明白大家驚訝的理由。", "text_idx": 215, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 38, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，一點都不像新吾會說的話～」", "text_idx": 170, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3726", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「愛理討厭這樣的我嗎？」", "text_idx": 186, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 40, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「新吾也在強迫我說～」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3727", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "現在的愛理開心得不得了，燦爛的笑容下袖子翩翩飛舞──", "text_idx": 223, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 42, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「最喜歡了！」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3728", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我也是，喜歡愛理。」", "text_idx": 164, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 217, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 44, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 177, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "愛理", "alt_speaker_idx": 209, "voice": "ar3729", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "坦率地傳達心意。", "text_idx": 206, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因為有想傳達的那個人，所以不會害怕退縮。", "text_idx": 205, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 47, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……總之現在就，欸～各位……預備～」", "text_idx": 165, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安潔", "alt_speaker_idx": 208, "voice": "ag0611", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 48, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "「你們看一下氣氛啦！」", "text_idx": 167, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "全員", "alt_speaker_idx": 204, "voice": "go064", "char_id": "汎用"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈……！」「哈哈……」", "text_idx": 173, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "愛理／新吾", "alt_speaker_idx": 211, "voice": "ar3730", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家熱熱鬧鬧地談笑。", "text_idx": 207, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們一起向前邁進。", "text_idx": 212, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
