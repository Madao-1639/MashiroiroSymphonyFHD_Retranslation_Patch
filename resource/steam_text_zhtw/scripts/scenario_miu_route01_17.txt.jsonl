{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「這下可不是鬧著玩的了。」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4273", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 1, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0879", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今早，社團教室前又被放了紙箱。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "箱子裡有一隻出生後沒幾個月的黑貓。", "text_idx": 438, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這是第２隻被棄養的貓了。", "text_idx": 458, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "還沒找到能領養白貓的飼主，又增加了新問題。", "text_idx": 460, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 6, "speaker": "白猫", "flag": 64, "pages": [{"page": 0, "text": "「咪～」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "白貓", "alt_speaker_idx": 435, "voice": "wc0006", "char_id": "白猫"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 7, "speaker": "黒猫", "flag": 64, "pages": [{"page": 0, "text": "「咪～咪～」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "黑貓", "alt_speaker_idx": 461, "voice": "bc0000", "char_id": "黒猫"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "２隻小貓互相呼應似的咪咪叫了起來。", "text_idx": 464, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 9, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「為什麼要做這麼過分的事……」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0975", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 10, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「貓好寂寞。」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 430, "voice": "sk1255", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 11, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「安潔不能原諒做這種事的人。」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3394", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「總之，必須想個對策才行。要是棄貓繼續增加就糟了。」", "text_idx": 386, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4274", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 13, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0880", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「學姊，妳還好嗎？」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 15, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……嗯，抱歉喔，我明明是部長……」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0881", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽學姊看起來大受打擊。", "text_idx": 448, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪注意到她的情況，在身旁握著她的手。", "text_idx": 443, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "像這種時候，我們必須成為她的力量才行。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「總之，先跟萬智老師商量看看吧。這不是靠我們就能解決的問題。」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「說的也是，我也覺得那樣做比較好。」", "text_idx": 394, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4275", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「學姊也同意嗎？」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 22, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0882", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊？」", "text_idx": 392, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 24, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊……嗯，說的沒錯。找八塚老師商量看看比較好呢。」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0883", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊悲傷的模樣看了讓人很難受。", "text_idx": 414, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "必須想辦法改善這個狀況才行。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 27, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「……所以，我就想說也和學園長商量看看。」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "萬智", "alt_speaker_idx": 450, "voice": "mc0268", "char_id": "万智"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 28, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「原來如此啊。聽起來不妙呢……」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0559", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟萬智老師說明情況後，我們決定向學園長尋求幫助。", "text_idx": 455, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「對不起。都是我的錯，給大家造成麻煩了……」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0884", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 31, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「不是美羽學姊的錯喔。是棄養小貓的飼主不對。」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0976", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 32, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「就是說啊，美羽學姊不需要道歉的……」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3395", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 33, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「就算是那樣，如果棄養動物的傢伙繼續增加就是大問題了。」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0560", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那妳說該怎麼辦啊！」", "text_idx": 401, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4276", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 35, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「為了思考對策，大家才集合起來的吧？」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0561", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「身為學園長，應該有什麼好方法吧？」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4277", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 37, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「這個嘛，如果真有什麼好方法，我願意把萬智嫁過去換取呢。」", "text_idx": 399, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0562", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 38, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「才不需要。」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4278", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 39, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「不需要……嗚嗚，說的也是。對瀨名同學來說，老師是不需要的呢。」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "萬智", "alt_speaker_idx": 450, "voice": "mc0269", "char_id": "万智"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 40, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊，我不是那個意思……」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4279", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "簡單來說，就是沒有好方法的意思。", "text_idx": 439, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 42, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥，怎麼辦？」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 430, "voice": "sk1256", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最糟就是通宵監視，試著抓到棄養貓的飼主。", "text_idx": 427, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要是再有更多人誤會我們社團的目標就困擾了。", "text_idx": 452, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「總之現在能做的，我覺得可以貼禁止棄養動物的標語在社團門口。」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 47, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「嗯，這是一定要做的。」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0563", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 48, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「標語我來做吧。」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0977", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 49, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也幫忙。」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "話雖如此，這並不是根本的解決之道。", "text_idx": 453, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 51, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「如果這樣還不能解決棄養動物的現象的話……」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0564", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 52, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……如果不能解決的話要怎麼樣？」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4280", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 53, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0565", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學園長沒有繼續說下去，只是看著美羽學姊。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的眼神絕對不是無情。", "text_idx": 411, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 56, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「……交給部長做判斷吧，就我的立場來說。」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0566", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 57, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0885", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 58, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「總之，請多加注意今後的狀況。還有，如果再發生什麼事務必向我報告，知道了嗎？」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0567", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「跩什麼跩啊。」", "text_idx": 396, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 420, "voice": "ar4281", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 60, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「因為我是學園長♪」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0568", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在母女兩人快要吵起來的氣氛中，美羽學姊行了禮準備離開。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪伴隨在她身邊，我也打算隨著她們兩人離開。", "text_idx": 441, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 63, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「……雖然你們說要保護動物。」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0569", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 64, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「但是今後會發生什麼事呢？」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0570", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 65, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0886", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 66, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "「只是自言自語，忘了吧。」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "蘭華", "alt_speaker_idx": 451, "voice": "rk0571", "char_id": "蘭華"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 67, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕～」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 432, "voice": "pn0331", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 68, "speaker": "黒猫", "flag": 64, "pages": [{"page": 0, "text": "「咪～咪～」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "黑貓", "alt_speaker_idx": 461, "voice": "bc0001", "char_id": "黒猫"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 69, "speaker": "白猫", "flag": 64, "pages": [{"page": 0, "text": "「咪～」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "白貓", "alt_speaker_idx": 435, "voice": "wc0007", "char_id": "白猫"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放學後的社團教室。", "text_idx": 424, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紙箱中，２隻貓緊緊依偎著熊喵。", "text_idx": 445, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看來小貓已經完全把熊喵當成母親了。", "text_idx": 436, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 73, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0887", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽學姊在那之後一直很消沉。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "此時的她看著箱子裡的貓咪們，背影顯得很寂寞。", "text_idx": 431, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 76, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……我做的事情，是不是錯了？」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0888", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "學姊喃喃自語，正在製作標語的我和紗凪互看了一眼。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我第一次看到這麼脆弱的學姊。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "連之前廢社騷動的時候，她也沒有說出這種話……", "text_idx": 459, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 80, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊沒有做錯。」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0978", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就是說啊。」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我贊同紗凪的話。", "text_idx": 423, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "現在的我們，只能做到這點程度的支持。", "text_idx": 433, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 84, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「但是，如果我沒有創立這個社團，或許小貓們就不會被棄養了……」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0889", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 85, "speaker": "黒猫", "flag": 64, "pages": [{"page": 0, "text": "「咪～」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "黑貓", "alt_speaker_idx": 461, "voice": "bc0002", "char_id": "黒猫"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 86, "speaker": "白猫", "flag": 64, "pages": [{"page": 0, "text": "「咪～咪～」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "白貓", "alt_speaker_idx": 435, "voice": "wc0008", "char_id": "白猫"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "聽到貓咪們的叫聲，學姊咬緊了下唇。", "text_idx": 449, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 88, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……新吾，你轉過去那邊。」", "text_idx": 319, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0979", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪走到學姊身旁，聲音溫柔地安慰她。", "text_idx": 444, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我聽到背後傳來吸鼻子的聲音，明白了為什麼她要叫我轉身。", "text_idx": 422, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有沒有什麼辦法能讓學姊打起精神來呢？", "text_idx": 428, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "小貓需要人照顧，但現在的學姊更讓人擔心。", "text_idx": 417, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 93, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「各位，請慢走～♪」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3396", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 94, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「我跟美羽學姊只是暫時回去而已。」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0980", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 95, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「很快就會回來嗎？」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3397", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 96, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「嗯，雖然現在是熊喵在照顧，但我還是擔心小貓……」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0890", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「既然如此，那我也回來吧。」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 98, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「不行。你家太遠了。」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0981", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「太陽快下山了，不能留學姊跟紗凪在社團教室。」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 100, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「太陽下山後跟男人待在社團教室裡更危險吧！」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0982", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我這麼不被信任啊。」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 102, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「今後我也不打算信任男人！」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0983", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "紗凪伸手驅趕我。", "text_idx": 442, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這個反應跟以前不同，可愛得甚至讓我想微笑。", "text_idx": 456, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 105, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「如果是這樣的話，安潔有個好主意。」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3398", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好主意？」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 107, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是的，小貓咪們交給安潔來照顧就好了喔！」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3399", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 108, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「所以，各位請回家好好紓解身心的疲勞吧。」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3400", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 109, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「不可以那樣的。我們平常就已經受到很多小菜夏的照顧了。」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0891", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 110, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊才是，工作過頭了。」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3401", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 111, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「安潔可是知道美羽學姊會在深夜偷跑來社團教室的喔！」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3402", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 112, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？深夜偷跑來……」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 113, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊……只是偶爾而已。因為擔心大家的狀況……」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0892", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 114, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「而且小紗同學也是。」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3403", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 115, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「……不用提我的事啦。」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0984", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真拿這兩個人沒辦法啊。", "text_idx": 437, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "居然在社團活動結束後還跑來……", "text_idx": 418, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不過，也是因此才有這麼深的羈絆吧。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 119, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這兩個人真的好厲害。", "text_idx": 457, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 120, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「明天起，大家就是開開心心的三連休了。美羽學姊和小紗同學都請好好休息吧！」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3404", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 121, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安潔也在用她的方法支持美羽學姊。", "text_idx": 416, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "貓咪由安潔照顧的話就能安心了。", "text_idx": 454, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "既然如此……", "text_idx": 426, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 124, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊，明天要不要去哪裡走走轉換一下心情呢？」", "text_idx": 390, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 125, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「欸……？」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0893", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「逛街之類的休閒或許能稍微振奮心情。」", "text_idx": 400, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 127, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道妳很擔心小貓們，不過我覺得精神一直繃得這麼緊不好。」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 128, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「喔喔～新吾居然也有這麼好的提議。」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0985", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「所以，明天跟我一起……」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 130, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「欸，等一下等一下等一下！」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0986", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 131, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「你趁機說些什麼啊？那根本就是約會吧！」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0987", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 132, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不，我沒有那個意思……」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 133, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「騙鬼！你的企圖太明顯了！」", "text_idx": 403, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0988", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 134, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽學姊，請放心吧。我會保護妳遠離這個男人的毒牙的！」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0989", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「保護……」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 136, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「我也要一起去！我不可能讓你跟美羽學姊兩個人獨處！」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0990", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 137, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 138, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「雖然變成三個人，學姊覺得怎麼樣呢？」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 139, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊、嗯，那個……」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0894", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 140, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「答案是Yes！美羽學姊、小紗同學和新吾同學的三角關係讓安潔興奮得克制不住了！」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 40, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3405", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 141, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不會發生讓安潔興奮的事情喔。」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 142, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「……那麼，就聽從大家的好意吧。」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0895", "char_id": "みう"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 143, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「決定了呢，新吾同學，加油！」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 415, "voice": "ag3406", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 144, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「你只是負責提東西的喔！」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "紗凪", "alt_speaker_idx": 440, "voice": "sn0991", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 145, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「瞭解。」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 425, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_17.txt", "scene": "*start", "row": 146, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 446, "voice": "mu0896", "char_id": "みう"}]}
