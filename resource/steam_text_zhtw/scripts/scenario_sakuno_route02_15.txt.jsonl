{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我低頭看她。", "text_idx": 361, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
