{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「感覺謠言真的消失了呢。」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，根本沒有人在意了。」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3837", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「如果能就這樣維持到休業式就好了……」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 3, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「俗話說謠言只活７５０日。」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3838", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那樣或許會持續到櫻乃畢業喔？」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 5, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那７．５日。」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3839", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……這次的確實有這種感覺。」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「太好了。因為……我討厭別人批評葛格。」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3840", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也討厭聽到別人批評櫻乃。」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 9, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「總之可以安心了？」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3841", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不能太大意就是了。不過可以稍微放心了吧。」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 11, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……那重新開始撒嬌也沒關係呢。」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3842", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸……？」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這段時間她都沒撒嬌呢。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 14, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……不行？」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3843", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「可以喔。但是如果又出現什麼謠言就糟糕了，所以只在家裡撒嬌吧。」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 16, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯，暫時忍耐只在家裡。」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3844", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「可以立刻來撒嬌了嗎？」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3845", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，過來。」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 19, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「打擾了。」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3846", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃輕巧地坐在我的腿上，身體靠著我。", "text_idx": 382, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「跟葛格靠在一起好安心。」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3847", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「想要你摸我的頭髮。」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3848", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好──」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「手機響了，等我一下喔。」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "拿出手機，是隼太打來的。", "text_idx": 370, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有什麼事嗎？", "text_idx": 373, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂。」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 28, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『不好意思打擾你跟櫻乃親熱啊。』", "text_idx": 341, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "隼太", "alt_speaker_idx": 397, "voice": "ht1211", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「什……！？為、為什麼你知道？」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 30, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『……抱歉，原來真的在親熱？那我等一下再打吧？』", "text_idx": 340, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "隼太", "alt_speaker_idx": 397, "voice": "ht1212", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……你問得實在太自然，嚇了我一跳。」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「沒關係的，找我有什麼事？」", "text_idx": 319, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 33, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『好像打擾到你了我就長話短說吧。等一下各務台的男生們要集合辦遺憾會。』", "text_idx": 342, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "隼太", "alt_speaker_idx": 397, "voice": "ht1213", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「合併試辦終止的事？」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 35, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『就是這樣。如果現在跟小櫻乃在一起，不用勉強參加沒關係……怎麼樣？』", "text_idx": 343, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "隼太", "alt_speaker_idx": 397, "voice": "ht1214", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「這個嘛，難得大家聚會，我就稍微去一下吧。」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 37, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『抱歉啊。』", "text_idx": 344, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "隼太", "alt_speaker_idx": 397, "voice": "ht1215", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「沒關係，那我立刻準備出門。」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "問好集合場所和時間，掛斷電話。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 40, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……你要出門嗎？」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3849", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「隼太他們要聚會，是合併終止的遺憾會。」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 42, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3850", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她抱住我，頭頂在我的胸口左右搖頭。", "text_idx": 353, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃？」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 45, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……因為補充了葛格，所以去一下沒關係。」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3851", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉，我會盡快回來的。」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3852", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「或許會趕不及晚飯時間，妳先吃吧。」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我知道了。」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3853", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我出門了。有什麼事就打電話給我。」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「有需要的話我１分鐘打十次給你。」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3854", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……呃，我會接的打一次就好。」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「開玩笑的。」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3855", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「也對。而且櫻乃以前也沒有做過那種事。」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「真的有事情我會打給你。」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3856", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我出門了。」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 57, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「慢走。」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3857", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……好像拖得有點晚。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃在等我吧。", "text_idx": 377, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我回來了。抱歉這麼晚……咦？」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……櫻乃？」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 62, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嘶呼……嘶呼……」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3858", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一走進客廳，就看見櫻乃趴在桌子上睡著了。", "text_idx": 345, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "桌上還擺著一些簡單的輕食。", "text_idx": 374, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她在等我啊……", "text_idx": 349, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
