{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 119, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯……唔……」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3870", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃……櫻乃……」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 121, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「咦……？」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3871", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "迷濛的眼神。", "text_idx": 394, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "慢慢凝聚焦點。", "text_idx": 358, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 124, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「葛格……？」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3872", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安，櫻乃。」", "text_idx": 305, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 126, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，早安。」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3873", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 127, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「咦？不是早上。」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3874", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 128, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「等著葛格，讓你即使吃過飯也沒關係，做了點簡單的……」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3875", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃，妳在餐桌上睡著了。」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 130, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，好像是。」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3876", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 131, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「發生了很多事，所以妳累了吧。」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 132, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯。」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3877", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 133, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「要睡覺就回房間躺在床上睡，不然沒辦法消除疲勞的。」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 134, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯，應該好好睡才對的。」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3878", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那現在回房間──」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 136, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不，我不是那個意思。」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3879", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 137, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「一直睡著的話，或許能得到親吻和公主抱。」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3880", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 138, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃用期待的眼神看我。", "text_idx": 380, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「兩種都沒有。」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 140, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「啊唔……葛格，好冷淡。」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3881", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 141, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她很失望的樣子。", "text_idx": 352, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 142, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "讓我都有點內疚了……", "text_idx": 390, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為讓妳等我了，所以今天就特別……」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 144, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我伸出手示意她過來。", "text_idx": 360, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 145, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3882", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 146, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃歪了歪頭，站到我面前。", "text_idx": 379, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 147, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「差不多這樣吧。」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把手放在她頭上。", "text_idx": 364, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就這樣摸著她的頭髮好一會。", "text_idx": 355, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我們之間不需要說話。", "text_idx": 362, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 151, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3883", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃瞇起眼，很舒服的樣子。", "text_idx": 381, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 153, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃，喜歡被摸頭髮嗎？」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 154, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，喜歡被葛格摸。」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3884", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 155, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「這樣啊。」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 156, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3885", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 157, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃思考了一下，解開緞帶。", "text_idx": 378, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 158, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「痛嗎？」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 159, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不，不是。」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3886", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 160, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "兩邊的緞帶都解開，頭髮垂放下來。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 161, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「這樣就可以被更全面地摸了。」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3887", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 162, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「好了，放馬過來。」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3888", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 163, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……好像有哪裡不對。」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 164, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「啊唔……不行？」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3889", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 165, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是不行，我要上了喔。」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 372, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 166, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯♪」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 376, "voice": "sk3890", "char_id": "桜乃"}]}
