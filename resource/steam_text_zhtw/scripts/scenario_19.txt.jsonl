{"script": "scenario_19.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0553", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0354", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 2, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0284", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 3, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「大家好安靜呢，小熊喵。」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0183", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 4, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕！」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0061", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 5, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「怎麼了嗎？愛理同學、櫻乃學妹。」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0285", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊、沒有，沒什麼特別的事……」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0554", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 7, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃，其他人呢？」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0555", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 8, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥去叫隼太學長了。」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0355", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 9, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「而小紗同學大概是去殺新吾同學了。」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0286", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「是嗎……」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0556", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 11, "speaker": "汎用２", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "三人", "alt_speaker_idx": 388, "voice": "go038", "char_id": "汎用２"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 12, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕？」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0062", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 13, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……仔細想想，只有我們４人很罕見呢。」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0557", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊～的確是呢。」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0288", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……所以，感覺熱鬧不起來？」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0357", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 16, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「這、這個，雖然不太清楚……」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0289", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「難道我們感情不好──」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0358", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不對不對不對不對！」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0558", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 19, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「就是說啊。大家都是在小愛理的家念書的夥伴嘛。」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0185", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 20, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「但是的確熱鬧不起來的感覺……」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0290", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 21, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「雖然聊天的話題要多少有多少，不過……」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0559", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0359", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 23, "speaker": "汎用２", "flag": 64, "pages": [{"page": 0, "text": "「好像缺少了什麼……」「好像缺少了什麼啊……」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "愛理／安潔", "alt_speaker_idx": 396, "voice": "go042", "char_id": "汎用２"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 24, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「是啊，少了什麼呢……少了什麼呢，小熊喵？搔搔搔。」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0186", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 25, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕♪嗚嚕、嗚嚕～♪」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0063", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 26, "speaker": "汎用２", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "全員", "alt_speaker_idx": 389, "voice": "go043", "char_id": "汎用２"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥哥還不來。」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0361", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 28, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「好慢喔。」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0293", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 29, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「是啊，如果瓜生君在的話。」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0188", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「呃，雖然這麼說，但是那傢伙也不是率先出來開啟話題的人啊……」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0562", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 31, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「但是……他在做什麼呢？希望他快點來呢……」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0563", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「抱歉抱歉，久等──」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「等好久了！」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0294", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 34, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「這邊喔～瓜生君。」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0189", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 35, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥。」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0362", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……哼。那就開始吧。」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0564", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？我來喊嗎？」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那就……各位，大家辛苦了！」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 39, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "「辛苦了～～～！」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "全員", "alt_speaker_idx": 389, "voice": "go044", "char_id": "汎用"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "用自動販賣機買來的飲料乾杯。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因為是紙杯所以乾杯也沒有好聽的敲擊聲，不過氣氛很足夠了。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 42, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「哎呀～終於結束了呢。啊，喝完的話安潔再幫大家倒喔！雖然說倒但只是再跑一趟自動販賣機而已啦～」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 47, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0296", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「所以最重要的考試，大家覺得考得怎麼樣？」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0566", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「唔唔！被這樣問好難受。」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0297", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「多虧了妳，我覺得應該考得還不錯。比原本預料的好。」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 46, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0364", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 47, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「可是不愧是結女，真的很難呢。」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "隼太", "alt_speaker_idx": 412, "voice": "ht0160", "char_id": "隼太"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都露出完成一項重大任務的表情。", "text_idx": 392, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "關於這一點，不分男女、不分結女或各務台──看到這個氣氛我個人還挺高興的。", "text_idx": 411, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「不過這次莫名地考得比以前輕鬆的感覺呢。」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0298", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 51, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「的確是……以前的話更有緊繃尖銳的氣氛。」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "紗凪", "alt_speaker_idx": 409, "voice": "sn0104", "char_id": "紗凪"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「以前的愛理只要到了考試期間，還會散發出『敢靠近就殺了妳』的氣勢呢。」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "紗凪", "alt_speaker_idx": 409, "voice": "sn0105", "char_id": "紗凪"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不要再提了啦。」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0567", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喔……」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 55, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「或許是因為各務台的大家來了才改變的呢。」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0191", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……聽她這麼說我很高興。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 57, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「也就是說，各務台的學生沒有緊張感。」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "櫻乃", "alt_speaker_idx": 401, "voice": "sk0365", "char_id": "桜乃"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是不是不是。」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「沒有緊張感的只有瓜生君吧，還有椋梨君。」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0568", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔哇，被嗆了！」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都笑了。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家，都在笑。", "text_idx": 393, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我也高興得笑了出來。", "text_idx": 398, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不過……我也感覺比平常更緊張喔，好的意義上。」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 65, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「再緊張一點比較好。」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0569", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 66, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「愛理同學是要再放鬆一點啦。」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安潔", "alt_speaker_idx": 394, "voice": "ag0299", "char_id": "アンジェ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 67, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「我已經很放鬆了。」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0570", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學像學園長那樣聳了聳肩。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「這種慶祝會還是第一次。」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0571", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 70, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「而且還像這樣大家一起。好開心喔！」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 410, "voice": "mu0192", "char_id": "みう"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 71, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕～嚕～～♪」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "熊喵", "alt_speaker_idx": 406, "voice": "pn0065", "char_id": "ぱんにゃ"}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我深吸了一口氣。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看著大家。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那……再乾杯一次吧！」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 1, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「為什麼？」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0572", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「今後也請多關照……的感覺。」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 399, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──以期中考試為分界線，告一段落的感覺。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「才不要呢。」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 395, "voice": "ar0573", "char_id": "愛理"}]}
{"script": "scenario_19.txt", "scene": "*prologue14", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沒錯，我感覺氣氛的確變得柔和了。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
