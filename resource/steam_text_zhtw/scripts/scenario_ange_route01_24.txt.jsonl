{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 0, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「哈……噗嗯！」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2115", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 1, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……早安，主人。」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2116", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被嘴唇上的觸感喚醒，睜開眼睛後我看見低頭看著我微笑的安潔。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我立刻發現自己不是躺在枕頭上──而是安潔柔軟的大腿上。", "text_idx": 406, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈。」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "比起早安，我反而先笑了出來。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安……妳居然學會了這種技巧啊，安潔。」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "讓我躺在大腿上，然後用吻叫醒我。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……對了，這也有寫在『第一次的To Do list』上呢。」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 9, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「您有舒服地醒來嗎……？」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2117", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……安潔的吻和大腿都好舒服……」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 11, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「安潔也好舒服……」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2118", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「可以感受到主人的體溫和重量，躺大腿非常地……」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2119", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喜歡？」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「是的……最喜歡了。」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2120", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 15, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「主人……最喜歡你……嗯。」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2121", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她彎下腰，又吻了我。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這個姿勢讓安潔豐滿的胸部又軟綿綿地壓到我的額頭上。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被柔軟上下包夾的吻。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 19, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呼……」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2122", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "嘴唇離開後，安潔的微笑變得更加陶醉了。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在這麼舒服的喚醒之後，我已經完全沒有睡意，身心都酥軟了……", "text_idx": 398, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 22, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「主人的頭髮睡到亂翹了。」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2123", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 23, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「幫您整理喔……嘿咿嘿咿♪」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2124", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈，我的頭髮原本就很會翹了。」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 25, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「主人的頭髮好蓬鬆，安潔很喜歡喔！」", "text_idx": 319, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2125", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 26, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「不對，清爽的臉頰、鼻子、額頭也……」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2126", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安潔的手指留戀地在我的頭髮和臉上滑動。", "text_idx": 402, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所謂的愛撫……就是指這種行為吧。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不禁這麼想。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為想要像這樣卿卿我我，所以稍微提早叫醒我了對吧，哈哈。」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 31, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「被您看穿了！？」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2127", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因為我的女僕很機伶。」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2128", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 34, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……那也是因為有非常非常優秀的主人在的緣故～♪」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2129", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈，好癢好癢！」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 36, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「因為安潔很機伶，所以不會中途停止喔～」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2130", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──剛睡醒就用盡全力嬉鬧。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "撐起身體，我感覺到通體舒暢。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……這是安潔的效果吧……」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好！感覺今天能表現得不錯呢。」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 41, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，那就太好了。」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2131", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 42, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「今天開始就是考試期間了呢，主人。」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2132", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「結束之後……」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2133", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一想到這裡，就更有幹勁了。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 47, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好！趕快去梳洗吧。」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 48, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「好的，主人。安潔和櫻乃學妹也去準備了。」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2134", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 49, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「對了安潔，考試沒問題嗎？」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「請不要提起這件事主人！求求您了～～～！」", "text_idx": 386, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2135", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都鼓足了幹勁的樣子。", "text_idx": 399, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 52, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「和期中考不同，沒有讓愛理盯著念書。」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "櫻乃", "alt_speaker_idx": 411, "voice": "sk0998", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「結果只有那一天一起念而已。」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 54, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「所以正是展現實力的時候。」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "櫻乃", "alt_speaker_idx": 411, "voice": "sk0999", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 55, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「喔喔，很優秀的志氣呢櫻乃學妹！」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2136", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 56, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「總之不要不及格就好。」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 411, "voice": "sk1000", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 57, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「目標這麼低！？」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2137", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「與其說展現實力，應該說露出馬腳吧……」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 59, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「啊，早安～三位。」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0421", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 60, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嚕！」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 414, "voice": "pn0117", "char_id": "ぱんにゃ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早安，熊喵也早安。」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 62, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「考試期間開始的早晨莫名地讓人緊張呢。」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0422", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 63, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「說的沒有錯。安潔已經因為各種事非常緊張了。」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2138", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 64, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「比如說叫醒哥哥？」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 411, "voice": "sk1001", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 65, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈哈哈，那就不限於今天了～」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2139", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，你們兩人感情很好呢。」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0423", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 67, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「對了瓜生君，雖然期中考的時候曾說過期末考結束後也來開慶祝會……」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0424", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，是的。」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「這次就跟小菜夏悠閒地過吧？」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0425", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……天羽學姊。」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「最初的時候最重要喔，對吧～小熊喵。」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0426", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 72, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "「嗚嚕～」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 414, "voice": "pn0118", "char_id": "ぱんにゃ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 73, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「喔、喔？在說什麼呢？請讓安潔也加入話題！」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2140", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 74, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "「在說今天是第一天最重要。好，我也加油吧！」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 416, "voice": "mu0427", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 75, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「考試期間回去各務台你覺得怎麼樣？」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0359", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那是逃亡吧。」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 77, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「說的也是，也就是說必須豁出去了啊。」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0360", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 78, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「那安潔呢？這次也能考好嗎？」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0361", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 79, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈，雖然沒有什麼自信……」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2141", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 80, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「但是為了不丟主人的臉，安潔會盡全力的！」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2142", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 81, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「喔，很棒欸。妳現在閃閃發光喔。」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0362", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 82, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「我也為了女朋友盡全力加油好了……這樣想的話考試感覺就很熱血欸。」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0363", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 83, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喔，隼太也提起幹勁了啊……乾同學狀況怎麼樣？」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 84, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「唔哈哈，小乾要為了學姊嗎？」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0364", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 85, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "「不要跟我說話廢渣！會害我把背起來的東西忘掉啦，白癡！」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "紗凪", "alt_speaker_idx": 415, "voice": "sn0376", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 86, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「散發出了殺氣呢。好可怕，抖抖抖。」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2143", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 87, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 404, "voice": "ar4083", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 88, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「那邊展開了冰冷又犀利的氣場！？」", "text_idx": 390, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2144", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 89, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「請不要把人說得像冷血動物一樣。」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 404, "voice": "ar4084", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 90, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不過，這次跟上次不同，可以和以前一樣一個人專心念書。」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "愛理", "alt_speaker_idx": 404, "voice": "ar4085", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 91, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「的確，這股氣場是以前的愛理同學。」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2145", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「期中考的時候是特殊狀況啊……」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 93, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不管什麼時候都是特殊狀況喔。你們每天不也是這樣？」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "愛理", "alt_speaker_idx": 404, "voice": "ar4086", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 94, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2146", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……被妳這麼一說，感覺又更繃緊神經了。」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 409, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 96, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「雖然某種程度上我是故意這麼說的。」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 404, "voice": "ar4087", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 97, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「感謝提醒。」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "隼太", "alt_speaker_idx": 422, "voice": "ht0365", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 98, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好了，把每天累積的努力成果徹底發揮出來吧。」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "愛理", "alt_speaker_idx": 404, "voice": "ar4088", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 99, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "「……是！」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安潔", "alt_speaker_idx": 401, "voice": "ag2147", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 100, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「好、好～早安～大家都做好了準備了嗎～」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "萬智", "alt_speaker_idx": 417, "voice": "mc0222", "char_id": "万智"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就這樣，期末考開始了。", "text_idx": 403, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "為了放心地迎向「將來」，每一天都是重要的積累。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
