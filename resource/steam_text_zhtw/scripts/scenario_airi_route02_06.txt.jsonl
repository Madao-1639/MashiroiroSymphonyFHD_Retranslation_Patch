{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「打擾了……」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，妳先開始了啊。」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 2, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嗯……」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2992", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我進來的時候，愛理正在振筆疾書。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「後天終於要開始考試了。我希望能考得不會後悔。」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2993", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──因為順利地完成了「第一次」。", "text_idx": 229, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這幾天愛理心無旁鶩地集中在念書這件事上。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她手邊疊了好幾本參考書，看來在我來之前，她已經用功好一會了。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「愛理真的很認真呢。」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2994", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「當然啦。」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2995", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "聽到我無意中說出的話，愛理哼了一聲回答。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「我是瀨名愛理喔。」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2996", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……認真、古板、可靠。班上所有人都認同的優等生。", "text_idx": 228, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過我知道，她不是個只有這樣的女孩子。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，妳很努力。」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「能聽你這麼說，我很高興。」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2997", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉喔。」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2998", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎麼了？啊，總之我先坐到暖桌裡喔。」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 19, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……那之後就沒了。」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar2999", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……呃，嗯。」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 21, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「但、但是啊，我真的覺得對新吾很抱歉。」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3000", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 22, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「考試結束前，不要做色色的事情喔。」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3001", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "自從「第一次」之後，我們就沒有愛愛過了。", "text_idx": 337, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不過這不是愛理需要道歉的事……", "text_idx": 301, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我懂的，我也這麼覺得。」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 26, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嗯……謝謝你。」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3002", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "雖然很遺憾，但是這一點實在沒辦法。", "text_idx": 347, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且，我們已經結合了。因為清晰地體認到這點，所以能克制住。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──就這層意義上來說，在考試前完成結合太好了。", "text_idx": 230, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……那個，而且還有點痛……」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3003", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔……什、什麼！那句話犯規了！」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「欸！？為為、為什麼？」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3004", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「會讓我想抱住妳跟妳說抱歉……」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊唔……」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3005", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 35, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好、好了來念書吧！！要是現在接吻或做什麼的話，我們就沒辦法回到用功狀態了！」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3006", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「說、說的也是……因為愛理立刻就會沉迷其中。」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 37, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……新吾才是立刻就會變大的說。」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3007", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好了來念書吧！」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 39, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「色狼、色狼～♪我知道的喔，只有我知道……」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3008", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……話說回來，愛理這麼努力，所以我也不能鬆懈。", "text_idx": 227, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管是身為男朋友，還是身為班級幹部的夥伴。我拿出紙筆用具，和愛理一樣開始念書。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 42, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……看到新吾這麼認真，我也能加油了。」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3009", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好……」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3010", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "愛理也重新鼓起幹勁，再次集中精神在手邊的筆記本上。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 45, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「考試結果，等著看吧，媽媽……」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3011", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這句喃喃自語，讓我的胸口莫名地難受。", "text_idx": 342, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 48, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……呼。」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3012", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「飯好像煮好了。新吾，抱歉再等一下，這邊結束後我想把那些分成小份。」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3013", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "聽到提醒的電子音，愛理從浴室探出頭。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她正在打掃浴室。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「一次煮好再分成小份冷凍起來，之後要用就很方便了……」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3014", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在讀書的空檔，愛理還很努力地做家事。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……一個人生活好辛苦。", "text_idx": 224, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且她還有打工。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明這麼忙，她還是認真念書，一直維持著優秀的成績。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……白飯由我來分吧？」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊……謝謝，幫了我好大的忙！分成一碗一碗的量用保鮮膜包起來放著，不熱了之後我會放進冷凍庫……」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 48, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3015", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……她真的很努力呢。", "text_idx": 225, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "愛理一直是這麼努力。我根本無法不出手幫她。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想支持愛理的努力。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身為男人、身為男朋友，這是我該做的吧。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「可是……」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "『考試結果，等著看吧，媽媽……』", "text_idx": 296, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這份努力……果然是為了做給學園長看嗎？", "text_idx": 341, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那明天見了，愛理。」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啊……等一下。」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3017", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 71, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「啾。」", "text_idx": 260, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3018", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 72, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔。」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 73, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……晚安，新吾。」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3019", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔、嗯，晚安。」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 325, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 75, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……」", "text_idx": 252, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3020", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾真是的，臉好紅喔。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他對偷襲沒輒啊。……真可愛。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「明明平常總是那樣寵我……真是的，好喜歡、好喜歡你喔，呵呵、呵呵呵～」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3021", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──所以我才能這樣努力。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我，已經不是一個人了。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有最喜歡的人，我是用全身與那個人相愛的女人。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 82, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「好……」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3022", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我回味著新吾溫柔的嘴唇的觸感，重新鼓起幹勁，再次開始念書。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "念書念得很順利。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "感覺確實吸收了知識，越來越集中精神。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就這樣……就這樣……", "text_idx": 313, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這次也，拿第一名……", "text_idx": 344, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 88, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……好冷。」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3023", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "寒意讓我發抖。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今晚好像會變得更冷。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 91, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「媽媽，有好好保暖自己嗎……」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3024", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 92, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3025", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "想起了媽媽。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 95, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……要不要偶爾打個電話呢？」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3026", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "產生了這個想法。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "為什麼呢？", "text_idx": 330, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，很在意──", "text_idx": 305, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 99, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『……喂。』", "text_idx": 290, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0220", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 100, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那、那個，我是愛理──」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3027", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 101, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『幹嘛這個時間打來？』", "text_idx": 293, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0221", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 102, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3028", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "冷淡的聲音。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我反射性地繃直背脊。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 105, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉。」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3029", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 106, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『有什麼事？』", "text_idx": 294, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0222", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 107, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那個……有點在意。因為今晚很冷……」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3030", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 108, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『為了那種事打電話來真稀奇呢。而且還是在考試前這種時期。』", "text_idx": 295, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0223", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我知道。我自己也不懂為什麼要這樣。", "text_idx": 226, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，妳也沒有必要那樣說吧……", "text_idx": 304, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 111, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『妳才是怎麼樣了？有好好生活嗎？』", "text_idx": 292, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0224", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 112, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「當……當然了，因為我不是媽媽！」", "text_idx": 279, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3031", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 113, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『喔……』", "text_idx": 291, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0225", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 114, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3032", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 115, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『說完了嗎？』", "text_idx": 297, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0226", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 116, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……嗯。」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 316, "voice": "ar3033", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 117, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "『那我掛電話了。』", "text_idx": 298, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "蘭華", "alt_speaker_idx": 339, "voice": "rk0227", "char_id": "蘭華"}]}
