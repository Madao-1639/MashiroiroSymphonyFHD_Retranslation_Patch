{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「時間也不早了，我差不多該回去了。」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5560", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學穿上外套站起來。", "text_idx": 446, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「明明休息還來陪我們念書，抱歉喔。」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 3, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「不用介意。反正我有時間，而且連晚飯都讓你們請了。」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5561", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 4, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「愛理的話，隨時都歡迎。」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3159", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃說的對。」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「謝謝你們。如果安潔也來就好了呢。」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5562", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「她有別的事也沒辦法。考試……希望她能順利過關。」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 8, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「沒問題，安潔是能幹的女僕。」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3160", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……希望她會加油。」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5563", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看遠方。瀨名同學在看遠方！", "text_idx": 452, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是啊……」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「到最後關頭了，加油吧！」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5564", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 13, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「反正明天是假日，妳住下來也可以的說。」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3161", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 14, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那就太麻煩你們了吧。」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5565", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我希望妳麻煩的說……」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3162", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「謝謝妳。但我還有家事得做，而且我也不想打擾你們。」", "text_idx": 400, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5566", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我沒有想那種事喔。」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「你不想過兩人時光嗎？」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5567", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「這個……」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「有點意外。瓜生君也有那種表情啊。」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5568", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「畢竟在家裡是兩人獨處，被強調的話，有點……」", "text_idx": 388, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 22, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……互相喜歡我是不會阻止，但是避免發展成責任問題比較好喔。」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5569", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道，不會因為是兩人獨處就做那種事。」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 24, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「……是嗎？」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5570", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 25, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……不會做喔。」", "text_idx": 305, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3163", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 26, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「嘿，還沒啊……」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5571", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「兩個人不有趣。愛理也住下來的話，就可以三人一起了。」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3164", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 28, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「三個人一起什麼？」", "text_idx": 319, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5572", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……不是玩撲克牌嗎？」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3165", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生君……你覺得她是說認真的嗎？」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5573", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「大概。」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 32, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3166", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃歪著頭。", "text_idx": 442, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 34, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「妳想像的是其他事嗎？」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3167", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 35, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「什麼──」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5574", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瀨名同學，抱歉。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "妹妹啊，從剛才的對話聽來，一般都是想像另一件事喔。", "text_idx": 422, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 38, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「要做什麼？」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3168", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃一臉很感興趣的表情逼近瀨名同學。", "text_idx": 438, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 40, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那、那種事情，瓜生君比較清楚！」", "text_idx": 405, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5575", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 41, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "「那再見，我今天就先回去了！」", "text_idx": 409, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "愛理", "alt_speaker_idx": 425, "voice": "ar5576", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "快速地說完後瀨名同學回家了。", "text_idx": 423, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 43, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……葛格。」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3169", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我覺得有些事不要知道比較好喔。」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 45, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「姆，只有我被排擠。」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3170", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是那個意思啦……」", "text_idx": 323, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那就告訴我吧？」", "text_idx": 411, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3171", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是什麼需要在意的事。」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「如果不需要在意，那說了也沒問題。」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3172", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那個……」", "text_idx": 406, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被小孩問『小寶寶是怎麼生出來』的父母就是這種心情吧。", "text_idx": 455, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 52, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不告訴我的話，明天我問其他人。」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3173", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那個，我覺得不要比較好。」", "text_idx": 407, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 54, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那告訴我。」", "text_idx": 410, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3174", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「愛理為什麼臉那麼紅？」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3175", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "反正總有一天也會知道……沒辦法了。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那個，瀨名同學說的三個人做的事。」", "text_idx": 408, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 59, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯嗯。」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3176", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「應該是我跟櫻乃跟瀨名同學三個人愛愛的意思。」", "text_idx": 359, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 61, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3177", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 62, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3178", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃的臉逐漸發紅。", "text_idx": 443, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 64, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……葛格，色狼。」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3179", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欸？我嗎！？」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 66, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「那種事情，我不知道。」", "text_idx": 414, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3180", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃對那方面的知識有時候非常偏差呢。」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 68, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「全方面清楚的人好色。」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3181", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……妳說的對。」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「門開著喔。」", "text_idx": 415, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 71, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「可以進去嗎？」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3182", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "怎麼了？平常她都是立刻就進來的。", "text_idx": 424, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「請進。」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 74, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「打擾了。」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3183", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃抱著枕頭進來我房間。", "text_idx": 440, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 76, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3184", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "直接走向床鋪，把她帶來的枕頭排在我的枕頭旁邊。", "text_idx": 450, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃小姐，妳在做什麼呢？」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 79, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「無懈可擊。」", "text_idx": 386, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3185", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「完美……？」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 81, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「今天可以一起睡嗎？」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3186", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「一起？為什麼？」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 83, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「因為想跟葛格一起睡。」", "text_idx": 345, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3187", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「原來如此，很足夠的理由。」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 85, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「所以，一起睡吧。」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3188", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不知不覺中就決定了。」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 87, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「沒問題的，只是一起睡而已。什麼都不會做，放心吧。」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3189", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 88, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那是男方的台詞吧？」", "text_idx": 413, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 89, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「是嗎？」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3190", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「但也不是絕對啦。」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 91, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「沒問題的，只是一起睡而已。什麼都不會做，放心吧。」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3191", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃，內容沒有變喔。」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我苦笑著吐槽。", "text_idx": 429, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 94, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「葛格會對我做什麼嗎？」", "text_idx": 392, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3192", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「雖然想，但今天不會。」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 96, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「啊唔，可惜。」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3193", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「居然可惜啊。」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 98, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「有一點。」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3194", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「一點？」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 100, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「其實，是很多。」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3195", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……妳知道葛格也算是男人嗎？」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 102, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「我知道你是會說出三個人愛愛這種話的男人。」", "text_idx": 364, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3196", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "又提起了。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 105, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「愛理也一起比較好嗎？」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3197", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「瀨名同學不是那種對象。」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就算真的要愛愛，對象除了櫻乃以外我無法想像。」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 108, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「既然這樣，一起睡也沒問題。」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3198", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「說的也是……咦？好像有點奇怪？」", "text_idx": 396, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 110, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「被發現了。」", "text_idx": 394, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3199", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「櫻乃，妳回自己房間比較好喔。」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 112, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3200", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃什麼都沒說，爬到我的床上。", "text_idx": 439, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然後拿被子蓋住半張臉。", "text_idx": 448, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只露出眼睛看著我。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……真糟糕啊。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不討厭一起睡……應該說，很高興。", "text_idx": 427, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以，這種時候才要狠下心──", "text_idx": 432, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 119, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「這個時被窩被很冷，我先鑽進來暖一暖。」", "text_idx": 403, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3201", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看來她不打算回去。", "text_idx": 451, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 121, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「空氣清淨機兼暖呼呼的被窩。再加上妹妹和戀人的優惠套組。」", "text_idx": 390, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3202", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我被逗得笑了出來。", "text_idx": 430, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道了，不會再趕妳回去。」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 124, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「謝謝你，葛格。」", "text_idx": 399, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3203", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……熬夜也不好，今天就睡了吧。」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 126, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3204", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我關掉電燈，躺上床。", "text_idx": 431, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 128, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「跟櫻乃說的一樣，被窩好溫暖呢。」", "text_idx": 401, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 129, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，但是相對的，我變得好冷。」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3205", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 130, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「還好嗎？」", "text_idx": 404, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 131, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「不好，所以靠緊一點。」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3206", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 132, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃這樣說，然後臉頰貼在我的胸口，全身依偎著我。", "text_idx": 445, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 133, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 134, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「葛格，好溫暖。」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3207", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 135, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "這就是……所謂的凌遲嗎？", "text_idx": 457, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 136, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明感受到櫻乃的呼吸和溫度，但必須什麼都不做地睡覺……", "text_idx": 435, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 137, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃身上類似淡淡花香的氣味似乎更明顯了。", "text_idx": 444, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 138, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「在這裡就覺得好安心。」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3208", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安心？」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 140, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「因為充滿了葛格的味道。」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3209", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 141, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我也在想相同的事。」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 142, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「相同的事？」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3210", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我現在感覺到櫻乃的味道。」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 144, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「……要多聞一下嗎？」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3211", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 145, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "櫻乃更靠近我。", "text_idx": 441, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 146, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "手臂碰到柔軟的觸感……毫無疑問，是櫻乃的胸部。", "text_idx": 433, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 147, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不禁身體緊繃。", "text_idx": 426, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我沒有自制到在這種狀況下還能保持平靜。", "text_idx": 428, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且櫻乃只是想對我撒嬌吧。", "text_idx": 454, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 151, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要忍耐，忍耐。", "text_idx": 456, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "現在是比起戀人，要當葛格的時候。", "text_idx": 449, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 153, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「晚安。」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3212", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 154, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，晚安。」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 155, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "睡意終於來襲，意識慢慢地沉入黑暗。", "text_idx": 453, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 156, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「葛格……睡著了？」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3213", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 157, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "半夢半醒中，櫻乃的聲音從遠方傳來，但是我好睏……", "text_idx": 417, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 158, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "「晚安。」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "櫻乃", "alt_speaker_idx": 437, "voice": "sk3214", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 159, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在嘴唇感受到柔軟觸感的同時，我完全陷入了睡眠。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
