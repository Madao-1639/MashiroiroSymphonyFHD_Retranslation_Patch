{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 0, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾啊」", "text_idx": 150, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2240", "char_id": "みう"}]}
