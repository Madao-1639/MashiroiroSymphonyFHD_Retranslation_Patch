{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 2, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2241", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么了吗？」", "text_idx": 155, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 4, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……没事，什么都没有♪」", "text_idx": 156, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2242", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我今天也牵着学姐的手和她散步。", "text_idx": 158, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们和平常一样，聊着些无关紧要的事。", "text_idx": 159, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "离学姐的毕业典礼，还有半个月。", "text_idx": 160, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但我们并没有聊过关于毕业之后的话题。", "text_idx": 161, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「社团活动结束之后可以到学姐家去吗？」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 11, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯，当然可以」", "text_idx": 163, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2243", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐笑着抱住我的手臂。", "text_idx": 165, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那副模样简直像是在撒娇一样。", "text_idx": 166, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 14, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「就剩咱们两个了，上次这样还是好久之前了呢」", "text_idx": 168, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0201", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，那我也差不多该回去了……」", "text_idx": 170, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 16, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「不用不用，能稍微和我聊一聊吗？」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0202", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……好」", "text_idx": 173, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "回家路上我去到学姐家里拜访，\\n美羽学姐突然说要打工，就出门了。", "text_idx": 174, "plain": "回家路上我去到学姐家里拜访，美羽学姐突然说要打工，就出门了。", "plain_idx": 175, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她估计也是为了方便我们谈话吧。", "text_idx": 176, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且为了让我们能聊得放松点，\\n出门前还准备好了点心。", "text_idx": 177, "plain": "而且为了让我们能聊得放松点，出门前还准备好了点心。", "plain_idx": 178, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 21, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「我一直想向你道谢」", "text_idx": 179, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0203", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 181, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 23, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「真的非常感谢你能一直这么为美羽着想」", "text_idx": 182, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0204", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎，没有……」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 25, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「美羽能像现在这样笑着，都是多亏了你啊……」", "text_idx": 185, "plain": "「美羽能像现在这样笑着，都是多亏了你啊……」", "plain_idx": 185, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0205", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其实我心里一直非常迷茫。", "text_idx": 187, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "自己做的真的对吗？", "text_idx": 188, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "会不会，多鼓励下学姐会更好……", "text_idx": 189, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……真的是这样吗」", "text_idx": 190, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 31, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0206", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我总感觉，反而是我一直在勉强学姐……」", "text_idx": 192, "plain": "「我总感觉，反而是我一直在勉强学姐……」", "plain_idx": 192, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近美羽学姐再也没聊过熊喵的事。", "text_idx": 193, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "自那一天后，也没在我面前再掉过眼泪。", "text_idx": 194, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但我不明白，这样真的是好的吗？", "text_idx": 195, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 36, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「没事的。毕竟这个结果是那孩子自己选择的」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0207", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 181, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 38, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「美羽肯定是希望能一直和熊喵生活在一起的吧」", "text_idx": 198, "plain": "「美羽肯定是希望能一直和熊喵生活在一起的吧」", "plain_idx": 198, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0208", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 39, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「只不过，她自己认为，那肯定是无法实现的……」", "text_idx": 200, "plain": "「只不过，她自己认为，那肯定是无法实现的……」", "plain_idx": 200, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0209", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 41, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「新吾，往后也请你多陪在她身边了」", "text_idx": 202, "plain": "「新吾，往后也请你多陪在她身边了」", "plain_idx": 202, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0210", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我现在这样，真的就可以了吗？」", "text_idx": 204, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 43, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0211", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在看到结子阿姨的笑容后，我知道对话已经结束了。", "text_idx": 206, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 45, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……你和母亲聊了什么？」", "text_idx": 207, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2244", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「只是闲聊了一下」", "text_idx": 209, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 47, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「是吗……那就好♪」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2245", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在聊天结束后，我就一直坐着等学姐回来。", "text_idx": 212, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "实际上，之后我还被结子阿姨诱惑来着，非常危险。", "text_idx": 213, "plain": "实际上，之后我还被结子阿姨诱惑来着，非常危险。", "plain_idx": 213, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 50, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我觉得母亲绝对是盯上了你」", "text_idx": 214, "plain": "「我觉得母亲绝对是盯上了你」", "plain_idx": 214, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2246", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 51, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「盯上了？」", "text_idx": 216, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 52, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「没错。她时不时会在吃饭的时候突然叹气，然后说」", "text_idx": 217, "plain": "「没错。她时不时会在吃饭的时候突然叹气，然后说」", "plain_idx": 217, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2247", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 53, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「唉……真想让新吾理解人妻的魅力啊」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2248", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……刚刚她确实也认真地这么对我说过。", "text_idx": 221, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当然，这种事还是不说为好。", "text_idx": 222, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 57, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「一定要多小心我母亲哦？\\n　可不能输给人妻」", "text_idx": 223, "plain": "「一定要多小心我母亲哦？　可不能输给人妻」", "plain_idx": 224, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2249", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天的学姐比平常还要喜欢撒娇。", "text_idx": 226, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对上视线后，她就一边摸着我的脸一边将嘴唇贴上来。", "text_idx": 227, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 60, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啾、嗯……啾……嗯嗯、啾……」", "text_idx": 228, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2250", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后学姐就这样把我扑倒，骑到了我身上。", "text_idx": 230, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她在我身上不停活动着，想要把味道留在我身上。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 63, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾，你只属于我……」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2251", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐对我的独占欲让我也变得躁动了起来。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 65, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……新吾，你要一直陪在我身边哦」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2252", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "即使这份独占欲，是因为与熊喵分别才产生的，我也会——", "text_idx": 237, "plain": "即使这份独占欲，是因为与熊喵分别才产生的，我也会——", "plain_idx": 237, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我会一直陪在你身边的」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "毫不犹豫地这么回答。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 69, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾，你还醒着吗？」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2408", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 71, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2409", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们依偎在一起，不知过了多久。", "text_idx": 244, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "关上灯，两人独处，就这样静静地任时间流逝。", "text_idx": 245, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然，学姐轻轻地叹了一口气。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 75, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么了吗？」", "text_idx": 155, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 76, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2410", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 77, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯，其实，我想对你道谢」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2411", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 79, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「你没有和我提有关小熊喵的事，对吧？」", "text_idx": 251, "plain": "「你没有和我提有关小熊喵的事，对吧？」", "plain_idx": 251, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2412", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 81, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我其实，并不想让小熊喵回到它母亲那里」", "text_idx": 253, "plain": "「我其实，并不想让小熊喵回到它母亲那里」", "plain_idx": 253, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2413", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 82, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我很可恶吧，明明说着保护，但只是想把它留在自己身边……」", "text_idx": 255, "plain": "「我很可恶吧，明明说着保护，但只是想把它留在自己身边……」", "plain_idx": 255, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2414", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知道该如何回话。", "text_idx": 257, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "于是我轻抚起学姐的头发。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 85, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……你说猫猫狗狗它们，为什么会比人类更快老去呢」", "text_idx": 259, "plain": "「……你说猫猫狗狗它们，为什么会比人类更快老去呢」", "plain_idx": 259, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2415", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 153, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 87, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「小熊喵……」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2416", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的声音颤抖了起来，不安地咬起了手指。", "text_idx": 263, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她应该是回想起来了。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "小时候很珍视的猫咪因为生病而死去的事情。", "text_idx": 265, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "和动物们一起生活，就肯定会迎来离别之时。", "text_idx": 266, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "狗狗会，猫也会。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "以及，熊喵也会。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 94, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2417", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「学姐真是太温柔了」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 96, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2418", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我再次摸起学姐的头发，学姐终于忍不住无声哭了出来。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不知熊喵是否知道。", "text_idx": 275, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有这么一个人，如此挂念着它。", "text_idx": 276, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有这么一个人，如此深爱着它。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知学姐的感情，是否能传达给熊喵。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那一直对它露出的笑容。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还有为它拼命做出来的挂在尾巴上的装饰。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知这一切。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知这一切，又是否会被它忘记呢……", "text_idx": 282, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
