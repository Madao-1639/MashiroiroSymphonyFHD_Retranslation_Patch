{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 124, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，没事」", "text_idx": 399, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我在想是不是应该送送她，她不是对这附近还是不熟嘛」", "text_idx": 400, "plain": "「我在想是不是应该送送她，她不是对这附近还是不熟嘛」", "plain_idx": 400, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
