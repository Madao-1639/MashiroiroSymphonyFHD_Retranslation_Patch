{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到头来，我一直在这里陪到了最后。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
