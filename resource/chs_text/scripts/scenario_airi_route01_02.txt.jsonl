{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 118, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生也明天见」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0760", "char_id": "愛理"}]}
