{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 113, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥一会站一会坐的，真忙啊」", "text_idx": 382, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0392", "char_id": "桜乃"}]}
