{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃」", "text_idx": 172, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……不在啊」", "text_idx": 173, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近，和樱乃说话的机会变少了。", "text_idx": 174, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "相对的，和美羽学姐在一起的时间变多了，但是兄妹间的交流减少了也不好。", "text_idx": 175, "plain": "相对的，和美羽学姐在一起的时间变多了，但是兄妹间的交流减少了也不好。", "plain_idx": 175, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「她应该先走了吧……」", "text_idx": 176, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知何时，我习惯了一个人上学。", "text_idx": 177, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "去活动室就有人在那里。", "text_idx": 178, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就能见到美羽学姐。", "text_idx": 179, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但是，为什么啊。", "text_idx": 180, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽说正慢慢习惯着，但我总归有点寂寞。", "text_idx": 181, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早上好，学姐」", "text_idx": 182, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 13, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊……早上好，新吾」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1789", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她站在兔子小屋前，好像在找什么东西。", "text_idx": 186, "plain": "她站在兔子小屋前，好像在找什么东西。", "plain_idx": 186, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「发生什么事了吗？」", "text_idx": 187, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 16, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我在想小熊喵怎么不在这……」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1790", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，我昨天早上在活动室里看到熊喵了」", "text_idx": 190, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 18, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊，真的？那就好，熊喵没事就好……」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1791", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她虽脸上挤出笑容，可却寂寞地握紧了拳头。", "text_idx": 193, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「尾巴上的新饰品，还没给它戴上吗……」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 21, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「对。还有我在想最近变冷了，它晚上会不会冻着」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1792", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「熊喵它，不在我们身边的时候会干些什么呀」", "text_idx": 197, "plain": "「熊喵它，不在我们身边的时候会干些什么呀」", "plain_idx": 197, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 23, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1793", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "百科都搜不到这种生物，生活状态是个谜。", "text_idx": 199, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概，算是猫的近亲吧……", "text_idx": 200, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……学姐，你不冷吗？」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看到她呼出的白雾，就想去握紧她的手。", "text_idx": 202, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在这里抱上去，实在有点难为情。", "text_idx": 203, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 29, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯哼哼，这样就暖和了咯」", "text_idx": 204, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1794", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……她自己先抱上来了。", "text_idx": 207, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的香味让我安心。", "text_idx": 208, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为我们之间有身高差，所以她掂起脚尖贴着我。", "text_idx": 209, "plain": "因为我们之间有身高差，所以她掂起脚尖贴着我。", "plain_idx": 209, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样，画面一转，身后鲜花盛开，啊哈哈哈……这样，背景就换成是鲜花盛放的场景了吧。", "text_idx": 210, "plain": "就这样，画面一转，身后鲜花盛开，啊哈哈哈……这样，背景就换成是鲜花盛放的场景了吧。", "plain_idx": 210, "len": 41, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 35, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉，我突然就抱起你来」", "text_idx": 211, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1795", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没事，就是吓了一跳。没想到学姐会主动抱我……」", "text_idx": 213, "plain": "「没事，就是吓了一跳。没想到学姐会主动抱我……」", "plain_idx": 213, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 37, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「不行呢。我是学姐，所以必须得忍着」", "text_idx": 214, "plain": "「不行呢。我是学姐，所以必须得忍着」", "plain_idx": 214, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1796", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我在学校里的时候，可是一直忍着的」", "text_idx": 216, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 39, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……真的嘛」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1797", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「当然了」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 41, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「太好……我还担心来着的」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1798", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「担心什么？」", "text_idx": 222, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 43, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「因为你呀，最近一直没有精神，我老感觉你是不是开始厌倦我了……」", "text_idx": 223, "plain": "「因为你呀，最近一直没有精神，我老感觉你是不是开始厌倦我了……」", "plain_idx": 223, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1799", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那是绝对不可能的！」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我拼命地否定。", "text_idx": 226, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「昨天不是对学姐说了嘛，我最喜欢美羽学姐了……」", "text_idx": 227, "plain": "「昨天不是对学姐说了嘛，我最喜欢美羽学姐了……」", "plain_idx": 227, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 47, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1800", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你能相信我吗」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 49, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「没有，也不是那样。只是，我好像太贪心了……」", "text_idx": 230, "plain": "「没有，也不是那样。只是，我好像太贪心了……」", "plain_idx": 230, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1801", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的脸上，泛出一丝红晕。", "text_idx": 232, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 51, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「光是对你说喜欢，似乎已经满足不了我了♪」", "text_idx": 233, "plain": "「光是对你说喜欢，似乎已经满足不了我了♪」", "plain_idx": 233, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1802", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「学姐……」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我自己也是如此。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "无论怎么诉说自己的喜爱之意，也无法控制满溢而出的感情。", "text_idx": 237, "plain": "无论怎么诉说自己的喜爱之意，也无法控制满溢而出的感情。", "plain_idx": 237, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我们十指相合，抱在一起接吻。", "text_idx": 238, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "聊天聊到一半，然后接起了吻。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明想一整天黏着她。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 58, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐，我也一起找熊……」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1476", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 59, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「欸，新吾在啊」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1477", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但现实总不能成全我。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早上好，纱凪」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 62, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……哼嗯」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1478", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「又怎么了」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 64, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「没什么。美羽学姐，我们去那边找它吧」", "text_idx": 251, "plain": "「没什么。美羽学姐，我们去那边找它吧」", "plain_idx": 251, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1479", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 65, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯，好呢。行吧——」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1803", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她这明显是奔着来把学姐抢走的。", "text_idx": 255, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她真的真心在祝福我们吗……", "text_idx": 256, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 68, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我说啊，你和美羽学姐，真的在交往？」", "text_idx": 257, "plain": "「我说啊，你和美羽学姐，真的在交往？」", "plain_idx": 257, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1480", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「上来就问这个啊」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "休息的时候，我刚被她叫出去，就莫名其妙地被问了这种问题。", "text_idx": 260, "plain": "休息的时候，我刚被她叫出去，就莫名其妙地被问了这种问题。", "plain_idx": 260, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我觉得，我们算是在交往」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 72, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你没有臆想症？」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1481", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你的意思是我幻想学姐在和我交往？」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 74, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我可没把话说的那么难听」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1482", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 75, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不是有很多人光是和对方目光相交，就以为她喜欢自己吗」", "text_idx": 267, "plain": "「不是有很多人光是和对方目光相交，就以为她喜欢自己吗」", "plain_idx": 267, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1483", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 76, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「比如夏天全身赤裸只穿一件外套的那种男人」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1484", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我觉得那种人比较少吧」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是很懂她想表达什么。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 79, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唔嗯……难道说……」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1485", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「到底怎么了」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 81, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1486", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就算你这么盯着我……」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 83, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你们可能要分了」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1487", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊？」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 85, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「一般的情侣都更加亲热，无论在哪都旁若无人地黏在一起吧」", "text_idx": 281, "plain": "「一般的情侣都更加亲热，无论在哪都旁若无人地黏在一起吧」", "plain_idx": 281, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1488", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 86, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「而且在大街上都能接起吻的人也有吧——」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1489", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，确实」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 88, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「可是，今天早上的美羽学姐呢？一如既往地淡定」", "text_idx": 286, "plain": "「可是，今天早上的美羽学姐呢？一如既往地淡定」", "plain_idx": 286, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1490", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 89, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「那不是恋爱中的女生该有的样子。女生谈了恋爱，就会心脏怦怦跳的啊」", "text_idx": 288, "plain": "「那不是恋爱中的女生该有的样子。女生谈了恋爱，就会心脏怦怦跳的啊」", "plain_idx": 288, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1491", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 90, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「仅仅和喜欢的男生四目相对，就会想一整天把他关在房间里肆意妄为啊」", "text_idx": 290, "plain": "「仅仅和喜欢的男生四目相对，就会想一整天把他关在房间里肆意妄为啊」", "plain_idx": 290, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1492", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我可不喜欢那种恋爱。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "更何况，还要被女生监禁。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 93, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我说你啊，包容力太小了」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1493", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 94, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「包容力？」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 95, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「恋人待在一起，一般会更加懒散吧」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1494", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我觉得我们够懒散了」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 97, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不对，学姐才没懒散」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1495", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 98, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「她要是真的喜欢你，就算在我面前，她也应该会和你亲热」", "text_idx": 302, "plain": "「她要是真的喜欢你，就算在我面前，她也应该会和你亲热」", "plain_idx": 302, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1496", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那是因为学姐她担心你啊。而且她也不是会在大家面前跟自己男朋友亲热的人」", "text_idx": 304, "plain": "「那是因为学姐她担心你啊。而且她也不是会在大家面前跟自己男朋友亲热的人」", "plain_idx": 304, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 100, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「都——说——了——能把学姐的顾虑打消，然后让她沉醉其中的才是恋爱啊」", "text_idx": 305, "plain": "「都——说——了——能把学姐的顾虑打消，然后让她沉醉其中的才是恋爱啊」", "plain_idx": 305, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1497", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唉……」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我干嘛要跟她聊恋爱话题啊。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……要是学姐变成那样，的确挺不得了的。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 104, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「难道说，我还有机会把美羽学姐夺回来？」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1498", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不不不，怎么可能」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 106, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「不好说呀。好男人可是能用眼神杀死女人的啊——」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1499", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「用眼神……啊」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就用纱凪练习一下吧。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要眼神锐利点就行了吧，锐利点。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 110, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「呃？！」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1500", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 112, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「喂，你干嘛！你这眼神是要杀了我啊！」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1501", "char_id": "紗凪"}]}
