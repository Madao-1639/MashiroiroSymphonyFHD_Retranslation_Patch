{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这两件事在我脑海中交汇，我一下子浮现出一个想法。", "text_idx": 515, "plain": "这两件事在我脑海中交汇，我一下子浮现出一个想法。", "plain_idx": 515, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
