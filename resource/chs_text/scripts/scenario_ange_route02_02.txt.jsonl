{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这是我和安洁一起迎来的第一个圣诞节，我也不能忽视。", "text_idx": 512, "plain": "这是我和安洁一起迎来的第一个圣诞节，我也不能忽视。", "plain_idx": 512, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
