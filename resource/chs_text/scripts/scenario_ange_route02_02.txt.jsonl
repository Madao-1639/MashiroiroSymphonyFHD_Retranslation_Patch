{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学生一个一个地进校了。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁精神饱满地给大家打着招呼，学生们虽然很惊讶，但还是笑着回应着她。", "text_idx": 349, "plain": "安洁精神饱满地给大家打着招呼，学生们虽然很惊讶，但还是笑着回应着她。", "plain_idx": 349, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 58, "speaker": "一年级结女校学生", "flag": 64, "pages": [{"page": 0, "text": "「哇，安洁同学在这里！」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jo0001", "char_id": "結女生徒１年"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 59, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是的，欢迎回来！」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2521", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 60, "speaker": "一年级结女校学生", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈，总有一种“就是这个——”的感觉呢。早上就是要这样啊～」", "text_idx": 355, "plain": "「啊哈哈，总有一种“就是这个——”的感觉呢。早上就是要这样啊～」", "plain_idx": 355, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jo0002", "char_id": "結女生徒１年"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 61, "speaker": "各务台校男生A", "flag": 64, "pages": [{"page": 0, "text": "「嗯？这不是安洁和瓜生吗」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "da0047", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 62, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，早上好」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 63, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「欢迎回来，呼呼——」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2522", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 64, "speaker": "各务台校男生A", "flag": 64, "pages": [{"page": 0, "text": "「哈哈，嗯，真是久违了啊」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "da0048", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不问年纪不问母校，也不问性别。", "text_idx": 365, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从旁边看着这样的安洁，不知怎么的，我也感到很开心。", "text_idx": 366, "plain": "从旁边看着这样的安洁，不知怎么的，我也感到很开心。", "plain_idx": 366, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 67, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「啊，欢迎回来～」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2523", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 68, "speaker": "结女校学生C", "flag": 64, "pages": [{"page": 0, "text": "「不如说是我想要欢迎安洁回来呢！」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jc0057", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈，早上好」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 70, "speaker": "结女校学生C", "flag": 64, "pages": [{"page": 0, "text": "「啊，早上好……瓜生也一起啊……」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jc0058", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 71, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是的，安洁的温柔少爷是来陪我的哦～哎呀～」", "text_idx": 375, "plain": "「是的，安洁的温柔少爷是来陪我的哦～哎呀～」", "plain_idx": 375, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2524", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 72, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「哈哈哈，安洁真是幸福啊！感觉是被爱着的呢～哎呀真是受不了了～」", "text_idx": 377, "plain": "「哈哈哈，安洁真是幸福啊！感觉是被爱着的呢～哎呀真是受不了了～」", "plain_idx": 377, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2525", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 73, "speaker": "结女校学生C", "flag": 64, "pages": [{"page": 0, "text": "「啊、开始秀恩爱了……这就不妙了……」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jc0059", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 74, "speaker": "结女校学生C", "flag": 64, "pages": [{"page": 0, "text": "「说真的，这是怎么了？怎么突然又这样了」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jc0060", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 75, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「哎嘿嘿……」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2526", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁和我对视了一眼，开心地笑了。", "text_idx": 385, "plain": "安洁和我对视了一眼，开心地笑了。", "plain_idx": 385, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 77, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是同学们让我们结缘的，所以，再一次地」", "text_idx": 386, "plain": "「是同学们让我们结缘的，所以，再一次地」", "plain_idx": 386, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2527", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 78, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「安洁想要表达谢意，或者说是想要报恩」", "text_idx": 388, "plain": "「安洁想要表达谢意，或者说是想要报恩」", "plain_idx": 388, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2528", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……所以，这就是。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这就是安洁表达和我顺利在一起的喜悦的方式。", "text_idx": 391, "plain": "这就是安洁表达和我顺利在一起的喜悦的方式。", "plain_idx": 391, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 81, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「哎嘿……就是这样的哦～少爷」", "text_idx": 392, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2529", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "能够这样表达心情，她似乎很开心的样子。她转向旁边的我，露出了闪闪发光的笑容。", "text_idx": 394, "plain": "能够这样表达心情，她似乎很开心的样子。她转向旁边的我，露出了闪闪发光的笑容。", "plain_idx": 394, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这样连我也开心起来了。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这孩子想要以这种方式“报恩”的心情——我非常理解。", "text_idx": 396, "plain": "这孩子想要以这种方式“报恩”的心情——我非常理解。", "plain_idx": 396, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 85, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「啊、什么？那个明天也要继续吗？」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4107", "char_id": "愛理"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到了午休时间。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在大家的午餐时间抛出这个话题的是濑名同学。", "text_idx": 401, "plain": "在大家的午餐时间抛出这个话题的是濑名同学。", "plain_idx": 401, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 88, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「考试都已经结束了，还这么辛苦啊」", "text_idx": 403, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0384", "char_id": "紗凪"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 89, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「安洁不像纱凪的成绩那么不尽如人意，所以心情也比较放松吧？」", "text_idx": 405, "plain": "「安洁不像纱凪的成绩那么不尽如人意，所以心情也比较放松吧？」", "plain_idx": 405, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4108", "char_id": "愛理"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 90, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我什么都没听见——」", "text_idx": 407, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0385", "char_id": "紗凪"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "顺便一说，今天上午公布了考试成绩。只能说，有考得好的人也有考得不太好的人。", "text_idx": 409, "plain": "顺便一说，今天上午公布了考试成绩。只能说，有考得好的人也有考得不太好的人。", "plain_idx": 409, "len": 37, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为我和安洁还算是排名比较靠前的，所以被濑名同学（她还是万年不变的第一名）表扬了。", "text_idx": 410, "plain": "因为我和安洁还算是排名比较靠前的，所以被濑名同学（她还是万年不变的第一名）表扬了。", "plain_idx": 410, "len": 41, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，如果说你明天还要继续的话，我也会陪你哦？」", "text_idx": 411, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 94, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「非常感谢」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2530", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 95, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「但是，我实在是不能接连拜托少爷早起啊」", "text_idx": 414, "plain": "「但是，我实在是不能接连拜托少爷早起啊」", "plain_idx": 414, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2531", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%51;「我只要有那个早安吻就没关系哦」", "text_idx": 416, "plain": "「あのキスがあればいいよ、俺は」", "plain_idx": 417, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 97, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "%51;「这样的话反而是安洁的身体会吃不消的……」", "text_idx": 418, "plain": "「それでは逆にアンジェの体が持ちませんよう……」", "plain_idx": 419, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2532", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 98, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「喂那边的！不要在别人面前亲热啊！你们这些恋爱上头的家伙——」", "text_idx": 421, "plain": "「喂那边的！不要在别人面前亲热啊！你们这些恋爱上头的家伙——」", "plain_idx": 421, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0386", "char_id": "紗凪"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 99, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「什么？我们只是普通的聊天而已……」", "text_idx": 423, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2533", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 100, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唔……你这家伙，你这普通对话不就是马上要开始亲热的前兆……！」", "text_idx": 425, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0387", "char_id": "紗凪"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 101, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呼呼呼，你们两个，真是长本事了啊」", "text_idx": 428, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0430", "char_id": "みう"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 102, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我们再不提高点精神上的耐力的话，感觉快要不能和他们一起吃饭了……」", "text_idx": 431, "plain": "「我们再不提高点精神上的耐力的话，感觉快要不能和他们一起吃饭了……」", "plain_idx": 431, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4109", "char_id": "愛理"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 103, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我倒是已经习惯了，随便放马过来吧」", "text_idx": 434, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1012", "char_id": "桜乃"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 104, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「真是可靠啊，这样安洁就放心了」", "text_idx": 437, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2534", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不不，安洁，我们还是注意一下吧……」", "text_idx": 439, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "初次H以后，我们的亲热程度真的是越来越高了啊……", "text_idx": 440, "plain": "初次H以后，我们的亲热程度真的是越来越高了啊……", "plain_idx": 440, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「咳咳……所以说，总之，恢复早上的问好只限今天」", "text_idx": 441, "plain": "「咳咳……所以说，总之，恢复早上的问好只限今天」", "plain_idx": 441, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
