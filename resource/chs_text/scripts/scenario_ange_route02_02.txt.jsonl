{"script": "scenario_ange_route02_02.txt", "scene": "*start", "row": 130, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「毕竟现在还有考试啊」", "text_idx": 473, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
