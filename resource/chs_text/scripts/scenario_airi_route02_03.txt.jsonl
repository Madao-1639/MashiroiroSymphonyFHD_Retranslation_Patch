{"script": "scenario_airi_route02_03.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我在……」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_03.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这副表情搞得我心神不宁，我点了点头。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_03.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "——考试真的离现在很近。", "text_idx": 358, "plain": "——考试真的离现在很近。", "plain_idx": 358, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
