{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「迷路的时候要及时和我联络」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 28, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「樱乃是想做就能做好的孩子」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1335", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 29, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「同样作为路痴，怎么总感觉自己输了……」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4472", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 30, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「只是随便走走而已」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1336", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「光是这样就够危险了」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只不过没想到又有新的目击情报。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来已经不是单纯的有谁看错了。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "也就是说……", "text_idx": 295, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
