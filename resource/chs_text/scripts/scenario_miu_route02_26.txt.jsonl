{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐没事吧，刚一直在发呆……", "text_idx": 359, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 70, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「现在开始，熊喵计划启动」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3459", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 71, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「真拿你们没办法。\\n　那我就在我公寓周围找找看吧」", "text_idx": 362, "plain": "「真拿你们没办法。　那我就在我公寓周围找找看吧」", "plain_idx": 363, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4476", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 72, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我和爱理一起」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1339", "char_id": "桜乃"}]}
