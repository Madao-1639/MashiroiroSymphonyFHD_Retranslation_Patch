{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 107, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「但最后还是继续养了♪」", "text_idx": 426, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0193", "char_id": "結子"}]}
