{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 37, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我都说了，我刚在外面看到了妈妈喵」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1615", "char_id": "紗凪"}]}
