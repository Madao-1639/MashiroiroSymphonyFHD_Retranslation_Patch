{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 25, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「难道樱乃你也在什么地方看到熊喵了？」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4471", "char_id": "愛理"}]}
