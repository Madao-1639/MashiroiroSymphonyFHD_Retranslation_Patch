{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 44, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「原来如此，是长得像熊猫的猫妈妈，所以是妈妈喵对吧」", "text_idx": 313, "plain": "「原来如此，是长得像熊猫的猫妈妈，所以是妈妈喵对吧」", "plain_idx": 313, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3457", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪的命名风格先不管。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你确定没看错吗？」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
