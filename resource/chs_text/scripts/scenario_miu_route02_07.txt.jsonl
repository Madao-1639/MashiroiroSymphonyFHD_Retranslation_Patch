{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 0, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾，今天一定要加油」", "text_idx": 137, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1465", "char_id": "みう"}]}
