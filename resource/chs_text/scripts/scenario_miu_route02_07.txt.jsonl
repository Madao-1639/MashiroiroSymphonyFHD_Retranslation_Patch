{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 4, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……我说的是学习」", "text_idx": 143, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1467", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，是啊！\\n　没人说过要努力练习接吻！」", "text_idx": 145, "plain": "「啊，是啊！　没人说过要努力练习接吻！」", "plain_idx": 146, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在来到天羽家前，我就一直坐立不安。", "text_idx": 147, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "毕竟我是来为期末考试学习的。", "text_idx": 148, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "赶快忘掉，把接吻的事彻底忘掉。", "text_idx": 149, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 150, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
