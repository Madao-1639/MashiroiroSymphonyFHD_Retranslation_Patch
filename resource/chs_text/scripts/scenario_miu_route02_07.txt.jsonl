{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 26, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……嗯」", "text_idx": 167, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1473", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或许学姐也是这么想的，她主动凑了过来。", "text_idx": 169, "plain": "或许学姐也是这么想的，她主动凑了过来。", "plain_idx": 169, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 28, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「抱歉，本来要好好学习的……」", "text_idx": 170, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1474", "char_id": "みう"}]}
