{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 30, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「奇怪的事？」", "text_idx": 173, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1475", "char_id": "みう"}]}
