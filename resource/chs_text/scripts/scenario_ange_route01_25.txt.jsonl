{"script": "scenario_ange_route01_25.txt", "scene": "*start", "row": 8, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「不、不是的，并不是那样……」", "text_idx": 176, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2150", "char_id": "アンジェ"}]}
