{"script": "scenario_ange_route01_25.txt", "scene": "*start", "row": 0, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「……话虽然这样说，但之后的路还很长呢」", "text_idx": 159, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2148", "char_id": "アンジェ"}]}
