{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我就先去趟学生会」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
