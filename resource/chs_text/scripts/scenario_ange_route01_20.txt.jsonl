{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我觉得那就是安洁对于“女仆”的诠释。现在她……表现得越来越……」", "text_idx": 431, "plain": "「我觉得那就是安洁对于“女仆”的诠释。现在她……表现得越来越……」", "plain_idx": 431, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
