{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "于是。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「所以你有什么事？」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 20, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「有，其实我忘了说」", "text_idx": 289, "plain": "「有，其实我忘了说」", "plain_idx": 289, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0965", "char_id": "桜乃"}]}
