{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不过，这毕竟是一件大事，大家难免会关心。", "text_idx": 458, "plain": "……不过，这毕竟是一件大事，大家难免会关心。", "plain_idx": 458, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
