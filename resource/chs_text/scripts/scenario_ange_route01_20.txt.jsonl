{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们明明关系已经很好了，樱乃却还是……在意着我们没有“做”吗？", "text_idx": 489, "plain": "我们明明关系已经很好了，樱乃却还是……在意着我们没有“做”吗？", "plain_idx": 489, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
