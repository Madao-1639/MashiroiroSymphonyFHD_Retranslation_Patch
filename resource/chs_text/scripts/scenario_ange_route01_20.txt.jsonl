{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 144, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「在我哥的房间里是听不到的」", "text_idx": 477, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0975", "char_id": "桜乃"}]}
