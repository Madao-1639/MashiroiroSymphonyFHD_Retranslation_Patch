{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 59, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「？」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1910", "char_id": "アンジェ"}]}
