{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 117, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「……所以你们已经进过洞房了吗？」", "text_idx": 437, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0353", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;「没！！！」", "text_idx": 439, "plain": "「い゛っ」", "plain_idx": 440, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 119, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「喂喂喂，你就算再怎么好奇，也不能直接这么问啊！」", "text_idx": 441, "plain": "「喂喂喂，你就算再怎么好奇，也不能直接这么问啊！」", "plain_idx": 441, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4059", "char_id": "愛理"}]}
