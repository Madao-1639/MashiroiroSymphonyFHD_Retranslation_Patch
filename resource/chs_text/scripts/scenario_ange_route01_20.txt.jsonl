{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 115, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「你们可真是不守规矩的一对儿」", "text_idx": 433, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4058", "char_id": "愛理"}]}
