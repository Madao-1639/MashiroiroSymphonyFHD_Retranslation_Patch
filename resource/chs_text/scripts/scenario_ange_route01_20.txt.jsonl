{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 146, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「诶？」", "text_idx": 481, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1921", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 147, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「所以，你们可以随意了」", "text_idx": 483, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0977", "char_id": "桜乃"}]}
