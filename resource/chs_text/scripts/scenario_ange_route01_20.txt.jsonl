{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 150, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「啊，少、少爷」", "text_idx": 486, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1922", "char_id": "アンジェ"}]}
