{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 159, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「所以说樱——乃——！」", "text_idx": 499, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
