{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 122, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谁让你们都住一起了呢？！安洁又变成这个样子，我当然在意啦！」", "text_idx": 446, "plain": "「谁让你们都住一起了呢？！安洁又变成这个样子，我当然在意啦！」", "plain_idx": 446, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4061", "char_id": "愛理"}]}
