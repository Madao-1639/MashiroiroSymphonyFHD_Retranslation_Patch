{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「总之，我不说」", "text_idx": 451, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 127, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「也、也是，你不说也挺好的」", "text_idx": 452, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4062", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 128, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「女人心，海底针」", "text_idx": 454, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0354", "char_id": "隼太"}]}
