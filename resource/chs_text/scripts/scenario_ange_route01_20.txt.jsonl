{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「生活费？」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 23, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0967", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 24, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「于是我打了个电话」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0968", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯……怎么说？」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_20.txt", "scene": "*start", "row": 26, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「说是给哥的红包」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0969", "char_id": "桜乃"}]}
