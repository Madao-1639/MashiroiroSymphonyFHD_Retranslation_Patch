{"script": "scenario_sakuno_route01_15.txt", "scene": "*start", "row": 51, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 226, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk2604", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_15.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "怎么。虽然和爱理聊了很久，但最后也没想出什么好办法。", "text_idx": 257, "plain": "怎么。虽然和爱理聊了很久，但最后也没想出什么好办法。", "plain_idx": 257, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
