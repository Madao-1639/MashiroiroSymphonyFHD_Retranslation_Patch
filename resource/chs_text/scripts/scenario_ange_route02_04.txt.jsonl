{"script": "scenario_ange_route02_04.txt", "scene": "*start", "row": 85, "speaker": "结女校学生A", "flag": 64, "pages": [{"page": 0, "text": "「这些都先不谈，你快吃啊，快！我超在意安洁的蛋糕啊」", "text_idx": 259, "plain": "「这些都先不谈，你快吃啊，快！我超在意安洁的蛋糕啊」", "plain_idx": 259, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ja0063", "char_id": "結女生徒Ａ"}]}
