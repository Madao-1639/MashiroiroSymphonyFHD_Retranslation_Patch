{"script": "scenario_airi_route01_14.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "两人干劲十足地接过了蒸笼，而濑名则笑嘻嘻地往我这里看了一眼。", "text_idx": 272, "plain": "两人干劲十足地接过了蒸笼，而濑名则笑嘻嘻地往我这里看了一眼。", "plain_idx": 272, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
