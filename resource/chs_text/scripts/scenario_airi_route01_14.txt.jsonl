{"script": "scenario_airi_route01_14.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "刚开始对男生的目光毫无防备的结女校女生，现在也开始在意起来了。", "text_idx": 308, "plain": "刚开始对男生的目光毫无防备的结女校女生，现在也开始在意起来了。", "plain_idx": 308, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
