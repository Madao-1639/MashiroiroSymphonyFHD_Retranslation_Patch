{"script": "scenario_airi_route01_14.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不禁心跳加速。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_14.txt", "scene": "*start", "row": 31, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这个，要保密哦」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar1480", "char_id": "愛理"}]}
