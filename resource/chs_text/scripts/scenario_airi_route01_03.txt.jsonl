{"script": "scenario_airi_route01_03.txt", "scene": "*start", "row": 38, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「啊呀呀？！」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar0764", "char_id": "愛理"}]}
