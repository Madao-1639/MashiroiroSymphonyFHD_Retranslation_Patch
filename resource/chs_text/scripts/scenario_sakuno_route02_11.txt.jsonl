{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「隼太你在做什么？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
