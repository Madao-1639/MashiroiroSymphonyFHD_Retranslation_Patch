{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这样啊」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
