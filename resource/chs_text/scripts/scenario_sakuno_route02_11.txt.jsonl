{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 82, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「是的」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3471", "char_id": "桜乃"}]}
