{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 0, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥，你这边结束了？」", "text_idx": 181, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3452", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "班会结束后，樱乃和平常一样出现在教室里。", "text_idx": 183, "plain": "班会结束后，樱乃和平常一样出现在教室里。", "plain_idx": 183, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，刚结束」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 3, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「完美」", "text_idx": 185, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3453", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "「真的跟传闻一样……兄妹在交往？」", "text_idx": 187, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "混在吵闹声中，那个声音又来了。", "text_idx": 189, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个声音我不集中精神去听就听不到……", "text_idx": 190, "plain": "这个声音我不集中精神去听就听不到……", "plain_idx": 190, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 8, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥？」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3454", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没什么」", "text_idx": 193, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃似乎没听到。", "text_idx": 194, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过这是为什么。", "text_idx": 195, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「濑名同学，谢谢你每天陪我们学习」", "text_idx": 196, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一起学习，时间就过得很快。", "text_idx": 197, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "说明学习的时候过得很充实。", "text_idx": 198, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 15, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我倒是没事……」", "text_idx": 200, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5594", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 16, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「安洁不在，寂寞了？」", "text_idx": 202, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3455", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 17, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是啊，她的记性也不算差，有塑造的价值」", "text_idx": 204, "plain": "「是啊，她的记性也不算差，有塑造的价值」", "plain_idx": 204, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5595", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喔……那要是一直让濑名同学教，\\n　那成绩应该能进步挺多的？」", "text_idx": 206, "plain": "「喔……那要是一直让濑名同学教，　那成绩应该能进步挺多的？」", "plain_idx": 207, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 19, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是啊，不过安洁的目标是寻找可以侍奉的主人」", "text_idx": 208, "plain": "「是啊，不过安洁的目标是寻找可以侍奉的主人」", "plain_idx": 208, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5596", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「能定下目标真的很厉害」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 21, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是啊，而我只是在漫无目的地学习」", "text_idx": 211, "plain": "「是啊，而我只是在漫无目的地学习」", "plain_idx": 211, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5597b", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就算如此，能有这些成绩你已经很厉害了……」", "text_idx": 213, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对于我的话语，濑名同学以苦笑回应。", "text_idx": 214, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "正是因为没有满足现状，她才会前进的吧。", "text_idx": 215, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 25, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「樱乃呢？」", "text_idx": 216, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5597", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 26, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我的目标？」", "text_idx": 218, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3456", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 27, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我好像没听过吧？」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5598", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 28, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「和哥哥在一起」", "text_idx": 222, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3457", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 29, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……唉，我都不该问的」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5599", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 30, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥呢？」", "text_idx": 226, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3458", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我？我的目标也是和樱乃在一起」", "text_idx": 228, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「为此我可得努力」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 33, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，所以现在要做的就是期末考试复习」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3459", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 34, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5600", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学盯着我们看。", "text_idx": 233, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「濑名同学有什么想问的？」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 37, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「没，你们俩真的只在学习呢」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5601", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 38, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「现在可是考试期间啊？」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3460", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 39, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是的，我还以为……」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5602", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学脸变红了。", "text_idx": 241, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 41, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「会、会是那种……更甜蜜的氛围」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5603", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 42, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我和哥哥一直都很恩爱，以前也是这样的」", "text_idx": 244, "plain": "「我和哥哥一直都很恩爱，以前也是这样的」", "plain_idx": 244, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3461", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 43, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「以前也是……嗯，毕竟你们在交往」", "text_idx": 246, "plain": "「以前也是……嗯，毕竟你们在交往」", "plain_idx": 246, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5604", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，别乱说」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 45, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哎？不是吗？」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5605", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「毕竟在一起很久了，比起恋人我们还是更像兄妹一点」", "text_idx": 251, "plain": "「毕竟在一起很久了，比起恋人我们还是更像兄妹一点」", "plain_idx": 251, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 47, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我在抓撒娇恩爱的机会，但是一直没有」", "text_idx": 252, "plain": "「我在抓撒娇恩爱的机会，但是一直没有」", "plain_idx": 252, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3462", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我都没注意你在干这事」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 49, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「那就不打扰你抓机会了，我要回去了」", "text_idx": 255, "plain": "「那就不打扰你抓机会了，我要回去了」", "plain_idx": 255, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5606", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 50, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「晚饭不一起吃了吗？」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3463", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 51, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「今天惠民超市有限时特卖」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5607", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 52, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「忘记了」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3464", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「原来如此」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 54, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「报纸里有传单，就是爱理说的，有限时特卖」", "text_idx": 264, "plain": "「报纸里有传单，就是爱理说的，有限时特卖」", "plain_idx": 264, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3465", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 55, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「这个，夹在报纸里的传单」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3466", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 56, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我没订报纸，这还有限定一人一份的商品啊！」", "text_idx": 268, "plain": "「我没订报纸，这还有限定一人一份的商品啊！」", "plain_idx": 268, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5608", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学看向我们这边。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「可以的话一起去？」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 59, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「樱乃可以吗？」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5609", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 60, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那是当然」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3467", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 61, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谢谢，帮大忙了」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5610", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "可能是因为买到了所有想要的东西，\\n濑名同学一脸开心的表情。", "text_idx": 278, "plain": "可能是因为买到了所有想要的东西，濑名同学一脸开心的表情。", "plain_idx": 279, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「只是这点小忙的话随时都能叫我们」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 64, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，和爱理一起购物连氛围都不一样」", "text_idx": 281, "plain": "「嗯，和爱理一起购物连氛围都不一样」", "plain_idx": 281, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3468", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 65, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是、是这样吗……」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5611", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 66, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「就跟赶往战场的狼或者盯上猎物的老鹰似的」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3469", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 67, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这种很正常的，很正常」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5612", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……也是」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还是不要过于抠细节了。", "text_idx": 290, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 70, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生你有什么要说的吗，说清楚点呗？」", "text_idx": 291, "plain": "「瓜生你有什么要说的吗，说清楚点呗？」", "plain_idx": 291, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5613", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
