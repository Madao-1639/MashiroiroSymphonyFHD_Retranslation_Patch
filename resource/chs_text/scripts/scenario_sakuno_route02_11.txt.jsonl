{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 85, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「那倒也是」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1164", "char_id": "隼太"}]}
