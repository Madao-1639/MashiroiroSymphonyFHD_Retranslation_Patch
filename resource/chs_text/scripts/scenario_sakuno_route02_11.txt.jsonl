{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 91, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「明天见」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5615", "char_id": "愛理"}]}
