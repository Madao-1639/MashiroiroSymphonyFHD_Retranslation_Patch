{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哦对，抱歉留了你一会」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
