{"script": "scenario_sakuno_route02_11.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哦，隼太」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
