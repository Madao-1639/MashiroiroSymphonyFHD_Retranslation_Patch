{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 0, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「嗯，今天也好冷冷……啊，怎么好暖和？！」", "text_idx": 154, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1517", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早上好，纱凪」", "text_idx": 156, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 2, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你还真的把火炉子借过来了啊……」", "text_idx": 157, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1518", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不试试怎么知道」", "text_idx": 159, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 4, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「呼啊——好暖和——」", "text_idx": 160, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1519", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这炉子是校长批准借给我们的，纱凪正把手放在炉子上烤。", "text_idx": 162, "plain": "这炉子是校长批准借给我们的，纱凪正把手放在炉子上烤。", "plain_idx": 162, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 6, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐呢？」", "text_idx": 163, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1520", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「昨天她有打工，今天应该会晚点来吧」", "text_idx": 165, "plain": "「昨天她有打工，今天应该会晚点来吧」", "plain_idx": 165, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 8, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哼嗯，一清二楚啊」", "text_idx": 166, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1521", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我是她男朋友啊」", "text_idx": 168, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 10, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1522", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也跟着她把手放在炉子上烤。", "text_idx": 171, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 12, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我说啊」", "text_idx": 172, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1523", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 174, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 14, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……新吾，你不会寂寞吗？」", "text_idx": 175, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1524", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「寂寞？」", "text_idx": 177, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 16, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐明年就毕业了。然后，就算你还和她交往，也不怎么能见到了」", "text_idx": 178, "plain": "「美羽学姐明年就毕业了。然后，就算你还和她交往，也不怎么能见到了」", "plain_idx": 178, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1525", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 180, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 18, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……而且你毕业了还可能被她甩」", "text_idx": 181, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1526", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "未来的事我也毫无头绪。", "text_idx": 183, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过我想好好珍惜现在这段能和学姐在一起的时光。", "text_idx": 184, "plain": "不过我想好好珍惜现在这段能和学姐在一起的时光。", "plain_idx": 184, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐毕业之后的事情，到时候再考虑就行了。", "text_idx": 185, "plain": "学姐毕业之后的事情，到时候再考虑就行了。", "plain_idx": 185, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 23, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「假如……我是说假如」", "text_idx": 186, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1527", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 174, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她把伸在火炉上的手抽回，瞥了我一眼。", "text_idx": 188, "plain": "她把伸在火炉上的手抽回，瞥了我一眼。", "plain_idx": 188, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 26, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「学姐毕业后，把没用的你反手踹了，你就会变成一个人……」", "text_idx": 189, "plain": "「学姐毕业后，把没用的你反手踹了，你就会变成一个人……」", "plain_idx": 189, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1528", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 27, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「那你也会很寂寞的吧——虽然到时候我来当你的女朋友也行」", "text_idx": 191, "plain": "「那你也会很寂寞的吧——虽然到时候我来当你的女朋友也行」", "plain_idx": 191, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1529", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就算被甩了，我的回答也不会变。", "text_idx": 193, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我不会讨厌美羽学姐，并且我绝不会以你是某人替代品的心态来和你交往」", "text_idx": 194, "plain": "「我不会讨厌美羽学姐，并且我绝不会以你是某人替代品的心态来和你交往」", "plain_idx": 194, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那样对你也不好吧」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 32, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1530", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不过，我也要加把劲不被她甩」", "text_idx": 197, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是啊，我只能加把劲。", "text_idx": 198, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为了能配得上美羽学姐。", "text_idx": 199, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 36, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「噗，啊哈哈哈！」", "text_idx": 200, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1531", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我本以为说得很清楚了，可她却捧着肚子笑了起来。", "text_idx": 202, "plain": "我本以为说得很清楚了，可她却捧着肚子笑了起来。", "plain_idx": 202, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 38, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「怎么你还真上纲上线了呀。本来美羽学姐就不可能甩了你吧」", "text_idx": 203, "plain": "「怎么你还真上纲上线了呀。本来美羽学姐就不可能甩了你吧」", "plain_idx": 203, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1532", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「说到底，本就是假设吧？而且，扯歪的不是你来着？」", "text_idx": 205, "plain": "「说到底，本就是假设吧？而且，扯歪的不是你来着？」", "plain_idx": 205, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 40, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我就只是试探一下你」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1533", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 41, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我还想着如果你真的回答要跟我交往，我就要去告诉美羽学姐」", "text_idx": 208, "plain": "「我还想着如果你真的回答要跟我交往，我就要去告诉美羽学姐」", "plain_idx": 208, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1534", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没能回应您的期待真是抱歉」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 43, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你最好永远都别回应」", "text_idx": 211, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1535", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她似乎暖和点了，开始清点活动室里的物品。", "text_idx": 213, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 45, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊，早上好呀～外面好冷呢——」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1846", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早上好」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 47, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「早上好，学姐」", "text_idx": 218, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1536", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐打着哆嗦从外面走进来，纱凪一个箭步飞扑过去。", "text_idx": 220, "plain": "美羽学姐打着哆嗦从外面走进来，纱凪一个箭步飞扑过去。", "plain_idx": 220, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 49, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「学姐，来烤火吧，这有火炉」", "text_idx": 221, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1537", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 50, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「是我为了学姐，去校长那里好不容易求来的」", "text_idx": 223, "plain": "「是我为了学姐，去校长那里好不容易求来的」", "plain_idx": 223, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1538", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 51, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊，真的嘛？不好意思呀。总是代我做了这么多事」", "text_idx": 225, "plain": "「啊，真的嘛？不好意思呀。总是代我做了这么多事」", "plain_idx": 225, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1847", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 52, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……我有的时候，也没法代替学姐」", "text_idx": 227, "plain": "「……我有的时候，也没法代替学姐」", "plain_idx": 227, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1539", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 53, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「欸？」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1848", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她把学姐拉到我旁边，然后背过去，深吸一口气。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 55, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「对了对了，还有件事」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1540", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后，她满脸笑容地转了过来。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 57, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐，你和新吾开始交往了吧。恭喜你们呀」", "text_idx": 235, "plain": "「美羽学姐，你和新吾开始交往了吧。恭喜你们呀」", "plain_idx": 235, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1541", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 58, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1849", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "于是，学姐也不服输似的同样露出满脸笑容。", "text_idx": 238, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 60, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「谢谢你，纱纱♪」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1850", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 61, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1542", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一刹那，我和纱凪四目相对。", "text_idx": 242, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我低着头，握着美羽学姐的手。", "text_idx": 243, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "之后，在我们面前，纱凪依旧露出了那副耀眼的笑容。", "text_idx": 244, "plain": "之后，在我们面前，纱凪依旧露出了那副耀眼的笑容。", "plain_idx": 244, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 65, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「学姐，请一定要幸福呢。不过，男朋友是新吾的话就没必要担心了」", "text_idx": 245, "plain": "「学姐，请一定要幸福呢。不过，男朋友是新吾的话就没必要担心了」", "plain_idx": 245, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1543", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 66, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「纱纱……」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1851", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐也回握着我的手。", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「谢谢你，纱凪」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或许没必要把火炉借过来。", "text_idx": 251, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为，就算这个活动室里没有火炉。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐和纱凪的笑容——", "text_idx": 253, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 72, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 169, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1544", "char_id": "紗凪"}]}
