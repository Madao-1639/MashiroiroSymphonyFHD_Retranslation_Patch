{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我一边和同班同学打着招呼，一边走向自己的座位。", "text_idx": 282, "plain": "我一边和同班同学打着招呼，一边走向自己的座位。", "plain_idx": 282, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "处理好每个小细节是营造良好氛围的捷径。", "text_idx": 283, "plain": "处理好每个小细节是营造良好氛围的捷径。", "plain_idx": 283, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就像打扫房间一样。", "text_idx": 284, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
