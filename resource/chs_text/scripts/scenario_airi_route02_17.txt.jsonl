{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 20, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「让人害羞的话居然这么轻松就说出口」", "text_idx": 166, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0609", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 21, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「恭喜」", "text_idx": 168, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0656", "char_id": "桜乃"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 22, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「然后，妈妈认为今天只有我和新吾会来！」", "text_idx": 170, "plain": "「然后，妈妈认为今天只有我和新吾会来！」", "plain_idx": 170, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3722", "char_id": "愛理"}]}
