{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 0, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理舞动着华丽的衣袖。", "text_idx": 123, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
