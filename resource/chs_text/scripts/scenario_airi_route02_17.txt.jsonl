{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天回爱理的老家，不仅是为了给校长拜年。", "text_idx": 174, "plain": "今天回爱理的老家，不仅是为了给校长拜年。", "plain_idx": 174, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
