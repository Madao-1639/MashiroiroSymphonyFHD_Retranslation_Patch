{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我这么说后，大家都震惊地瞪大眼睛。", "text_idx": 183, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 30, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3723", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理和我都看着对方笑了。", "text_idx": 186, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 32, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是啊，气氛之类的无所谓，新吾也是大家也是」", "text_idx": 187, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3724", "char_id": "愛理"}]}
