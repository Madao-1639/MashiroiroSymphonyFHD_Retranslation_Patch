{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 35, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥，爱理」", "text_idx": 193, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0658", "char_id": "桜乃"}]}
