{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都有些震惊了。", "text_idx": 197, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 38, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，真不像是新吾会说的话～」", "text_idx": 198, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3726", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_17.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「爱理讨厌这样的我吗？」", "text_idx": 200, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
