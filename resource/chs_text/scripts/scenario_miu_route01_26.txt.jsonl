{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 0, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥哥，无精打采的」", "text_idx": 187, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1297", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「有、有吗？」", "text_idx": 189, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 2, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「昨天发生什么了？」", "text_idx": 190, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1298", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「也没……」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "事实上，发生了一些难以启齿的事情。", "text_idx": 193, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "超出意料也要有个度吧。", "text_idx": 194, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真没想到会看到美羽学姐那副样子……", "text_idx": 195, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我满脑子都在想那种事情，一整晚都没合眼。", "text_idx": 196, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看上去无精打采也是因为这个吧。", "text_idx": 197, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 9, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥哥，脸好红」", "text_idx": 198, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1299", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我、我什么也没看见！」", "text_idx": 200, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 11, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1300", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "面对樱乃都这幅模样，等见到美羽学姐了还不知道会成什么样。", "text_idx": 203, "plain": "面对樱乃都这幅模样，等见到美羽学姐了还不知道会成什么样。", "plain_idx": 203, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这种时候要尽量保持平常心……", "text_idx": 204, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 14, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1186", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;「哇啊？！」", "text_idx": 208, "plain": "「うあ！？」", "plain_idx": 209, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的反应糟透了。", "text_idx": 210, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "倒不如说怎么可能能保持住平常心啊。", "text_idx": 211, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 18, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……早、早上好」", "text_idx": 212, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1187", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早上吼！」", "text_idx": 214, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 20, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥，声调都变了」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1301", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喉、喉咙有点不舒服。咳咳！」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我轻咳几声，尽量拉开了和学姐的距离。", "text_idx": 218, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 23, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「是空气太干燥了吗……没事吧，新吾？」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1188", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「？！」", "text_idx": 221, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "刚拉开的距离被学姐一下就缩短了，她探过头来凝视我的脸。", "text_idx": 222, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "空气中飘来学姐的体香。", "text_idx": 223, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "再这样下去又会想起昨天发生的事情，我慌慌张张地移开了视线。", "text_idx": 224, "plain": "再这样下去又会想起昨天发生的事情，我慌慌张张地移开了视线。", "plain_idx": 224, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 28, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「还是稍微打开窗通通风吧」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1189", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，不用开窗也行的」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 30, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「是吗？」", "text_idx": 228, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1190", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "每当视线和学姐对上，我就如鲠在喉。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是不是我太过在意了啊……", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 34, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……我去看看外面的兔子」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1302", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，慢走」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我笑着把樱乃送出门。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 37, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1191", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "回过神来又和学姐独处了。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "和平时不同，现在脑海里想不出任何话题。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 40, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「今、今天天气不错呢」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1192", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是啊」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们手上一边做着其他事，一边强撑起兴致进行对话。", "text_idx": 244, "plain": "我们手上一边做着其他事，一边强撑起兴致进行对话。", "plain_idx": 244, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后马上又会沉默下去。", "text_idx": 245, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有当学姐转过身的时候，我内心紧绷着的弦才能放松一点。", "text_idx": 246, "plain": "只有当学姐转过身的时候，我内心紧绷着的弦才能放松一点。", "plain_idx": 246, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要认真想想这个情况要怎么解决了啊……", "text_idx": 247, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我可不想一直这样别扭下去啊。", "text_idx": 248, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 47, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾，听我说……」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1193", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%123;「哇啊————？！」", "text_idx": 251, "plain": "「うわあーーーーっ！？」", "plain_idx": 252, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 49, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1194", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨天的情景突然在我眼前重现，让我无比动摇。", "text_idx": 254, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不行啊，终于出现幻觉了吗……", "text_idx": 255, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 52, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「你还好吗，新吾？」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1195", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，是的。抱歉……」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "场景的重现是结束了，但是我又不敢直视学姐了。", "text_idx": 259, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且我感觉活动室里氧气有点稀薄。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 56, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……那个，昨天真是抱歉了啊」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1196", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「诶……」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 58, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「本来是准备和小猫们一起洗澡的……然后多蒙和卡琳就开始闹起来了……」", "text_idx": 264, "plain": "「本来是准备和小猫们一起洗澡的……然后多蒙和卡琳就开始闹起来了……」", "plain_idx": 264, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1197", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 59, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「然后我就出来追它，结果撞上了新吾。\\n　我吓得都忘记遮起来了……」", "text_idx": 266, "plain": "「然后我就出来追它，结果撞上了新吾。　我吓得都忘记遮起来了……」", "plain_idx": 267, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1198", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我、我才是真的非常对不起你」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我已经结巴到不像是一个日本人了。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这种情况下，我明明应该在学姐开口前先道歉的。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 63, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「对了，这个。你把手机忘在我家了吧？」", "text_idx": 272, "plain": "「对了，这个。你把手机忘在我家了吧？」", "plain_idx": 272, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1199", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 64, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「这是在我的房间里找到的……」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1200", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，真是太感谢了」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 66, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「手机里的内容我可什么都没看啊」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1201", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 67, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「偷看别人的手机可是最不好的行为，就算新吾频频和女孩子发短信那也是新吾的自由」", "text_idx": 279, "plain": "「偷看别人的手机可是最不好的行为，就算新吾频频和女孩子发短信那也是新吾的自由」", "plain_idx": 279, "len": 39, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1202", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「手机里也没什么东西。会发短信的异性也就只有樱乃了」", "text_idx": 281, "plain": "「手机里也没什么东西。会发短信的异性也就只有樱乃了」", "plain_idx": 281, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 69, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……这样啊，太好了」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1203", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「诶？」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 71, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊啊，我在说些什么啊。不是这样的，不是你想的这样」", "text_idx": 285, "plain": "「啊啊，我在说些什么啊。不是这样的，不是你想的这样」", "plain_idx": 285, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1204", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "原本看上去很冷静的美羽学姐，现在看起来也相当慌张。", "text_idx": 287, "plain": "原本看上去很冷静的美羽学姐，现在看起来也相当慌张。", "plain_idx": 287, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 73, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「真是抱歉啊。昨天让你看到了不堪入目的东西……」", "text_idx": 288, "plain": "「真是抱歉啊。昨天让你看到了不堪入目的东西……」", "plain_idx": 288, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1205", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我、我什么都没看见哦。我不太记得清昨天发生的事情呢」", "text_idx": 290, "plain": "「我、我什么都没看见哦。我不太记得清昨天发生的事情呢」", "plain_idx": 290, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 75, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「肯定很讨厌吧。让你看到那么穷酸的身体……」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1206", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没有那回事！一点也不穷酸！」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "胸部也比外表看起来要丰满得多，肌肤则是白皙通透。", "text_idx": 294, "plain": "胸部也比外表看起来要丰满得多，肌肤则是白皙通透。", "plain_idx": 294, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽说日本人有不少都是屁股比较大的葫芦型体型，但学姐并非如此。", "text_idx": 295, "plain": "虽说日本人有不少都是屁股比较大的葫芦型体型，但学姐并非如此。", "plain_idx": 295, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然个子比较矮小，但是该凸的地方还是很有料的，给人的感觉十分匀称……", "text_idx": 296, "plain": "虽然个子比较矮小，但是该凸的地方还是很有料的，给人的感觉十分匀称……", "plain_idx": 296, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 80, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……你果然看到了啊」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1207", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊啊啊，不是的。我没看见，这都是我的胡言乱语」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在可不是冷静分析学姐身体的时候。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过都这样了还说什么也没看见，又有点太不自然了啊。", "text_idx": 301, "plain": "不过都这样了还说什么也没看见，又有点太不自然了啊。", "plain_idx": 301, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉，我就直说了吧」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「其实……我看见了」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看得清清楚楚，这句话我就不加上去了。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是这方面的问题。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 88, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呜，早知道再练练腹肌就好了……」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1208", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……也不是这方面的问题啊。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唉……」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我绝望了。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对单手拿着手机尝试念写的自己绝望了。\\n（注：念写，为将心中所想显现为现实图像的超能力）", "text_idx": 311, "plain": "对单手拿着手机尝试念写的自己绝望了。（注：念写，为将心中所想显现为现实图像的超能力）", "plain_idx": 312, "len": 44, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "哪有一上来就是全裸的。这都算是对理性的直接挑战了。", "text_idx": 313, "plain": "哪有一上来就是全裸的。这都算是对理性的直接挑战了。", "plain_idx": 313, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且对方还是那位美羽学姐。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "平时可是绝对无法企及的高岭之花。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不，现在也还是高岭之花，\\n而我看到了她的裸体后不由自主就试着念写了。", "text_idx": 316, "plain": "不，现在也还是高岭之花，而我看到了她的裸体后不由自主就试着念写了。", "plain_idx": 317, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……作为人类来说，我可能已经完蛋了」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "开始念叨这种话，我这病情看来已经是晚期了。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 99, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唉……」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1259", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 100, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？怎么了吗，唉声叹气的……」", "text_idx": 322, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "原以为是一样有着烦恼的同志，但是看她的表情又不像是有什么烦恼。", "text_idx": 323, "plain": "原以为是一样有着烦恼的同志，但是看她的表情又不像是有什么烦恼。", "plain_idx": 323, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 102, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我这么幸福真的好吗……」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1260", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是发生了什么好事吗？」", "text_idx": 326, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 104, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「嗯。昨天和“新吾”一起洗了澡♪」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1261", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;「噗？！」", "text_idx": 329, "plain": "「ぶっ！？」", "plain_idx": 330, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 106, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……话说在前头，是猫的“新吾”哦？」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1262", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这、这种事情我肯定知道啊」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我相当地心虚。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 109, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「而且泡在水里的新吾可爱得不得了～」", "text_idx": 335, "plain": "「而且泡在水里的新吾可爱得不得了～」", "plain_idx": 335, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1263", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 110, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「还会用离开了我就活不下去一样的眼神看着我呢」", "text_idx": 337, "plain": "「还会用离开了我就活不下去一样的眼神看着我呢」", "plain_idx": 337, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1264", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 111, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「这样下去，搞不好我也会变得没了“新吾”就活不下去啊」", "text_idx": 339, "plain": "「这样下去，搞不好我也会变得没了“新吾”就活不下去啊」", "plain_idx": 339, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1265", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 112, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我还在想为什么这么热闹，原来是在向瓜生告白吗？」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4333", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 113, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「才、才不是呢。我说的是猫的“新吾”」", "text_idx": 345, "plain": "「才、才不是呢。我说的是猫的“新吾”」", "plain_idx": 345, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1266", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 114, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哼……」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4334", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 115, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……哼什么哼啊」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1267", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 116, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4335", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 117, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么了？」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 118, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……这种家伙到底哪里好了啊」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4336", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 119, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「诶？」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 120, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「爱理，你没事吧？刚刚开始就一直在说一些意义不明的事情」", "text_idx": 355, "plain": "「爱理，你没事吧？刚刚开始就一直在说一些意义不明的事情」", "plain_idx": 355, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1268", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 121, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「意义不明的明明是纱凪好吧」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4337", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 122, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1269", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学耸耸肩，我和纱凪则是面面相觑。", "text_idx": 360, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 124, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你别盯着别人的脸看啊，恶心死了」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1270", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 125, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最后，我也只得无奈地耸耸肩。", "text_idx": 363, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
