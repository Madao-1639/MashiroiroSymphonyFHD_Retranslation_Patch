{"script": "scenario_miu_route02_30.txt", "scene": "*start", "row": 27, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「所以我对现在这个状况没什么好说的」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1656", "char_id": "紗凪"}]}
