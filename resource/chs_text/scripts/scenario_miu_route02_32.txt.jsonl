{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 0, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……接下来就只剩它们了吧」", "text_idx": 155, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2419", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 157, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 2, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「等这只兔子回归自然后，\\n　我们就不再继续保护动物了」", "text_idx": 158, "plain": "「等这只兔子回归自然后，　我们就不再继续保护动物了」", "plain_idx": 159, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2420", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这是为什么？」", "text_idx": 161, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 4, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2421", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐」", "text_idx": 164, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 6, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……我打算在这个月结束社团活动」", "text_idx": 165, "plain": "「……我打算在这个月结束社团活动」", "plain_idx": 165, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2422", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「？！」", "text_idx": 167, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 8, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「抱歉呀，说得这么晚」", "text_idx": 168, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2423", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「为什么，这么突然……」", "text_idx": 170, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 10, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「其实很早之前我就这么决定了」", "text_idx": 171, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2424", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 12, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「明明好不容易才有了这么多社员……\\n　擅自这么做真是抱歉」", "text_idx": 173, "plain": "「明明好不容易才有了这么多社员……　擅自这么做真是抱歉」", "plain_idx": 174, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2425", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是因为熊喵吗？", "text_idx": 176, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还是说有什么别的原因？", "text_idx": 177, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但无论是什么原因，这都是由作为社团长的美羽学姐决定的，\\n我没有说三道四的资格。", "text_idx": 178, "plain": "但无论是什么原因，这都是由作为社团长的美羽学姐决定的，我没有说三道四的资格。", "plain_idx": 179, "len": 40, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「可是……」", "text_idx": 180, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不行，我不能说。说出来也只会让学姐徒生困扰。", "text_idx": 181, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "…………", "text_idx": 182, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是。", "text_idx": 183, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「学姐真的觉得这样就可以了吗？」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 21, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2426", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……果然，还是不该说的。", "text_idx": 186, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不想看到学姐露出那副表情……", "text_idx": 187, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 24, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……唔，是吗，学姐这么说的啊」", "text_idx": 189, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1658", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你就这样接受了吗？」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 26, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「既然学姐都说要解散了，\\n　我们作为社员也只能服从了不是吗」", "text_idx": 192, "plain": "「既然学姐都说要解散了，　我们作为社员也只能服从了不是吗」", "plain_idx": 193, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1659", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还以为纱凪会和我一起劝学姐继续。", "text_idx": 195, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没想到她的反应居然会这么平淡。", "text_idx": 196, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么她会这么简单就接受了。", "text_idx": 197, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明那时是那么努力去守护这个社团……", "text_idx": 198, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 32, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「什么嘛，怎么一脸不满」", "text_idx": 199, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1660", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你可以接受吗？这个社团就这样解散」", "text_idx": 201, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 34, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1661", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「大家一起贴海报，召集社员……\\n　还给猫找养家，明明都那么努力了」", "text_idx": 203, "plain": "「大家一起贴海报，召集社员……　还给猫找养家，明明都那么努力了」", "plain_idx": 204, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 36, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……看来，你还不知道真正重要的是什么」", "text_idx": 205, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1662", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 157, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪叹了口气，环视了一下活动室，\\n拿了一个剩下的给熊喵吃的猫罐头。", "text_idx": 207, "plain": "纱凪叹了口气，环视了一下活动室，拿了一个剩下的给熊喵吃的猫罐头。", "plain_idx": 208, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 39, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你知道学姐为什么要即使累倒了也坚持打工吗？」", "text_idx": 209, "plain": "「你知道学姐为什么要即使累倒了也坚持打工吗？」", "plain_idx": 209, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1663", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 40, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你难道就没觉得不可思议吗，\\n　被保护在这个活动室里的动物们的食费是从哪里来的？」", "text_idx": 211, "plain": "「你难道就没觉得不可思议吗，　被保护在这个活动室里的动物们的食费是从哪里来的？」", "plain_idx": 212, "len": 42, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1664", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪的这番话，结论已经很明显了。", "text_idx": 214, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我们是没有部费的来着」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 44, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「没错。这些都是用的美羽学姐打工赚来的钱」", "text_idx": 216, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1665", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 45, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「虽然我之前也想过帮忙，但被她拒绝了……」", "text_idx": 218, "plain": "「虽然我之前也想过帮忙，但被她拒绝了……」", "plain_idx": 218, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1666", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 47, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「那美羽学姐毕业之后，谁能来代替学姐？」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1667", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪把罐头丢到我怀里后，继续说着。", "text_idx": 222, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 49, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「其实，美羽学姐是想让你来当社团长的」", "text_idx": 223, "plain": "「其实，美羽学姐是想让你来当社团长的」", "plain_idx": 223, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1668", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 50, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「但是她没那么做」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1669", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 51, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「学姐在不久前找我道歉了」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1671", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 52, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「她说虽然想继续让社团开设下去，但果然还是做不到」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1672", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 53, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我当然是反对过的。\\n　我说，社团长让我或者新吾来当不就行了吗」", "text_idx": 231, "plain": "「我当然是反对过的。　我说，社团长让我或者新吾来当不就行了吗」", "plain_idx": 232, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1673", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 54, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……但她还是说不行。\\n　你知道为什么吗？」", "text_idx": 234, "plain": "「……但她还是说不行。　你知道为什么吗？」", "plain_idx": 235, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1674", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不知道……」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 56, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1675", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 57, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「因为她很心疼我们」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1676", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 58, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「她比任何人都更重视你……」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1677", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 59, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「所以美羽学姐没办法让你当这个社团长」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1678", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 61, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「这三年里，她自己一直一个人工作着守护这个社团」", "text_idx": 245, "plain": "「这三年里，她自己一直一个人工作着守护这个社团」", "plain_idx": 245, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1679", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 62, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「如果我或者你也会体验到这种艰辛，\\n　那么就算会被别人说是伪善，她也会解散这个社团，学姐就是这样的人」", "text_idx": 247, "plain": "「如果我或者你也会体验到这种艰辛，　那么就算会被别人说是伪善，她也会解散这个社团，学姐就是这样的人」", "plain_idx": 248, "len": 52, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1680", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 63, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「学姐她，对我们的事，要比保护动物看得更重」", "text_idx": 250, "plain": "「学姐她，对我们的事，要比保护动物看得更重」", "plain_idx": 250, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1681", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 64, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「这不就只能接受了么。\\n　既然她说了要由她自己解散社团……」", "text_idx": 252, "plain": "「这不就只能接受了么。　既然她说了要由她自己解散社团……」", "plain_idx": 253, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1682", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……真是赢不过她啊」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 67, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「这不是当然的吗，她可是我喜欢的人。\\n　你想到她那个地步，还早一百亿年呢」", "text_idx": 256, "plain": "「这不是当然的吗，她可是我喜欢的人。　你想到她那个地步，还早一百亿年呢」", "plain_idx": 257, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1683", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把怀里的罐头放回架子后，再次确认了心中的想法。", "text_idx": 259, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我决不能就这样让社团解散。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我应做的事就只有一个。", "text_idx": 261, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你真的就这样接受了吗？」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 72, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「什么」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1684", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你想就这样被美羽学姐溺爱下去吗」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 74, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1685", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪轻笑了一下，拍了下我的肩。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 76, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「果然啊」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1686", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯？」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 78, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1687", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 79, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你是个好男人」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1688", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 80, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，卡琳，多蒙，到这来～」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0212", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 81, "speaker": "通用", "flag": 64, "pages": [{"page": 0, "text": "「喵——」\\n「喵——」", "text_idx": 279, "plain": "「喵——」「喵——」", "plain_idx": 280, "len": 12, "alt_speaker": "卡琳／多蒙", "alt_speaker_idx": 278, "voice": "go078", "char_id": "汎用"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 82, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2427", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 83, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「美羽也来一起玩吧？\\n　卡琳，去叫美羽过来」", "text_idx": 283, "plain": "「美羽也来一起玩吧？　卡琳，去叫美羽过来」", "plain_idx": 284, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0213", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 84, "speaker": "卡琳", "flag": 64, "pages": [{"page": 0, "text": "「喵——」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "kr0009", "char_id": "カリン"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 85, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「来吧来吧，\\n　你看卡琳都在叫你一起玩哦～？」", "text_idx": 290, "plain": "「来吧来吧，　你看卡琳都在叫你一起玩哦～？」", "plain_idx": 291, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0214", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 86, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……那个，母亲」", "text_idx": 293, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2428", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 87, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「我在，怎么了吗？\\n　哎呀，都说不行了，多蒙真是的……」", "text_idx": 295, "plain": "「我在，怎么了吗？　哎呀，都说不行了，多蒙真是的……」", "plain_idx": 296, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0215", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 88, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2429", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 89, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「母亲，你不会害怕养猫吗？」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2430", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 90, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「害怕？」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0216", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 91, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「猫不是会比我们早死得多吗？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2431", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 92, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「即使之前再可爱，\\n　最后也只会留下悲伤的回忆而已……」", "text_idx": 305, "plain": "「即使之前再可爱，　最后也只会留下悲伤的回忆而已……」", "plain_idx": 306, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2432", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 93, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「为什么母亲即使如此也还在养猫？」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2433", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 94, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0217", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 95, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「确实啊，离别是一件令人伤心的事……」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0218", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 96, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「但是，和这些孩子在一起的时间，\\n　会永远……都是我珍贵的宝物」", "text_idx": 313, "plain": "「但是，和这些孩子在一起的时间，　会永远……都是我珍贵的宝物」", "plain_idx": 314, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0219", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 97, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2434", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 98, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「等你什么时候也变成母亲了……\\n　肯定会明白的」", "text_idx": 317, "plain": "「等你什么时候也变成母亲了……　肯定会明白的」", "plain_idx": 318, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0220", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 99, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「哎……」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2435", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 100, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「孩子总有一天会离开父母……\\n　就算是我和你像这样待在一起的时间，\\n　应该也不剩多长了」", "text_idx": 322, "plain": "「孩子总有一天会离开父母……　就算是我和你像这样待在一起的时间，　应该也不剩多长了」", "plain_idx": 323, "len": 46, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0221", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 101, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「你会遇到非常棒的人。\\n　然后接下来的时间里和那个人制造属于你们的回忆」", "text_idx": 325, "plain": "「你会遇到非常棒的人。　然后接下来的时间里和那个人制造属于你们的回忆」", "plain_idx": 326, "len": 37, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0222", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 102, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「就像，你给我带来了很多难忘的回忆一样……」", "text_idx": 328, "plain": "「就像，你给我带来了很多难忘的回忆一样……」", "plain_idx": 328, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0223", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 103, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 162, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2436", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 104, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「就像你说的那样，卡琳和多蒙有一天会离开我的身边」", "text_idx": 331, "plain": "「就像你说的那样，卡琳和多蒙有一天会离开我的身边」", "plain_idx": 331, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0224", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 105, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「但是，和这两个孩子的回忆，\\n　会永远留在妈妈的心里……\\n　不对，是我必须要将它们留在心里」", "text_idx": 333, "plain": "「但是，和这两个孩子的回忆，　会永远留在妈妈的心里……　不对，是我必须要将它们留在心里」", "plain_idx": 334, "len": 48, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0225", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 106, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「所以，来。你也不能忘了哦」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0226", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 107, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「？！」", "text_idx": 167, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2437", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 108, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「因为熊喵肯定会记得你的……」", "text_idx": 339, "plain": "「因为熊喵肯定会记得你的……」", "plain_idx": 339, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0227", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 109, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「所以你也绝对不能忘掉熊喵哦？」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0228", "char_id": "結子"}]}
