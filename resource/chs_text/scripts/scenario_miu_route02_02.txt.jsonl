{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 0, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「呵呵，呵，呵呵呵……♪」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0294", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 1, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「新吾，那是怎么回事？」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0580", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「什么怎么回事？」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 3, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「万智老师啊，万智老师。最近经常一个人呵呵呵地笑着」", "text_idx": 220, "plain": "「万智老师啊，万智老师。最近经常一个人呵呵呵地笑着」", "plain_idx": 220, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0581", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「难道说，找到男朋友了？」", "text_idx": 222, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 5, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「我感觉也像。要真是这样的话，大家要好好祝福祝福她啊」", "text_idx": 223, "plain": "「我感觉也像。要真是这样的话，大家要好好祝福祝福她啊」", "plain_idx": 223, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0582", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 6, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「所以啊，新吾」", "text_idx": 225, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0583", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哇啊，感觉没好事」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 8, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「别这么说嘛。你去向万智老师问清楚情况。这样一来大家都能幸福」", "text_idx": 228, "plain": "「别这么说嘛。你去向万智老师问清楚情况。这样一来大家都能幸福」", "plain_idx": 228, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0584", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……果然是这回事吗」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隼太拍了我肩膀几下，把我推向万智老师身边。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 11, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……呵，呵呵呵♪」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0295", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不禁转过头看向隼太，并用眼神确认“没问题吧？”。", "text_idx": 234, "plain": "我不禁转过头看向隼太，并用眼神确认“没问题吧？”。", "plain_idx": 234, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "万智老师正在看某张照片，心情很好。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这果然是有男朋友了吧。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「请问……万智老师，最近是遇到什么开心事了吗？」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 16, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「啊呀，新吾问得好啊……」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0296", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被老师那闪闪发光的眼睛盯着，我不禁退后了两步。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这是想要别人主动上来搭话吗……", "text_idx": 241, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「老师看上去很开心的样子」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 20, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「嗯嗯。古德里安真是太可爱了♪」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0297", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「古德里安？」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 22, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「猫啊，就是猫。最近我开始养小猫了。那小家伙的名字叫做古德里安」", "text_idx": 246, "plain": "「猫啊，就是猫。最近我开始养小猫了。那小家伙的名字叫做古德里安」", "plain_idx": 246, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0298", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 23, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「真是一个可爱得不行的小家伙啊」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0299", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 24, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「我还是第一次养猫，没想到竟然这么可爱……」", "text_idx": 250, "plain": "「我还是第一次养猫，没想到竟然这么可爱……」", "plain_idx": 250, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0300", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 25, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「我还给它买了洋装，它这么可爱穿什么都很合适啊～」", "text_idx": 252, "plain": "「我还给它买了洋装，它这么可爱穿什么都很合适啊～」", "plain_idx": 252, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0301", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 26, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「啊，下次买什么样的洋装给它呢。呵呵，呵呵呵♪」", "text_idx": 254, "plain": "「啊，下次买什么样的洋装给它呢。呵呵，呵呵呵♪」", "plain_idx": 254, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0302", "char_id": "万智"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "嗯，还是让老师一个人待着比较好。", "text_idx": 256, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "万智老师幸福的话，那不也挺好吗。", "text_idx": 257, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "作为学生的我们也不该对此说三道四。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 30, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「……这情况，已经是晚期了啊」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0585", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不能说三道四！", "text_idx": 261, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 32, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「嗯，八冢老师啊……」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4371", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 33, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「能懂老师的心情」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1310", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 34, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「樱乃也喜欢猫吗？」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4372", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 35, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「喜欢动物」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1311", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 36, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「你哥呢？」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4373", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「濑名同学，你这么问是有什么深意吗」", "text_idx": 275, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 38, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「喜欢，动物」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1312", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，你这个回答的意义我也搞不懂」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 40, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「樱乃同学，喜欢animal的新吾同学呢」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3423", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「搞不懂为什么动物要用英语来说……」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 42, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「男人什么的灭绝了就好了」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1311", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最搞不懂的还是这个人的心。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这件事是以自己来收尾，真是太可悲了。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 45, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐觉得动物系男生怎么样呢？」", "text_idx": 288, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1312", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 46, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「动物系男生？」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1243", "char_id": "みう"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 47, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「就是说像这个新吾一样，全年发情，不分场合随时准备交尾的男生」", "text_idx": 294, "plain": "「就是说像这个新吾一样，全年发情，不分场合随时准备交尾的男生」", "plain_idx": 294, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1313", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还真是够惨的啊。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就算同为男性，也还是会讨厌这种动物系男生的啊。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 50, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯……不过新吾也不是不分场合交尾的人吧？」", "text_idx": 298, "plain": "「嗯……不过新吾也不是不分场合交尾的人吧？」", "plain_idx": 298, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1244", "char_id": "みう"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐竟然说出了“交尾”这种词，搞得我心里一惊。", "text_idx": 300, "plain": "学姐竟然说出了“交尾”这种词，搞得我心里一惊。", "plain_idx": 300, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 52, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哪有，他绝对会频繁的交尾。不分场合，不论对象」", "text_idx": 301, "plain": "「哪有，他绝对会频繁的交尾。不分场合，不论对象」", "plain_idx": 301, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1314", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但是交尾这个词从纱凪嘴里说出来就没有一点违和感。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明都是女生，真是不可思议啊。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 55, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……没有被我哥交尾过」", "text_idx": 305, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1313", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 56, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「被交尾了那还得了……」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4374", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 57, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「交尾这种词，我觉得不能从清纯的少女嘴里说出来。交尾这种词……交尾这种词」", "text_idx": 309, "plain": "「交尾这种词，我觉得不能从清纯的少女嘴里说出来。交尾这种词……交尾这种词」", "plain_idx": 309, "len": 37, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3424", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看上去比谁都高兴的安洁就先不管了。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要想办法回收动物新吾这个称号。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 60, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「喂，动物」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1315", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "感觉没戏了。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 62, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你这家伙，就算搞错了也别想着和美羽学姐交尾啊」", "text_idx": 316, "plain": "「你这家伙，就算搞错了也别想着和美羽学姐交尾啊」", "plain_idx": 316, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1316", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好好好，这个话题到此为止。说这种话，对美羽学姐很没礼貌吧？」", "text_idx": 318, "plain": "「好好好，这个话题到此为止。说这种话，对美羽学姐很没礼貌吧？」", "plain_idx": 318, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 64, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哼，你以为说这种话就能骗过我吗。我可是知道的啊？」", "text_idx": 319, "plain": "「哼，你以为说这种话就能骗过我吗。我可是知道的啊？」", "plain_idx": 319, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1317", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 65, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「男的只要和雌性两个人独处一室，就会野性大发然后失去自我」", "text_idx": 321, "plain": "「男的只要和雌性两个人独处一室，就会野性大发然后失去自我」", "plain_idx": 321, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1318", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这又是从哪来的过激的知识啊。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且，雌性……", "text_idx": 324, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 68, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐也要多加小心啊。动物新吾肯定瞄着学姐呢」", "text_idx": 325, "plain": "「美羽学姐也要多加小心啊。动物新吾肯定瞄着学姐呢」", "plain_idx": 325, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1319", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真不想这个称呼就这样被定下来啊。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 70, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呵呵呵，新吾不是那种人对吧～？」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1245", "char_id": "みう"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「说实话，我都不知道要怎么回答了」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 72, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「虽然只是我个人的印象，不过新吾交尾的话肯定会很温柔的♪」", "text_idx": 331, "plain": "「虽然只是我个人的印象，不过新吾交尾的话肯定会很温柔的♪」", "plain_idx": 331, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1246", "char_id": "みう"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;「噗？！」", "text_idx": 333, "plain": "「ぶっ！？」", "plain_idx": 334, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "越来越不好回答了。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐说“交尾”这种话过于生动了……", "text_idx": 336, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 76, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……天羽学姐，我觉得还是少说交尾这种词比较好」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4375", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 77, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊，说的也是呢。交尾这种词不能说也不能做呢」", "text_idx": 339, "plain": "「啊，说的也是呢。交尾这种词不能说也不能做呢」", "plain_idx": 339, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1247", "char_id": "みう"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 78, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥，你交尾会很温柔吗？」", "text_idx": 341, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1314", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃不要对奇怪的地方感兴趣」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 80, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「这个年纪是这样的」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1315", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就算到这个岁数了也要自重啊」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_02.txt", "scene": "*start", "row": 82, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1316", "char_id": "桜乃"}]}
