{"script": "scenario_miu_route02_14.txt", "scene": "*start", "row": 37, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 175, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0155", "char_id": "結子"}]}
{"script": "scenario_miu_route02_14.txt", "scene": "*start", "row": 38, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，话题变得沉重起来了。\\n　结子，下次咱俩去哪聚聚吧？下个月我空闲较多」", "text_idx": 205, "plain": "「哎呀，话题变得沉重起来了。　结子，下次咱俩去哪聚聚吧？下个月我空闲较多」", "plain_idx": 206, "len": 39, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0640", "char_id": "蘭華"}]}
