{"script": "scenario_miu_route02_14.txt", "scene": "*start", "row": 41, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「守望孩子追求幸福，不正是作为父母的幸福吗」", "text_idx": 213, "plain": "「守望孩子追求幸福，不正是作为父母的幸福吗」", "plain_idx": 213, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0157", "char_id": "結子"}]}
