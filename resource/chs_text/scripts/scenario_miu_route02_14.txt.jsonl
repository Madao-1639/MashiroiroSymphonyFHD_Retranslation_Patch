{"script": "scenario_miu_route02_14.txt", "scene": "*start", "row": 44, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「你那狡猾的笑脸一点没变」", "text_idx": 218, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0643", "char_id": "蘭華"}]}
