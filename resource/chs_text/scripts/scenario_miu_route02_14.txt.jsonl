{"script": "scenario_miu_route02_14.txt", "scene": "*start", "row": 32, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「我一直都很感激你……」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0153", "char_id": "結子"}]}
