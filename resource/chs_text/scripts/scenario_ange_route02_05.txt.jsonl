{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 100, "speaker": "各务台校男生B", "flag": 64, "pages": [{"page": 0, "text": "「也让我们来帮忙吧！全是女生的话力气活就人手不足了吧！」", "text_idx": 416, "plain": "「也让我们来帮忙吧！全是女生的话力气活就人手不足了吧！」", "plain_idx": 416, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "db0031", "char_id": "各務台男子Ｂ"}]}
