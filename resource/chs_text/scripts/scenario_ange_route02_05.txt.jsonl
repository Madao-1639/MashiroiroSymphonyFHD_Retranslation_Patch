{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 114, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "%164;「全部安静！！！」", "text_idx": 440, "plain": "「全員静かにっっっ！！！」", "plain_idx": 441, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4117", "char_id": "愛理"}]}
{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 115, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「呀，不好意思？！」", "text_idx": 443, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2633", "char_id": "アンジェ"}]}
