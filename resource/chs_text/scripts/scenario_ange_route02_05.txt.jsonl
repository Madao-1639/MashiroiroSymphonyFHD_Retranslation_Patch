{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 98, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「总之总之，请先听我说，那边的各位请先坐下，啊怎么弄得这么乱？！」", "text_idx": 411, "plain": "「总之总之，请先听我说，那边的各位请先坐下，啊怎么弄得这么乱？！」", "plain_idx": 411, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2631", "char_id": "アンジェ"}]}
