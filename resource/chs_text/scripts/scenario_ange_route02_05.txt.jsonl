{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 42, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈……」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2620", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "“安洁要做一个巨大的蛋糕”这件事真的是传遍全校了，大家似乎都非常感兴趣。", "text_idx": 329, "plain": "“安洁要做一个巨大的蛋糕”这件事真的是传遍全校了，大家似乎都非常感兴趣。", "plain_idx": 329, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
