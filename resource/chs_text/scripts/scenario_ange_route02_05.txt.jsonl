{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 40, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「喂～大家在外面排好队吧～现在蛋糕制作组有事情要谈～」", "text_idx": 324, "plain": "「喂～大家在外面排好队吧～现在蛋糕制作组有事情要谈～」", "plain_idx": 324, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0381", "char_id": "隼太"}]}
