{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学一声大喝，全场立刻鸦雀无声。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
