{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 102, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「话倒是这么说～～！」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2632", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "原本充满活力地开始指挥的安洁，逐渐开始感到无法控制局面。", "text_idx": 422, "plain": "原本充满活力地开始指挥的安洁，逐渐开始感到无法控制局面。", "plain_idx": 422, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
