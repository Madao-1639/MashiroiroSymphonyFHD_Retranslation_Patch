{"script": "scenario_ange_route02_05.txt", "scene": "*start", "row": 131, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「那么各位，请先听安洁讲话！之后，我再来给大家安排工作」", "text_idx": 471, "plain": "「那么各位，请先听安洁讲话！之后，我再来给大家安排工作」", "plain_idx": 471, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2640", "char_id": "アンジェ"}]}
