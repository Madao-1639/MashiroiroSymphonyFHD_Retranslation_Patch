{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 34, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊……大家都来了呀。圣诞快乐♪」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2042", "char_id": "みう"}]}
