{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 3, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3442", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 4, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「看你这个表情，果然只是在虚张声势……」", "text_idx": 234, "plain": "「看你这个表情，果然只是在虚张声势……」", "plain_idx": 234, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4455", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 5, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「呜呜呜呜，我、我才没有觉得寂寞」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3443", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是这种角色来着的吗？", "text_idx": 238, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "算了，这个暂且不管。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没想到会在圣诞节当天在活动室里看到大家。", "text_idx": 240, "plain": "没想到会在圣诞节当天在活动室里看到大家。", "plain_idx": 240, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 9, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「话说回来，为什么新吾你会在这？」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1595", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「什么为什么？」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 11, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这么快就和天羽学姐分手了吗？」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4456", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "果然濑名同学是知道我和学姐的事情的。", "text_idx": 247, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不是，没那种事。我只是想和家人一起过圣诞节而已……」", "text_idx": 248, "plain": "「不是，没那种事。我只是想和家人一起过圣诞节而已……」", "plain_idx": 248, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 14, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是这样吗，樱乃？」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4457", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 15, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「今年我和爱理过」", "text_idx": 252, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1326", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 16, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「没错。我们之前就约好了」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4458", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 17, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「也就是说……」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1596", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 18, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「果然，是和学姐分手了。肯定是被美羽学姐说“没用”了」", "text_idx": 258, "plain": "「果然，是和学姐分手了。肯定是被美羽学姐说“没用”了」", "plain_idx": 258, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3444", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为啥大伙一说到这个就会特别开心啊……", "text_idx": 260, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 20, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「毕竟对象是天羽学姐……我也觉得没有男人能配得上她」", "text_idx": 261, "plain": "「毕竟对象是天羽学姐……我也觉得没有男人能配得上她」", "plain_idx": 261, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4459", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你们已经完全确定我被甩了啊」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 22, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「新吾同学的背影总感觉弥散着一股哀愁的气息……」", "text_idx": 264, "plain": "「新吾同学的背影总感觉弥散着一股哀愁的气息……」", "plain_idx": 264, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3445", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "总觉得特意去否定她们也好麻烦。", "text_idx": 266, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 24, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「作为一个男性，也就挑帽子的品味还不错了……」", "text_idx": 267, "plain": "「作为一个男性，也就挑帽子的品味还不错了……」", "plain_idx": 267, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4460", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 25, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……那个帽子，我也是第一次见」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1327", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "毕竟这是昨……今天刚从学姐那得到的。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃肯定不知道。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 28, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是美羽学姐亲手做的……好像也不是」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3446", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 29, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1597", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来只有纱凪知道这是学姐亲手织的。", "text_idx": 276, "plain": "看来只有纱凪知道这是学姐亲手织的。", "plain_idx": 276, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是我吹嘘，这个帽子真的很暖和。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还是第一次从别人那得到亲手织的礼物，真想一直戴着。", "text_idx": 278, "plain": "我还是第一次从别人那得到亲手织的礼物，真想一直戴着。", "plain_idx": 278, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
