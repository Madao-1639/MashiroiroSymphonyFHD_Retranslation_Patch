{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐似乎也听到了安洁她们说的话，露出了困惑的表情。", "text_idx": 314, "plain": "美羽学姐似乎也听到了安洁她们说的话，露出了困惑的表情。", "plain_idx": 314, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
