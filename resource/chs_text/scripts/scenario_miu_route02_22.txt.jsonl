{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 124, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊」", "text_idx": 414, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 125, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「小、小熊喵？！不要看过来……那个……那个……」", "text_idx": 415, "plain": "「小、小熊喵？！不要看过来……那个……那个……」", "plain_idx": 415, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2065", "char_id": "みう"}]}
