{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 127, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「没错没错，要准备饭」", "text_idx": 418, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2066", "char_id": "みう"}]}
