{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 27, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「我想让少爷一直保持形象。因为安洁最喜欢少爷了」", "text_idx": 285, "plain": "「我想让少爷一直保持形象。因为安洁最喜欢少爷了」", "plain_idx": 285, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag2654", "char_id": "アンジェ"}]}
