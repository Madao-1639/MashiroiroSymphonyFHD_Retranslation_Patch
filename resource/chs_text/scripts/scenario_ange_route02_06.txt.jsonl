{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安洁叫纱凪“纱纱”呢，说不定就是因为两个人很相似，关系才这么好」", "text_idx": 356, "plain": "「安洁叫纱凪“纱纱”呢，说不定就是因为两个人很相似，关系才这么好」", "plain_idx": 356, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 66, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「好了，出发了渣滓们！等着吧安洁，就让我来帮帮你～」", "text_idx": 357, "plain": "「好了，出发了渣滓们！等着吧安洁，就让我来帮帮你～」", "plain_idx": 357, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0393", "char_id": "紗凪"}]}
