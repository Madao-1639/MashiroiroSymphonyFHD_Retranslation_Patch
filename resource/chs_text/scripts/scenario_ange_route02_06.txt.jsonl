{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 61, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「哇，谢谢纱纱」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0436", "char_id": "みう"}]}
{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 62, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「纱纱真是温柔啊，好孩子好孩子～」", "text_idx": 350, "plain": "「纱纱真是温柔啊，好孩子好孩子～」", "plain_idx": 350, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0437", "char_id": "みう"}]}
