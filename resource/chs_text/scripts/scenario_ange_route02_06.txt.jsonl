{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 69, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0394", "char_id": "紗凪"}]}
