{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我懂」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
