{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知不觉看入迷了。", "text_idx": 371, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 76, "speaker": "结女校学生B", "flag": 64, "pages": [{"page": 0, "text": "「话说纱凪同学，仔细一看的话，女仆装还蛮可爱的……」", "text_idx": 373, "plain": "「话说纱凪同学，仔细一看的话，女仆装还蛮可爱的……」", "plain_idx": 373, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jb0034", "char_id": "結女生徒Ｂ"}]}
