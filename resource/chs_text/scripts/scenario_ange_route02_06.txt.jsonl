{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 57, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「喂小子们，我也来帮忙」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0389", "char_id": "紗凪"}]}
{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 58, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「哦，真的吗？」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0387", "char_id": "隼太"}]}
{"script": "scenario_ange_route02_06.txt", "scene": "*start", "row": 59, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你们可别误会了啊！我只是来代替温柔的美羽学姐的！」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0390", "char_id": "紗凪"}]}
