{"script": "scenario_miu_route02_10.txt", "scene": "*replay_miu_03", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他红着脸，试图将自己的分身弄大。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*replay_miu_03", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他的这幅模样，我只觉得怜爱。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
