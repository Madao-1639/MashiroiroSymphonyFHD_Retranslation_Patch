{"script": "scenario_miu_route02_10.txt", "scene": "*replay_miu_03", "row": 50, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……怎么了？」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu1633", "char_id": "みう"}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*replay_miu_03", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他慌张地用手刺激着自己的下体。", "text_idx": 229, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
