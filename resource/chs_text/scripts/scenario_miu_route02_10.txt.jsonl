{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隼太一脸苦涩，拍了拍我的肩头。", "text_idx": 106, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我对美羽学姐已经无法自拔了……」", "text_idx": 107, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
