{"script": "scenario_miu_route02_10.txt", "scene": "*replay_miu_03", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈啊哈啊……啊……」", "text_idx": 185, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*replay_miu_03", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他拼命强忍的样子，对我来说是一种奖励。", "text_idx": 186, "plain": "他拼命强忍的样子，对我来说是一种奖励。", "plain_idx": 186, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
