{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也不敢相信。只要和她在一起，我就无法镇静」", "text_idx": 110, "plain": "「我也不敢相信。只要和她在一起，我就无法镇静」", "plain_idx": 110, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 7, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「顺便问问，天羽学姐昨天说了什么？」", "text_idx": 111, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0640", "char_id": "隼太"}]}
