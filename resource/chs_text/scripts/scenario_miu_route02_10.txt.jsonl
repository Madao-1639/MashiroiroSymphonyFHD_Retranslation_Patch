{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 9, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「呃……」", "text_idx": 114, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0641", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「明明是我离不开她」", "text_idx": 116, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 11, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「看来天羽学姐也是神魂颠倒的啊」", "text_idx": 117, "plain": "「看来天羽学姐也是神魂颠倒的啊」", "plain_idx": 117, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0642", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是这样么……」", "text_idx": 119, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 13, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「你想想，那位天羽学姐居然能说出离不开你这种话？」", "text_idx": 120, "plain": "「你想想，那位天羽学姐居然能说出离不开你这种话？」", "plain_idx": 120, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0643", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 14, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「她有对其他人说过同样的话吗？」", "text_idx": 122, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0644", "char_id": "隼太"}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么可能……」", "text_idx": 124, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_10.txt", "scene": "*start", "row": 16, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「总之，你加把劲！事不过三」", "text_idx": 125, "plain": "「总之，你加把劲！事不过三」", "plain_idx": 125, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0645", "char_id": "隼太"}]}
