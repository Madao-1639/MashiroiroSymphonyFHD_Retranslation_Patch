{"script": "scenario_ange_route02_03.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "校长看了一眼时钟，表情一下变得严肃了起来。", "text_idx": 193, "plain": "校长看了一眼时钟，表情一下变得严肃了起来。", "plain_idx": 193, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route02_03.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来今天她也很忙啊。", "text_idx": 194, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
