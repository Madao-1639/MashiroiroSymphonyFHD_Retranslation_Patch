{"script": "scenario_ange_route02_08.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其他人也都来了——", "text_idx": 405, "plain": "其他人也都来了——", "plain_idx": 405, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
