{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，还是在意——", "text_idx": 331, "plain": "不过，还是在意——", "plain_idx": 331, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
