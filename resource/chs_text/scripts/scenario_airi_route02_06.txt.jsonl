{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我刚进房间，就看见爱理已经开始醉心地挥舞她的自动铅笔。", "text_idx": 178, "plain": "我刚进房间，就看见爱理已经开始醉心地挥舞她的自动铅笔。", "plain_idx": 178, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
