{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我回想起了母亲的事情。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 95, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……偶尔也试着往家里打打电话吧」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3026", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我对母亲的事情在意了起来。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
