{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 92, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3025", "char_id": "愛理"}]}
