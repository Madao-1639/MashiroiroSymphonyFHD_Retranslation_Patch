{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 97, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「大恩难以言谢呀」", "text_idx": 425, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0365", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 98, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「好了，接下来就是发挥你们积累的时候了」", "text_idx": 427, "plain": "「好了，接下来就是发挥你们积累的时候了」", "plain_idx": 427, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4088", "char_id": "愛理"}]}
