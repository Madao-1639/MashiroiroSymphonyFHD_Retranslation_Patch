{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 48, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哈啊哈啊哈啊……新吾，快点」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1701", "char_id": "紗凪"}]}
