{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们正好看到学姐从走廊另一边的校长办公室里走出来。", "text_idx": 338, "plain": "我们正好看到学姐从走廊另一边的校长办公室里走出来。", "plain_idx": 338, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪立马冲到了学姐面前。", "text_idx": 339, "plain": "纱凪立马冲到了学姐面前。", "plain_idx": 339, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 58, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「纱纱……还有新吾……」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2454", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 59, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我们有很重要的事想和学姐说」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1705", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 60, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「重要的事？」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2455", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "调整好呼吸后，我也来到了学姐身旁。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 62, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「难道说你已经和校长说完了吗？」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1706", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 63, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2456", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐茫然地歪了歪头。", "text_idx": 351, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我从纱凪那听说了，学姐想要结束社团活动的理由」", "text_idx": 352, "plain": "「我从纱凪那听说了，学姐想要结束社团活动的理由」", "plain_idx": 352, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我们就是想和你商量下这件事，希望学姐能让我们继续保护动物」", "text_idx": 353, "plain": "「我们就是想和你商量下这件事，希望学姐能让我们继续保护动物」", "plain_idx": 353, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 67, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「即使美羽学姐毕业了，\\n　我们也还想继续进行我们的社团活动」", "text_idx": 354, "plain": "「即使美羽学姐毕业了，　我们也还想继续进行我们的社团活动」", "plain_idx": 355, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1707", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「所以我们……」", "text_idx": 357, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 69, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2457", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 70, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……谢谢你们。\\n　但我刚刚和濑名老师说的不是要解散社团」", "text_idx": 359, "plain": "「……谢谢你们。　但我刚刚和濑名老师说的不是要解散社团」", "plain_idx": 360, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2458", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 72, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「那学姐是和她聊了什么？」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1708", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 73, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2459", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 74, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「……所以，天羽说了什么？」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0326", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 75, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0654", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 76, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「说是能不能作为一个新的课外活动……让学生们植树」", "text_idx": 369, "plain": "「说是能不能作为一个新的课外活动……让学生们植树」", "plain_idx": 369, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0655", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 77, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「植树？」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0327", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 78, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「真是的，把这事说得可真简单～」", "text_idx": 373, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0656", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 79, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「……预、预算方面有点难度吧，要植树的话」", "text_idx": 375, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0328", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 80, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，这就是我们大人的任务了，不是吗～」", "text_idx": 377, "plain": "「哎呀，这就是我们大人的任务了，不是吗～」", "plain_idx": 377, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0657", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 81, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「校长……」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0329", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 82, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「要想成为好女人，可不是只有学习的偏差值高就行了」", "text_idx": 381, "plain": "「要想成为好女人，可不是只有学习的偏差值高就行了」", "plain_idx": 381, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0658", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 83, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「学问和女人味的偏差值，还有恋爱的偏差值也要高呢」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0330", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 84, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「可真敢说呀，明明是个单身贵族～♪」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0659", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 85, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「我、我是自愿单身的……」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0331", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 86, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「女性再怎么努力，男性那边看不到就……」", "text_idx": 389, "plain": "「女性再怎么努力，男性那边看不到就……」", "plain_idx": 389, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0660", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 87, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「说的没错！说的没错！」", "text_idx": 391, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0332", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 88, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「好了，万智。工作来了哦。为了我们可爱的学生们」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0661", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 89, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "「是，校长」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mc0333", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「为了增添自然？」", "text_idx": 397, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 91, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯。我想了很多关于这方面的事」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2460", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 92, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「无论我们再怎么保护动物，结局都是不会变的……」", "text_idx": 400, "plain": "「无论我们再怎么保护动物，结局都是不会变的……」", "plain_idx": 400, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2461", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「但我们还可以继续社团活动的不是吗？」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 94, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我也有这么打算。\\n　但我们只是保护的话是不够的。\\n　还得增添新的……」", "text_idx": 403, "plain": "「我也有这么打算。　但我们只是保护的话是不够的。　还得增添新的……」", "plain_idx": 404, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2462", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 95, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「几年后、几十年后……\\n　我们保护的动物，还有它们的孩子……」", "text_idx": 406, "plain": "「几年后、几十年后……　我们保护的动物，还有它们的孩子……」", "plain_idx": 407, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2463", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐看了眼活动室附近的佛塔，继续说了下去。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 97, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我们必须创造出一个能让小熊喵它们能安心生活下去的地方」", "text_idx": 410, "plain": "「我们必须创造出一个能让小熊喵它们能安心生活下去的地方」", "plain_idx": 410, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2464", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐这时候露出的笑容，真的十分耀眼。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看了看旁边的纱凪，她也正笑着。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "于是，我也露出笑容——", "text_idx": 414, "plain": "于是，我也露出笑容——", "plain_idx": 414, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 102, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我能做的……」", "text_idx": 415, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 103, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我拍！」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2465", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 104, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐突然兴奋地拿出了手机。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「怎么突然拍起照片来了……」", "text_idx": 419, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 107, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「哎嘿嘿，就突然觉得必须得好好给重要的事情留下纪念♪」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2466", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 108, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「好，那我也来拍拍」", "text_idx": 422, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1710", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪一脸不开心地拿起手机。", "text_idx": 424, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也拿起了自己的手机，\\n但刚掏出来就又放回去了。", "text_idx": 425, "plain": "我也拿起了自己的手机，但刚掏出来就又放回去了。", "plain_idx": 426, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐」", "text_idx": 427, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 112, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「怎么了，新吾？」", "text_idx": 428, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2467", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我突然明白了。", "text_idx": 430, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我爱着学姐的程度，绝不会输给她爱着我的程度。", "text_idx": 431, "plain": "我爱着学姐的程度，绝不会输给她爱着我的程度。", "plain_idx": 431, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以，我也得爱着她所爱的东西才行。", "text_idx": 432, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 116, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我想聊聊咱们社团之后的事」", "text_idx": 433, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 117, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 349, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2468", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "注意到的时候，发现大家都从活动室里出去了。", "text_idx": 435, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 119, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁似乎想说什么，但被濑名堵住嘴巴带走了。", "text_idx": 436, "plain": "安洁似乎想说什么，但被濑名堵住嘴巴带走了。", "plain_idx": 436, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃还是和往常一样看不出表情。", "text_idx": 437, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 121, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看着这样的她们，我突然间也不紧张了。", "text_idx": 438, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "仔细想想这也不是难说出口的事。", "text_idx": 439, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「学姐毕业之后，可以让我来当社团长吗？」", "text_idx": 440, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 124, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「哎……」", "text_idx": 336, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2469", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「如果大家都要保护动物，\\n　那么，就由我来保护大家」", "text_idx": 442, "plain": "「如果大家都要保护动物，　那么，就由我来保护大家」", "plain_idx": 443, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「保护由学姐你创建的这个社团」", "text_idx": 444, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 127, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2470", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 128, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾……」", "text_idx": 446, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2471", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 129, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐以最美丽的笑容回应了我。", "text_idx": 448, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对此，我已经别无所求了。", "text_idx": 449, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
