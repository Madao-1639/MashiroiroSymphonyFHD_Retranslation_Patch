{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 50, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「可恶，你居然能跑这么快吗……」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1702", "char_id": "紗凪"}]}
