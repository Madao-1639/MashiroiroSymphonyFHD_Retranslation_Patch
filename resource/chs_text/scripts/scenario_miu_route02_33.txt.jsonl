{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 0, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你可真是不中用啊，\\n　你这样子也能算美羽学姐的男朋友吗？」", "text_idx": 234, "plain": "「你可真是不中用啊，　你这样子也能算美羽学姐的男朋友吗？」", "plain_idx": 235, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1689", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「真奇怪。\\n　她明明说了会过来的……」", "text_idx": 237, "plain": "「真奇怪。　她明明说了会过来的……」", "plain_idx": 238, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想和学姐重新谈一次关于社团的事。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪也赞同了我这个想法，\\n然后我们就这样等着学姐到活动室来。", "text_idx": 240, "plain": "纱凪也赞同了我这个想法，然后我们就这样等着学姐到活动室来。", "plain_idx": 241, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 4, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「这不是完全没来吗」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1690", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是啊」", "text_idx": 244, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 6, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「唉……你还是给学姐打个电话吧」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1691", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我刚才打过了，但没人接」", "text_idx": 247, "plain": "「我刚才打过了，但没人接」", "plain_idx": 247, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 8, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「这就是分手的前奏吗」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1692", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你别乱说」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 10, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「我知道，说着玩的」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1693", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 11, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「所以，你想好怎么说服学姐了吗」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1694", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎，不是你来说服她吗？」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 13, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1695", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我开玩笑的，别这副表情」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 15, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……反正我说了学姐也听不进去」", "text_idx": 259, "plain": "「……反正我说了学姐也听不进去」", "plain_idx": 259, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1696", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「才没那回事」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 17, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「就是这样」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1697", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 18, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哎……你们在这里干什么？」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4500", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 19, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哦，来得正好爱理。\\n　你有在哪看到过美羽学姐吗？」", "text_idx": 267, "plain": "「哦，来得正好爱理。　你有在哪看到过美羽学姐吗？」", "plain_idx": 268, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1698", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 20, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「天羽学姐的话，我刚在校门前遇到了」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4501", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 21, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「然后就看她向校长办公室走去了，应该是有什么事吧……」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4502", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 22, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「什喵？！」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1699", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「校长办公室，难道说……」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是要去向校长报告说终止社团活动吗？", "text_idx": 277, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那就得赶紧阻止她了……", "text_idx": 278, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 26, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「新吾，该去校长办公室了」", "text_idx": 279, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1700", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好！」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 28, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「啊，等下……」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4503", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 29, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2440", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 30, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『纱纱，你知道吗？\\n　动物们是可以理解人类的话语的』", "text_idx": 286, "plain": "『纱纱，你知道吗？　动物们是可以理解人类的话语的』", "plain_idx": 287, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2441", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 31, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『虽然大家都对我说的话置之一笑……』", "text_idx": 289, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2442", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 32, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『不过我相信，只要好好看着它们的眼睛和它们说话，\\n　它们就能明白我们想要表达的意思』", "text_idx": 291, "plain": "『不过我相信，只要好好看着它们的眼睛和它们说话，　它们就能明白我们想要表达的意思』", "plain_idx": 292, "len": 43, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2443", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 33, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『所以，我……』", "text_idx": 294, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2444", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 34, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『我希望自己能够成为问心无愧直视它们眼睛的人』", "text_idx": 296, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2445", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 35, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "『如果现在对这里的一切熟视无睹，\\n　我想我肯定就无法成为那样的人了……』", "text_idx": 298, "plain": "『如果现在对这里的一切熟视无睹，　我想我肯定就无法成为那样的人了……』", "plain_idx": 299, "len": 37, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2446", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 36, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "『……你们说想要保护动物』", "text_idx": 302, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0650", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 37, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "『但你们之后会遇到怎样的困难呢』", "text_idx": 304, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0651", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 38, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "『……如果有一天，你也能这样和他人一起生活就好了』", "text_idx": 307, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0236", "char_id": "結子"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 39, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "『和你最重要的人』", "text_idx": 309, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0237", "char_id": "結子"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 40, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "『还有这些你最爱的孩子们一起……』", "text_idx": 311, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0238", "char_id": "結子"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 41, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2447", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 42, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「打扰了」", "text_idx": 314, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2448", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 43, "speaker": "兰华", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，好久不见了。有什么事吗？」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "rk0652", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 44, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2449", "char_id": "みう"}]}
