{"script": "scenario_airi_route02_12.txt", "scene": "*start", "row": 24, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是这样哦～」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag0594", "char_id": "アンジェ"}]}
