{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「呃……」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有种做父母的被孩子问小孩怎么出生的感觉。", "text_idx": 316, "plain": "有种做父母的被孩子问小孩怎么出生的感觉。", "plain_idx": 316, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
