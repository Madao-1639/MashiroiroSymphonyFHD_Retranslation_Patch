{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 85, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「所以，今晚一起睡」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3188", "char_id": "桜乃"}]}
