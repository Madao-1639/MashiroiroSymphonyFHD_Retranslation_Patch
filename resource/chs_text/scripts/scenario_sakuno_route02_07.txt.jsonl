{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「完美是指……」", "text_idx": 355, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 81, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「今天可以一起睡吗？」", "text_idx": 356, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3186", "char_id": "桜乃"}]}
