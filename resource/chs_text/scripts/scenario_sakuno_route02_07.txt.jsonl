{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 71, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我可以进来吗？」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3182", "char_id": "桜乃"}]}
