{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 74, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「打扰了」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3183", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃抱着枕头走进我房间。", "text_idx": 349, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 76, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3184", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她径直走向床边，把自己的枕头放在我旁边。", "text_idx": 351, "plain": "她径直走向床边，把自己的枕头放在我旁边。", "plain_idx": 351, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃同学，你这是在做什么？」", "text_idx": 352, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
