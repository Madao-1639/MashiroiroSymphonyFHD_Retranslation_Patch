{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 88, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这话应该是男生说的吧？」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
