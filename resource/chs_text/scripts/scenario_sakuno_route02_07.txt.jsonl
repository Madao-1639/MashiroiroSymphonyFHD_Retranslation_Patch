{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 112, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3200", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃沉默着，钻进我的被窝。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她就那样把身子埋在被子里。", "text_idx": 401, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只露出眼睛看着我。", "text_idx": 402, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……麻烦了。", "text_idx": 403, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不讨厌一起睡……不如说很开心。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我必须化身厉鬼——", "text_idx": 405, "plain": "所以我必须化身厉鬼——", "plain_idx": 405, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 119, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「这个季节被子很冷，我先暖一下」", "text_idx": 406, "plain": "「这个季节被子很冷，我先暖一下」", "plain_idx": 406, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3201", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看样子她不打算回去。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 121, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「洁净空气，暖床，而且是妹妹，还是恋人，血赚」", "text_idx": 409, "plain": "「洁净空气，暖床，而且是妹妹，还是恋人，血赚」", "plain_idx": 409, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3202", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她自然地笑了起来。", "text_idx": 411, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「知道了，我不会再说回去之类的话了」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 124, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「谢谢哥哥」", "text_idx": 413, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3203", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……熬夜纠结也没意义，今天就睡觉吧」", "text_idx": 415, "plain": "「……熬夜纠结也没意义，今天就睡觉吧」", "plain_idx": 415, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 126, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3204", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我关掉房间电灯，钻进被窝里。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 128, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「被窝还真给你暖好了，好暖和」", "text_idx": 419, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 129, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，不过我有点冷」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3205", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 130, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没问题吧？」", "text_idx": 422, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 131, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「有问题，所以要抱抱」", "text_idx": 423, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3206", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 132, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "说着，樱乃靠近我，把脸搭在我的胸上。", "text_idx": 425, "plain": "说着，樱乃靠近我，把脸搭在我的胸上。", "plain_idx": 425, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 133, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 134, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥好温暖」", "text_idx": 426, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3207", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 135, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "你这是想把我弄废啊？", "text_idx": 428, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 136, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "感受到樱乃的呼吸和温暖，我没法什么都不干就睡觉……", "text_idx": 429, "plain": "感受到樱乃的呼吸和温暖，我没法什么都不干就睡觉……", "plain_idx": 429, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 137, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在这个样子，我无法忽略樱乃身上那带有淡淡花香的味道。", "text_idx": 430, "plain": "现在这个样子，我无法忽略樱乃身上那带有淡淡花香的味道。", "plain_idx": 430, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 138, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「在哥哥这边很安心」", "text_idx": 431, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3208", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安心？」", "text_idx": 433, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 140, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「到处都是哥哥的味道」", "text_idx": 434, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3209", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 141, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我跟你想法一致」", "text_idx": 436, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 142, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「想法一致？」", "text_idx": 437, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3210", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也能闻到你的味道」", "text_idx": 439, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 144, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……要多闻闻吗？」", "text_idx": 440, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3211", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 145, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃靠得更近了。", "text_idx": 442, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 146, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "手腕感受到的柔软触感……毫无疑问，就是樱乃的胸部。", "text_idx": 443, "plain": "手腕感受到的柔软触感……毫无疑问，就是樱乃的胸部。", "plain_idx": 443, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 147, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 324, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身体不由得充满了力量。", "text_idx": 444, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还没戒色到这种状况都能平静下来。", "text_idx": 445, "plain": "我还没戒色到这种状况都能平静下来。", "plain_idx": 445, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃只是在撒娇。", "text_idx": 446, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 151, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "忍耐，忍耐。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "比起恋人，现在的我是哥哥。", "text_idx": 448, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 153, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「晚安」", "text_idx": 449, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3212", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 154, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，晚安」", "text_idx": 451, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 155, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "困意来袭，我睡下了。", "text_idx": 452, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 156, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥……睡了？」", "text_idx": 453, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3213", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 157, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是梦还是现实呢，远处似乎传来樱乃的声音，但我好困……", "text_idx": 455, "plain": "是梦还是现实呢，远处似乎传来樱乃的声音，但我好困……", "plain_idx": 455, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 158, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「晚安」", "text_idx": 449, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3214", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 159, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "伴随着嘴唇传来的温柔触感，我睡着了。", "text_idx": 457, "plain": "伴随着嘴唇传来的温柔触感，我睡着了。", "plain_idx": 457, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
