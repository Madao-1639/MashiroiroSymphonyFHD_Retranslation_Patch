{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 0, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「有点晚了，我要回去了」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5560", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学穿上外套站了起来。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「抱歉啊，假期还让你陪我们学习」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 3, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「没事，我今天有空，而且你们还请我吃了晚饭」", "text_idx": 237, "plain": "「没事，我今天有空，而且你们还请我吃了晚饭」", "plain_idx": 237, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5561", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 4, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理随时来都行」", "text_idx": 240, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3159", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃说得对」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 6, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谢谢你们，安洁要是也来就好了」", "text_idx": 243, "plain": "「谢谢你们，安洁要是也来就好了」", "plain_idx": 243, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5562", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「她有事也没办法，考试能顺利通过就行」", "text_idx": 245, "plain": "「她有事也没办法，考试能顺利通过就行」", "plain_idx": 245, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 8, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「没问题的，安洁是能干的女仆」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3160", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 9, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……有在努力就好」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5563", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在看远处，濑名同学在看远处！", "text_idx": 250, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是啊……」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 12, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「都坚持到最后了，继续努力吧」", "text_idx": 252, "plain": "「都坚持到最后了，继续努力吧」", "plain_idx": 252, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5564", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 13, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「明天休息，爱理住在我这也行的」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3161", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 14, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这个实在是打扰过头了」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5565", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 15, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我倒是希望这样……」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3162", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 16, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谢谢，但家里还有事要做，而且我不想打扰你们俩」", "text_idx": 260, "plain": "「谢谢，但家里还有事要做，而且我不想打扰你们俩」", "plain_idx": 260, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5566", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我可没这么想」", "text_idx": 262, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 18, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「你们俩不想要独处的时间吗？」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5567", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这个就……」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 20, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「没想到你会露出那种表情」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5568", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「本来家里就我们俩，你这样强调就有点……」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 22, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我不阻止你们交往，但还是避免发生责任问题吧」", "text_idx": 269, "plain": "「我不阻止你们交往，但还是避免发生责任问题吧」", "plain_idx": 269, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5569", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我知道的，两人独处也不会做那种事的」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 24, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……是吗？」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5570", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 25, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……不会做的」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3163", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 26, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哦，还没做啊……」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5571", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 27, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「两个人做没意思，爱理住下就可以三个人一起做了」", "text_idx": 278, "plain": "「两个人做没意思，爱理住下就可以三个人一起做了」", "plain_idx": 278, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3164", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 28, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「三个人一起做什么？」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5572", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 29, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……不是打牌吗？」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3165", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 30, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生……你觉得她是认真的吗？」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5573", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「大概」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 32, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……？」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3166", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃歪着头。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 34, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「难道跟我想的不一样？」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3167", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 35, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「什——呃」", "text_idx": 292, "plain": "「什——呃」", "plain_idx": 292, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5574", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不好意思，濑名同学。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的妹妹啊，一般来说刚才那对话肯定是想别的事啊？", "text_idx": 295, "plain": "我的妹妹啊，一般来说刚才那对话肯定是想别的事啊？", "plain_idx": 295, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 38, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「要做什么？」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3168", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃一脸感兴趣的表情，靠近濑名同学。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 40, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这、这种事瓜生更了解」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5575", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 41, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「那就拜拜，我要回去了！」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5576", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "光速说完这些，濑名同学回去了。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 43, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……哥哥」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3169", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我觉得有些事还是不知道更好」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 45, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哼，只有我被排除在外」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3170", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那倒不是……」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 47, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那能告诉我吗？」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3171", "char_id": "桜乃"}]}
