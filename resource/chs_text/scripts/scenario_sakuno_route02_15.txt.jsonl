{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「感觉传闻真的消失了啊」", "text_idx": 184, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 1, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯。好像突然之间就没人关心了」", "text_idx": 186, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3837", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「要是就这样持续到毕业典礼就好了……」", "text_idx": 188, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 3, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「流言蜚语也就750天」", "text_idx": 189, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3838", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「要真这样，这流言蜚语没准得传到你毕业那天咯？」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 5, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那就7.5天」", "text_idx": 192, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3839", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……这次还真差不多」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 7, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「太好了。我讨厌哥哥被恶言相向……」", "text_idx": 195, "plain": "「太好了。我讨厌哥哥被恶言相向……」", "plain_idx": 195, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3840", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也是，听不得你被恶言相向」", "text_idx": 197, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 9, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「总之暂且安心了？」", "text_idx": 198, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3841", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「还是切忌粗心大意啊。\\n　不过多少也可以安心一点了吧」", "text_idx": 200, "plain": "「还是切忌粗心大意啊。　不过多少也可以安心一点了吧」", "plain_idx": 201, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 11, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……那么，再稍微开始撒点娇也没问题了吧」", "text_idx": 202, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3842", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎……？」", "text_idx": 204, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "原来之前没有撒娇啊。", "text_idx": 205, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 14, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……不可以吗？」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3843", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「可以啊。不过，要是再出了什么事就麻烦了，\\n　那就只在家里撒娇吧？」", "text_idx": 208, "plain": "「可以啊。不过，要是再出了什么事就麻烦了，　那就只在家里撒娇吧？」", "plain_idx": 209, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 16, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯，暂且忍一下就只在家里」", "text_idx": 210, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3844", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 17, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那我可以撒娇了吗？」", "text_idx": 212, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3845", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，来吧」", "text_idx": 214, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 19, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「失礼了」", "text_idx": 215, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3846", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃坐上我的膝盖，\\n把身体倚了过来。", "text_idx": 217, "plain": "樱乃坐上我的膝盖，把身体倚了过来。", "plain_idx": 218, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 21, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「和哥哥粘在一起就很安心」", "text_idx": 219, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3847", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 22, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「摸摸我的头发」", "text_idx": 221, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3848", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好——」", "text_idx": 223, "plain": "「好——」", "plain_idx": 223, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「来电话了。抱歉，等我一下」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我拿出手机一看，发现来电的是隼太。", "text_idx": 225, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有什么事吗？", "text_idx": 226, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「喂」", "text_idx": 227, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 28, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『在你和小樱卿卿我我的时候打扰真抱歉啊』", "text_idx": 228, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1211", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……？！为、为什么你会知道啊？」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 30, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『……抱歉。真的是啊。那我之后再打给你？』", "text_idx": 231, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1212", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……你说得这么自然，我还真上钩了」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没事的，所以，是什么事？」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 33, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『好像打扰到你们了，那我就简短地说了啊。\\n　各务台的男生正在找人聚一块准备开个安慰会』", "text_idx": 235, "plain": "『好像打扰到你们了，那我就简短地说了啊。　各务台的男生正在找人聚一块准备开个安慰会』", "plain_idx": 236, "len": 44, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1213", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「关于废止临时并校这件事？」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 35, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『唉，是这回事啦。你如果在和小樱在一起，\\n　就不勉强你参加了……怎么说？』", "text_idx": 239, "plain": "『唉，是这回事啦。你如果在和小樱在一起，　就不勉强你参加了……怎么说？』", "plain_idx": 240, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1214", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这样啊。机会难得，\\n　我也稍微露个脸吧」", "text_idx": 242, "plain": "「这样啊。机会难得，　我也稍微露个脸吧」", "plain_idx": 243, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 37, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "『抱歉啊』", "text_idx": 244, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1215", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没事。那我马上就去准备」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "得知集合的地点和时间后，我挂断电话。", "text_idx": 247, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 40, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……要出门去哪里？」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3849", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「和隼太他们聚，说是废止并校的安慰会」", "text_idx": 250, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 42, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3850", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她把我抱紧后把脸埋在我的胸前，\\n咕噜咕噜地左右摇着头。", "text_idx": 253, "plain": "她把我抱紧后把脸埋在我的胸前，咕噜咕噜地左右摇着头。", "plain_idx": 254, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃？」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 45, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……补充了哥哥能量，稍微分开一下也没问题」", "text_idx": 256, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3851", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……抱歉。我不会回家太晚的」", "text_idx": 258, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 47, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3852", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「晚饭，也许会赶不上，\\n　你就先自己吃吧」", "text_idx": 261, "plain": "「晚饭，也许会赶不上，　你就先自己吃吧」", "plain_idx": 262, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 49, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「知道了」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3853", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我就先出门了。\\n　有什么事的话，就给我打电话」", "text_idx": 265, "plain": "「那我就先出门了。　有什么事的话，就给我打电话」", "plain_idx": 266, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 51, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「有必要的话，一分钟会打十次左右的」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3854", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……呃，我会好好接的，所以打一次就行了」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 53, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「开玩笑的」", "text_idx": 270, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3855", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「也是啊。\\n　你从来都没有做出过这样的事呢」", "text_idx": 272, "plain": "「也是啊。　你从来都没有做出过这样的事呢」", "plain_idx": 273, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 55, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「真的有困难的时候会打电话的」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3856", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那么，我先出门了」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 57, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「一路顺风」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3857", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……稍微有些晚了啊。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃，还在等着我啊。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我回来了。对不起回来晚……哎呀？」", "text_idx": 281, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……樱乃？」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 62, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「呼呜……呼呜……」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3858", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我一进客厅，\\n就看见樱乃趴在桌子上，发出平缓的呼吸声。", "text_idx": 285, "plain": "我一进客厅，就看见樱乃趴在桌子上，发出平缓的呼吸声。", "plain_idx": 286, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在桌子上，准备了一些小吃。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还在等我回来吗……", "text_idx": 288, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来我做了不好的事情啊。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，这样子睡在这里可是会感冒的」", "text_idx": 290, "plain": "「樱乃，这样子睡在这里可是会感冒的」", "plain_idx": 290, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把手轻轻地放在她的肩上，微微摇动她的身体。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 69, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「唔……嗯……哥哥……」", "text_idx": 292, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3859", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃？」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我靠近看了看她的脸。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 72, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯……」", "text_idx": 295, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3860", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来还睡得迷迷糊糊的啊。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「话说回来……」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "总感觉，她眉头正皱着。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "也许是做了个不怎么好的梦。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 77, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥哥……等等……不要走……」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3861", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哎？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 79, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3862", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽说不用回答梦话……", "text_idx": 306, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没事的。我在这里」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我抚起了她挂在额头的发丝。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后把手放在她的头上慢慢地梳起头发。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 84, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「唔……唔……」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3863", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，我就在这里。一直都会和你在一起的」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 86, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「……嗯，唔……呼呜……」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3864", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她皱着的眉头舒展开来。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来是有了效果啊。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 89, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「呼呜……呼呜……」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3865", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好像睡得很香。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 91, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也稍微萌生了些捉弄的心思。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃，再睡下去小心感冒哦？」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我边说着，边轻轻地戳了戳她的脸颊。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 95, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3866", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "弹嫩柔软的触感让人心情愉快。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我又试着轻轻捏了捏。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 98, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「唔、嗯……」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3867", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "再试着用手指悄悄抚摸一下。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 100, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「唔、呼……唔嗯……」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3868", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃……」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然不忍心让她起来……", "text_idx": 331, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「樱乃……樱乃，起来了」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 104, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯……唔嗯……」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3869", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "微微张开的嘴唇。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 107, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "长长的睫毛。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "轻微起伏的纤细肩膀。", "text_idx": 337, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "落在脸颊上的柔软发丝。", "text_idx": 338, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "睡颜也……相当可爱。", "text_idx": 339, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
