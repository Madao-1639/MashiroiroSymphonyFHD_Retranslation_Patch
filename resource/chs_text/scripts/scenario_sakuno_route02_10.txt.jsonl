{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 89, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，不过爱理老师在更好」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3450", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 90, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我倒不是这个意思……」", "text_idx": 380, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5585", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 91, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我们决定考试期间只关注复习」", "text_idx": 382, "plain": "「我们决定考试期间只关注复习」", "plain_idx": 382, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 92, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是这样啊」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5586", "char_id": "愛理"}]}
