{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 60, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「你也别太嘴硬了啊！」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2202", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 61, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「有自信是好事，但是别过头了」", "text_idx": 327, "plain": "「有自信是好事，但是别过头了」", "plain_idx": 327, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5578", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 62, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「为什么？」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2203", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 63, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「你这么大声音会给人添麻烦的」", "text_idx": 331, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5579", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 64, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「生……生在这个世上真是抱歉啊」", "text_idx": 333, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2204", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 65, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「纱凪先说了」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3445", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 66, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「不过她有干劲倒是好事」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5580", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「濑名同学考得怎么样？」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 68, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「和以前一样」", "text_idx": 340, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5580b", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 69, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「能干之人的从容！」", "text_idx": 342, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2205", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 70, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「瓜生，你再怎么努力也比不过爱理的！」", "text_idx": 344, "plain": "「瓜生，你再怎么努力也比不过爱理的！」", "plain_idx": 344, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2206", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 71, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「变成了借爱理之威的纱凪同学」", "text_idx": 346, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3446", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 72, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「真是的……比起结果，考试更看重的是你做了什么」", "text_idx": 348, "plain": "「真是的……比起结果，考试更看重的是你做了什么」", "plain_idx": 348, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5581", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学一脸呆住的表情，说道。", "text_idx": 350, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 74, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「爱理，这是能干之人的言论」", "text_idx": 351, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2207", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 75, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「我觉得小乾也是能干的人」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1156", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 76, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「为了追赶美羽学姐，我可不会在这时候停下！」", "text_idx": 355, "plain": "「为了追赶美羽学姐，我可不会在这时候停下！」", "plain_idx": 355, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2208", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 77, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「所以我不能输给瓜生，为了展示实力，我要战胜他，让他臣服于我」", "text_idx": 357, "plain": "「所以我不能输给瓜生，为了展示实力，我要战胜他，让他臣服于我」", "plain_idx": 357, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn2209", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 78, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「……我现在好像能理解一部分小乾的思考模式了」", "text_idx": 359, "plain": "「……我现在好像能理解一部分小乾的思考模式了」", "plain_idx": 359, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1157", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，确实」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "比如说，手段不知道什么时候就变成了目的。", "text_idx": 362, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 81, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「抱歉，今天我要先走了」", "text_idx": 363, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1158", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我们也走吧」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 83, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理也一起回去吧」", "text_idx": 366, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3447", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 84, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是呢」", "text_idx": 368, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5582", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 85, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「今天也一起复习吧？」", "text_idx": 370, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3448", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 86, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「不会打扰你们吗？」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5583", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_10.txt", "scene": "*start", "row": 87, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「打扰？」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3449", "char_id": "桜乃"}]}
