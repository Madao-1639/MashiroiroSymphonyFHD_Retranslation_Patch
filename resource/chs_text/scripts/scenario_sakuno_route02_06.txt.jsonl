{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 0, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生」", "text_idx": 191, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5527", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还在做回家的准备，这时濑名同学走到我旁边。", "text_idx": 193, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「你今天能来吗？」", "text_idx": 194, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 3, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我是这么打算的」", "text_idx": 195, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5528", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好的，能稍微等一下吗，马上弄好」", "text_idx": 197, "plain": "「好的，能稍微等一下吗，马上弄好」", "plain_idx": 197, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 5, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「不用急」", "text_idx": 198, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5529", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 6, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「我可能也要稍微晚点再去你家那边」", "text_idx": 200, "plain": "「我可能也要稍微晚点再去你家那边」", "plain_idx": 200, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5530", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「有什么事吗？」", "text_idx": 202, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 8, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「嗯，刚才校长叫我过去一趟」", "text_idx": 203, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5531", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好像有点不开心。", "text_idx": 205, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是那件事吗？」", "text_idx": 206, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "废止并校的传闻还在扩散。", "text_idx": 207, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 12, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「就是这样，可事到如今该我做的和我能做到的我都做完了，\\n　只是姑且还是得去汇报一下」", "text_idx": 208, "plain": "「就是这样，可事到如今该我做的和我能做到的我都做完了，　只是姑且还是得去汇报一下」", "plain_idx": 209, "len": 43, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5532", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 13, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「久等了，濑名同学」", "text_idx": 211, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1143", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「隼太也在啊，我是不是一起去更好？」", "text_idx": 214, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 15, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「今天只是报告而已，你不来也行」", "text_idx": 215, "plain": "「今天只是报告而已，你不来也行」", "plain_idx": 215, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1144", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「好，有事打电话」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 17, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「嗯，那拜拜」", "text_idx": 218, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht1145", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 18, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「拜拜，瓜生」", "text_idx": 220, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5533", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊、嗯」", "text_idx": 222, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我目送他人离开教室。", "text_idx": 223, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……」", "text_idx": 224, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 22, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「哥」", "text_idx": 226, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3142", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃来到我的教室。", "text_idx": 228, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「校长好像找濑名同学有事」", "text_idx": 229, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 25, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，她短信发我了」", "text_idx": 230, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3143", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……不愧是她，毫无漏洞」", "text_idx": 232, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 27, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「所以我打算今天先回去」", "text_idx": 233, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3144", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，也是，那就走吧」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 29, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理，欢迎」", "text_idx": 236, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3145", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 30, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「打扰了」", "text_idx": 238, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5534", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 31, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「要先吃饭？先洗澡？还是说先——」", "text_idx": 240, "plain": "「要先吃饭？先洗澡？还是说先——」", "plain_idx": 240, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3146", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 32, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「当然是复习」", "text_idx": 242, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5535", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 33, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「啊呜……不愧是爱理，轻松化解」", "text_idx": 244, "plain": "「啊呜……不愧是爱理，轻松化解」", "plain_idx": 244, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3147", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 34, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「那是自然，我可不是来玩的」", "text_idx": 246, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5536", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「欢迎，来得有点快啊」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 36, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是啊」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5537", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就那一瞬间，她的表情有些许痛苦。", "text_idx": 251, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好像发生了什么。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽说有点在意，但现在樱乃还在这儿。", "text_idx": 253, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那今天就拜托了」", "text_idx": 254, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 41, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那就拜托了，爱理老师的私教课」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3148", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 42, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「别这样，你这话听着好邪恶」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5538", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 43, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理是喝红茶吗？」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3149", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 44, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「可以的，谢了」", "text_idx": 261, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5539", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从樱乃那里接过杯子，爱理稍微喝了一点后叹了一口气。", "text_idx": 263, "plain": "从樱乃那里接过杯子，爱理稍微喝了一点后叹了一口气。", "plain_idx": 263, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 46, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「当老师很累吗？」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3150", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 47, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「啊，不，不是这个原因」", "text_idx": 266, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5540", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「难道说那件事有什么变化？」", "text_idx": 268, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 49, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「有一点，然后还有其他的事」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5541", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放好杯子后，樱乃和我对视。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 51, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「那件事？」", "text_idx": 272, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3151", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 52, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「因为流言早就传开了，所以我也直说了，就是废止并校的事情」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5542", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 53, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯，我也听说了，说是并校要废止了」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3152", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 54, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是呢，这种事总是传得很快」", "text_idx": 278, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5543", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「有什么新变化吗？」", "text_idx": 280, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 56, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谁知道呢，她什么都没告诉我，可能是没变化吧」", "text_idx": 281, "plain": "「谁知道呢，她什么都没告诉我，可能是没变化吧」", "plain_idx": 281, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5544", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那濑名同学叹气，是因为刚才说的那一点“其他的事”？」", "text_idx": 283, "plain": "「那濑名同学叹气，是因为刚才说的那一点“其他的事”？」", "plain_idx": 283, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 58, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5545", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 59, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「说是叫我有空的时候要注意那些被传闻冲昏了脑袋的人，\\n　他们实在有点让人看不下去」", "text_idx": 286, "plain": "「说是叫我有空的时候要注意那些被传闻冲昏了脑袋的人，　他们实在有点让人看不下去」", "plain_idx": 287, "len": 42, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5546", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这是校长说的吗？」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 61, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是那些死板的老师」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5547", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 62, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「校长她本来就不在意这些，非要说的话对于这些东西她还挺支持那些的……」", "text_idx": 292, "plain": "「校长她本来就不在意这些，非要说的话对于这些东西她还挺支持那些的……」", "plain_idx": 292, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5548", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这个成问题了吗？」", "text_idx": 294, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 64, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「问题倒算不上，只是有老师说这事儿影响风纪，借题发挥大做文章」", "text_idx": 295, "plain": "「问题倒算不上，只是有老师说这事儿影响风纪，借题发挥大做文章」", "plain_idx": 295, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5549", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「毕竟结女是历史悠久的女校」", "text_idx": 297, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「对于以前就在这里的老师们来说，\\n　合并带来的问题更多吧」", "text_idx": 298, "plain": "「对于以前就在这里的老师们来说，　合并带来的问题更多吧」", "plain_idx": 299, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 67, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是啊，最开始我也是这么想的」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5550", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 68, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「当时爱理对哥那态度，冷得像个大冰块」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3153", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 69, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「那个……确实是我不对」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5551", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没事的，我觉得当时你那反应很正常」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 71, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……如果不是你，我现在可能也还是那个态度呢」", "text_idx": 307, "plain": "「……如果不是你，我现在可能也还是那个态度呢」", "plain_idx": 307, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5552", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 72, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理现在已经被融化了？」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3154", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 73, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「你这说法也太……至少用和解这词吧」", "text_idx": 311, "plain": "「你这说法也太……至少用和解这词吧」", "plain_idx": 311, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5553", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 74, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「好像没怎么融化呀」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3155", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 75, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「就这样吧，化掉了那才要不得」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5554", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学开心地笑着。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 77, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谢谢招待，很好喝」", "text_idx": 318, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5555", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学放好空杯子。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 79, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「要再来一杯吗？」", "text_idx": 321, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3156", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 80, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「谢谢，不用了，时间还有一些」", "text_idx": 323, "plain": "「谢谢，不用了，时间还有一些」", "plain_idx": 323, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5556", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 81, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「还有时间的话，不就正好再来一杯？」", "text_idx": 325, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3157", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 82, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，你忘了我来这里做什么的吗？」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5557", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学笑着说道。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 84, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「那就再努力学习一会吧」", "text_idx": 330, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5558", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 85, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理老师的“补习班”」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk3158", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 86, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「所以别用那种糟糕的说法呀！」", "text_idx": 334, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar5559", "char_id": "愛理"}]}
