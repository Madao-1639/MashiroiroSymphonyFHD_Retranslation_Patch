{"script": "scenario_airi_route02_11.txt", "scene": "*start", "row": 45, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「！！！……」", "text_idx": 286, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3166", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_11.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "曾几何时，有着无与伦比人望的爱理——", "text_idx": 288, "plain": "曾几何时，有着无与伦比人望的爱理——", "plain_idx": 288, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
