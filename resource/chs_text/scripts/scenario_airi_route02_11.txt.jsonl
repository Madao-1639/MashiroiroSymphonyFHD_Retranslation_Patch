{"script": "scenario_airi_route02_11.txt", "scene": "*start", "row": 29, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「等下……搞什么啊」", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar3161", "char_id": "愛理"}]}
