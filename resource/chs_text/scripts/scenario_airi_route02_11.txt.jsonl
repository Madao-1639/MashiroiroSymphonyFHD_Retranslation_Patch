{"script": "scenario_airi_route02_11.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理一脸的不可思议。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_11.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也是多少有些不知所措。", "text_idx": 247, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
