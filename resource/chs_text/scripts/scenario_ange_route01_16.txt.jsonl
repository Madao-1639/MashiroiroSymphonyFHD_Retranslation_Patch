{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……呜哇，你们都看到了？！」", "text_idx": 411, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 114, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「被喂了一嘴狗粮，真心的」", "text_idx": 412, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4012", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 115, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「而且这种状况以后还会更加严重，想想就可怕！」", "text_idx": 414, "plain": "「而且这种状况以后还会更加严重，想想就可怕！」", "plain_idx": 414, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0327", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 116, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「太危险了，得要赶快隔离」", "text_idx": 416, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4013", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 117, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「话说，已经没事了吧？瓜生」", "text_idx": 418, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4014", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……还有一件事」", "text_idx": 420, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 119, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「是什么」", "text_idx": 421, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4015", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我好像真的喜欢安洁」", "text_idx": 423, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 121, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「这种事情，一目了然啦」", "text_idx": 424, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4016", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 122, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈……嗯，抱歉」", "text_idx": 426, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我们走吧」", "text_idx": 427, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 124, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 428, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4017", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 125, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「好～咧」", "text_idx": 430, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0328", "char_id": "隼太"}]}
