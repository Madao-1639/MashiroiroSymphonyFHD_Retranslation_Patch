{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「早啊～」", "text_idx": 235, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 1, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「大家，早上好！」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1606", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们两人一起走进教室。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 3, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，早上好♪」", "text_idx": 241, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4003", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔……！」", "text_idx": 243, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "迎接我们的，是已经聚集完毕的朋友们。", "text_idx": 244, "plain": "迎接我们的，是已经聚集完毕的朋友们。", "plain_idx": 244, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 6, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「大、大家都在呢～……」", "text_idx": 245, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1607", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 7, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「我从昨天开始就和爱理在一起」", "text_idx": 248, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0908", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 8, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「原来如此，同床共寝了呢」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1608", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 9, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哎，别用那种会让人误会的说法啊！」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4004", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 10, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「总、总之呢……我们从樱乃那里大概听说了一些事情，所以大家就不假思索地在这儿等着你们了」", "text_idx": 255, "plain": "「总、总之呢……我们从樱乃那里大概听说了一些事情，所以大家就不假思索地在这儿等着你们了」", "plain_idx": 255, "len": 44, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4005", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 11, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「话说，你们也是一起过来的？」", "text_idx": 257, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0324", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊啊，嗯……」", "text_idx": 259, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 13, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「诶嘿……」", "text_idx": 260, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1609", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们各自露出了羞涩的笑容。", "text_idx": 262, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我们是一起从校门走到教室来的」", "text_idx": 263, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 16, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是少爷邀请我的……」", "text_idx": 264, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1610", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 17, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「咦？你们就把其他上学的学生们放在一边了吗？」", "text_idx": 267, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0408", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「因为……」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我强忍着羞意说道。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安洁，是我的女仆呀」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我没有多说什么。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但一切尽在不言中。", "text_idx": 273, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们既是互相爱慕的男女——同时也是“少爷和女仆”。", "text_idx": 274, "plain": "我们既是互相爱慕的男女——同时也是“少爷和女仆”。", "plain_idx": 274, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这就是我们想要的理想状态，因为昨天，我们彼此袒露肌肤，并互相确认过了。", "text_idx": 275, "plain": "这就是我们想要的理想状态，因为昨天，我们彼此袒露肌肤，并互相确认过了。", "plain_idx": 275, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「就是这样，哈哈」", "text_idx": 276, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 26, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……♪」", "text_idx": 277, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0409", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽学姐莞然一笑。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家各自也露出了微笑。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然也有人在抓狂。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不、不过，你们从樱乃那里听到了多少？」", "text_idx": 282, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 31, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「呵呵……这个嘛」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4006", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 32, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「就是，你们已经成为了一对与众不同的情侣」", "text_idx": 285, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4007", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 33, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「噫、噫呜噫呜，爱理同学……！」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1611", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 34, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，我说得不对吗？」", "text_idx": 289, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4008", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 35, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「请不要捉弄我……」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1612", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对于濑名同学善意的调侃，安洁满脸通红，低下了头。", "text_idx": 293, "plain": "对于濑名同学善意的调侃，安洁满脸通红，低下了头。", "plain_idx": 293, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个反应才是最好的肯定。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家突然热烈地欢笑起来。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 39, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "「啊哈哈哈，哟！真佩服你啊，少爷～！」", "text_idx": 296, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ht0325", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不，就是……既然大家都聚在这里了，我也只好豁出去了……」", "text_idx": 298, "plain": "「不，就是……既然大家都聚在这里了，我也只好豁出去了……」", "plain_idx": 298, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 41, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「少、少爷，您又多心了……」", "text_idx": 299, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1613", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「不行吗？」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 43, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「……真是的，拿您没办法，少爷」", "text_idx": 302, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1614", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 44, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「看来不能没有安洁在您身边呢」", "text_idx": 304, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1615", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「是啊，可不是嘛」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 46, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「唔唔……你们……」", "text_idx": 307, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4009", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 47, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「已经像是夫妻俩了」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk0909", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 48, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「呼诶诶？！请、请不要这样……！！」", "text_idx": 311, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1616", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 49, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「瓜生看似在顾虑周围的气氛，但其实在很轻松地应对呢……」", "text_idx": 313, "plain": "「瓜生看似在顾虑周围的气氛，但其实在很轻松地应对呢……」", "plain_idx": 313, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4010", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 50, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是的！安洁的心都跳起来了！」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1617", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 51, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呵呵～这就是情人眼里出西施呢～」", "text_idx": 317, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu0410", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 52, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「啊啊，已经无法挽回了……」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0355", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 53, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「那么，安洁？！难道他已经对你下手了吗？！不仅是内心，就连身体也无法挽回了吗？！」", "text_idx": 323, "plain": "「那么，安洁？！难道他已经对你下手了吗？！不仅是内心，就连身体也无法挽回了吗？！」", "plain_idx": 323, "len": 41, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn0356", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 54, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「才才才才才才没有呀！当然没有啊！」", "text_idx": 325, "plain": "「才才才才才才没有呀！当然没有啊！」", "plain_idx": 325, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1618", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哈哈……」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我将手放在安洁的头上。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 57, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1619", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁的脸颊瞬间涨红。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「所以说……」", "text_idx": 332, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我就这样看着周围的所有人。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我现在真的一定很放松吧。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过——这也是因为和安洁在一起。", "text_idx": 335, "plain": "不过——这也是因为和安洁在一起。", "plain_idx": 335, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为我想和安洁依偎在一起，所以与以前的情况不同是理所当然的。", "text_idx": 336, "plain": "因为我想和安洁依偎在一起，所以与以前的情况不同是理所当然的。", "plain_idx": 336, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "带着这样的豁然开朗，我害羞但又自豪地说。", "text_idx": 337, "plain": "带着这样的豁然开朗，我害羞但又自豪地说。", "plain_idx": 337, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我感觉，自己终于成为了，真正意义上的“少爷”」", "text_idx": 338, "plain": "「我感觉，自己终于成为了，真正意义上的“少爷”」", "plain_idx": 338, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 66, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 339, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1620", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 67, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「安洁也感觉，自己终于成为了一名真正的女仆……少爷……」", "text_idx": 341, "plain": "「安洁也感觉，自己终于成为了一名真正的女仆……少爷……」", "plain_idx": 341, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1621", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 68, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……这样啊」", "text_idx": 343, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4011", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "以濑名同学为代表，大家都露出了笑容——", "text_idx": 345, "plain": "以濑名同学为代表，大家都露出了笑容——", "plain_idx": 345, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 70, "speaker": "各务台校男生A", "flag": 64, "pages": [{"page": 0, "text": "「话说……」", "text_idx": 347, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "da0045", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 71, "speaker": "结女校学生C", "flag": 64, "pages": [{"page": 0, "text": "「这种肉麻的剧场要持续到什么时候啊——？！」", "text_idx": 350, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "jc0054", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "教室里的其他同学们，表示了自己的强烈不满，虽说会有这种反应挺正常的。", "text_idx": 352, "plain": "教室里的其他同学们，表示了自己的强烈不满，虽说会有这种反应挺正常的。", "plain_idx": 352, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……觉得就算这样也无所谓，我现在，真的很放松。", "text_idx": 353, "plain": "……觉得就算这样也无所谓，我现在，真的很放松。", "plain_idx": 353, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 74, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「诶嘿嘿」", "text_idx": 354, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1622", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁的脸上，洋溢着喜悦的笑容。", "text_idx": 356, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "于是，放学后。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 77, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「那么少爷，安洁去做学校的工作了」", "text_idx": 358, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1623", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，加油哦」", "text_idx": 360, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 79, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「嘿嘿……」", "text_idx": 361, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1624", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 80, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「今天可能没法为您送行了，请您一路小心，平安回到家中」", "text_idx": 363, "plain": "「今天可能没法为您送行了，请您一路小心，平安回到家中」", "plain_idx": 363, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1625", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 81, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「……安洁无论何时，都在为您的平安祈福」", "text_idx": 365, "plain": "「……安洁无论何时，都在为您的平安祈福」", "plain_idx": 365, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1626", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我也是。\\n　……安洁，到我这边来一下」", "text_idx": 367, "plain": "「我也是。　……安洁，到我这边来一下」", "plain_idx": 368, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 83, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「好的……」", "text_idx": 369, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1627", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「摸摸头摸摸头～」", "text_idx": 371, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 85, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「呼哇哇～……好温暖～……」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1628", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 86, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「那、那个少爷，虽然安洁感觉很舒服，但安洁并没有做任何值得表扬的事情……」", "text_idx": 374, "plain": "「那、那个少爷，虽然安洁感觉很舒服，但安洁并没有做任何值得表扬的事情……」", "plain_idx": 374, "len": 37, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1629", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。但是，我就是想要给你摸摸头」", "text_idx": 376, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 88, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「啊……」", "text_idx": 329, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1630", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……因为安洁很可爱啊」", "text_idx": 378, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 90, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「呜～～」", "text_idx": 379, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1631", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 91, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯～？」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 92, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「心里的小鹿在乱撞～……嗯嗯，少爷，少爷，少爷……」", "text_idx": 382, "plain": "「心里的小鹿在乱撞～……嗯嗯，少爷，少爷，少爷……」", "plain_idx": 382, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1632", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「安洁非常值得被抚摸哦」", "text_idx": 384, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 94, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「谢谢您……」", "text_idx": 385, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1633", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 95, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「那个，那个，少爷……？」", "text_idx": 387, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1634", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，什么？」", "text_idx": 389, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 97, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「安洁，是属于少爷的……嘿嘿」", "text_idx": 390, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1635", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我也是」", "text_idx": 392, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「我是喜欢安洁的，安洁的少爷」", "text_idx": 393, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最后抚摸一次后，我放开了手，然后凝视她的眼睛。", "text_idx": 394, "plain": "最后抚摸一次后，我放开了手，然后凝视她的眼睛。", "plain_idx": 394, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……我已经明白，这意味着什么了」", "text_idx": 395, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 102, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「嗯……少爷」", "text_idx": 396, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1636", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 103, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「是的，我的，少爷」", "text_idx": 398, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1637", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "像是在回味一般，安洁重述了一遍。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我喜笑颜开。", "text_idx": 401, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯，那，安洁，要加油哦」", "text_idx": 402, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 107, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「嗯！那么，我先告辞了。我走了，少爷！！」", "text_idx": 403, "plain": "「嗯！那么，我先告辞了。我走了，少爷！！」", "plain_idx": 403, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag1638", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "——我们彼此明白了，各自想要的是什么。", "text_idx": 405, "plain": "——我们彼此明白了，各自想要的是什么。", "plain_idx": 405, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们已经互相确认过，我们两人的感情紧密地交织在一起。", "text_idx": 406, "plain": "我们已经互相确认过，我们两人的感情紧密地交织在一起。", "plain_idx": 406, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我们和昨天不一样了。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 111, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因此，接下来——", "text_idx": 408, "plain": "因此，接下来——", "plain_idx": 408, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
