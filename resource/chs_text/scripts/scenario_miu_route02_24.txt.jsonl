{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 0, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……真厉害，还在变大」", "text_idx": 217, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2082", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 1, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呼呼，很痒吗？\\n　要变得更大哦，摸摸摸摸」", "text_idx": 219, "plain": "「呼呼，很痒吗？　要变得更大哦，摸摸摸摸」", "plain_idx": 220, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2083", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 2, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜～」", "text_idx": 223, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "pn0409", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 3, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「看来小熊喵有在好好吃饭呢，慢慢变大了～」", "text_idx": 225, "plain": "「看来小熊喵有在好好吃饭呢，慢慢变大了～」", "plain_idx": 225, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2084", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 4, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「哈啊啊啊……我也想像那样变大。特别是胸部，能变得像学姐一样大就好了」", "text_idx": 228, "plain": "「哈啊啊啊……我也想像那样变大。特别是胸部，能变得像学姐一样大就好了」", "plain_idx": 228, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1609", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 5, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「你在说什么蠢话啊。胸部之类的，现在这样就很够了好吧」", "text_idx": 231, "plain": "「你在说什么蠢话啊。胸部之类的，现在这样就很够了好吧」", "plain_idx": 231, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4465", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 6, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「爱理你是在向B罩杯的我挑战吗」", "text_idx": 234, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1610", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "居然有B吗。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 8, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「……新吾，你刚刚是在笑吧？」", "text_idx": 237, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1611", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没有没有，真没笑」", "text_idx": 239, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是用手捂了下嘴就怀疑到我头上了吗。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 11, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「那么那么，纱纱就由我安洁来摸摸吧，我摸我摸」", "text_idx": 242, "plain": "「那么那么，纱纱就由我安洁来摸摸吧，我摸我摸」", "plain_idx": 242, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3451", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 12, "speaker": "安洁", "flag": 64, "pages": [{"page": 0, "text": "「快快～变～大～吧～胸～部。B杯，快消失～」", "text_idx": 245, "plain": "「快快～变～大～吧～胸～部。B杯，快消失～」", "plain_idx": 245, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ag3452", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 13, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1612", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "怎么看都是反效果吧。", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 15, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「爱理也想被摸摸吗？」", "text_idx": 251, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1331", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 16, "speaker": "爱理", "flag": 64, "pages": [{"page": 0, "text": "「……别在问之前就出手啊」", "text_idx": 253, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "ar4466", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 17, "speaker": "樱乃", "flag": 64, "pages": [{"page": 0, "text": "「嗯」", "text_idx": 255, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sk1332", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "活动室里不知道为什么突然到处都开始抚摸起来了。", "text_idx": 257, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 19, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「小熊喵，就算你再怎么踩，我也不会出奶的啦」", "text_idx": 258, "plain": "「小熊喵，就算你再怎么踩，我也不会出奶的啦」", "plain_idx": 258, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2085", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 20, "speaker": "熊喵", "flag": 64, "pages": [{"page": 0, "text": "「溜～」", "text_idx": 223, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": "pn0410", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我会加油让学姐有出奶的一天的！", "text_idx": 261, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我暗自下定决心。", "text_idx": 262, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "说起来，被学姐抚摸的话，会露出不妙的表情。", "text_idx": 263, "plain": "说起来，被学姐抚摸的话，会露出不妙的表情。", "plain_idx": 263, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨天在学姐的房间里的时候，我也是那副不妙的表情。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 25, "speaker": "纱凪", "flag": 64, "pages": [{"page": 0, "text": "「为什么你这家伙从刚才开始就一直在笑？」", "text_idx": 265, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "sn1613", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为昨天我被学姐“用嘴巴打扫”了！", "text_idx": 267, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那肯定不敢在这说。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没什么，只是觉得现在真是和平」", "text_idx": 269, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我决定用这个没什么毛病的理由好好笑一下。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 30, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「哇，天色已经完全变暗了」", "text_idx": 271, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2086", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「今天也辛苦你了」", "text_idx": 273, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 32, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯，新吾也是～」", "text_idx": 274, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2087", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "白天总是没有两人独处的时机，不知不觉就到这个时间了。", "text_idx": 276, "plain": "白天总是没有两人独处的时机，不知不觉就到这个时间了。", "plain_idx": 276, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐在大家面前的时候还是那个可靠的社团长。", "text_idx": 277, "plain": "学姐在大家面前的时候还是那个可靠的社团长。", "plain_idx": 277, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只不过，只有我们两人的时候……", "text_idx": 278, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 36, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「新吾，大家在活动室里摸摸的时候是不是很开心～？」", "text_idx": 279, "plain": "「新吾，大家在活动室里摸摸的时候是不是很开心～？」", "plain_idx": 279, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2088", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就会变成只属于我的女朋友。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "作为男性，我对这种绝妙的切换是没有抵抗力的。", "text_idx": 282, "plain": "作为男性，我对这种绝妙的切换是没有抵抗力的。", "plain_idx": 282, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「没能被美羽学姐摸摸，我好寂寞」", "text_idx": 283, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 40, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「那现在就来摸摸你吧♪」", "text_idx": 284, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2089", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐伸了伸腰，朝我的头伸出手。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那我也来摸摸学姐吧」", "text_idx": 287, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 43, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「不要，新吾摸我头的时候一副老父亲的脸。绝对是把我当孩子了是吧～？」", "text_idx": 288, "plain": "「不要，新吾摸我头的时候一副老父亲的脸。绝对是把我当孩子了是吧～？」", "plain_idx": 288, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2090", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「那就来做只会对女朋友做的事吧」", "text_idx": 290, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 45, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「诶……」", "text_idx": 291, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2091", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 46, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯唔？！\\n　啾、嗯嗯，嗯……啾……嗯……哈啊……」", "text_idx": 293, "plain": "「嗯唔？！　啾、嗯嗯，嗯……啾……嗯……哈啊……」", "plain_idx": 294, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2092", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我趁学姐不注意亲了上去，脸和额头也都是我的印记。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后我们就这样一直看着彼此发呆。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 49, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……总感觉脸好烫」", "text_idx": 298, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2093", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「嗯。明明外面还很冷」", "text_idx": 300, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 51, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「那个，今天要顺路来我家吗？」", "text_idx": 301, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2094", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这样好吗？」", "text_idx": 303, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 53, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯。在活动室里没能好好摸摸新吾的份，在家里会好好摸回来的」", "text_idx": 304, "plain": "「嗯。在活动室里没能好好摸摸新吾的份，在家里会好好摸回来的」", "plain_idx": 304, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2095", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「唔……」", "text_idx": 306, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "难道是那种摸摸吗……", "text_idx": 307, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「学、学姐……」", "text_idx": 308, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「哇啊？！」", "text_idx": 309, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 58, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呼呼，今天也出来了好多……」", "text_idx": 310, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2096", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊……啊……」", "text_idx": 312, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 60, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「……新吾还要继续摸摸吗？」", "text_idx": 313, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2097", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「已、已经不行了……」", "text_idx": 315, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 62, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「那我来清理一下吧」", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2098", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 63, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「阿姆、啾，嗯嗯、啾，额、哈啊，啾、嗯，噗啾、嗯、啾……」", "text_idx": 318, "plain": "「阿姆、啾，嗯嗯、啾，额、哈啊，啾、嗯，噗啾、嗯、啾……」", "plain_idx": 318, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2099", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊啊，学姐……唔……」", "text_idx": 320, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐向上看着我，用刚学会不久的“清洁技术”打扫着我的那里。", "text_idx": 321, "plain": "学姐向上看着我，用刚学会不久的“清洁技术”打扫着我的那里。", "plain_idx": 321, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她那完全没有嫌弃的表情，让我确确实实地感受到了自己被爱着。", "text_idx": 322, "plain": "她那完全没有嫌弃的表情，让我确确实实地感受到了自己被爱着。", "plain_idx": 322, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果我是个女生的话，我想我是做不到像学姐一样的。", "text_idx": 323, "plain": "如果我是个女生的话，我想我是做不到像学姐一样的。", "plain_idx": 323, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 68, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「啊……还好吗？\\n　新吾的，又变大了……」", "text_idx": 324, "plain": "「啊……还好吗？　新吾的，又变大了……」", "plain_idx": 325, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2100", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「……学姐，可以和我接吻吗？」", "text_idx": 327, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 70, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「诶？但我刚刚，用嘴给你……嗯嗯？！」", "text_idx": 328, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2101", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 71, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯、啾，嗯嗯、哈啊、啾，嗯嗯、啾，啾、啾……」", "text_idx": 330, "plain": "「嗯、啾，嗯嗯、哈啊、啾，嗯嗯、啾，啾、啾……」", "plain_idx": 330, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2102", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对那个爱过我的肉棒的唇，我也爱得不行。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐她努力让我能变得舒服起来，我也是同样的想让她舒服。", "text_idx": 333, "plain": "学姐她努力让我能变得舒服起来，我也是同样的想让她舒服。", "plain_idx": 333, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后，随着我到了高潮，心情也愉快到了极限。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 75, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「呼呼。新吾的唇，真柔软♪」", "text_idx": 335, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2103", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「美羽学姐的才是」", "text_idx": 337, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 77, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「嗯、啾，嗯嗯、啾，嗯嗯……嗯……啾……」", "text_idx": 338, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2104", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们一边贪图着彼此的嘴唇，一边努力让对方染上彼此的气味。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐蓬松的头发包裹着我的脸，甘甜的气味充满了我的鼻腔。", "text_idx": 341, "plain": "学姐蓬松的头发包裹着我的脸，甘甜的气味充满了我的鼻腔。", "plain_idx": 341, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真不想回家，我想一直待在这里。", "text_idx": 342, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的香味就是这么危险的东西。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「学姐，不用送我了」", "text_idx": 344, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 83, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「但是天很黑我很担心。\\n　新吾这么可爱，说不定会被恐怖的女人袭击……」", "text_idx": 345, "plain": "「但是天很黑我很担心。　新吾这么可爱，说不定会被恐怖的女人袭击……」", "plain_idx": 346, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2105", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「这附近没有那么危险的人吧……」", "text_idx": 348, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 85, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「哎呀，新吾要回去了吗？\\n　我开车送你一下吧」", "text_idx": 350, "plain": "「哎呀，新吾要回去了吗？　我开车送你一下吧」", "plain_idx": 351, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0176", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 87, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「就是因为有这种危险的女人在，我才担心啦」", "text_idx": 353, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2106", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然出现的结子阿姨让我有些不知所措。", "text_idx": 355, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 89, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「最近总是只陪着美羽，\\n　也要好好爱着我这边哦……」", "text_idx": 356, "plain": "「最近总是只陪着美羽，　也要好好爱着我这边哦……」", "plain_idx": 357, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0177", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还突然就开始了禁断的出轨剧本。", "text_idx": 359, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 91, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「真是的，妈妈你在说些什么傻话。没看到新吾正困扰着吗」", "text_idx": 360, "plain": "「真是的，妈妈你在说些什么傻话。没看到新吾正困扰着吗」", "plain_idx": 360, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2107", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 92, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「可爱男孩子困扰着的样子可是人妻最喜欢的东西了♪」", "text_idx": 362, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0178", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 93, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2108", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 94, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「美羽你不也是喜欢着这样的新吾吗？」", "text_idx": 365, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0179", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 95, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「我、我那是……」", "text_idx": 367, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2109", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 96, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「女性呀，最喜欢让新吾这样认真的男孩子不知所措了♪」", "text_idx": 369, "plain": "「女性呀，最喜欢让新吾这样认真的男孩子不知所措了♪」", "plain_idx": 369, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0180", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 97, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「…………」", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2110", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 98, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「不好意思，新吾。我的女儿兴趣有些变态」", "text_idx": 372, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0181", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 99, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「诶诶，母亲好狡猾。明明是你自己说的——」", "text_idx": 374, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2111", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "变态的美羽学姐也挺好的，突然觉得会这么想的自己好悲哀。", "text_idx": 376, "plain": "变态的美羽学姐也挺好的，突然觉得会这么想的自己好悲哀。", "plain_idx": 376, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 101, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「妈妈你就是特意来捉弄我们的吗？」", "text_idx": 377, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2112", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 102, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「是有一点那样的想法，只不过主要是比较在意之前听到的熊喵的叫声」", "text_idx": 379, "plain": "「是有一点那样的想法，只不过主要是比较在意之前听到的熊喵的叫声」", "plain_idx": 379, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0182", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 103, "speaker": "结子", "flag": 64, "pages": [{"page": 0, "text": "「但看来是我的错觉……」", "text_idx": 381, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": "yk0183", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 104, "speaker": "美羽", "flag": 64, "pages": [{"page": 0, "text": "「小熊喵的？」", "text_idx": 383, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": "mu2113", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "「啊，这么说来我昨天在很晚的时候也有听到」", "text_idx": 385, "plain": "「啊，这么说来我昨天在很晚的时候也有听到」", "plain_idx": 385, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
