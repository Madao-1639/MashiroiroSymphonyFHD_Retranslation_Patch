{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，熊喵在这里啊？”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4467", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 1, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜？”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0411", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学走到暖炉旁取暖，手放在嘴边呵气。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了，濑名同学？”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“刚才，我在我家公寓附近看到这孩子，还以为它是去散步了。”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4468", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“刚才？熊喵一直都在社团教室里喔……”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嗯？那大概是我看错了……”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4469", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一开始说要当幽灵社员的濑名同学，现在只要有时间就会来社团露脸。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如今她也习惯熊喵了，还会主动开罐头给它吃。", "text_idx": 425, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "熊喵也跑到濑名同学脚边，露出肚子给她看。", "text_idx": 449, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没想到我能看见这一天到来呢……", "text_idx": 446, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 11, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呼，今天外面也好冷……”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3453", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“哇哇，熊喵小姐是学会瞬间移动的招式了吗？”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3454", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 13, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜噜？”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0412", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了，安洁？”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "比濑名同学更忙的安洁，现在也是有空就会来社团。", "text_idx": 445, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过她是什么意思呢？熊喵学会瞬间移动……", "text_idx": 414, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 17, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁刚才去各务台商场买东西，看到熊喵小姐慢吞吞地在走路呢！”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3455", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 18, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“没想到比起光速赶回来的安洁，熊喵小姐居然更早到社团了！”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3456", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然光速是夸张了点，不过这种奇怪的目击情报增加了啊……", "text_idx": 462, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“各务台商场？熊喵一直待在社团教室对吧？”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4470", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，没有错。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 22, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜～？”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0413", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都不禁歪着头思考。", "text_idx": 423, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 24, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……熊喵会分身术。”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1333", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 25, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“难道樱乃也在哪里看见熊喵了？”", "text_idx": 406, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4471", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 26, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“刚才迷路的时候，在山路。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1334", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“迷路的话应该打电话给我的啊。”", "text_idx": 397, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 28, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“樱乃是肯努力就办得到的孩子。”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1335", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 29, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“同样身为路痴，我有种输了的感觉……”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4472", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 30, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“只是随便走走而已。”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1336", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就是那样才危险。”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，又增加了新的目击情报。", "text_idx": 415, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这不是单纯看错就能解释的程度。", "text_idx": 463, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "也就是说……", "text_idx": 417, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 35, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喂、不得了了！妈妈喵、妈妈喵出现了！”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1614", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“冷静一点，纱凪。怎么了？”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4473", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 37, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我就说了，外面有妈妈喵出现了！”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1615", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“妈妈喵？”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一个没听过的专有名词。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 40, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“熊喵，高兴吧，找到你的妈妈了！”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1616", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 41, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜噜～？”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0414", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 42, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“熊喵的……”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1337", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“妈妈？”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4474", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“原来如此，像猫熊一样的猫的妈妈，所以叫做妈妈喵啊！”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3457", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "先不讨论纱凪的取名品味。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这是真的吗？”", "text_idx": 395, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 47, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我亲眼看到的！在我家附近，有一只体型较大的熊喵出现了。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1617", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但是，那也没办法确定是熊喵的母亲……”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 49, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“除此之外哪里还有那么罕见的生物啦！而且，它身边还有其他小熊喵。”", "text_idx": 405, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1618", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那或许是熊喵的姐弟也说不定。”", "text_idx": 403, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1619", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 51, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯……”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除非我自己也看到，不然有点难相信。", "text_idx": 465, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 53, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊……大家都来了啊，辛苦了～”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2145", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 54, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐，请听我说！我终于找到熊喵的母亲了！”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1620", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 55, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2146", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 56, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“还活着喔，熊喵的家人！它们没有死！”", "text_idx": 391, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1621", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 57, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2147", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 58, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～？”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0415", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这不是很好吗，熊喵。你的妈妈好像还活着喔。”", "text_idx": 393, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4475", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 60, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜！”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0416", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 61, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“这样熊喵就能再见到家人了呢！”", "text_idx": 396, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3458", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 62, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“安洁，想太远了。”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1338", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 63, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯，首先要找出妈妈喵的出没地点才行。”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1622", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 64, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2148", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐？”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……欸？”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2149", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 67, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊、什么？新吾君，怎么了吗？”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2150", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐没事吧？她好像很恍神……", "text_idx": 426, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 70, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那么接下来，就要启动熊喵作战了呢！”", "text_idx": 399, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3459", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 71, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“真没办法。我就在公寓附近找看看吧。”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 451, "voice": "ar4476", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 72, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我跟爱理一起去。”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 444, "voice": "sk1339", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 73, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁就以学校周边为主搜寻！”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 428, "voice": "ag3460", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 74, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那么，我就去找我家附近的森林。”", "text_idx": 400, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 456, "voice": "sn1623", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都各自说出自己搜寻的范围，离开了社团。", "text_idx": 424, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 76, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2151", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 77, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～噜～”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0417", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐？”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 79, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……小熊喵的妈妈，还活着啊。”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2152", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“虽然还无法确定，但可能性很高的样子。”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 81, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2153", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我感觉得到学姐很困惑。", "text_idx": 438, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "找到母亲的话，熊喵就能跟其他动物一样回归自然。", "text_idx": 440, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是对学姐来说，那不是简单的事。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "熊喵跟其他没有取名字的动物们不同。", "text_idx": 450, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们都把它当成家人一样相处。", "text_idx": 435, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 87, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵，你妈妈还活着喔。太好了呢。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2154", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 88, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜～？”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 448, "voice": "pn0418", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 89, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2155", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐没有继续说话，只是抱紧了熊喵……", "text_idx": 427, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天我来到学姐家，等她打工结束。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为熊喵的事，她看起来很没精神，但我只能担心地等待着。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 93, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊，原来是熊喵小姐的母亲。”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0186", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 94, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐听说了这件事后好像很困惑的样子。”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 95, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“我想也是。因为那孩子非常疼爱熊喵小姐……”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0187", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐没事吧？”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 97, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“没事的喔，因为有新吾同学在♪”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0188", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老实说，我不知道自己能为学姐做些什么事。", "text_idx": 460, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "应该和大家一起去找熊喵的母亲吗？我连这点判断都办不到。", "text_idx": 431, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 100, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“……以前，我跟新吾同学说过对吧？”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0189", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 101, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“美羽小时候，家里的小猫因为生病过世，之后她就害怕饲养生物……”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0190", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 102, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“说过。”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 103, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“我也是喔。小时候，老家养的猫……”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0191", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 104, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“那只猫自然衰老死亡的时候，我以为我再也不会养猫了。”", "text_idx": 401, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0192", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 105, "speaker": "ドモン", "flag": 64, "pages": [{"page": 0, "text": "“喵呜～”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "朵萌", "alt_speaker_idx": 442, "voice": "dm0006", "char_id": "ドモン"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 106, "speaker": "カリン", "flag": 64, "pages": [{"page": 0, "text": "“喵～”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "花铃", "alt_speaker_idx": 461, "voice": "kr0006", "char_id": "カリン"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 107, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“但是，果然还是养了呢♪”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0193", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 108, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 109, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“美羽她看到朵萌和花铃的时候一定很难受……”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0194", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 110, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但是学姐很疼猫咪们。”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 111, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“即使如此，它们也只是‘妈妈的猫’。那孩子不会让自己再更进一步……”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0195", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 112, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“而且，对熊喵小姐也是……”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0196", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 114, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“希望有一天那孩子能振作起来，变得能跟动物们一起生活呢♪”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0197", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也希望那一天到来。", "text_idx": 434, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "希望她不要逃避最喜欢的东西，能宠爱它们。", "text_idx": 429, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 117, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个……结子小姐是为什么会又想养猫呢？”", "text_idx": 398, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 118, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0198", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 119, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“这个嘛……因为我成为了妈妈吧？”", "text_idx": 394, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0199", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 121, "speaker": "カリン", "flag": 64, "pages": [{"page": 0, "text": "“喵呜～”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "花铃", "alt_speaker_idx": 461, "voice": "kr0007", "char_id": "カリン"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 122, "speaker": "ドモン", "flag": 64, "pages": [{"page": 0, "text": "“喵～”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "朵萌", "alt_speaker_idx": 442, "voice": "dm0007", "char_id": "ドモン"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 123, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“好好好，想吃干干了对吧？跟我来吧。”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结子", "alt_speaker_idx": 457, "voice": "yk0200", "char_id": "結子"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 124, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结子小姐走向厨房，她的背影在我眼中与美羽学姐重叠。", "text_idx": 458, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 125, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "希望有一天，能像结子小姐一样。", "text_idx": 430, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 126, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想看到她跟最喜欢的猫咪们幸福生活的模样。", "text_idx": 437, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在比任何人都近的地方看着她。", "text_idx": 422, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 128, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔，你一直在等我吧。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2156", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“打工辛苦了。”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 130, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2157", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 131, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？我的脸上有沾到什么吗？”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 132, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“没有。只是就想看着你♪”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2158", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 133, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好害羞喔。”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 134, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸～明明都交往了？”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2159", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那学姐会怎么样呢？”", "text_idx": 402, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 136, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……唔。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2160", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 137, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我反过来凝视着她。", "text_idx": 436, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 138, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“这、这个嘛，有点害羞呢……”", "text_idx": 392, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2161", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 139, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然脸红的学姐好可爱。", "text_idx": 453, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 140, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看这样子她应该没事了，感觉是平常的美羽学姐……", "text_idx": 452, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 141, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，对了对了，关于小熊喵的事……”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2162", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 142, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是。”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 143, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“如果找到它的妈妈了，我想立刻就让它回归自然。”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2163", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 144, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看得出来她在强颜欢笑。", "text_idx": 439, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 145, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“对小熊喵来说，那样才是幸福嘛♪”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2164", "char_id": "みう"}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 146, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，这就是学姐选择的答案吧。", "text_idx": 416, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 147, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那么我也只能从旁守护她。", "text_idx": 464, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "待在她身边，见证这一切。", "text_idx": 432, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 149, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那明天开始，就去找熊喵的妈妈吧。”", "text_idx": 404, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 441, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_26.txt", "scene": "*start", "row": 150, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。希望快点找到，让小熊喵高兴。”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 459, "voice": "mu2165", "char_id": "みう"}]}
