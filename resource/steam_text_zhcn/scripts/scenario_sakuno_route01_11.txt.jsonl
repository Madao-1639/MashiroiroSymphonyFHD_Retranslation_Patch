{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“请进。”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“可以聊一下吗？”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2429", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没关系。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以为是像平常一样来阅读，但今天樱乃没有拿着书。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 4, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2430", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "进来房间后，樱乃一直盯着我看。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你有什么话想对我说吗？”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………嗯。”", "text_idx": 191, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2431", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沉默了一会后，樱乃点头。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“烦恼的事？”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 10, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。大概，是人生最大的烦恼。”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2432", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“最大……很不得了呢。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 12, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，所以……来找葛格。”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2433", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个，跟你最近常常看手机有关系吗？”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 14, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“你注意到了？”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2434", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 16, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……关系，或许有一点点。”", "text_idx": 193, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2435", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这样。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "人生最大吗……", "text_idx": 262, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呐，樱乃，虽然我可能不是可靠的哥哥──”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃扯了扯着我的袖子。", "text_idx": 290, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没有那种事。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2436", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我从来没有觉得葛格不可靠。”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2437", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……谢谢你，樱乃。”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为妹妹有烦恼，我却只能看着……”", "text_idx": 225, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 25, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“因为是葛格喔。”", "text_idx": 226, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2438", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……什么意思呢？", "text_idx": 257, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“可以稍微，听我说吗……？”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2439", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这种事当然没问题。”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2440", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然我这样回答了，但樱乃仍沉默了一阵子。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 31, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我说啊……”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2441", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 32, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我不知道该朝哪里去。”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2442", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 33, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“之前虽然知道，但现在变得不知道了。”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2443", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "什么意思呢？", "text_idx": 263, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，现在的樱乃并不是要求答案。", "text_idx": 261, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，然后呢？”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我倾听樱乃缓缓述说的话语。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 38, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“想法明明一直、一直没有改变，但是，或许不改变不行了……”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2444", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 39, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“明明必须做点什么，但是什么都办不到……”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2445", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 40, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“心好像迷路了一样。”", "text_idx": 229, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2446", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“迷路啊……”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 42, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2447", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃现在说的事情，我想我大概连一半都没有听懂。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，我想支持她的想法不会改变。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我去找到就好了。”", "text_idx": 234, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……像那个时候一样。”", "text_idx": 192, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那个时候？”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2448", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“找到迷路的樱乃。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……葛格还记得啊。”", "text_idx": 200, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2449", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不可能忘记的。”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“说的也是……给你，添了很多麻烦。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2450", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是那样喔，樱乃。”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不是吗？”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2451", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我很高兴喔。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“高兴？”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2452", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为那一天，我确实成为樱乃的“葛格”了。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过这不能跟樱乃说。", "text_idx": 259, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为身为葛格第一个找到妹妹。”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 59, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2453", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 60, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“说的也是。葛格总是能找到我。”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2454", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 61, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不管什么时候，只要等着就会来接我。”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2455", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 62, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为你是我重要的妹妹。”", "text_idx": 224, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 63, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……谢谢你。”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2456", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃没有再多说什么。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概……没有其他能说的，或是想说的都说完了吧。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 66, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2457", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃凝视着我。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好久没去了……要去看看吗？”", "text_idx": 228, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我下意识就这样说了。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 70, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那个时候的场所？”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2458", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 72, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2459", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "刚才谈话时想起来了。", "text_idx": 266, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从家里走过去也没有很远。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 75, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……嗯，去看。”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2460", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在我们出生前就存在的街道。", "text_idx": 269, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "已经几年、几十年没有改变的风景。", "text_idx": 275, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "路灯微弱地照亮延伸到远处的道路。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个地方，夜晚的黑暗远比光芒更深沉。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……现在来还是觉得很暗呢。”", "text_idx": 199, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 81, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，黑漆漆。”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2461", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "走在身旁的樱乃稍微靠近我一点。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 83, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不过，以前就是这样了？”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "凭着记忆慢慢走着。", "text_idx": 265, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老旧的街景，两旁是气派的房子。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 86, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2462", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "循着记忆前进。", "text_idx": 276, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那个时候，我拼了命。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "心脏好像要裂开一样痛，几乎喘不过气，但是我仍然没有停下脚步。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一直找、一直找、一直找。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我还记得发现樱乃时自己才终于安心。", "text_idx": 282, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……樱乃当时在的地方是更前面一点吧？”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 93, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。继续往前走，墙壁有点凹陷的地方。”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2463", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为很暗，我们自然地靠着彼此。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "沿着延伸的墙壁慢慢往前走。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概……是在这附近。", "text_idx": 271, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就在我这么想的时候。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 98, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2464", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃发出声音，停下脚步。", "text_idx": 288, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 100, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……是这里呢。”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2465", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "墙壁与墙壁之间，一个狭小凹陷的场所。", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 102, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，是这样。”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃就坐在这里动也不动。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 104, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那个时候……我还小。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2466", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……是啊。”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我对这里有特别的感情。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 107, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那一天，我们在这里成为了兄妹。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或许是为了确认这件事，所以我才会想来。", "text_idx": 283, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 109, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格，刚才的事……我可以继续说吗？”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2467", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 110, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你人生最大的烦恼？”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 111, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2468", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 112, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，你愿意说的话。”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 113, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我希望你听。”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2469", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 114, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道了，那……告诉我吧？”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 284, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 115, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2470", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她抬起头深呼吸一口气。", "text_idx": 273, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后笔直地看着我。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_11.txt", "scene": "*start", "row": 118, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我……有了喜欢的人。”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 286, "voice": "sk2471", "char_id": "桜乃"}]}
