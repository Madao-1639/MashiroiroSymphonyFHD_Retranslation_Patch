{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早上好。”", "text_idx": 404, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 1, "speaker": "各務台男子Ａ", "flag": 64, "pages": [{"page": 0, "text": "“早～瓜生。”", "text_idx": 407, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "各务台男生A", "alt_speaker_idx": 450, "voice": "da0026", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 2, "speaker": "結女生徒Ｃ", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君，早安～”", "text_idx": 416, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "结女学生C", "alt_speaker_idx": 491, "voice": "jc0026", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，早安。”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我一边跟同学们打招呼，一边朝自己的座位走去。", "text_idx": 466, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "确实做好这种小事，是维持良好气氛的捷径。", "text_idx": 485, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就跟勤快打扫房间是一样的道理。", "text_idx": 460, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯嗯……”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我点了点头肯定自己，正要坐下。", "text_idx": 468, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生。”", "text_idx": 415, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0793", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……来。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "听到濑名喊我，动作瞬间停止。", "text_idx": 452, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安……怎么了？”", "text_idx": 405, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她一脸严肃的表情……", "text_idx": 454, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "该不会是昨天学园长那件事？", "text_idx": 500, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我在心里猜测。", "text_idx": 467, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过。", "text_idx": 444, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我挑了几本参考书来。”", "text_idx": 398, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0794", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名从书包里拿出大量参考书，通通叠在我的桌上。", "text_idx": 479, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……欸？”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“离班会还有一点时间吧？这段时间也善加利用吧。”", "text_idx": 422, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0795", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个情况……", "text_idx": 501, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是、是要念书吗？”", "text_idx": 410, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 23, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这不是当然的吗？昨天你说了希望我再教你念书对吧，瓜生？”", "text_idx": 429, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0796", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我那句“你还愿意再教我念书吗”濑名非～常认真地听进去了。", "text_idx": 471, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，这个量也太……", "text_idx": 445, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "的确教念书是我拜托她的，而她也说过我“很好教”所以想继续教我也能理解。", "text_idx": 484, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是好不容易才摆脱期中考，立刻又要专心念书实在很疲惫……", "text_idx": 448, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 29, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0797", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“坐下。”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0798", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好。”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嗯，很好。”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0799", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当我表现出“很有教导的价值”的反应时，濑名开心并且满意地笑了。", "text_idx": 463, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好吧……能让她这样笑也不错。", "text_idx": 456, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 35, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那首先就从这本开始吧。”", "text_idx": 434, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0800", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“麻烦你了……”", "text_idx": 436, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过，那些话昨天才刚说出口而已，今天就行动了。", "text_idx": 446, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名爱理这个女孩子，在好与不好的意义上都认真得惊人啊……", "text_idx": 480, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "应该说，是我太低估她的认真了。", "text_idx": 462, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在第一与第二节课中间的下课时间。", "text_idx": 453, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 41, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生，休息时间也善加利用吧。”", "text_idx": 417, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0801", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……欸？”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你在发什么呆啊！厕所上完了吧？那就快点回去了！”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0802", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔哇、我、我知道了啦不用拉我……！”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 45, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊！？女、女仆看到了！爱理同学和新吾同学之间还不错的气氛！”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0328", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 46, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谁要对瓜生下手啊！我是被他拜托教他念书的！”", "text_idx": 426, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0803", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "第二和第三节之间的下课时间。", "text_idx": 487, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 48, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“早安啊～先去各务台再来这里实在好麻烦喔～”", "text_idx": 406, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0168", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“错了，老师刚才说的话没有认真听吗？刚刚才说过这里是重点的啊。”", "text_idx": 435, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0804", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 50, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“新吾被盘问了！”", "text_idx": 402, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0169", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 51, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“盘问是什么意思啊！只是稍微复习一下刚才的课程而已！”", "text_idx": 420, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0805", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“实际上是那样没错。”", "text_idx": 391, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……‘实际上’是什么意思啊瓜生！”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0806", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，我想说从旁人角度看起来也是那样。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 55, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“明明考试才刚结束而已欸？唉～比起那个新吾新吾，我刚才来学校的途中看到了～”", "text_idx": 408, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0170", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 56, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0807", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 57, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生，你过来我的座位一下。”", "text_idx": 418, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0808", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名突然站起来，一把抓住我的手拉走。", "text_idx": 481, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“咦？”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 60, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“要闲聊到什么时候？不要说蠢话了快过来……！”", "text_idx": 425, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0809", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈哈哈，隼太，待会再说给我听吧～”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 62, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0171", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 63, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“被带走了。”", "text_idx": 424, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0329", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 64, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“……不是盘问而是洗脑吗？新吾那家伙根本百依百顺嘛！”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0172", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 65, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“根据安洁的机密情报，刚才的下课时间也是那样喔！”", "text_idx": 413, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0330", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 66, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“爱理那家伙，真的堕落了呢……男人那种东西不要去管就好了，而且还偏偏是瓜生。”", "text_idx": 414, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "纱凪", "alt_speaker_idx": 490, "voice": "sn0118", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 67, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“因为安洁非常在意，今后也要关注才行。”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0331", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 68, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“我也是～好像挺有趣的感觉～跟考试前的气氛都不同了。”", "text_idx": 396, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0173", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 69, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“就是这样，那么小纱同学再见啰～”", "text_idx": 392, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0332", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 70, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喂、喂！我也不能错过朋友遭受男人的魔爪啦……！”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 490, "voice": "sn0119", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 71, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不是错放吗？”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0333", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那种地方就该错过啦！”", "text_idx": 433, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 490, "voice": "sn0120", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 73, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“那么课就上到这边……”", "text_idx": 431, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0096", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "第三节课结束了。", "text_idx": 486, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 75, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“八冢老师！”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0810", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 76, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“是！”", "text_idx": 411, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0097", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 77, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“为什么新吾君被濑名同学拉着过来呢！？”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0098", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“刚才的内容有问题想问。”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0811", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“看到学生突然被拉过来，老师可能会以为是发生什么事了……但就是这么回事。”", "text_idx": 421, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老师会惊讶也能理解。", "text_idx": 493, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 81, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“啊、好的，是这样啊。问问题当然可以……毕竟我是老师嘛。”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0099", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明白原因后，万智老师也接受这个状况了。", "text_idx": 474, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 83, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“其实我偶尔会没有自信……像现在被濑名同学叫住，我就担心是不是刚才的课程有说错的地方……”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 45, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0100", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没想到居然进入沮丧模式了。", "text_idx": 477, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 85, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生，说点什么安慰她！”", "text_idx": 419, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0812", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？欸……啊……”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“万、万智老师的那种地方，我还挺喜欢的喔！”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 88, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“！！”", "text_idx": 437, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0101", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 89, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“是、是吗？真是困扰呢欸嘿、讨厌啦～这样子老师不就会想让你们尽管问了嘛～”", "text_idx": 409, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "万智", "alt_speaker_idx": 443, "voice": "mc0102", "char_id": "万智"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 90, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "%51;“只要瓜生在，八冢老师就很好说话。如果只有我一个人她就会胆战心惊的样子……”", "text_idx": 9, "plain": "“只要瓜生在，八冢老师就很好说话。如果只有我一个人她就会胆战心惊的样子……”", "plain_idx": 356, "len": 38, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0813", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 91, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好，那就麻烦你了，八冢老师。要好好问到懂喔瓜生！”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0814", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──然后，午休时间。", "text_idx": 439, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 93, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我吃饱了。”", "text_idx": 397, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0815", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 94, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好了，瓜生。”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0816", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，果然在这里也要念吗？”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 96, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这不是当然的吗？你以为我是为什么才把念书的用具都带来啊？”", "text_idx": 428, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0817", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名一脸理所当然的表情。", "text_idx": 478, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这半天下来，只要稍微有空档时间她就会盯着我念书……", "text_idx": 502, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有这样就算了，但是……", "text_idx": 449, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 100, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“开始了开始了！”", "text_idx": 394, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0334", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 101, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“哇啊，真的在念书呢～小熊喵。”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 492, "voice": "mu0208", "char_id": "みう"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 102, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜！”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 482, "voice": "pn0074", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 103, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“连在这里都念书喔……爱理已经不行了，失去她太遗憾了……”", "text_idx": 430, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "纱凪", "alt_speaker_idx": 490, "voice": "sn0121", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 104, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“放弃得太早了吧！哈哈哈，女人的友情真是虚幻啊～”", "text_idx": 401, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "隼太", "alt_speaker_idx": 503, "voice": "ht0174", "char_id": "隼太"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就像这样，大家都在旁边看。", "text_idx": 458, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就我个人来说，这种情况就像把大家晾在一边，我很难静下心来念书。", "text_idx": 459, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 107, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……瓜生，现在念书好吗？”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0818", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 108, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“既然如此，就加入大家的聊天啦！”", "text_idx": 403, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0819", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然我觉得自己没有表现出来，但濑名还是看穿我的心思，她不悦地转向旁边。", "text_idx": 498, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 110, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不想念的话就说清楚啊……”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0820", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 111, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她小声抱怨着，很不满地嘟起嘴。", "text_idx": 455, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 112, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看得出来她是真心想督促我念书。", "text_idx": 469, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──她完全不在意周遭的气氛。但是她的存在感却会改变气氛。", "text_idx": 438, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而她的“存在”，此时此刻是专注在我一个人身上……", "text_idx": 494, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 115, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……念吧。麻烦你了，濑名。”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而我无法忽视她的那份心意。", "text_idx": 495, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然念书这件事是我主动提起的，但除此之外她很少会这么积极丢球给我。", "text_idx": 497, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以虽然对大家很不好意思……我不能错过这个好机会。", "text_idx": 472, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 119, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好！既然如此我就不会客气了！”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0822", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈哈……还是请你手下留情啊。”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 121, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“那我们就保持安静吧。”", "text_idx": 432, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 492, "voice": "mu0209", "char_id": "みう"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 122, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，抱歉，不用介意我们的。”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然只要我们换个地方就能解决，但我觉得那样做会让大家心里有疙瘩，结果还是只能留在原地。", "text_idx": 496, "plain": null, "plain_idx": null, "len": 43, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 124, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“就算你那样说还是很碍眼啊。跟美羽学姐相处的快乐时光，才不想看到那种认真念书的家伙呢。”", "text_idx": 393, "plain": null, "plain_idx": null, "len": 44, "alt_speaker": "纱凪", "alt_speaker_idx": 490, "voice": "sn0122", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 125, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“喂，纱凪！不要把参考书拿走啦！”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0823", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔，还我们吧！”", "text_idx": 400, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 127, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔喔手不要伸过来啦你这只团子虫！还给你就是了敢碰我就杀了你喔！”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "纱凪", "alt_speaker_idx": 490, "voice": "sn0123", "char_id": "紗凪"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 128, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈哈……来，濑名。”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 129, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊……谢谢。”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0824", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 130, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不过，还是会想和你们聊天呢～关于这点怎么样呢熊喵小姐，就动物来说！”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0335", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 131, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜……”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 482, "voice": "pn0075", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 132, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜、呜噜～”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "熊喵", "alt_speaker_idx": 482, "voice": "pn0076", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 133, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“喔喔！熊喵小姐也表现出希望心爱的新吾同学陪它玩的感觉！”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "安洁", "alt_speaker_idx": 457, "voice": "ag0336", "char_id": "アンジェ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 134, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜！”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 482, "voice": "pn0077", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 135, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“咿……喂、不要再过来了！”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0825", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 136, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“来，不好意思喔熊喵。天羽学姐麻烦你了。”", "text_idx": 412, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 137, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“好～小熊喵来这边～呵呵，过了这么久小爱理还是不习惯呢～”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 492, "voice": "mu0210", "char_id": "みう"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 138, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“至少，代理的瓜生～”", "text_idx": 423, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 476, "voice": "sk0398", "char_id": "桜乃"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 139, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜～”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 482, "voice": "pn0078", "char_id": "ぱんにゃ"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 140, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你樱乃。那么，濑名……”", "text_idx": 427, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 141, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“唔、嗯。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0826", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 142, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样，在大家的干扰下濑名继续教我念书。", "text_idx": 461, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 143, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0827", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 144, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以，瓜生，这里有一个特别的解题诀窍喔。”", "text_idx": 399, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0828", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 145, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喔，那我要笔记下来。”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 473, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 146, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“很正确的态度。嗯，仔细记下来吧。呵呵，顺便连这题也一起教你好了。”", "text_idx": 395, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "爱理", "alt_speaker_idx": 483, "voice": "ar0829", "char_id": "愛理"}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 147, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我越是接球，濑名就丢得越起劲。", "text_idx": 470, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当然我也一颗不漏地都接下了。", "text_idx": 464, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然我还不知道她为什么会对我这么积极热心……", "text_idx": 499, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route01_04.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但感觉并不坏，毕竟我也是男生嘛。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
