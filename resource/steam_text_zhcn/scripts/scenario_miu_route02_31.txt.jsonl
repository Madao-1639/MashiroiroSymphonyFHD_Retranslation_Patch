{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 0, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君你啊……”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2240", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 2, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2241", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 4, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……不，没什么♪”", "text_idx": 182, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2242", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天也和学姐牵着手走路。", "text_idx": 232, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "像平常一样闲聊。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "距离毕业典礼，还有半个月。", "text_idx": 276, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是我们之间，仍没有聊过这个话题。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“社团活动结束后，可以去学姐的家吗？”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 11, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，当然可以喔～”", "text_idx": 199, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2243", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐笑着勾上我的手臂。", "text_idx": 248, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的动作就像在求助一样。", "text_idx": 243, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 14, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“好久没有两个人独处了呢。”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0201", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，我也差不多该回去……”", "text_idx": 193, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 16, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“别那样说嘛，稍微聊一下吧？”", "text_idx": 191, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0202", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……唉。”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放学后我来到学姐家打扰，但是美羽学姐临时接到打工的通知，所以出门了。", "text_idx": 262, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐在对我客气吧。", "text_idx": 244, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她叫我不必介意尽管坐，出门前还准备了点心给我吃。", "text_idx": 241, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 21, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“我觉得应该对新吾同学道谢。”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0203", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 23, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你总是为美羽着想。”", "text_idx": 224, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0204", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不会，没什么的……”", "text_idx": 189, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 25, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“都是多亏了新吾同学喔。美羽才能像那样笑着……”", "text_idx": 226, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0205", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我心中总是很迷惘。", "text_idx": 258, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "自己做的事是正确的吗？", "text_idx": 275, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我是不是应该多安慰学姐一点……", "text_idx": 259, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……真的是那样吗？”", "text_idx": 188, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 31, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0206", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我觉得，自己是不是反而给学姐造成压力了……”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近美羽学姐完全不提熊喵的事了。", "text_idx": 264, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那天以来，也没有再流过眼泪。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知道这究竟是不是好事。", "text_idx": 254, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 36, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“没关系的。因为最后，还是那孩子要做决定。”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0207", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 38, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“美羽一定很想跟熊喵小姐一起生活吧。”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0208", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 39, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“但那是无法实现的事。她自己也知道……”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0209", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 41, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“新吾同学，今后也请你多陪在那孩子身边。”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0210", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“只要那样就好了吗？”", "text_idx": 192, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 43, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "结子", "alt_speaker_idx": 271, "voice": "yk0211", "char_id": "結子"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到结子小姐的笑容，我什么话都说不出来了。", "text_idx": 268, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……你跟妈妈说话了吗？”", "text_idx": 183, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2244", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“稍微聊了一下而已。”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“这样啊……太好了♪”", "text_idx": 225, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2245", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结果，我一直待到学姐回来。", "text_idx": 272, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老实说，被结子小姐全力诱惑差一点就要栽了。", "text_idx": 274, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 50, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我觉得我妈妈一定在打新吾君的主意。”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2246", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 51, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“打我的主意？”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 52, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。因为有时候吃饭吃到一半，她会突然叹气然后喃喃自语。”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2247", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 53, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唉……好想教新吾君人妻的魅力。”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2248", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……刚才她一脸认真对我说同样的话了。", "text_idx": 228, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当然，这件事我说不出口。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 57, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“要小心我妈妈喔。不可以输给人妻什么的！”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2249", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天的学姐比平常还要撒娇。", "text_idx": 233, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们的视线一对上，她就凑上来亲吻我。", "text_idx": 256, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啾、嗯……啾……嗯嗯、啾……”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2250", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐就这样把我压倒，骑到我身上来。", "text_idx": 245, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们唇舌交缠了好一会。", "text_idx": 255, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君是我一个人的新吾君喔……”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2251", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐表现出的独占欲让我胸口发热。", "text_idx": 249, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 65, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……新吾君，要一直在我身边喔。”", "text_idx": 186, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2252", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就算这份感情是因为跟熊喵分离而产生的也没关系。", "text_idx": 250, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我会一直在你身边。”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我毫不犹豫地回答。", "text_idx": 260, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君，你醒着吗？”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2408", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“醒着。”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2409", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们这样依偎着彼此多久了呢？", "text_idx": 257, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "关掉灯，静静地感受只属于两人的时间。", "text_idx": 238, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然，学姐小声地叹了口气。", "text_idx": 269, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 75, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了吗？”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 76, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2410", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 77, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，那个，我想谢谢你。”", "text_idx": 200, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2411", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 79, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵的事，你什么都没有问我对吧？”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2412", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 81, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我啊，其实不希望让小熊喵回到妈妈的身边。”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2413", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 82, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“很过分吧？说要救助动物，结果却想让它待在自己身边……”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2414", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不知道该怎么回应。", "text_idx": 253, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我只是摸了摸学姐的头发。", "text_idx": 261, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 85, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……狗狗或猫咪，为什么寿命都比人类短呢？”", "text_idx": 187, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2415", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 87, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵……”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2416", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的声音颤抖，她咬住自己的手背。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她小的时候，疼爱的猫因为生病死去。", "text_idx": 242, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "应该是想起当时的事了吧。", "text_idx": 251, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要跟动物一起生活，就一定会遭遇别离。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "狗也是，猫也是。", "text_idx": 267, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还有，熊喵也是。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 94, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉喔。”", "text_idx": 185, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2417", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为学姐太善良了。”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 263, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 96, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔……”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 273, "voice": "mu2418", "char_id": "みう"}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在我的抚摸下，学姐开始压抑地哭了起来。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……熊喵知道吗？", "text_idx": 229, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有一个这么思念它的人。", "text_idx": 265, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有一个这么爱它的人。", "text_idx": 266, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的心意，有传达给它吗？", "text_idx": 247, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管是对熊喵展露的笑容。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还是拼命做好的尾巴饰品。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "全部。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_31.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "全部都会逐渐被它遗忘吗……", "text_idx": 237, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
