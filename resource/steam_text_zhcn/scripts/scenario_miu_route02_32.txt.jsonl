{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 0, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……之后就剩下这些孩子们而已了。”", "text_idx": 228, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2419", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 2, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“让这些兔子回到大自然后，就不要再救助动物了。”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2420", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这是什么意思？”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 4, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2421", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐。”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 6, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……到这个月底，我想关闭这个社团。”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2422", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 8, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔，这么晚才告诉你。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2423", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么、突然……”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 10, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“其实我以前就这么决定了。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2424", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 12, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“好不容易招齐了社员……擅自决定我很抱歉。”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2425", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是因为熊喵的事吗？", "text_idx": 325, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还是有其他原因？", "text_idx": 339, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 15, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但无论如何，这是社长美羽学姐决定的事。我没有插嘴的资格。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那样……”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不行，不要说。说了也只会让学姐困扰而已。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "…………", "text_idx": 308, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐，那样真的好吗？”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 21, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2426", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……果然不该说的。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不想看到学姐露出那种表情……", "text_idx": 319, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 24, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……嗯～是喔。学姐那样说。”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1658", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你这么轻易就接受了？”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 26, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为学姐都说要结束了，我们这些社员也只能听从吧？”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1659", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以为纱凪会跟我一起阻止学姐的。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但她的反应却是这么冷漠。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么她能如此轻易就接受？", "text_idx": 314, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明是做了那么多努力一路守护过来的社团……", "text_idx": 324, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 32, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“干嘛？一脸不满的表情。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1660", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“纱凪无所谓吗？这样下去社团就要没有了。”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 34, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1661", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“大家一起贴海报、招社员……还帮猫找领养饲主，做了那么多事情。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……你啊，不懂重要的是什么欸。”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1662", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪叹口气环顾社团教室，然后拿起一个原本要给熊喵吃的猫罐头。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 39, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你知道为什么美羽学姐要那么拼命打工直到自己倒下吗？”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1663", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 40, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你没有觉得不可思议吗？这个社团救助的动物们的伙食费是从哪里来的。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1664", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被她这么一说，我只想得到一个答案。", "text_idx": 338, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……没有所谓的社团经费吧。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 44, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“没错，都是美羽学姐打工赚来的。”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1665", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 45, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“虽然我也想帮忙，但是她不准……”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1666", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 47, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐毕业之后，谁要代替她？”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1667", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪把猫罐头丢给我，接着说。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 49, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“其实，美羽学姐想拜托你当社长。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1668", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但是，她没能说出口。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1669", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 51, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“学姐不久前来找我道歉了。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1671", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“她说虽然希望社团继续经营，但还是没办法。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1672", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 53, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“当然，我也反对过了。如果缺社长，我或新吾来当就好了。”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1673", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 54, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……但是她说不行。你知道是为什么吗？”", "text_idx": 229, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1674", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是……”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 56, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1675", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为她重视我们。”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1676", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 58, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“因为比起任何人她最重视新吾……”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1677", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“所以美羽学姐才没有拜托你当社长。”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1678", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 61, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“三年来，她都一个人边工作边守护这个社团。”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1679", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 62, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“如果要让我或新吾承担这个责任，她宁可被叫成伪善者也要结束社团。”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1680", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 63, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“比起被救助的动物们，她更爱我们。”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1681", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 64, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我也只能接受了不是吗？那样的她居然主动说要关闭社团……”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1682", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……敌不过那个人呢。”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 67, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这是当然的啊。因为是我憧憬的人。像你这种人要跟她平起平坐，还早一百亿年呢！”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1683", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把猫罐头放回架上，在心中做出了决定。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不会让社团就这样消失。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我该做的事只有一件。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“纱凪觉得这样就好吗？”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“什么？”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1684", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就这样单方面享受美羽学姐的爱。”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 74, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1685", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪勾起嘴角，拍拍我的肩膀。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 76, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“果然啊。”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1686", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 78, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1687", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 79, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你是个好男人呢。”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 330, "voice": "sn1688", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 80, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，花铃、朵萌，来这边～”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0212", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 81, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "“喵嗯～”“喵呜～”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "花铃／朵萌", "alt_speaker_idx": 337, "voice": "go078", "char_id": "汎用"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 82, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2427", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 83, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“美羽也一起玩吧？花铃，去叫美羽过来。”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0213", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 84, "speaker": "カリン", "flag": 64, "pages": [{"page": 0, "text": "“喵呜～”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "花铃", "alt_speaker_idx": 336, "voice": "kr0009", "char_id": "カリン"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 85, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“你看你看，花铃在说希望你一起玩喔～”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0214", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 86, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……呐，妈妈。”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2428", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 87, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？哎呀、不行喔，朵萌真是的……”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0215", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2429", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 89, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“妈妈不会害怕养猫吗？”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2430", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 90, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“害怕？”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0216", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“因为比起我们，猫咪会很早就死掉喔？”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2431", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 92, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“就算非常疼爱它们，最后也只剩下悲伤的回忆……”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2432", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 93, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“即使如此，为什么妈妈又养猫了呢？”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2433", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 94, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0217", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 95, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“这个嘛。的确分离是很悲伤的事……”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0218", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 96, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“但是，跟这些孩子们一起度过的时光，是会一直一直留在心中的宝物……”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0219", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 97, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2434", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 98, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“等到有一天你当母亲的时候……一定就会懂了。”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0220", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 99, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2435", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 100, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“孩子总有一天会离开父母……能跟你像这样相处的时间，也不多了吧。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0221", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 101, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“你遇见了很棒的人。接下来你会跟那个人一起创造回忆。”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0222", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 102, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“就像你带给我许多的回忆一样……”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0223", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 103, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2436", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 104, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“你说的没错，花铃和朵萌总有一天会离开我。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0224", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 105, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“但是，跟这些孩子们的回忆，会一直留在妈妈心中……不对，是必须留下才行。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0225", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 106, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“所以，没错，你也别忘记喔。”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0226", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 107, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2437", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 108, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“因为熊喵小姐一定也会记得你的……”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0227", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 109, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“你也不能忘记熊喵小姐喔？”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0228", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 110, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“可别说一起度过的时光只剩下悲伤那种话喔？”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0229", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 111, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“妈妈……”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 335, "voice": "mu2438", "char_id": "みう"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 112, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔。没能为你做些像母亲会做的事情。”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0230", "char_id": "結子"}]}
{"script": "scenario_miu_route02_32.txt", "scene": "*start", "row": 113, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“但是妈妈是爱你的。今后也会一直爱着喔！”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "结子", "alt_speaker_idx": 334, "voice": "yk0231", "char_id": "結子"}]}
