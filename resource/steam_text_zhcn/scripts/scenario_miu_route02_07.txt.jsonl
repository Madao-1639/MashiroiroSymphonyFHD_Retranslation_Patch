{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 0, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君，今天一定要好好加油！”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1465", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好，这次我会善用舌头的！”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 2, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1466", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我会努力成为结子小姐认可的男人！”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 4, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……那个，我是说念书。”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1467", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊，说的也是！没有人说是要努力接吻嘛！”", "text_idx": 226, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在踏进学姐家之前，我就已经慌张到手足无措了。", "text_idx": 288, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我只是去学姐家念书准备期末考而已。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "忘掉吧，把接吻的事忘得一干二净吧。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 10, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1468", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "翻开英文教科书后，已经过了３０分钟。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没有结子小姐的妨碍，我本以为复习应该会有所进展。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个，美羽学姐。”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 14, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊、是的！”", "text_idx": 225, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1469", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 16, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1470", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一对上眼神，我们就同时低下头。一直重复这个循环。", "text_idx": 278, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“感、感觉好热喔～”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 19, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔、嗯，说的也是呢～”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1471", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 21, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1472", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好尴尬。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且也念不下书。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样忍耐下去也不是办法。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐，那个……”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 26, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1473", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐似乎也在想同一件事，她主动把自己的脸靠近。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 28, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔，明明应该念书才行的……”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1474", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我才要说对不起。从刚才就一直在想奇怪的事情……”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“奇怪的事情？”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1475", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个……我，想跟美羽学姐接吻……”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 32, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1476", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐红着脸点点头。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "第一次的亲吻就是让我们感到如此冲击。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没想到只是双唇相贴，就能那么舒服……", "text_idx": 314, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 36, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……妈妈说要善用舌头对吧？”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1477", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“要试试看吗？”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 38, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1478", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐再次点头，我抬起她的下巴，首先把嘴唇贴上去。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后抱住她的肩膀，一边变换角度一边伸出舌头与她纠缠。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 41, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯、啾、咧溜、嗯嗯、啾、哈啊、啊姆、啾、咧啰、咧溜、嗯、啾……”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1479", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一开始只是轻轻地戳，感受舌头的动作。", "text_idx": 279, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的呼吸好热。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "产生了一种身体轻飘飘浮起的错觉。", "text_idx": 282, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啾、嗯嗯、啊姆、咧噜、嗯、啾、咧啰、啾、嗯嗯、啾……”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1480", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我试着顺势吸吮学姐的舌头，她立刻抖了一下。", "text_idx": 309, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊姆、啾、啾、哈姆、啾、啾……”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1481", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "接着学姐也开始吸我的舌头，这次换我抖了一下。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 49, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“哈啊，新吾君……”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1482", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 50, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯、啾、啊姆、咧噜、咧啰、啾、嗯嗯、啾、咧噜、啾……”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1483", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的舌头伸得比我更长，纠缠的动作也更流畅。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来她比我更早掌握到诀窍，非常积极地使用舌头。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纠缠吸吮、吸吮又纠缠，好像一个不注意自己就要被她压倒了。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈啊哈啊、学姐……”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 55, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啾……嗯……有善用舌头了吗……”", "text_idx": 228, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1484", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 56, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啾、啾、嗯、哈啊……啾、啾……新吾君你都愣住了……”", "text_idx": 229, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1485", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最后，学姐用力吸吮了一下我的舌头，面带笑容地玩弄着我。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我觉得今天越来越没办法念书了。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想一整天都跟学姐接吻。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……这下子，要念书是不可能的了呢。”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1486", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽老师太残酷了。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 62, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“怎么办？明明今天下午要打工没有时间……”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1487", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那就努力到打工时间为止吧。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 64, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“英文吗？”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1488", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不，是接吻。”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1489", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的指尖抚摸着害羞不已的学姐的唇，两人凝视着彼此。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "接着学姐将我的食指含入口中，轻轻点头。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君……嗯嗯！？啾、嗯嗯、啾、嗯嗯、啾、啾、嗯嗯嗯！？”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1490", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在这之后，我跟美羽老师的秘密读书会没有停歇地持续下去……", "text_idx": 289, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 71, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“……新吾同学，你怎么了吗？”", "text_idx": 200, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0116", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 72, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 73, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“你从刚才开始就很疲倦的样子……”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0117", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊、不……”", "text_idx": 224, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐出门去打工，我正要回家的时候被结子小姐留下来喝茶。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我无法思考。", "text_idx": 306, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结果，直到学姐去打工前我们都在接吻。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就连现在，我都感觉有东西贴在嘴唇上。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且，看到与美羽学姐相似的结子小姐的嘴唇心脏猛跳了一下。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 80, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“念书有进展了吗？”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0118", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，嗯……”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其实我们一直在亲亲这件事我说不出口。", "text_idx": 283, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且结子小姐身上的香气好甜我不敢靠近。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她看起来一点也不像人妻。就算穿上结女的制服去学校也没有违和感……", "text_idx": 290, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 85, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“这样啊。我还以为你们一定是在房间里练习接吻了呢……”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0119", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“噗！？”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 87, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“那孩子从昨天晚上就一直嚷嚷着。”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0120", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 88, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“她说自己年纪比较大，所以必须比新吾同学更擅长接吻才行。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0121", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 89, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“还希望我教她接吻的方法……”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0122", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个……所以结子小姐就教她了吗？”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 91, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，这个嘛，你觉得呢？”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0123", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "唔哇，她绝对教了。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "原来如此，是结子小姐亲授的接吻啊……", "text_idx": 285, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一回想起来，嘴唇就觉得寂寞了。", "text_idx": 277, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不过，感觉真好呢。可以聊这种事情的亲子关系……”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 96, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“是吗？”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0124", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是的。明明是母女却像朋友一样，让我很憧憬。”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果结子小姐是我妈妈的话，我感觉自己一定会变成最强的恋母情结。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "谁都不准碰我妈妈！之类的。", "text_idx": 334, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 100, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“……但是，身为母亲我是失职了。”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0125", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "听到意料之外的话，椅子喀搭了一下。", "text_idx": 286, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 103, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“因为我没办法治好美羽内心的伤口……”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0126", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 104, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“内心的伤口……？”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结子小姐轻轻抚摸着趴在她腿上的猫，转头看着我。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 106, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“美羽她其实是不能养动物的孩子。”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0127", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不能养动物是什么意思？她有过敏之类的吗……？”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 108, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“不，不是那种原因。”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0128", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 109, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“她小时候家里养的猫因为生病过世了……”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0129", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 110, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“那之后，她因为打击太大，所以害怕再饲养动物。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0130", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 112, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“明明知道这件事，我却养了花铃和朵萌……养了新的猫。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0131", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“可是，那样……”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 114, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“那孩子实在是太爱动物们了吧。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0132", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 115, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“所以就算是自然衰老死亡，美羽也会归咎到自己身上。”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0133", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 116, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“总有一天，花铃和朵萌死掉的时候一定也是……”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0134", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 117, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“让女儿遭受这些事，我是个失职的母亲。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0135", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没有那种事喔。我觉得结子小姐是个很优秀的母亲。”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 119, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0136", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是同情也不是客套话，我是真心这么想。", "text_idx": 280, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 121, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "猫咪们像是也赞同我的话，蹭了蹭结子小姐。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 122, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你。今后美羽的事，就拜托你了。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结子", "alt_speaker_idx": 322, "voice": "yk0137", "char_id": "結子"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐一定也是这么想的。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 124, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "露出这个笑容的结子小姐，是最棒也是最优秀的母亲──", "text_idx": 336, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 125, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“你没有被妈妈做什么奇怪的事情吧？”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1491", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没事啦。比起那个，今天请你好好休息。”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 127, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1492", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐很不舍得分开地握住我的手。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 129, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结子小姐说的那些事，我决定不要告诉学姐。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不想让学姐想起过世的猫，也希望她能一直保持笑容。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 131, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔，结果今天还是没能念书……”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1493", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 132, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不会，因为是我的错。”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 133, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“但是我……一直在跟新吾君亲亲……”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1494", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 134, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……现在也有点想。”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1495", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“可以喔。”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 136, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯！？啾、嗯嗯、啾、哈啊、嗯、啾……”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1496", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 137, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们牵着手，忘我地接吻。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 138, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "跟结子小姐相同的气味，沾附到我的身上。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 139, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……接吻，是这么舒服的事情啊。”", "text_idx": 199, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1497", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 140, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，舒服到有点可怕。”", "text_idx": 234, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 141, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1498", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 142, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“但是……还有比接吻更舒服的事情对吧？”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1499", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 144, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1500", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 145, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“光是要想像就有点可怕呢……”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 146, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……嗯，没办法想像呢。比接吻还厉害的事……”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1501", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 147, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过总有一天，我们也会经历那种事。", "text_idx": 281, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到时，我们会怎么样呢……果然无法想像。", "text_idx": 284, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 149, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君，可以再亲一次吗？”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1502", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 150, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“别说一次，要几次都可以。”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 312, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 151, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“听到你这样说，我真的会亲很多很多次了。”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 327, "voice": "mu1503", "char_id": "みう"}]}
{"script": "scenario_miu_route02_07.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结子小姐亲授的接吻让我彻底荡漾，沉迷其中了……", "text_idx": 323, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
