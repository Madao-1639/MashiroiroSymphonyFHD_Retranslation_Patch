{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 0, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你真的很没用欸。那样还算是美羽学姐的男朋友吗？”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1689", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“真奇怪。她明明有说今天会来社团的……”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我打算再跟学姐谈一次社团的事。", "text_idx": 415, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪也赞同，所以我们才会在这里等着学姐。", "text_idx": 427, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 4, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“根本没来嘛。”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1690", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是啊。”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉……打电话给她比较快吧？”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1691", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“刚才打过了，但是转语音信箱。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 8, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这是破局的前奏吧。”", "text_idx": 391, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1692", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不可能不可能。”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 10, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那种事我知道啦。”", "text_idx": 396, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1693", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 11, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“所以？你有想好说服学姐的说法了吧？”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1694", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？不是纱凪要说服她吗？”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 13, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1695", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“开玩笑的啦、开玩笑！不要那个表情嘛。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 15, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……就算我来说服，学姐也不会听的。”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1696", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没有那种事吧？”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 17, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“就是有那种事啦！”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1697", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哎呀……你们在这种地方做什么？”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4500", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 19, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喔，爱理你来得正好。你有没有看到美羽学姐？”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1698", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“天羽学姐的话，刚才在校门口有看到她喔。”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4501", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 21, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“她说有事要去学园长室一趟……”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4502", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 22, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“什么！？”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1699", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学园长室，该不会……”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是要去报告即将结束社团吗？", "text_idx": 404, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果是这样，必须阻止她……", "text_idx": 405, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 26, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“新吾，要冲进学园长室了！”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1700", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好！”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 28, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊、等等……”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4503", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 29, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2440", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘小纱凪，你知道吗？动物们能够理解人类的语言喔。’", "text_idx": 311, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2441", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 31, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘虽然大家都取笑不相信……’", "text_idx": 315, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2442", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 32, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘但是啊，只要好好地注视着眼睛说话，我们的心意就能相通喔！’", "text_idx": 309, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2443", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 33, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘所以，我……’", "text_idx": 313, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2444", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 34, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘想成为能够直视着动物们的眼睛的人。’", "text_idx": 312, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2445", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 35, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘如果现在别开视线，我觉得我就没办法那样做了……’", "text_idx": 310, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2446", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 36, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘……虽然你们说要保护动物。’", "text_idx": 307, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0650", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 37, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘但是今后会发生什么事呢？’", "text_idx": 308, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0651", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 38, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "‘……希望你有一天能跟那个人一起生活。’", "text_idx": 306, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 430, "voice": "yk0236", "char_id": "結子"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 39, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "‘那个重要的人。’", "text_idx": 316, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "结子", "alt_speaker_idx": 430, "voice": "yk0237", "char_id": "結子"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 40, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "‘然后，跟最喜欢的孩子们一起……’", "text_idx": 314, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "结子", "alt_speaker_idx": 430, "voice": "yk0238", "char_id": "結子"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 41, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2447", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 42, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“打扰了。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2448", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 43, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，好久不见。怎么了？”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0652", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 44, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2449", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我有一件事想拜托濑名学园长……”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2450", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 46, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“拜托？”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0653", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2451", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 48, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“哈啊哈啊哈啊……新吾、快点！”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1701", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 49, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“要快点的是你吧？”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔、你居然能跑那么快……”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1702", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 51, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“总之快点去学园长室！”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我知道。”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1703", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 53, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“打扰了。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2452", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 54, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊！美羽学姐！”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1704", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 55, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2453", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "走廊的另一端，学姐正好从学园长室走出来。", "text_idx": 434, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪大步跑向学姐。", "text_idx": 428, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小纱凪……连新吾君也……”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2454", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我们有重要的话要跟学姐说！”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1705", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“重要的话？”", "text_idx": 397, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2455", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "平复了一下呼吸后，我也走向学姐。", "text_idx": 411, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 62, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“难道已经向学园长报告了吗？”", "text_idx": 398, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1706", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2456", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐不解地歪着头。", "text_idx": 406, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我听纱凪说了。学姐想关闭社团的理由。”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“所以我想跟你讨论一下，能不能想个办法让救助动物的活动继续下去。”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 67, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“就算美羽学姐毕业，我们也想继续这个社团。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1707", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“所以，我们……”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2457", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 70, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……谢谢你们。不过，我不是去找濑名学园长说那件事的。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2458", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那么你是去说了什么事呢？”", "text_idx": 393, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1708", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 73, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2459", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 74, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“……所以，天羽同学的想法是？”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0326", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 75, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0654", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 76, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“她希望可以举办植树活动，作为学校新课外活动的一环……”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0655", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 77, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“植树？”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0327", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 78, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“真是的，说得那么简单～”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0656", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 79, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“……预、预算上有点难度呢，植树这种活动。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0328", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 80, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“不过，想办法解决这种大人的因素本来就是我们的责任啦～”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0657", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 81, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“学园长……”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0329", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 82, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“要成为好女人，不是只要学业成绩优秀就好。”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0658", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 83, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“学问与女性的成绩，还有恋爱的成绩也很重要呢。”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0330", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 84, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“真会说呢，你这个单身贵族～♪”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0659", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 85, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“我、我又不是自己喜欢才单身的……”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0331", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 86, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“女人不管多么努力，还是得要有看男人的眼光才行呢……”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0660", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 87, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“就是说啊就是说啊！”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0332", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 88, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "“那么万智，要工作啰！为了可爱的学生们。”", "text_idx": 392, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "兰华", "alt_speaker_idx": 403, "voice": "rk0661", "char_id": "蘭華"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 89, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“好的，学园长！”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "万智", "alt_speaker_idx": 401, "voice": "mc0333", "char_id": "万智"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“复育大自然？”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我考虑了很多，然后想到这个。”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2460", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 92, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“就算在这里继续救助动物们，结果还是没有改变任何事……”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2461", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“所以，社团会继续存在吧？”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 94, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我是这么打算的。不过，只有保护是不行的。必须创造新的做法……”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2462", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 95, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“让几年后、几十年后……我们救助过的动物，以及它们的孩子们……”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2463", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐望向社团教室附近的供养塔。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 97, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“让小熊喵它们，能够有个安心生活的场所。”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2464", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐此时此刻的笑容，真的好耀眼。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一旁的纱凪也露出同样的笑容。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以，我也笑了──", "text_idx": 419, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 102, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那么，我能做的事……”", "text_idx": 394, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 103, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“咔擦！”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2465", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 104, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐突然拿出手机拍了我。", "text_idx": 432, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么回事？突然拍我……”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 107, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸嘿嘿，我想说重要的东西要仔细地保存♪”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2466", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 108, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那我也来咔擦。”", "text_idx": 395, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 426, "voice": "sn1710", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪看起来有点不爽地拿出手机。", "text_idx": 429, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "连我也不自觉想拿出自己的手机，但是手伸到一半就停下了。", "text_idx": 435, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐。”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 112, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“什么事，新吾君？”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2467", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我突然想到。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我有没有用不输给她的爱来爱她呢？", "text_idx": 417, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我有没有像这个人爱我一样，同等地爱她呢？", "text_idx": 416, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 116, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“关于我们社团今后的事。”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 117, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2468", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当我注意到的时候，其他人也都来到社团教室外了。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 119, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁似乎想说什么，但被濑名同学捂住了嘴巴。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃则是一如往常的平静表情。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 121, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到大家的态度，我放松了下来。", "text_idx": 423, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不必想得那么复杂。", "text_idx": 402, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐毕业以后，我可以继任社长吗？”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 124, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2469", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“如果大家愿意继续救助动物，那就由我来保护大家。”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我要守护学姐创立的社团。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 420, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 127, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2470", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 128, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君……”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 431, "voice": "mu2471", "char_id": "みう"}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 129, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐对我绽放了最灿烂的笑容。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_33.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我别无所求了。", "text_idx": 414, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
