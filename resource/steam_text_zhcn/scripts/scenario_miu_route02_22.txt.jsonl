{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你们也真是闲欸……”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4453", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 1, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁才不是闲。就算是圣诞节也有很多事……”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3441", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 2, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哼嗯，除了学校的工作以外还有其他事啊。”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4454", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 3, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3442", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“早知如此，不要逞强不就好了……”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4455", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 5, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔唔、安、安洁才没有寂寞呢！”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3443", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是这种人设吗？", "text_idx": 380, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "算了，先不想那个。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我没想到圣诞节当天，会在社团教室里见到大家。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 9, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“是说，为什么新吾也在？”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 409, "voice": "sn1595", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“什么为什么？”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 11, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你跟天羽学姐已经破局了？”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4456", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "果然濑名同学也知道了吗？", "text_idx": 394, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不，没有喔。我只是想跟家人一起过圣诞节……”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 14, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是吗，樱乃？”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4457", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“今年跟爱理过圣诞节。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 396, "voice": "sk1326", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“对啊，之前就约好了。”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4458", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 17, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“也就是说……”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 409, "voice": "sn1596", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 18, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“果然是破局了啊。被美羽学姐说‘派不上用场’了吧。”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3444", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么她说得那么开心的样子……", "text_idx": 375, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“毕竟对象是天羽学姐……能配得上那个人的男人，本来就很少见了。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4459", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“大家已经肯定我被甩了吗？”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 22, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“新吾同学的背影，散发出一股哀愁的气息……”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3445", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我懒得否定了。", "text_idx": 389, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 24, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然你戴的帽子挺有品味的，但是男人又不能只靠这个……”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4460", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 25, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……没看过这顶帽子。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 396, "voice": "sk1327", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "是昨天……应该说今天，美羽学姐送我的。", "text_idx": 393, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃当然不知道。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 28, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“应该不可能……是美羽学姐的亲手编织的吧。”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3446", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 29, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 409, "voice": "sn1597", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来只有纱凪认出这顶毛帽是学姐亲手编的。", "text_idx": 406, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这顶帽子真的很温暖。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也是第一次收到亲手做的礼物，所以想一直戴着。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但头顶有点闷热了。", "text_idx": 365, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 34, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊……大家也来了啊，圣诞快乐♪”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2042", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐走进社团教室，大家也向她打招呼祝圣诞快乐。", "text_idx": 383, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 36, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君也是～”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2043", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 37, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“圣诞快乐。”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看了一眼我戴着的毛帽，学姐立刻害羞地低下头。", "text_idx": 401, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 39, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜、噜。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0394", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 40, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“怎么了，小熊喵？想让新吾君抱抱吗？”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2044", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 41, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～呜噜～♪”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0395", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 42, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼。新吾君，可以请你抱一下它吗？”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2045", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“了解，来吧熊喵。”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 44, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜♪”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0396", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "熊喵活力充沛地跳到我的胸口。", "text_idx": 399, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔哇，抱着熊喵就好温暖……”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 47, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0397", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且有美羽学姐的气味。", "text_idx": 414, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我忍不住把脸埋在熊喵的毛中。", "text_idx": 388, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……两、两位不是破局了吗？”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3447", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 51, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“如你所见吧。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4461", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 52, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然压低了音量，但我还是听得一清二楚。", "text_idx": 416, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "刚好是个机会，我就正式跟大家报告与美羽学姐的关系吧。", "text_idx": 376, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 54, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2046", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且美羽学姐听到安洁她们小声的谈话，也一脸困扰的表情。", "text_idx": 415, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊……大家，可以听我说一下吗？”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到大家视线都集中在我身上，我接着说。", "text_idx": 402, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这种事情，其实我觉得没有必要特地报告。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我，跟美羽学姐交往了。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新、新吾君……”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2047", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但是我也不喜欢躲躲藏藏的，所以还是决定跟大家说……”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到学姐满脸通红，我的脸也热了起来。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……管他的，虽然是在大家面前，但还是牵手吧。", "text_idx": 367, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 64, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2048", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐回握了我的手，大家没有特别的反应。", "text_idx": 381, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "太紧绷了吧，这种气氛……", "text_idx": 379, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就、就是这样，报告结束。”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 68, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我对大家点头致意，然后观察她们的表情。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结果只有纱凪一个人忍笑忍得身体都在发抖。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……纱凪，没有人这样的吧。”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 71, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“噗、啊哈哈哈！因为啊～看你紧张得全身僵硬，太好笑了。”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "纱凪", "alt_speaker_idx": 409, "voice": "sn1598", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 72, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊啊……安洁也到忍耐的极限了！已经想祝福两位想得受不了了！”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3448", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 73, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然有点好奇你们两人是怎么交往的……”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4462", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 74, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……好嫩。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 396, "voice": "sk1328", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被樱乃这么一指，我整个人都羞耻得快要烧起来了。", "text_idx": 417, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 76, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“恭喜你们，新吾同学、美羽学姐！祝福两位早日生下健康的小宝宝！”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3449", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，那个还太早了吧……”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 78, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“问题不在那里。我绝对不会把美羽学姐的纯洁交给像你这样的家伙！”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "纱凪", "alt_speaker_idx": 409, "voice": "sn1599", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……那个，我已经得到了喔。", "text_idx": 368, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 80, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2049", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且我的纯洁也献给学姐了。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……昨天还第一次用嘴巴帮我做了。", "text_idx": 366, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 83, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥，要加油生下健康的小宝宝。”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "樱乃", "alt_speaker_idx": 396, "voice": "sk1329", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 84, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，要生的不是你哥哥是天羽学姐喔。”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4463", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 85, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“新吾，你懂的吧？不准去想跟美羽学姐交配喔！”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "纱凪", "alt_speaker_idx": 409, "voice": "sn1600", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“交、交配……”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 87, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“小纱同学，女孩子不可以把交配这种话挂在嘴上喔！”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 384, "voice": "ag3450", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 88, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“交配。”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 396, "voice": "sk1330", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 89, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“樱乃也不要说啦，交配这种词，很下流。”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 400, "voice": "ar4464", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知不觉中，整个社团教室充斥着下流的词汇。", "text_idx": 374, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2050", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不过，也好啦。能看到学姐的这个笑容。", "text_idx": 364, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这样一来就不必在意周围的视线了。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "随时随地都可以跟美羽学姐卿卿我我……！", "text_idx": 420, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 95, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，不要动喔，现在帮你装上去。”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2051", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 96, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“咦……你比之前长得更大了？”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2052", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 97, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，真是的这么有精神～”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2053", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "嗯，卿卿我我的。", "text_idx": 377, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 99, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐正在帮熊喵装上她新作的翅膀饰品。", "text_idx": 382, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到她们甜甜蜜蜜的模样，我什么话都说不出口了。", "text_idx": 403, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 101, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵，怎么样？会不会痛？”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2054", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 102, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～噜～♪”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0398", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 103, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“太好了……之前一直没见到你，我好寂寞喔。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2055", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 104, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜、噜。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0399", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 105, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“今后天气要变更冷了，你可不能感冒啰！”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2056", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 106, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜♪”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0400", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 107, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊……小熊喵，肚子饿了吗？”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2057", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 108, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我买了好多小熊喵喜欢的鸡胸肉起司味的罐头喔。”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2058", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 109, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～♪”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0401", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 110, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“那你等一下喔，我现在准备……”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2059", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我也来帮忙吧？”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 112, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“不用，没关系，新吾君休息吧。”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2060", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "美羽学姐从架子上拿出罐头，熟练地打开并倒在容器里。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一开始我站在旁边看着，但渐渐按捺不住，于是从背后抱住了她。", "text_idx": 372, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 115, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君也肚子饿了吗～？”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2061", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 116, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉，妨碍你了。”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 117, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“完全没有妨碍我喔～喂完小熊喵吃饭后，我也想要抱抱呢！”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2062", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我就来抱抱你吧。”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 119, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，等一下，小熊喵先……啊！”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2063", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我用力抱紧她，亲吻她的脖子，学姐立刻敏感地起了反应。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 121, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉，发出奇怪的声音。”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2064", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到学姐害羞的表情，我就更放不开她了。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 123, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～噜～”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0402", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 124, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊！”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 125, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小、小熊喵！？那种眼神……呃……那个……”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2065", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“对、对了，吃饭！喂它吃饭吧！”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 392, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 127, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“说的也是，来吃饭吧！”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 411, "voice": "mu2066", "char_id": "みう"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一看到那种满心期待的表情……我就无法继续抱下去了。", "text_idx": 373, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 129, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～♪”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 398, "voice": "pn0403", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_22.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在熊喵面前，我们就是会莫名地害羞呢……", "text_idx": 378, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
