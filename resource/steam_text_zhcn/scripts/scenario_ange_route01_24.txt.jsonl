{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 0, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“哈……噗嗯！”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2115", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 1, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……早安，主人。”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2116", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被嘴唇上的触感唤醒，睁开眼睛后我看见低头看着我微笑的安洁。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我立刻发现自己不是躺在枕头上──而是安洁柔软的大腿上。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈哈。”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "比起早安，我反而先笑了出来。", "text_idx": 413, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安……你居然学会了这种技巧啊，安洁。”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "让我躺在大腿上，然后用吻叫醒我。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……对了，这也有写在‘第一次的To Do list’上呢。”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 9, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“您有舒服地醒来吗……？”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2117", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯……安洁的吻和大腿都好舒服……”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 11, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁也好舒服……”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2118", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“可以感受到主人的体温和重量，躺大腿非常地……”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2119", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喜欢？”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的……最喜欢了。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2120", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 15, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“主人……最喜欢你……嗯。”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2121", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她弯下腰，又吻了我。", "text_idx": 401, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个姿势让安洁丰满的胸部又软绵绵地压到我的额头上。", "text_idx": 422, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被柔软上下包夹的吻。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 19, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呼……”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2122", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "嘴唇离开后，安洁的微笑变得更加陶醉了。", "text_idx": 398, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在这么舒服的唤醒之后，我已经完全没有睡意，身心都酥软了……", "text_idx": 399, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 22, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“主人的头发睡到乱翘了。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2123", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 23, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“帮您整理喔……嘿咿嘿咿♪”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2124", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈哈，我的头发原本就很会翘了。”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 25, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“主人的头发好蓬松，安洁很喜欢喔！”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2125", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 26, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不对，清爽的脸颊、鼻子、额头也……”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2126", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁的手指留恋地在我的头发和脸上滑动。", "text_idx": 403, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所谓的爱抚……就是指这种行为吧。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不禁这么想。", "text_idx": 406, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为想要像这样卿卿我我，所以稍微提早叫醒我了对吧，哈哈。”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 31, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“被您看穿了！？”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2127", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为我的女仆很机伶。”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2128", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 34, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呵呵……那也是因为有非常非常优秀的主人在的缘故～♪”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2129", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊哈哈，好痒好痒！”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 36, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“因为安洁很机伶，所以不会中途停止喔～”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2130", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──刚睡醒就用尽全力嬉闹。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "撑起身体，我感觉到通体舒畅。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯……这是安洁的效果吧……”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好！感觉今天能表现得不错呢。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 41, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呵呵，那就太好了。”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2131", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 42, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“今天开始就是考试期间了呢，主人。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2132", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“结束之后……”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2133", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯……”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一想到这里，就更有干劲了。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 47, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好！赶快去梳洗吧。”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 48, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“好的，主人。安洁和樱乃学妹也去准备了。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2134", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 49, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“对了安洁，考试没问题吗？”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“请不要提起这件事主人！求求您了～～～！”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2135", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都鼓足了干劲的样子。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 52, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“和期中考不同，没有让爱理盯着念书。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "樱乃", "alt_speaker_idx": 412, "voice": "sk0998", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“结果只有那一天一起念而已。”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 54, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“所以正是展现实力的时候。”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 412, "voice": "sk0999", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 55, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“喔喔，很优秀的志气呢樱乃学妹！”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2136", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 56, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“总之不要不及格就好。”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 412, "voice": "sk1000", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 57, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“目标这么低！？”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2137", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“与其说展现实力，应该说露出马脚吧……”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 59, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，早安～三位。”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0421", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 60, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜！”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 414, "voice": "pn0117", "char_id": "ぱんにゃ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安，熊喵也早安。”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 62, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“考试期间开始的早晨莫名地让人紧张呢。”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0422", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 63, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“说的没有错。安洁已经因为各种事非常紧张了。”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2138", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 64, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“比如说叫醒哥哥？”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 412, "voice": "sk1001", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 65, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊哈哈哈哈，那就不限于今天了～”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2139", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“呵呵，你们两人感情很好呢。”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0423", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 67, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“对了瓜生君，虽然期中考的时候曾说过期末考结束后也来开庆祝会……”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0424", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，是的。”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“这次就跟小菜夏悠闲地过吧？”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0425", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……天羽学姐。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“最初的时候最重要喔，对吧～小熊喵。”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0426", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 72, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“呜噜～”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "熊喵", "alt_speaker_idx": 414, "voice": "pn0118", "char_id": "ぱんにゃ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 73, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“喔、喔？在说什么呢？请让安洁也加入话题！”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2140", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 74, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“在说今天是第一天最重要。好，我也加油吧！”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 418, "voice": "mu0427", "char_id": "みう"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 75, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“考试期间回去各务台你觉得怎么样？”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0359", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那是逃亡吧。”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 77, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“说的也是，也就是说必须豁出去了啊。”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0360", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 78, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“那安洁呢？这次也能考好吗？”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0361", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 79, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊哈哈，虽然没有什么自信……”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2141", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 80, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“但是为了不丢主人的脸，安洁会尽全力的！”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2142", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 81, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“喔，很棒欸。你现在闪闪发光喔。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0362", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 82, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“我也为了女朋友尽全力加油好了……这样想的话考试感觉就很热血欸。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0363", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 83, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喔，隼太也提起干劲了啊……乾同学状况怎么样？”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 84, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“唔哈哈，小乾要为了学姐吗？”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0364", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 85, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不要跟我说话废渣！会害我把背起来的东西忘掉啦，白痴！”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "纱凪", "alt_speaker_idx": 417, "voice": "sn0376", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 86, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“散发出了杀气呢。好可怕，抖抖抖。”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2143", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 87, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 415, "voice": "ar4083", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 88, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那边展开了冰冷又犀利的气场！？”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2144", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 89, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“请不要把人说得像冷血动物一样。”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 415, "voice": "ar4084", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 90, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不过，这次跟上次不同，可以和以前一样一个人专心念书。”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "爱理", "alt_speaker_idx": 415, "voice": "ar4085", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 91, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“的确，这股气场是以前的爱理同学。”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2145", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“期中考的时候是特殊状况啊……”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 93, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不管什么时候都是特殊状况喔。你们每天不也是这样？”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 415, "voice": "ar4086", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 94, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2146", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……被你这么一说，感觉又更绷紧神经了。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 410, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 96, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然某种程度上我是故意这么说的。”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 415, "voice": "ar4087", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 97, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“感谢提醒。”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "隼太", "alt_speaker_idx": 423, "voice": "ht0365", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 98, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好了，把每天累积的努力成果彻底发挥出来吧。”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 415, "voice": "ar4088", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 99, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……是！”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 402, "voice": "ag2147", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 100, "speaker": "万智", "flag": 64, "pages": [{"page": 0, "text": "“好、好～早安～大家都做好了准备了吗～”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "万智", "alt_speaker_idx": 396, "voice": "mc0222", "char_id": "万智"}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样，期末考开始了。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_24.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为了放心地迎向“将来”，每一天都是重要的积累。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
