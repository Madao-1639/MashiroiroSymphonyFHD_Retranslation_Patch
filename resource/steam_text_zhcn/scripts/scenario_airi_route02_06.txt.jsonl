{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“打扰了……”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，你先开始了啊。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 2, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嗯……”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2992", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我进来的时候，爱理正在振笔疾书。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“后天终于要开始考试了。我希望能考得不会后悔。”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2993", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──因为顺利地完成了“第一次”。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这几天爱理心无旁鹜地集中在念书这件事上。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她手边叠了好几本参考书，看来在我来之前，她已经用功好一会了。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 8, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“爱理真的很认真呢。”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2994", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“当然啦。”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2995", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "听到我无意中说出的话，爱理哼了一声回答。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我是濑名爱理喔。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2996", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……认真、古板、可靠。班上所有人都认同的优等生。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过我知道，她不是个只有这样的女孩子。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，你很努力。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“能听你这么说，我很高兴。”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2997", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉喔。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2998", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了？啊，总之我先坐到暖桌里喔。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 19, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……那之后就没了。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar2999", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……呃，嗯。”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 21, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但、但是啊，我真的觉得对新吾很抱歉。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3000", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 22, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“考试结束前，不要做色色的事情喔。”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3001", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "自从“第一次”之后，我们就没有爱爱过了。", "text_idx": 340, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过这不是爱理需要道歉的事……", "text_idx": 301, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我懂的，我也这么觉得。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 26, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嗯……谢谢你。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3002", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然很遗憾，但是这一点实在没办法。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且，我们已经结合了。因为清晰地体认到这点，所以能克制住。", "text_idx": 339, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──就这层意义上来说，在考试前完成结合太好了。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……那个，而且还有点痛……”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3003", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔……什、什么！那句话犯规了！”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“欸！？为为、为什么？”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3004", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“会让我想抱住你跟你说抱歉……”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊唔……”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3005", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 35, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好、好了来念书吧！！要是现在接吻或做什么的话，我们就没办法回到用功状态了！”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3006", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“说、说的也是……因为爱理立刻就会沉迷其中。”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 37, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……新吾才是立刻就会变大的说。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3007", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好了来念书吧！”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 39, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“色狼、色狼～♪我知道的喔，只有我知道……”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3008", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 40, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……话说回来，爱理这么努力，所以我也不能松懈。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管是身为男朋友，还是身为班级干部的伙伴。我拿出纸笔用具，和爱理一样开始念书。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 42, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……看到新吾这么认真，我也能加油了。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3009", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 43, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好……”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3010", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理也重新鼓起干劲，再次集中精神在手边的笔记本上。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 45, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“考试结果，等着看吧，妈妈……”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3011", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这句喃喃自语，让我的胸口莫名地难受。", "text_idx": 347, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 48, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……呼。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3012", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“饭好像煮好了。新吾，抱歉再等一下，这边结束后我想把那些分成小份。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3013", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "听到提醒的电子音，爱理从浴室探出头。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她正在打扫浴室。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯……”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“一次煮好再分成小份冷冻起来，之后要用就很方便了……”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3014", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在读书的空档，爱理还很努力地做家务。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……一个人生活好辛苦。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且她还有打工。", "text_idx": 338, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明这么忙，她还是认真念书，一直维持着优秀的成绩。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……白饭由我来分吧？”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊……谢谢，帮了我好大的忙！分成一碗一碗的量用保鲜膜包起来放着，不热了之后我会放进冷冻库……”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 48, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3015", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……她真的很努力呢。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理一直是这么努力。我根本无法不出手帮她。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我想支持爱理的努力。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身为男人、身为男朋友，这是我该做的吧。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“可是……”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "‘考试结果，等着看吧，妈妈……’", "text_idx": 230, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这份努力……果然是为了做给学园长看吗？", "text_idx": 345, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那明天见了，爱理。”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊……等一下。”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3017", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 71, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啾。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3018", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 72, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔。”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 73, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……晚安，新吾。”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3019", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔、嗯，晚安。”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 329, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 75, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“呵呵……”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3020", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "新吾真是的，脸好红喔。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "他对偷袭没辄啊。……真可爱。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“明明平常总是那样宠我……真是的，好喜欢、好喜欢你喔，呵呵、呵呵呵～”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3021", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──所以我才能这样努力。", "text_idx": 298, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我，已经不是一个人了。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "有最喜欢的人，我是用全身与那个人相爱的女人。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 82, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好……”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3022", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我回味着新吾温柔的嘴唇的触感，重新鼓起干劲，再次开始念书。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "念书念得很顺利。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "感觉确实吸收了知识，越来越集中精神。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样……就这样……", "text_idx": 318, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这次也，拿第一名……", "text_idx": 348, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 88, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……好冷。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3023", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "寒意让我发抖。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今晚好像会变得更冷。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 91, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“妈妈，有好好保暖自己吗……”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3024", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 92, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3025", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然。", "text_idx": 337, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "想起了妈妈。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 95, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……要不要偶尔打个电话呢？”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3026", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "产生了这个想法。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么呢？", "text_idx": 302, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，很在意──", "text_idx": 307, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 99, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘……喂。’", "text_idx": 224, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0220", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 100, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那、那个，我是爱理──”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3027", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 101, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘干嘛这个时间打来？’", "text_idx": 228, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0221", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 102, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3028", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "冷淡的声音。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我反射性地绷直背脊。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 105, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3029", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 106, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘有什么事？’", "text_idx": 229, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0222", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 107, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那个……有点在意。因为今晚很冷……”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3030", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 108, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘为了那种事打电话来真稀奇呢。而且还是在考试前这种时期。’", "text_idx": 225, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0223", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我知道。我自己也不懂为什么要这样。", "text_idx": 293, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，你也没有必要那样说吧……", "text_idx": 306, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 111, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘你才是怎么样了？有好好生活吗？’", "text_idx": 226, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0224", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 112, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“当……当然了，因为我不是妈妈！”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3031", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 113, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘喔……’", "text_idx": 227, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0225", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 114, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3032", "char_id": "愛理"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 115, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘说完了吗？’", "text_idx": 231, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "兰华", "alt_speaker_idx": 309, "voice": "rk0226", "char_id": "蘭華"}]}
{"script": "scenario_airi_route02_06.txt", "scene": "*start", "row": 116, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 334, "voice": "ar3033", "char_id": "愛理"}]}
