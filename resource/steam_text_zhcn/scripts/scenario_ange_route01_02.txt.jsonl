{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 0, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欢迎回来～欢迎回来～”", "text_idx": 450, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0688", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 1, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“今天也在呢。”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0669", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 2, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“早啊，安洁～”", "text_idx": 441, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0259", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 3, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊……！”", "text_idx": 397, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0689", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一看见我们，手上拿着竹扫帚的安洁就跑了过来。", "text_idx": 487, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 5, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“首先是隼太同学，欢迎回来！”", "text_idx": 477, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0690", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 6, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“喔～哈哈，果然安洁的招呼听了很舒服很棒呢！”", "text_idx": 404, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0260", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 7, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“喔喔，安洁很舒服吗？”", "text_idx": 403, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0691", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 8, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“啊啊，今天把回各务台的事安排晚一点真是太正确了。果然早晨就是需要安洁啊～”", "text_idx": 400, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0261", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 9, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁就像咖啡一样的存在呢！”", "text_idx": 421, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0692", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的确是会让人精神一振的女孩。", "text_idx": 507, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隼太含闲聊的招呼（？）结束后，安洁转向了樱乃。", "text_idx": 546, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“樱乃学妹，欢迎回来～”", "text_idx": 448, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0693", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 13, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“早安，星期五很开心呢。”", "text_idx": 442, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0670", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的！非常开心～光是想起来安洁就好像要脱皮了。”", "text_idx": 446, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0694", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“现在是冬天，保养肌肤很重要。”", "text_idx": 456, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0671", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 16, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“正是如此呢。那么还是控制一下脱皮好了。”", "text_idx": 452, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0695", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 407, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0672", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 18, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“中午再去找你们玩喔。”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0673", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 19, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“好的，安洁会等着。”", "text_idx": 419, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0696", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 20, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“……这两个人的对话明明超脱常轨，但又能确实沟通真厉害啊。”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0262", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真的。是安洁厉害还是樱乃厉害呢？", "text_idx": 530, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "接着安洁转向我。", "text_idx": 519, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我回来了，安洁早安。”", "text_idx": 435, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 24, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欢迎回来，新吾同学。”", "text_idx": 449, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0697", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 25, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0698", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 413, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 27, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……欸嘿。”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0699", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 28, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“～♪～～♪”", "text_idx": 479, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0700", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……你今天心情很好呢。”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 30, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也笑了。", "text_idx": 513, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她对我没有说其他话，取而代之的是灿烂的笑容和轻盈的脚步。", "text_idx": 505, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就好像在说对我不需要多余的言词……", "text_idx": 510, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“新吾同学感觉怎么样呢？”", "text_idx": 440, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0701", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 34, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我今天也心情很好喔。”", "text_idx": 411, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没错，连我都雀跃起来了。", "text_idx": 524, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为一早就看见了心情很好的安洁。”", "text_idx": 416, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 37, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呵呵……”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0702", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 38, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“对新吾就只有简单的招呼啊。”", "text_idx": 423, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0263", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 39, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“是我们赢了。”", "text_idx": 444, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0674", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 40, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，新吾同学输了。怎么办呢？”", "text_idx": 391, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0703", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为心情好所以没关系。”", "text_idx": 417, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 42, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“真是心胸宽大呢～”", "text_idx": 459, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0704", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们开玩笑地聊了几句，情绪也越来越开心了。", "text_idx": 515, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "可以感受到安洁比起以前又更和我们打成一片了。", "text_idx": 493, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 45, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那么安洁要继续执行早晨的任务了。大家待会见～”", "text_idx": 472, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0705", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，加油喔。待会见。”", "text_idx": 409, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──我们的好心情不只有在校门口。", "text_idx": 481, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 48, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“感觉……好自然喔。”", "text_idx": 431, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0706", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 49, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在等早上班会开始的时候，安洁在我耳边轻声说。", "text_idx": 502, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我立刻就明白她的意思。我点了点头，视线看向前方。", "text_idx": 518, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 51, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好期待考试的结果全部发下来的时刻。”", "text_idx": 418, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3731", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“真是的，没问题的啦。绝～对比这群渣虫考得更好！”", "text_idx": 460, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0214", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 53, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“喔～真敢说～那我真的开始期待了！”", "text_idx": 405, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0264", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 54, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“也是，对于教你们念书的我来说，当然希望你们都考到好成绩。”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3732", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 55, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔……压力好大……”", "text_idx": 392, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0215", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除去不是同班的另外两人（和一只），上周庆祝会的成员们今天也像这样谈天说笑着。", "text_idx": 544, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 57, "speaker": "結女生徒Ａ", "flag": 64, "pages": [{"page": 0, "text": "“濑名同学今天也跟瓜生君他们在一起呢……”", "text_idx": 454, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "结女学生A", "alt_speaker_idx": 537, "voice": "ja0053", "char_id": "結女生徒Ａ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 58, "speaker": "結女生徒Ｃ", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君、椋梨君，待会也要跟我们说话喔～”", "text_idx": 457, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "结女学生C", "alt_speaker_idx": 539, "voice": "jc0048", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到我们讨论得热烈，班上同学也加入了。", "text_idx": 529, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，待会就过去那边喔～”", "text_idx": 410, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 61, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“感谢您的指名！”", "text_idx": 433, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0265", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 62, "speaker": "汎用", "flag": 64, "pages": [{"page": 0, "text": "“我们才是～”", "text_idx": 434, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "全员", "alt_speaker_idx": 490, "voice": "go065", "char_id": "汎用"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 63, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……变得很受欢迎呢，这两个人。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3733", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 64, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“真是的，这群公的有哪里好啊……光是说话就感觉到贞操危机了，对吧？”", "text_idx": 461, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0216", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 65, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呵呵，完全融入对话中的小纱同学就算这么说也……”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0707", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 66, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不过不管是瓜生君还是椋梨君，不会在聊到一半就跑走这点值得称赞。”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3734", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 67, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“讨厌～哈哈哈，当然啦！”", "text_idx": 467, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "隼太", "alt_speaker_idx": 545, "voice": "ht0266", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你觉得我们是那种人吗？”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“要是觉得就不会像这样跟你们说话了。那么，接下来──”", "text_idx": 466, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3735", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──的确非常地“自然”呢。", "text_idx": 483, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学的变化已经在大家心里留下了印象，受此影响，结女的学生们已经对我们抱持友善的态度了。", "text_idx": 525, "plain": null, "plain_idx": null, "len": 45, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 72, "speaker": "各務台男子Ａ", "flag": 64, "pages": [{"page": 0, "text": "“你看了吗？昨天那集！”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "各务台男生A", "alt_speaker_idx": 495, "voice": "da0042", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 73, "speaker": "結女生徒Ｂ", "flag": 64, "pages": [{"page": 0, "text": "“看了看了！那两个人之后到底会怎么样啊……！”", "text_idx": 458, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "结女学生B", "alt_speaker_idx": 538, "voice": "jb0030", "char_id": "結女生徒Ｂ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 74, "speaker": "各務台女子Ａ", "flag": 64, "pages": [{"page": 0, "text": "“啊哈哈，没想到会有跟结女的大小姐们热烈讨论连续剧的这一天到来啊～”", "text_idx": 398, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "各务台女生A", "alt_speaker_idx": 494, "voice": "sa0039", "char_id": "各務台女子Ａ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不只是我们。教室中不分男女，大家都聊得很开心。", "text_idx": 488, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在一个月前完全无法想像的，极其普通的男女混校的气氛。", "text_idx": 499, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "进入１１月以后，我们２－Ｔ就像这样，和１０月完全不一样了。", "text_idx": 543, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“怎、怎么了？瓜生君。”", "text_idx": 428, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3736", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 79, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊、没有……嗯，只是有点。”", "text_idx": 399, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 80, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“反正一定是在想色情的事吧？男生就是这样啦，啊～讨厌讨厌！”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0217", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 81, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呵呵……”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0708", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在我们这群人中，能敏锐察觉到转变的人似乎只有我和安洁。", "text_idx": 500, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──新吾同学跟安洁有某方面很相似。", "text_idx": 482, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "嗯，这种视线也是“某方面”的其中之一吧。", "text_idx": 498, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 85, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在经常相处的同学中，会对这女孩特别感到伙伴意识果然不是没有原因的……", "text_idx": 503, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 86, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“接续星期五，又全员到齐了呢。”", "text_idx": 439, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0311", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到了午休时间，学姐和熊喵、樱乃也加入了我们。大家围着桌子。", "text_idx": 491, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……虽然想这么说，但椋梨君回各务台了吧？”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0312", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，刚才回去的。好像有必须在今天完成的工作。”", "text_idx": 408, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身处这种特殊情况下的学生会长真辛苦。", "text_idx": 541, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯～椋梨君真可惜……可以帮忙转告他下次再一起吗？”", "text_idx": 414, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0313", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道了，那家伙会很高兴的。”", "text_idx": 437, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 93, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“总之，有好好地送他出门了喔！”", "text_idx": 429, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0709", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 94, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“安洁的‘请慢走’，用在椋梨君回各务台的时候一点违和感也没有，真好呢。”", "text_idx": 422, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3737", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 95, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“要是椋梨那混帐可以就这样不回来，渣虫的数量减少就更好了……”", "text_idx": 465, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0218", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 96, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“隼太学长回来的话就增加了。”", "text_idx": 476, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0675", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 97, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“可怕！”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0219", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 98, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“而且还会把作物啃得乱七八糟呢。”", "text_idx": 463, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0710", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 99, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“蝗虫吗？”", "text_idx": 464, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3738", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 100, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“椋梨君真厉害呢，小熊喵。”", "text_idx": 447, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0314", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 101, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～噜～”", "text_idx": 415, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "熊喵", "alt_speaker_idx": 526, "voice": "pn0097", "char_id": "ぱんにゃ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的朋友渐渐变成谜之生命体了。", "text_idx": 517, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "总之，虽然少了一个人，但大家还是气氛融洽地吃着午餐。", "text_idx": 511, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 104, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“庆祝会好开心呢～”", "text_idx": 426, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0315", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "中心人物果然还是天羽学姐。", "text_idx": 489, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 106, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个人的天然属性所营造出的和平时空，与这种午饭时光实在非常契合。", "text_idx": 542, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢谢。听学姐这么说，提案就有价值了。”", "text_idx": 468, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 108, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“不，我也要说谢谢喔。”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0316", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 109, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小爱理，你说过那是第一次对吧？其实那样的庆祝会我也是第一次呢。”", "text_idx": 424, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0317", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 110, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊……是这样吗？”", "text_idx": 396, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3739", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 111, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“呵呵，所以才更觉得开心，对吧？”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0318", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 112, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这、这个……是啊……”", "text_idx": 470, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3740", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 113, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理害羞了。”", "text_idx": 455, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0676", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 114, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这样的爱理很稀有呢。美羽学姐，多说一点！”", "text_idx": 471, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0220", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 115, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你们喔！”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3741", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到因为濑名同学的反应而起哄的女生们，天羽学姐笑得更开心了。", "text_idx": 528, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 117, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“如果能那么开心的话，就算每个礼拜都考试也可以呢。”", "text_idx": 420, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0319", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 118, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那那那是什么恐怖的事情！”", "text_idx": 474, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0711", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 119, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“拜、拜托请不要那样……”", "text_idx": 438, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0221", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 120, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，我倒觉得无所谓喔？庆祝会的参加者只有我跟学姐了吗？”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3742", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 121, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“是我错了啦爱理～！”", "text_idx": 445, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0222", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是个会反击的女孩呢。", "text_idx": 506, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“希望下次还有机会能跟大家一起庆祝。”", "text_idx": 425, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 124, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯♪好期待期末考的来临呢。”", "text_idx": 406, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0320", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 125, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“呵呵，真期待呢，两位。”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3743", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 126, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔唔唔……”", "text_idx": 394, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0223", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 127, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“明明期中考的结果都还没有发回来……”", "text_idx": 443, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0712", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纯真无邪的天羽学姐，以及被自己抛的梗逼到绝境的乾同学＆安洁。", "text_idx": 535, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 129, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，对了。大家听我说，今天……”", "text_idx": 401, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0321", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 130, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽学姐拿出了一个袋子。", "text_idx": 504, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 131, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“锵～有饼干喔！”", "text_idx": 475, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0322", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 132, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喔喔！？是、是美羽学姐亲手做的吗！？”", "text_idx": 402, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0224", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 133, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，欸嘿嘿，因为妈妈在做饼干，所以我也顺便一起做了。”", "text_idx": 412, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0323", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 134, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“想说今天大家也会聚在一起，所以就带来了。大家愿意的话饭后来吃吧？”", "text_idx": 430, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "美羽", "alt_speaker_idx": 540, "voice": "mu0324", "char_id": "みう"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 135, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“当然愿意了～！！”", "text_idx": 427, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "纱凪", "alt_speaker_idx": 536, "voice": "sn0225", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 136, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在渐渐恢复和乐的气氛中──", "text_idx": 501, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 137, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔唔……还是一样这么优秀的体贴方式，美羽学姐……！”", "text_idx": 393, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0713", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 138, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有安洁一个人被败北感打击到了。", "text_idx": 492, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……安洁，那我们去准备配点心的茶吧？”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 140, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我对她说。", "text_idx": 516, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 141, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──不知道为什么，比起其他人的反应，我更快注意到安洁的情绪。", "text_idx": 480, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 142, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欸……啊……”", "text_idx": 451, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0714", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我来帮忙。茶点餐具放在那边对吧？”", "text_idx": 436, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 144, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊……是、是的。”", "text_idx": 395, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0715", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 145, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那安洁和新吾同学去准备茶喔。请各位稍等一下～”", "text_idx": 473, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0716", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 146, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“走吧，新吾同学！”", "text_idx": 469, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 508, "voice": "ag0717", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 147, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁恢复了笑容，充满活力地站了起来。", "text_idx": 509, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 148, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 407, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 520, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也笑了，跟她一起。", "text_idx": 514, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 150, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3745", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 151, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“真稀奇呢，那女孩。”", "text_idx": 462, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3746", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 152, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“？”", "text_idx": 478, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0678", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 153, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“没事，什么都没有。”", "text_idx": 453, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3747", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 154, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“感谢地等茶来吧。”", "text_idx": 432, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 527, "voice": "ar3748", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_02.txt", "scene": "*start", "row": 155, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 407, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 522, "voice": "sk0679", "char_id": "桜乃"}]}
