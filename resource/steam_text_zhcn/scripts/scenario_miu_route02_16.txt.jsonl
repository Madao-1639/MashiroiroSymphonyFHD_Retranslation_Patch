{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，你醒了吗？”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃？”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……不在啊。”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近，跟樱乃说话的机会减少了。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然跟美羽学姐相处的时间变多，但是不能因此就失去兄妹间的交流。", "text_idx": 319, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“她先出门了吗……”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不知从什么时候开始，我已经习惯一个人上学了。", "text_idx": 288, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要去社团教室就能遇到人。", "text_idx": 295, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要去社团教室就能见到美羽学姐。", "text_idx": 294, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但是，为什么呢？", "text_idx": 283, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "习惯这件事的自己有些许的寂寞。", "text_idx": 291, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安，学姐。”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 13, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊……早安，新吾君。”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1789", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐站在兔子小屋前，好像在找什么东西的样子。", "text_idx": 301, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么了吗？”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 16, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我在找小熊喵……”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1790", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊，熊喵的话我昨天早上有在社团看到它。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 18, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸，真的吗？太好了，它没事……”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1791", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然脸上带着微笑，但学姐双手交握在胸前，有点寂寞的样子。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你还没给它吗？尾巴的新饰品……”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 21, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。而且现在变得这么冷，好担心它晚上有没有问题。”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1792", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我们不在的时候，熊喵都在做什么呢？”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 23, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1793", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "连在图鉴上都没有看过，生态成谜的生物。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只知道算是猫科的吧，大概……", "text_idx": 293, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊……学姐，会冷吗吗？”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看到学姐呼出白色的气息，我就想握住她的手。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "直接抱住还有点不好意思就是了。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 29, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，这样会很温暖喔。”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1794", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 31, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……学姐主动抱住了我。", "text_idx": 284, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "令人安心的气味。", "text_idx": 292, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为身高差距，所以学姐踮起脚尖靠在我身上。", "text_idx": 296, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样抱着她转圈试试好了？啊哈哈、唔呼呼呼……像在花田里一样。", "text_idx": 302, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 35, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……抱歉喔，突然抱住你。”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1795", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没关系，只是有点吓一跳而已。没想到学姐会这么做……”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 37, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我这样不行吧。因为年纪比你大，所以要忍耐才对。”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1796", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我也是在学校的时候，一直在忍耐。”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 39, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……是吗？”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1797", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“当然了。”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 41, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“太好了……我好害怕。”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1798", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“害怕？”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 43, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“因为新吾君最近都好冷静，我想说你是不是对我腻了……之类的。”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1799", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不对不对不对不对！”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我全力否定。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“昨天不是也说过了吗？我最喜欢美羽学姐……”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1800", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不相信我吗？”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 49, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“不，不是那样的。但是，好像变得贪心了……”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1801", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的脸颊浮现红晕。", "text_idx": 300, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 51, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“光是说喜欢新吾君，好像已经不够了♪”", "text_idx": 228, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1802", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐……”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 53, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也是。", "text_idx": 303, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管嘴巴上说了多少喜欢，翻涌的情绪还是停不下来。", "text_idx": 289, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以才会牵手、拥抱、亲吻。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们沉默下来，亲吻对方。", "text_idx": 304, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好想一整天都跟学姐在一起。", "text_idx": 299, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 58, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐，我也一起找熊喵……”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1476", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 59, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔欸，新吾来了啊。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1477", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……但是现实没有那么美好。", "text_idx": 282, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安，纱凪。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 62, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……哼嗯。”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1478", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“什么？怎么了？”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 64, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“没有啊。美羽学姐，我们去那边找吧？”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1479", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 65, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，嗯，说的也是。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 316, "voice": "mu1803", "char_id": "みう"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她很明显就是要把学姐从我身边抢走。", "text_idx": 297, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她是真心祝福我们的吗……", "text_idx": 298, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 68, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呐，你跟美羽学姐真的在交往吗？”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1480", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“突然问这个？”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "下课时间，纱凪把我叫来走廊，然后没有任何铺陈就问了。", "text_idx": 287, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 71, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“至少我是觉得有交往啦。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你应该没有妄想症之类的吧？”", "text_idx": 224, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1481", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你觉得我是一个擅自妄想跟学姐交往的神经病？”", "text_idx": 226, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 74, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我又没有说到那种程度。”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1482", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 75, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“可是有些人光是对上视线就以为对方喜欢自己不是吗？”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1483", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 76, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“比如在夏天穿着长大衣里面全裸的男人之类的。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1484", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……那种人应该非常罕见吧。”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我搞不懂纱凪到底想说什么。", "text_idx": 306, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 79, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯……这该不会是……”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1485", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“你到底怎么了？”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 81, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1486", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“干嘛一直盯着我……”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 83, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“或许不行了吧。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1487", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“蛤？”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 85, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“一般来说，情侣是更甜甜蜜蜜，不分场合就卿卿我我的才对吧？”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1488", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 86, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“路上也能常常看到在亲亲的情侣呢。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1489", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，是有看过。”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 88, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但今天早上的美羽学姐是怎么回事？那么冷静，跟平常一样嘛。”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1490", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 89, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那不是恋爱中的女人的表情。真的在谈恋爱的话，胸口应该要更揪紧才对。”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1491", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 90, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“光是跟喜欢的男人四目相对，就会想一整天都把他监禁在房间里为所欲为。”", "text_idx": 229, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1492", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那种恋爱也太糟糕了。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且还是被女孩子做到那种程度。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 93, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你是不是包容力不够啊？”", "text_idx": 225, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1493", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 94, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“包容力？”", "text_idx": 230, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 95, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“如果是情侣，一般来说要更迷恋才对吧。”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1494", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……我觉得很迷恋了啊。”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 97, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不对，学姐没有迷恋。”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1495", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 98, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“如果她真的喜欢新吾，就算在我面前应该也会跟你卿卿我我才对。”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1496", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐会顾虑别人的眼光啊。而且她也不是会在大家面前那样做的个性。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 100, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我～就～说～了，能把那些顾虑都破坏殆尽沉迷其中的才叫做恋爱啊。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1497", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唉……”", "text_idx": 234, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "为什么我要被她教导什么是恋爱啊？", "text_idx": 290, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 103, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……虽然如果学姐能变成那样是很厉害啦。", "text_idx": 285, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 104, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这表示还能把美羽学姐抢回来吗……？”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1498", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不不不，那不可能。”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 106, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“谁知道呢？好男人是能用眼神就杀死一个女人的呢～”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1499", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“用眼神……”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "拿纱凪来练习看看。", "text_idx": 308, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "瞪她就可以吧？瞪她。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 110, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔！？”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1500", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 309, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_16.txt", "scene": "*start", "row": 112, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“喂！你不准杀我啦！”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 315, "voice": "sn1501", "char_id": "紗凪"}]}
