{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 0, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "‘有了喜欢的人。’", "text_idx": 275, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2472", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃那样说之后过了几天。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "从那天起樱乃的态度……完全没变。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那句话是真心的吗？还是“喜欢的人”的意思，跟我以为的不一样……？", "text_idx": 415, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "总之樱乃表现得跟平常一样。", "text_idx": 393, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 6, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对，樱乃的态度没有变。", "text_idx": 392, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "改变的……是我。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我一直很在意那句话，在意樱乃的态度。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "以前她从来没说过这种事情。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然只是我自己觉得，但樱乃好像对恋爱没什么兴趣……", "text_idx": 413, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 12, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“你的表情很有趣喔。”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "隼太", "alt_speaker_idx": 416, "voice": "ht1026", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……但是笑不出来吧？”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 14, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“什么嘛，有自觉啊。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "隼太", "alt_speaker_idx": 416, "voice": "ht1027", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“所以，有什么事吗？”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 16, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“已经午休了，你没有注意到吗？”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "隼太", "alt_speaker_idx": 416, "voice": "ht1028", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸……？”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我环顾四周，教室里一片热闹嘈杂。", "text_idx": 398, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "咦……？", "text_idx": 389, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天的课是上什么？", "text_idx": 385, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 21, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你怎么了，一直发呆。该不会是感冒了？”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5250", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 22, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我没有不舒服。”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 23, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那就快点走了。学生食堂会没位子。”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "纱凪", "alt_speaker_idx": 412, "voice": "sn2135", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 24, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“樱乃也先去等我们了。”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5251", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊……嗯，也对。”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 26, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5252", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 27, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“变冷了呢。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5253", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理缩了缩肩膀。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“风变冷了，与其说秋天感觉已经是冬天了。”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2473", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然不讨厌冬天，但是今年好像会讨厌了。”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5254", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 31, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……暖气费？”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2474", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“意外地很贵喔。从家里拿毛毯来好了。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5255", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 33, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我家也有，需要的话给你用吧？”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2475", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“也好，如果需要我会问你的。”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5256", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 35, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，随时都可以跟我说。”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2476", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是说，樱乃真的很平常的样子呢。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5257", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 37, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“因为我喜欢现在这种温度。”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2477", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 38, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这样啊，有点羡慕你呢。”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5258", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 39, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理，不喜欢？”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2478", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 40, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不适应这种温度。”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5259", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 41, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……我抱紧你吧？”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2479", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 42, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那种事，你去对瓜生君做吧。”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5260", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 43, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊唔……”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2480", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 44, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……你好像变得更热了。”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5261", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 45, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“脸，发热了。”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2481", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 46, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“如果对瓜生君也是这种反应，应该立刻就会被发现了吧。”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5262", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“在哥哥面前，我表现得很普通。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2482", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 48, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……办得到吗？”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5263", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“靠气势跟毅力。”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2483", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 50, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这两个词都感觉跟樱乃无缘呢。”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5264", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“之前想表现得普通但是失败了。”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2484", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 52, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不要去想好像是最好的。”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2485", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 53, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“顺其自然就对了？”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5265", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 54, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2486", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 55, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但是，好像没有很顺利喔。”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5266", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 56, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2487", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 57, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“但是，为什么你知道？我跟平常一样吧。”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2488", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 58, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君的态度。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5267", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 59, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格，有什么奇怪吗？”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2489", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 60, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好像回到之前在烦恼什么的时候一样，一直在想事情。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5268", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 61, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君对其他事情都能笑着处理，只有一件事深深烦恼着。”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5269", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 62, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不过，这也表示那究竟有多特别啦……”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5270", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理看着我。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 64, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以说，樱乃，你对瓜生君做什么了吧？”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5271", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 65, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯……我对葛格说我有喜欢的人了。”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2490", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 66, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊，他怎么回答？”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5272", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 67, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不是。我只对葛格说‘有喜欢的人’而已。”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2491", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 68, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5273", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "爱理一脸惊讶。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 70, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“都说到那样了还不告诉他啊？”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5274", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 71, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“果然……还是说不出口。”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2492", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 72, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然我懂你的心情。”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5275", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她苦笑了一下。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 74, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但是看瓜生君的反应，感觉现在立刻告诉他也没关系的说。”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5276", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 75, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“是吗？”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2493", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 76, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然只是我自己这么认为。”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5277", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 77, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……要决定的人是我自己？”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2494", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 78, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“对。不过我随时可以听你商量喔。”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5278", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 79, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“有什么我能帮忙的事情吗？”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5279", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 80, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……因为这是我第一次恋爱，希望你教我该做什么才好。”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2495", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 81, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5280", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 82, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理的话，一定恋爱经验丰富。”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2496", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 83, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“没有那种事喔。我……那个……”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5281", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 84, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理也跟我一样？”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2497", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 85, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……没错。不，或许我比樱乃更没经验。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5282", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 86, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“因为我又没有喜欢上谁过。”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5283", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 87, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“有点惊讶。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2498", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 88, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“但是这种时候，该怎么办呢？”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5284", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 89, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“知己知彼，百战百胜。”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2499", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 90, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“虽然不太对，但好像相去不远呢。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5285", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 91, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“所以只要知道葛格的事，一定就没问题。”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2500", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 92, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我觉得没有女孩子比樱乃更了解瓜生君了。”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5286", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 93, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格的事，我也不是全部都知道。”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2501", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 94, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以你才会总是看着瓜生君吗？”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5287", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 95, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……有一直看着吗？”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2502", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 96, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你没有自觉？”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5288", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 97, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "温柔的微笑。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 98, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，你的眼神总是追着瓜生君喔。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5289", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 99, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“如果真的一直看，葛格应该会注意到。”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2503", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 100, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“如果从小就一直那样呢？”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5290", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 101, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2504", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 102, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“至少，从我跟樱乃第一次见面的时候起，你就一直是那样了。”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5291", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 103, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……我没有意识到。”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2505", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 104, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“一开始我只以为是‘喜欢哥哥的妹妹’而已。”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5292", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 105, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以瓜生君也没注意到吧？”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5293", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 106, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“很有道理……”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5294", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 107, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不过最近的樱乃看起来有恋爱中少女的感觉就是了。”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5295", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 108, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理在调侃我？”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2506", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 109, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“才不是。首先要知己，对吧？”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5296", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 110, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……的确，或许我知道了不认识的自己。”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2507", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 111, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以说，接下来去知道敌人瓜生君就好了。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5297", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 112, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“该怎么做才好呢？”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2508", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 113, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这个嘛，比如说──”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 406, "voice": "ar5298", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 114, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊、嗯。我知道了，好……”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "呼……", "text_idx": 388, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 116, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“电话？”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2509", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 117, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，是濑名同学。”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 118, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2510", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 119, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“结女的人问了她很多事，为了省事她想整理好一次问我。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 120, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“问葛格的事？”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2511", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 121, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好像是呢。”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 122, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这样的话身为妹妹不能输。我也想知道各种事。”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2512", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃连我自己没注意的事都知道，应该没有你不知道的事情吧？”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 124, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格也知道我不知道的我，你知道我的全部吗？”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2513", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……是啊。”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 126, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们是兄妹，同时也是男与女。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一定有很多彼此不知道的事情……", "text_idx": 383, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "也有很多无法知道的事吧。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“总之，好像暂时会受到濑名同学大量提问。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 130, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“喜欢的人的事……大家都想知道吧。”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 403, "voice": "sk2514", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 131, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 132, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她在想喜欢的人的事吗？", "text_idx": 390, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 133, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身为哥哥我应该祝福她。", "text_idx": 414, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 134, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "祝福樱乃幸福。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 135, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我早就知道的，她总有一天会喜欢上某个人。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 136, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“说的也是呢……我也懂那种心情喔。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 401, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route01_12.txt", "scene": "*start", "row": 137, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我现在想知道的对象──", "text_idx": 399, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
