{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安～”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 1, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“大家早安！”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1606", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们走进教室。", "text_idx": 404, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 3, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，早安♪”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4003", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔！”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在教室迎接我们的，是已经全员到齐的朋友们。", "text_idx": 395, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 6, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“大、大家都来了呢……”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1607", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 7, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我跟爱理从昨晚就在一起。”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 418, "voice": "sk0908", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 8, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“原来如此，一起过夜了呀。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1608", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“喂、不要用那种让人遐想的说法啦！”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4004", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“总、总而言之……我已经听樱乃说了，所以忍不住就全员集合等着你们。”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4005", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 11, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“是说，你们一起进来了欸？”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "隼太", "alt_speaker_idx": 432, "voice": "ht0324", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 12, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊嗯……”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 13, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欸嘿……”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1609", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们都露出无法掩饰的害羞笑容。", "text_idx": 405, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我想说从校门一起走到教室。”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 16, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“主人约安洁一起走……”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1610", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 17, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“咦？不去管其他进学校的学生吗？”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 429, "voice": "mu0408", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为……”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 19, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我红着脸说。", "text_idx": 410, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“安洁是我的女仆嘛。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "除此之外的话就不说了。", "text_idx": 431, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我的理由都浓缩在这一句里。", "text_idx": 409, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "互相喜欢的男女，同时还是“主人与女仆”。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这是我们之间相处的模式，昨天已经坦承相见确认心意了。", "text_idx": 430, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就这样，哈哈。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 26, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……♪”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 429, "voice": "mu0409", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽学姐笑了。", "text_idx": 397, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其他人也都露出别有含意的笑容。", "text_idx": 389, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当然也有人显得不太能接受。", "text_idx": 401, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但、但是，大家从樱乃那里听说了多少？”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 31, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“呵呵呵……这个嘛～”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4006", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“成为了跟一般人不一样的情侣呢。”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4007", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 33, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不、不是的不是的爱理同学！”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1611", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，不是情侣吗？”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4008", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 35, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“请不要欺负安洁……”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1612", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学善意的戏弄让安洁的脸通红一片。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没有比这个反应更肯定的答案了。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大家都兴奋起来。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 39, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“唔哈哈哈，很敢讲欸主人～！”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "隼太", "alt_speaker_idx": 432, "voice": "ht0325", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃……因为大家都这样聚在一起了，我也只能坦白……”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 41, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“主、主人又在介意别人……”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1613", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不行吗？”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 43, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……真是的，拿主人您没办法呢。”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1614", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 44, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“看来安洁不在您身边是不行的。”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1615", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是啊，已经变成这样了。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 46, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“唔……你们两个……”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4009", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“立刻就像夫妇一样。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 418, "voice": "sk0909", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 48, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔欸欸！？讨、讨厌啦那种事……”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1616", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君看似因为我们才坦白，其实只是情绪放松了吧……”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4010", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 50, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的！安洁心跳加速了！”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1617", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 51, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“呵呵～这就是恋爱使人盲目呢～”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 429, "voice": "mu0410", "char_id": "みう"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊啊已经无法挽回了……”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 427, "voice": "sn0355", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 53, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“是说安洁！？你已经被下手了！？不只心灵连身体都无法挽回了吗！？”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "纱凪", "alt_speaker_idx": 427, "voice": "sn0356", "char_id": "紗凪"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 54, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“没没没没没没有被下手喔！当然什么都没有做！”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1618", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哈哈……”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把手放到安洁头上。", "text_idx": 407, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 57, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1619", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁的脸颊瞬间就红了。", "text_idx": 400, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就是这样……”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我环视大家。", "text_idx": 408, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在的我真的是放松了吧。", "text_idx": 423, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是这也是因为和安洁在一起的缘故。", "text_idx": 388, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为我想亲近安洁，所以变得和以前不同也是理所当然的。", "text_idx": 394, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "类似豁出去的气势，我害羞但骄傲地说着。", "text_idx": 424, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我，感觉自己终于真正意义上地成为‘主人’了。”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 66, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1620", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 67, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁也感觉终于成为真正的女仆了……主人……”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1621", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 68, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊。”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4011", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学和大家都笑了。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 70, "speaker": "各務台男子Ａ", "flag": 64, "pages": [{"page": 0, "text": "“所以……”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "各务台男生A", "alt_speaker_idx": 392, "voice": "da0045", "char_id": "各務台男子Ａ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 71, "speaker": "結女生徒Ｃ", "flag": 64, "pages": [{"page": 0, "text": "“这段闪光剧场要持续到什么时候啊！？”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "结女学生C", "alt_speaker_idx": 428, "voice": "jc0054", "char_id": "結女生徒Ｃ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们受到了来自教室里四面八方的尖锐视线，虽然早就预料到了。", "text_idx": 403, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……即使这样也没关系。现在的我真的彻底放松了。", "text_idx": 383, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 74, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欸嘿嘿。”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1622", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只要能看到安洁这个开心的笑容。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "时间来到了放学后。", "text_idx": 415, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 77, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那么主人，安洁要去做学校的工作了！”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1623", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，加油。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 79, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欸嘿……”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1624", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 80, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“或许没办法去校门口送您离开，但是主人回家路上请务必小心慢走喔！”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1625", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 81, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“……安洁会一直祈求主人平安的。”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1626", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我也是。……安洁，过来一下。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 83, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是……”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1627", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“摸摸摸～”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 85, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呼哇哇……哇嗯……”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1628", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 86, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那、那个主人，虽然安洁感觉轻飘飘的，可是安洁没有做什么值得称赞的事情……”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1629", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 87, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯。可是我想这么做。”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 88, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1630", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 89, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……因为安洁很可爱。”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 90, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔唔～～”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1631", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 91, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯～？”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 92, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“胸口揪得紧紧的……嗯嗯、主人、主人、主人……”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1632", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 93, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“让人摸起来很有成就感呢，安洁。”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 94, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你……”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1633", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 95, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那个、那个、主人……？”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1634", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 96, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，怎么了？”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 97, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁是主人的人……欸嘿！”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1635", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 98, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……我也是。”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我是安洁喜欢的人，安洁的主人。”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最后再摸了一下，我收回手，凝视着她的眼睛。", "text_idx": 416, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……我已经明白这是什么意思了。”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 102, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的……主人。”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1636", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 103, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的，我的主人。”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1637", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁反复地说着。", "text_idx": 399, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 105, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我露出微笑。", "text_idx": 411, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，安洁加油喔。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 107, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“好的！那么安洁就暂时离开。安洁要出发了，主人！”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 398, "voice": "ag1638", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "──我们都知道对方希望自己做什么。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 109, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "双方的心意契合而成的轴心，让我们两人紧密地连结在一起。", "text_idx": 390, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 110, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以我们已经和之前不同了。", "text_idx": 412, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 111, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以，接下来──", "text_idx": 413, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 112, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“嘻嘻嘻～♪”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "隼太", "alt_speaker_idx": 432, "voice": "ht0326", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……唔哇，你看到了！？”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 114, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“被闪光弹攻击了，真的。”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4012", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 115, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“一想到刚才的闪光今后还会变得更夸张，不免觉得有些可怕啊！”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "隼太", "alt_speaker_idx": 432, "voice": "ht0327", "char_id": "隼太"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 116, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“太危险了，要快点隔离才行。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4013", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 117, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“所以已经没事了，瓜生君？”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 422, "voice": "ar4014", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_16.txt", "scene": "*start", "row": 118, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……还有一件事。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 414, "voice": null, "char_id": null}]}
