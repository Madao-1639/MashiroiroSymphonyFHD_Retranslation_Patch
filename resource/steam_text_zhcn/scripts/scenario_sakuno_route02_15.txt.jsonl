{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 120, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃……樱乃……”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 121, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“咦……？”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3871", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "迷蒙的眼神。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "慢慢凝聚焦点。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 124, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格……？”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3872", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安，樱乃。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 126, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，早安。”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3873", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 127, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“咦？不是早上。”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3874", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 128, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“等着葛格，让你即使吃过饭也没关系，做了点简单的……”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3875", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 129, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，你在餐桌上睡着了。”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 130, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，好像是。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3876", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 131, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“发生了很多事，所以你累了吧。”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 132, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……嗯。”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3877", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 133, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“要睡觉就回房间躺在床上睡，不然没办法消除疲劳的。”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 134, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……嗯，应该好好睡才对的。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3878", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 135, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那现在回房间──”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 136, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不，我不是那个意思。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3879", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 137, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“一直睡着的话，或许能得到亲吻和公主抱。”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3880", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 138, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃用期待的眼神看我。", "text_idx": 379, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“两种都没有。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 140, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊唔……葛格，好冷淡。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3881", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 141, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她很失望的样子。", "text_idx": 351, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 142, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "让我都有点内疚了……", "text_idx": 391, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“因为让你等我了，所以今天就特别……”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 144, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我伸出手示意她过来。", "text_idx": 360, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 145, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3882", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 146, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃歪了歪头，站到我面前。", "text_idx": 378, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 147, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“差不多这样吧。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我把手放在她头上。", "text_idx": 363, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就这样摸着她的头发好一会。", "text_idx": 354, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们之间不需要说话。", "text_idx": 359, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 151, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3883", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃眯起眼，很舒服的样子。", "text_idx": 380, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 153, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，喜欢被摸头发吗？”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 154, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，喜欢被葛格摸。”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3884", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 155, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这样啊。”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 156, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3885", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 157, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃思考了一下，解开缎带。", "text_idx": 377, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 158, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“痛吗？”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 159, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不，不是。”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3886", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 160, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "两边的缎带都解开，头发垂放下来。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 161, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这样就可以被更全面地摸了。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3887", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 162, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“好了，放马过来。”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3888", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 163, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃……好像有哪里不对。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 164, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊唔……不行？”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3889", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 165, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是不行，我要上了喔。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 371, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_15.txt", "scene": "*start", "row": 166, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯♪”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 375, "voice": "sk3890", "char_id": "桜乃"}]}
