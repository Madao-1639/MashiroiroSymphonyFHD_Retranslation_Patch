{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 0, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“哎呀……”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "星期日，我正在帮忙樱乃折刚晒好的衣服。", "text_idx": 380, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是我的手机，不好意思衣服还没折完。”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 3, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没关系，只剩下几件就结束了。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0726", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“咦？濑名同学……打给我真稀奇。”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喂？”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "‘喂，我是濑名……’", "text_idx": 268, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 390, "voice": "ar3785", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "电话那一头的濑名同学，声音听起来莫名地有种紧迫感。", "text_idx": 391, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……怎么了？”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她声音中的情绪，加上不是打给樱乃而是打给我这点让我觉得很奇怪。", "text_idx": 367, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 11, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "‘呃、那个……’", "text_idx": 265, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 390, "voice": "ar3786", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "‘安洁……有去你家吗？’", "text_idx": 269, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 390, "voice": "ar3787", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？没有，她没有来……”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 14, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "‘是吗……那就好。’", "text_idx": 271, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 390, "voice": "ar3788", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 15, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "‘但是小心一点。’", "text_idx": 264, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 390, "voice": "ar3789", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……小心一点？", "text_idx": 358, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "‘就这样。抱歉假日还打给你。’", "text_idx": 270, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 390, "voice": "ar3790", "char_id": "愛理"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学只说了这些，然后就挂断电话了。", "text_idx": 389, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 19, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理怎么了？”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0728", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 20, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃……她说小心安洁。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 21, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0729", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“？”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0730", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“到底怎么了？”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 24, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“打回去问问看。”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0731", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃放下折好的我的内裤，拿出手机。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 26, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哇！”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0732", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "此时，樱乃的手机正好响起。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 28, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“纱凪学姐。”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0733", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“乾同学？”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 30, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“喂。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0734", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 31, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……没有来。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0735", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃看了我一眼。", "text_idx": 385, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……乾同学也是为了安洁打来的吗？", "text_idx": 357, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到、到底发生什么事了？", "text_idx": 363, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我回拨给濑名同学看看好了……”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 36, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喔哇！？”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这次换我的手机响起，上面显示的名字是天羽学姐。", "text_idx": 396, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 38, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喂……该不会是为了安洁的事？”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 39, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘哇！？瓜生君你怎么知道？’", "text_idx": 266, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 395, "voice": "mu0339", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃，因为我跟樱乃从刚才就一直接到联络……”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 41, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘啊，原来是这样……啊哈哈，辛苦了。’", "text_idx": 267, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 395, "voice": "mu0340", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 42, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "‘真困扰呢，虽然很感谢那份心意。’", "text_idx": 272, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 395, "voice": "mu0341", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 43, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喔、喔喔……呃，其实我们还不知道发生了什么……”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 44, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，妈妈在叫我了。那就明天见啰，掰掰瓜生君。”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 395, "voice": "mu0342", "char_id": "みう"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 45, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "天羽学姐好像以为我们也知道是怎么回事，很干脆就挂断了电话。", "text_idx": 366, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我看向樱乃……她也结束了通话，放下手机。", "text_idx": 376, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎、怎么了？”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我也不清楚。”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0738", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 50, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“总之安洁好像不太妙。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0739", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“你那边呢？”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0740", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃……讲到一半就挂了……果然也是跟安洁有关，真困扰啊……”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0741", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“？？？”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0742", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我跟樱乃一起歪着头，百思不得其解。", "text_idx": 377, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "到底是出了什么事情呢，安洁……", "text_idx": 364, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 58, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "此时，门铃声响起。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 60, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们两兄妹连忙下楼。", "text_idx": 375, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 61, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格，该不会？”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0743", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 62, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“应该就是了吧……”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喂？”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 64, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“我是安洁！”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0821", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "果然。", "text_idx": 381, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 66, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“有没有什么需要本人安洁服务的事情呢～？”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0822", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一打开门，就看到活力充沛的安洁，说话时还小跳步了一下。", "text_idx": 362, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 68, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“不管是什么都可以喔，请不要客气尽管说！”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0823", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“呃……也就是说，安洁你刚才到处去问有没有需要女仆服务吗……”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 70, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“刚才做了很多奇怪的想像。”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0744", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 71, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那个安洁是长这样的吗？之类的……”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0745", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 72, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“你以为安洁是妖怪吗！？”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0824", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 73, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“真人？”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0746", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 74, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔，被你这么一说，反而没什么自信了……”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0825", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 75, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥，好像是真人。”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0747", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 76, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“刚才那句话才确定是真人啊……”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0826", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 77, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，长相也没有问题……”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "总之，还好实情是这样。", "text_idx": 373, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不过，为什么这种程度的事会让濑名同学和天羽学姐都困扰呢？", "text_idx": 356, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 80, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“总之先进来吧。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0748", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 81, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“好！打扰了～”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0827", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在门口已经站得够久了，我们让安洁进来家中……", "text_idx": 365, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 83, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“哇～哇～好棒的住宅喔～在这里好像能做很多工作呢！”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0828", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 84, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对于第一次拜访的我家，安洁的双眼闪闪发亮。", "text_idx": 370, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，有什么要做的吗？”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 86, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没有。”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0749", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 87, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欸欸！？”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0829", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "平淡的回答。", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 89, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“衣服也已经折完了。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0750", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“晚饭的准备……天还这么亮，现在做太早了。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 91, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“而且哥哥也仔细地打扫过家里了。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0751", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，这么说来上午的时候我打扫了浴室和厕所呢。”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 93, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你。”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0752", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 94, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“怎么这样～安洁的、安洁的工作……”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0830", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结果让她进来好像也没什么意义，这不禁让我感到有点抱歉。", "text_idx": 394, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不过安洁不会因为这点小事就灰心。", "text_idx": 355, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 97, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“但是！经由本人安洁的观察，这个家里面还有许多可以做的工作喔！”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0831", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 98, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“比如说那边的厨房！安洁觉得只要改变一下布置就能变得更有效率喔！”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 33, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0832", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 99, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“说到这里，那就立刻──”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0833", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 100, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不可以改变。”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0753", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 101, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“！”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 3, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0834", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 102, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "往厨房跑去的安洁在樱乃的制止下紧急煞车。", "text_idx": 372, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 103, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这个状态就好，我比较习惯。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0754", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 104, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“欸欸～如果把饭勺稍微～”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0835", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 105, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不可以。”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0755", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 106, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔……”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0836", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 107, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那、那就那就，把那边的换气扇的油污清理一下……”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0837", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 108, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……如果我们擅自清理换气扇，妈妈会生气。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0756", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不知道为什么她最喜欢清换气扇了……她不在家的时候也会再三提醒我们不可以碰。”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 110, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔啊～”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0838", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 111, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“这、这样的话，打扫房间还是什么安洁都会做……”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0839", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 112, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不是自己扫的话不自在。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0757", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 113, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我的房间也已经扫到一尘不染了……”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 114, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“啊！？”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0840", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 115, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那安洁来确认打扫完的地方吧！如果有要加强的部分安洁会负起责任……”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0841", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 116, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“安洁。”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0758", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 117, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是、是的。”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0842", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 118, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我们家不用没关系。”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0759", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 119, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“呜啊啊啊～每个人的家都这么说～～”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0843", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……我想也是。", "text_idx": 359, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 121, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "安洁有这个心意是很好，但是积极过头老实说不知道该怎么反应比较好。", "text_idx": 369, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学、天羽学姐，或许乾同学也是，不知道该怎么办所以就请她离开了……", "text_idx": 388, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 123, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“唔、唔，打扰你们了……”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 368, "voice": "ag0844", "char_id": "アンジェ"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 124, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结果安洁就处于不完全燃烧的状态……应该说连烧都没烧就离开了。", "text_idx": 393, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 125, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“安洁在结女里没有要做的事情了吗？”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 383, "voice": "sk0760", "char_id": "桜乃"}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 126, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯……这我也不清楚。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 378, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这股满出来的干劲，大概是昨天被我鼓励出来的吧……", "text_idx": 397, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_ange_route01_05.txt", "scene": "*start", "row": 128, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "无、无话可说……", "text_idx": 379, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
