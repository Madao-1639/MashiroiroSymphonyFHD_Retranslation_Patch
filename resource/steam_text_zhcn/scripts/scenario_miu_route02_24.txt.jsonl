{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 0, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……好厉害喔，又变大了。”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2082", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 1, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，会痒吗？为了让你变得更大更大，我会一直摸摸喔！”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2083", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 2, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 373, "voice": "pn0409", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 3, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵吃得好多，所以越变越大了呢～”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2084", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 4, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呼啊……我也想被那样摸摸。特别是胸部，想让学姐帮我变大～”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "纱凪", "alt_speaker_idx": 380, "voice": "sn1609", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 5, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你在说什么傻话。胸部有现在的大小就够了吧。”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 374, "voice": "ar4465", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这是对B罩杯的我的挑战吗？”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 380, "voice": "sn1610", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "原来她是B罩杯啊。", "text_idx": 347, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 8, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……新吾，你刚才笑了吧？”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 380, "voice": "sn1611", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没有笑、没有笑。”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是用手盖住嘴巴就被怀疑了。", "text_idx": 350, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 11, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“那么那么，小纱同学就由本人安洁来摸摸吧！嘿咿～”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "安洁", "alt_speaker_idx": 359, "voice": "ag3451", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 12, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“胸部快～点～变～大～B罩杯绝种吧～”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "安洁", "alt_speaker_idx": 359, "voice": "ag3452", "char_id": "アンジェ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 13, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 380, "voice": "sn1612", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 14, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不管怎么看都是反效果。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理也想被摸摸吗？”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 371, "voice": "sk1331", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……问之前你不就摸了？”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 374, "voice": "ar4466", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 17, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 371, "voice": "sk1332", "char_id": "桜乃"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 18, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "社团教室里到处都摸摸了起来。", "text_idx": 377, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 19, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵，就算你用脚这样踩踩，我也不会有母乳喔～”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2085", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 20, "speaker": "ぱんにゃ", "flag": 64, "pages": [{"page": 0, "text": "“噜～”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "熊喵", "alt_speaker_idx": 373, "voice": "pn0410", "char_id": "ぱんにゃ"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "总有一天，我会让她产母乳的！", "text_idx": 360, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我暗自下了决心。", "text_idx": 364, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "老实说，被美羽学姐摸摸之后真的会变成那种表情。", "text_idx": 384, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨晚，我在学姐的房间也是那样。", "text_idx": 368, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 25, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你干嘛从刚才开始就一直贼笑？”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 380, "voice": "sn1613", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "因为昨天第一次被“用嘴巴舔干净”了！", "text_idx": 351, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我说不出口。", "text_idx": 365, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“感觉好和平呢。”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "搬出这个正大光明的理由，我可以堂堂正正地贼笑了。", "text_idx": 366, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“哇，天都黑了。”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2086", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“今天也辛苦了。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 32, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯，新吾君也辛苦了～”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2087", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "今天迟迟没有两人独处的机会，一回过神来已经这么晚了。", "text_idx": 345, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐还是一样，在大家面前是个可靠的社长。", "text_idx": 358, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后，两人独处的时候……", "text_idx": 372, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 36, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君，在社团教室里被大家摸摸很开心吧～？”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2088", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "变成只属于我的女朋友。", "text_idx": 349, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这个转换太绝妙，只要是男人，一定都受不了女性的这种反差。", "text_idx": 387, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“没办法被美羽学姐摸摸，感觉很寂寞。”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 40, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“那现在来摸摸你吧♪”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2089", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 41, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐踮起脚尖，伸手放到我头上。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我也摸摸学姐吧。”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 43, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“摸我头的新吾君露出像爸爸一样的表情。讨厌，你绝对把我当成小孩子了吧～？”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2090", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那就做只有女朋友能做的事情吧。”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2091", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 46, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯嗯！？啾、嗯嗯、嗯……啾……嗯……哈啊……”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2092", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 47, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "出奇不意地夺走她的唇，在脸颊和额头也烙下我的印记。", "text_idx": 346, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们凝视彼此，沉浸在此时此刻。", "text_idx": 362, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 49, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……感觉脸变得好热喔。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2093", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就是说啊，明明外面那么冷。”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 51, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“呐，今天也要来我家吗？”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2094", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 52, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“可以吗？”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 53, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯。在社团教室里没办法摸摸的份，回家后尽情帮你摸摸喔！”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2095", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 54, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔……”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "那个摸摸该不会是……", "text_idx": 389, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学、学姐……”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔啊！？”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，今天也射出来好多喔……”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2096", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 59, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊……”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……新吾君，不要摸摸了吗？”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2097", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 61, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“已、已经不行了……”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 62, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“那就帮你清干净喔。”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2098", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊姆、啾、嗯嗯、啾、嗯、哈啊、啾、嗯、哔啾、嗯、啾唔……”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2099", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 64, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊、学姐……咿……”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 65, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐用新学会的“清洁技巧”对付我的家伙，然后抬起眼眸看我。", "text_idx": 355, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 66, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这种时候，看到她脸上没有任何厌恶的表情，就能深深感觉到自己是被爱着的呢。", "text_idx": 388, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "如果我是女人，叫我做同样的事情大概没办法。", "text_idx": 353, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 68, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊……还好吗？新吾君的又变大了喔……”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2100", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……学姐，可以吻你吗？”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 70, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸？可是我、嘴巴里有新吾君的……嗯嗯！？”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2101", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯、啾、嗯嗯、哈啊、啾、嗯嗯、啾、啾、啾……”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2102", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "疼爱过我的家伙的嘴唇，是如此的惹人怜爱。", "text_idx": 375, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐总是想让我舒服，她自己却什么也不要求。", "text_idx": 354, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 74, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看我达到高潮，她就打从心底高兴。", "text_idx": 376, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 75, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼，新吾君的嘴唇好软喔♪”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2103", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐的才是。”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 77, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯、啾、嗯嗯、啾、嗯嗯……嗯……啾……”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2104", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们吸吮着对方的嘴唇，分享彼此的气味。", "text_idx": 363, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的甜香充盈我的鼻腔，蓬松柔软的头发搔痒了我的脸颊。", "text_idx": 356, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 80, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不想和她分开，不想回家。", "text_idx": 343, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 81, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "让我产生这些念头的，学姐的危险香气。", "text_idx": 385, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“学姐，不用送我了啦。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 83, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“但是天色暗了我会担心。新吾君这么可爱，好像会被可怕的女人袭击……”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2105", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这附近哪有那种人……”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 85, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，新吾同学要回去了吗？我开车送你到半路吧？”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0176", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 87, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“就是有这种可怕的女人，所以才担心啊。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2106", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 88, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结子小姐突如其来的登场让我心脏狂跳。", "text_idx": 382, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 89, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“最近你都只陪美羽，已经不爱我了啊……”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0177", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 90, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "还擅自开始营造禁忌不伦恋的气氛了。", "text_idx": 386, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 91, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“吼唷，妈妈不要说傻话了！新吾君会困扰的。”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2107", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 92, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“可爱男孩子困扰的模样，是人妻的最爱喔♪”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0178", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 93, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2108", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 94, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“美羽也喜欢那样的新吾同学不是吗？”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0179", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 95, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我、我……”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2109", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 96, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“女人这种生物啊，都会想要让新吾君这种正经的男性哭哭喔♪”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0180", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 97, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2110", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 98, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“抱歉喔，新吾同学，我女儿这么变态个性又差劲。”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0181", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 99, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸欸！妈妈太狡猾了啦，明明是你自己说的！”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2111", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 100, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "变态的美羽学姐正好。会如此想的我也蛮可悲的。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 101, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“妈妈，你是特地来戏弄我们的吗？”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2112", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 102, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“虽然有一部份是，但其实是有点在意不久前听到的熊喵小姐的叫声。”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0182", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 103, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“但或许是我听错了……”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0183", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 104, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小熊喵？”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2113", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，这么说来我昨天很晚的时候也听到了熊喵的叫声。”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“虽然那个时候没有看到它的身影……”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 367, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 107, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2114", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在社团看到熊喵的时候它都很有精神，我觉得应该不用担心，但美羽学姐似乎不这么想。", "text_idx": 352, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 109, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“那妈妈要回去了，美羽也别太晚回家喔。”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0184", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 110, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“嗯……为什么要带新吾君一起走？”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 383, "voice": "mu2115", "char_id": "みう"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 111, "speaker": "結子", "flag": 64, "pages": [{"page": 0, "text": "“唔呼呼。”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "结子", "alt_speaker_idx": 381, "voice": "yk0185", "char_id": "結子"}]}
{"script": "scenario_miu_route02_24.txt", "scene": "*start", "row": 112, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "最近，我开始觉得结子小姐的这个笑容有点可怕……", "text_idx": 369, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
