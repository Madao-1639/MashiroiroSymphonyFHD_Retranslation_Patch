{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“时间也不早了，我差不多该回去了。”", "text_idx": 367, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5560", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学穿上外套站起来。", "text_idx": 446, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“明明休息还来陪我们念书，抱歉喔。”", "text_idx": 368, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 3, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不用介意。反正我有时间，而且连晚饭都让你们请了。”", "text_idx": 323, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5561", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 4, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理的话，随时都欢迎。”", "text_idx": 386, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3159", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃说的对。”", "text_idx": 376, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你们。如果安洁也来就好了呢。”", "text_idx": 399, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5562", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“她有别的事也没办法。考试……希望她能顺利过关。”", "text_idx": 348, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 8, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没问题，安洁是能干的女仆。”", "text_idx": 382, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3160", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 9, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……希望她会加油。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5563", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看远方。濑名同学在看远方！", "text_idx": 453, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 11, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是啊……”", "text_idx": 370, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“到最后关头了，加油吧！”", "text_idx": 333, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5564", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 13, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“反正明天是假日，你住下来也可以的说。”", "text_idx": 335, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3161", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 14, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那就太麻烦你们了吧。”", "text_idx": 412, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5565", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 15, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我希望你麻烦的说……”", "text_idx": 356, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3162", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你。但我还有家务得做，而且我也不想打扰你们。”", "text_idx": 398, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5566", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我没有想那种事喔。”", "text_idx": 357, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你不想过两人时光吗？”", "text_idx": 329, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5567", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这个……”", "text_idx": 403, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“有点意外。瓜生君也有那种表情啊。”", "text_idx": 373, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5568", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“毕竟在家里是两人独处，被强调的话，有点……”", "text_idx": 380, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 22, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……互相喜欢我是不会阻止，但是避免发展成责任问题比较好喔。”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5569", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 23, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道，不会因为是两人独处就做那种事。”", "text_idx": 361, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 24, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……是吗？”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5570", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 25, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……不会做喔。”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3163", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 26, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嘿，还没啊……”", "text_idx": 343, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5571", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“两个人不有趣。爱理也住下来的话，就可以三人一起了。”", "text_idx": 325, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3164", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 28, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“三个人一起什么？”", "text_idx": 318, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5572", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……不是玩扑克牌吗？”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3165", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君……你觉得她是说认真的吗？”", "text_idx": 387, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5573", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“大概。”", "text_idx": 347, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 32, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 315, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3166", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃歪着头。", "text_idx": 442, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 34, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“你想像的是其他事吗？”", "text_idx": 330, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3167", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 35, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“什么──”", "text_idx": 326, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5574", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学，抱歉。", "text_idx": 447, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "妹妹啊，从刚才的对话听来，一般都是想像另一件事喔。", "text_idx": 422, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 38, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“要做什么？”", "text_idx": 395, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3168", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃一脸很感兴趣的表情逼近濑名同学。", "text_idx": 438, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 40, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那、那种事情，瓜生君比较清楚！”", "text_idx": 405, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5575", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 41, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那再见，我今天就先回去了！”", "text_idx": 409, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 449, "voice": "ar5576", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "快速地说完后濑名同学回家了。", "text_idx": 423, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 43, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……葛格。”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3169", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 44, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我觉得有些事不要知道比较好喔。”", "text_idx": 362, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 45, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“姆，只有我被排挤。”", "text_idx": 350, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3170", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是那个意思啦……”", "text_idx": 322, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 47, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那就告诉我吧？”", "text_idx": 411, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3171", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是什么需要在意的事。”", "text_idx": 321, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 49, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“如果不需要在意，那说了也没问题。”", "text_idx": 349, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3172", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 50, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个……”", "text_idx": 406, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "被小孩问‘小宝宝是怎么生出来’的父母就是这种心情吧。", "text_idx": 456, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 52, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不告诉我的话，明天我问其他人。”", "text_idx": 319, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3173", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个，我觉得不要比较好。”", "text_idx": 407, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 54, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那告诉我。”", "text_idx": 410, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3174", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 55, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理为什么脸那么红？”", "text_idx": 384, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3175", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 56, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 57, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "反正总有一天也会知道……没办法了。", "text_idx": 419, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 58, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个，濑名同学说的三个人做的事。”", "text_idx": 408, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 59, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯嗯。”", "text_idx": 340, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3176", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“应该是我跟樱乃跟濑名同学三个人爱爱的意思。”", "text_idx": 355, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 61, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3177", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 62, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3178", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃的脸逐渐发红。", "text_idx": 443, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 64, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……葛格，色狼。”", "text_idx": 313, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3179", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？我吗！？”", "text_idx": 379, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 66, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“那种事情，我不知道。”", "text_idx": 414, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3180", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 67, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃对那方面的知识有时候非常偏差呢。”", "text_idx": 374, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 68, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“全方面清楚的人好色。”", "text_idx": 331, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3181", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 69, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……你说的对。”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“门开着喔。”", "text_idx": 415, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 71, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“可以进去吗？”", "text_idx": 336, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3182", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "怎么了？平常她都是立刻就进来的。", "text_idx": 424, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 73, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“请进。”", "text_idx": 397, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 74, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“打扰了。”", "text_idx": 364, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3183", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 75, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃抱着枕头进来我房间。", "text_idx": 440, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 76, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3184", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "直接走向床铺，把她带来的枕头排在我的枕头旁边。", "text_idx": 451, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 78, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃小姐，你在做什么呢？”", "text_idx": 375, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 79, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“无懈可击。”", "text_idx": 365, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3185", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 80, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“完美……？”", "text_idx": 352, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 81, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“今天可以一起睡吗？”", "text_idx": 327, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3186", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 82, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“一起？为什么？”", "text_idx": 317, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 83, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“因为想跟葛格一起睡。”", "text_idx": 345, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3187", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“原来如此，很足够的理由。”", "text_idx": 334, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 85, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“所以，一起睡吧。”", "text_idx": 363, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3188", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 86, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不知不觉中就决定了。”", "text_idx": 324, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 87, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没问题的，只是一起睡而已。什么都不会做，放心吧。”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3189", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 88, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那是男方的台词吧？”", "text_idx": 413, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 89, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“是吗？”", "text_idx": 369, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3190", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“但也不是绝对啦。”", "text_idx": 328, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 91, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没问题的，只是一起睡而已。什么都不会做，放心吧。”", "text_idx": 381, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3191", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 92, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，内容没有变喔。”", "text_idx": 378, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我苦笑着吐槽。", "text_idx": 430, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 94, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格会对我做什么吗？”", "text_idx": 391, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3192", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 95, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“虽然想，但今天不会。”", "text_idx": 393, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 96, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊唔，可惜。”", "text_idx": 338, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3193", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“居然可惜啊。”", "text_idx": 354, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 98, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“有一点。”", "text_idx": 372, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3194", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 99, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“一点？”", "text_idx": 316, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 100, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“其实，是很多。”", "text_idx": 332, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3195", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 101, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……你知道葛格也算是男人吗？”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 102, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“我知道你是会说出三个人爱爱这种话的男人。”", "text_idx": 360, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3196", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔……”", "text_idx": 337, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 104, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "又提起了。", "text_idx": 418, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 105, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理也一起比较好吗？”", "text_idx": 385, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3197", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 106, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“濑名同学不是那种对象。”", "text_idx": 383, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就算真的要爱爱，对象除了樱乃以外我无法想像。”", "text_idx": 353, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 108, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“既然这样，一起睡也没问题。”", "text_idx": 366, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3198", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 109, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“说的也是……咦？好像有点奇怪？”", "text_idx": 396, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 110, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“被发现了。”", "text_idx": 394, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3199", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 111, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“樱乃，你回自己房间比较好喔。”", "text_idx": 377, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 112, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3200", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 113, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃什么都没说，爬到我的床上。", "text_idx": 439, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 114, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后拿被子盖住半张脸。", "text_idx": 448, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 115, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只露出眼睛看着我。", "text_idx": 420, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 116, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……真糟糕啊。", "text_idx": 416, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 117, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不讨厌一起睡……应该说，很高兴。", "text_idx": 427, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 118, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "所以，这种时候才要狠下心──", "text_idx": 432, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 119, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“这个时被窝被很冷，我先钻进来暖一暖。”", "text_idx": 404, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3201", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 120, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看来她不打算回去。", "text_idx": 452, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 121, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“空气清净机兼暖呼呼的被窝。再加上妹妹和恋人的优惠套组。”", "text_idx": 389, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3202", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 122, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我被逗得笑了出来。", "text_idx": 431, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 123, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道了，不会再赶你回去。”", "text_idx": 359, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 124, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你，葛格。”", "text_idx": 400, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3203", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 125, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……熬夜也不好，今天就睡了吧。”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 126, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯。”", "text_idx": 339, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3204", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 127, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我关掉电灯，躺上床。", "text_idx": 428, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 128, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“跟樱乃说的一样，被窝好温暖呢。”", "text_idx": 401, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 129, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，但是相对的，我变得好冷。”", "text_idx": 341, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3205", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 130, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“还好吗？”", "text_idx": 402, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 131, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“不好，所以靠紧一点。”", "text_idx": 320, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3206", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 132, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃这样说，然后脸颊贴在我的胸口，全身依偎着我。", "text_idx": 445, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 133, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 134, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格，好温暖。”", "text_idx": 392, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3207", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 135, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这就是……所谓的凌迟吗？", "text_idx": 458, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 136, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "明明感受到樱乃的呼吸和温度，但必须什么都不做地睡觉……", "text_idx": 435, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 137, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃身上类似淡淡花香的气味似乎更明显了。", "text_idx": 444, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 138, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“在这里就觉得好安心。”", "text_idx": 346, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3208", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 139, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“安心？”", "text_idx": 351, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 140, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“因为充满了葛格的味道。”", "text_idx": 344, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3209", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 141, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……我也在想相同的事。”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 142, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“相同的事？”", "text_idx": 388, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3210", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 143, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我现在感觉到樱乃的味道。”", "text_idx": 358, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 144, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……要多闻一下吗？”", "text_idx": 314, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3211", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 145, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃更靠近我。", "text_idx": 441, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 146, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "手臂碰到柔软的触感……毫无疑问，是樱乃的胸部。", "text_idx": 433, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 147, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 148, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我不禁身体紧绷。", "text_idx": 426, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 149, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我没有自制到在这种状况下还能保持平静。", "text_idx": 429, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 150, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且樱乃只是想对我撒娇吧。", "text_idx": 455, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 151, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "要忍耐，忍耐。", "text_idx": 457, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 152, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在是比起恋人，要当葛格的时候。", "text_idx": 450, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 153, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“晚上好。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3212", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 154, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯，晚安。”", "text_idx": 342, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 434, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 155, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "睡意终于来袭，意识慢慢地沉入黑暗。", "text_idx": 454, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 156, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“葛格……睡着了？”", "text_idx": 390, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3213", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 157, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "半梦半醒中，樱乃的声音从远方传来，但是我好困……", "text_idx": 417, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 158, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“晚上好。”", "text_idx": 371, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "樱乃", "alt_speaker_idx": 437, "voice": "sk3214", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_07.txt", "scene": "*start", "row": 159, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "在嘴唇感受到柔软触感的同时，我完全陷入了睡眠。", "text_idx": 421, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
