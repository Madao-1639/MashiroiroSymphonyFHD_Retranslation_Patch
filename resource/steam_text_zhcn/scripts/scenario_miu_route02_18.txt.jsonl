{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 0, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唔～今天也好冷喔……欸、好温暖！？”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1517", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早安，纱凪。”", "text_idx": 215, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 2, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你真的去借暖炉啦……”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1518", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“果然主动开口就借到了呢。”", "text_idx": 217, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 4, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“呼啊～好温暖～”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1519", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪把手伸向这台在学园长的许可下借来的煤油暖炉取暖。", "text_idx": 250, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 6, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐呢？”", "text_idx": 221, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1520", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“昨天有打工，所以今天会比较晚到吧？”", "text_idx": 216, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 8, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“哼嗯，连那些都知道啊。”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1521", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 9, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“毕竟是男朋友嘛。”", "text_idx": 220, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 10, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1522", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也把手伸向暖炉。", "text_idx": 238, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 12, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那个。”", "text_idx": 226, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1523", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 13, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 14, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……新吾不寂寞吗？”", "text_idx": 186, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1524", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“寂寞？”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 16, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐明年就要毕业了喔。那样一来就算你们在交往，见面机会还是会变少。”", "text_idx": 222, "plain": null, "plain_idx": null, "len": 37, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1525", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 17, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊……”", "text_idx": 199, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 18, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……毕业后，你或许会被学姐抛弃喔。”", "text_idx": 187, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1526", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "未来的事情我也不知道。", "text_idx": 245, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 21, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是我想好好珍惜跟学姐相处的这段时间。", "text_idx": 229, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐毕业后的事情，到时候再想就可以了。", "text_idx": 236, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 23, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“如果……只是如果喔。”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1527", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪收回取暖的手，瞄了我一眼。", "text_idx": 251, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 26, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“学姐毕业后，如果你这个废材被甩掉变成一个人的话……”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1528", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 27, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我想你大概会很寂寞，所以要我当你的女朋友也可以喔？”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1529", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 29, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就算我真的被甩，我的回答也不会变。", "text_idx": 237, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 30, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“如果被甩了，我不会讨厌美羽学姐，也绝对不会为了找代替的对象而跟纱凪交往。”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 38, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那样做对纱凪也很失礼吧？”", "text_idx": 227, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 32, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1530", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 33, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不过，我会努力不要被甩掉的啦。”", "text_idx": 191, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 34, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没错，我只能努力。", "text_idx": 246, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 35, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "努力成为配得上美羽学姐的人。", "text_idx": 231, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“噗、啊哈哈哈！”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1531", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以为我回答得很完美，结果却换来纱凪捧腹大笑。", "text_idx": 239, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 38, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你干嘛当真啊～美羽学姐不可能甩掉你的啦！”", "text_idx": 193, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1532", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 39, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是说如果吗？而且，是你先说出奇怪的话。”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 40, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“只是稍微测试你一下而已。”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1533", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 41, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我本来想如果你回答说要跟我交往的话，我就立刻向美羽学姐报告。”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1534", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 42, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不好意思没有回应你的期待。”", "text_idx": 189, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 43, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“一辈子都不需要你的回应啦。”", "text_idx": 188, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1535", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "身体暖起来后，纱凪开始确认社团教室里的备品。", "text_idx": 255, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 45, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊，两位早安～外面好冷呢。”", "text_idx": 200, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "美羽", "alt_speaker_idx": 254, "voice": "mu1846", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 46, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早上好。”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 47, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“早安，学姐！”", "text_idx": 214, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1536", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 48, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "纱凪立刻就跑到刚走进社团教室的美羽学姐身边。", "text_idx": 252, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 49, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“学姐，请到暖炉旁来暖暖身体吧。”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1537", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 50, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“为了学姐，我去拜托学园长借来了这个喔！”", "text_idx": 192, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1538", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 51, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸欸，是这样啊？抱歉喔，一直以来都让你们代替我做很多事。”", "text_idx": 218, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "美羽", "alt_speaker_idx": 254, "voice": "mu1847", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 52, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……我才没有办法代替学姐。”", "text_idx": 185, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1539", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 53, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 219, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "美羽", "alt_speaker_idx": 254, "voice": "mu1848", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "把学姐推到我身边，纱凪背对我们深呼吸了一口气。", "text_idx": 242, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 55, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“对了对了，我忘记说一件事。”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1540", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 56, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后，她面带笑容地重新转过来。", "text_idx": 247, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 57, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“美羽学姐，你跟新吾在交往吧？恭喜你们！”", "text_idx": 223, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1541", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 254, "voice": "mu1849", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 59, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "结果，学姐也露出不输给纱凪的灿烂笑容。", "text_idx": 253, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 60, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你，小纱凪♪”", "text_idx": 224, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 254, "voice": "mu1850", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 61, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1542", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只有一瞬间，我跟纱凪对上了视线。", "text_idx": 233, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 63, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我低下头，握主美羽学姐的手。", "text_idx": 240, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 64, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "接着，站在我们面前的纱凪再次展露耀眼的笑容。", "text_idx": 243, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 65, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“学姐，请一定要幸福喔。其实，对象是新吾的话我倒是不担心啦。”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1543", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“小纱凪……”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "美羽", "alt_speaker_idx": 254, "voice": "mu1851", "char_id": "みう"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 67, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐也回握我的手。", "text_idx": 235, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你，纱凪。”", "text_idx": 225, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 244, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 69, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "或许根本没必要去借暖炉呢。", "text_idx": 241, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 70, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "即使没有暖炉，这间社团教室……", "text_idx": 232, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 71, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她们的笑容。", "text_idx": 234, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 72, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 249, "voice": "sn1544", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_18.txt", "scene": "*start", "row": 73, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "几乎让我忘记了冬天──", "text_idx": 230, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
