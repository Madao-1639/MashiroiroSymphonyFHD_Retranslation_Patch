{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 0, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘……那么，大家请保重。’", "text_idx": 161, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "兰华", "alt_speaker_idx": 186, "voice": "rk0708", "char_id": "蘭華"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 1, "speaker": "蘭華", "flag": 64, "pages": [{"page": 0, "text": "‘我会期待再相见的那天。’", "text_idx": 162, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "兰华", "alt_speaker_idx": 186, "voice": "rk0709", "char_id": "蘭華"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 2, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "随着学园长道别的话语，合并试办结束了。", "text_idx": 204, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 3, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "干脆到令人有些意外，而且……留下深远的余韵。", "text_idx": 190, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 4, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“……结束后再来看，真的很短呢。”", "text_idx": 164, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "隼太", "alt_speaker_idx": 205, "voice": "ht1216", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 5, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是啊。”", "text_idx": 174, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "合并试办开始到现在，两个月。", "text_idx": 188, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在回头看，真是一转眼就过去了。", "text_idx": 198, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "发生了很多事呢。", "text_idx": 187, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "开心的事、难过的事、悲伤的事。", "text_idx": 191, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 10, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但是，在这里度过的时间成为了对我来说是很重要的回忆。", "text_idx": 185, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 11, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“真的已经结束了吗？”", "text_idx": 177, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 196, "voice": "sk4001", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是啊……还没有真实感呢。”", "text_idx": 173, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 197, "voice": "ar5656", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 13, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“是的，安洁也是。”", "text_idx": 175, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3627", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 14, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“感觉假日结束后还能再跟大家见面。”", "text_idx": 169, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3628", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 15, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我倒是觉得回到没有男人的安静生活很高兴。”", "text_idx": 171, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 200, "voice": "sn2224", "char_id": "紗凪"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "连熟悉的毒舌都没有了气势。", "text_idx": 203, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 17, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君你们等一下要做什么？”", "text_idx": 176, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 197, "voice": "ar5657", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 18, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我们到今天就结束了，所以为了表达感谢兼整理物品，待会要打扫我们使用的地方。”", "text_idx": 170, "plain": null, "plain_idx": null, "len": 39, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 19, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……这样啊。”", "text_idx": 165, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 197, "voice": "ar5658", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 20, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“打扫的话，安洁也来帮忙！”", "text_idx": 172, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3629", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你，不过……今天可以就交给各务台的男生们吗？”", "text_idx": 179, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 22, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“说的也是呢，那么，麻烦各位了。”", "text_idx": 178, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3630", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 23, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“这个……是学校的钥匙。”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3631", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 24, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我接下她递来的钥匙。", "text_idx": 193, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 25, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这是……？”", "text_idx": 182, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 26, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“因为打扫时需要。”", "text_idx": 166, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3632", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 27, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……是啊。”", "text_idx": 163, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 28, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "这是安洁信赖的证明。", "text_idx": 202, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那我可以暂时借用一下吗？”", "text_idx": 183, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 30, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“当然了。”", "text_idx": 168, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3633", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 31, "speaker": "アンジェ", "flag": 64, "pages": [{"page": 0, "text": "“安洁有备用的所以不必担心。全部都结束后再还给安洁。”", "text_idx": 167, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "安洁", "alt_speaker_idx": 189, "voice": "ag3634", "char_id": "アンジェ"}]}
{"script": "scenario_sakuno_route02_17.txt", "scene": "*start", "row": 32, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你，安洁。”", "text_idx": 180, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "新吾", "alt_speaker_idx": 194, "voice": null, "char_id": null}]}
