{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“蛤？你要跟他一起去买送天羽学姐的礼物？”", "text_idx": 205, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4431", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 1, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯。还是爱理也要一起来？”", "text_idx": 188, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1545", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 2, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我怎么可能去……应该说你脑袋是撞到了吗？”", "text_idx": 200, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4432", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 3, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“为什么？”", "text_idx": 181, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1546", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 4, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“一般来说不会做到那种程度吧？为了男人……”", "text_idx": 176, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4433", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 5, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“啊，果然吗？我也在想我是不是做过头了。”", "text_idx": 187, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1547", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不要去了，只会让你自己难受而已。”", "text_idx": 178, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4434", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 7, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不要，我要去。”", "text_idx": 179, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1548", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 8, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“真固执。居然自己找罪受……”", "text_idx": 204, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4435", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 9, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯～我不觉得难受啊～”", "text_idx": 191, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1549", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 10, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那在公园里抱着猫哭的人是谁呢？”", "text_idx": 211, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4436", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 11, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“还发生过那种事呢。”", "text_idx": 207, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1550", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哼嗯，已经成为可以笑着说出来的回忆了吗？”", "text_idx": 186, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4437", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 13, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这个嘛。一个人想起来的时候或许还是会哭。”", "text_idx": 208, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1551", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 14, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“既然这样……”", "text_idx": 202, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4438", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 15, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“但是，我果然还是希望喜欢上的人能幸福。”", "text_idx": 184, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1552", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 16, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 174, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4439", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 17, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“会想要……为他做点什么。”", "text_idx": 183, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1553", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“就算你这么说，我也不懂。”", "text_idx": 196, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4440", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 19, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那爱理也谈一场恋爱吧？”", "text_idx": 213, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1554", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 20, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“那么蠢的事，我敬谢不敏。”", "text_idx": 210, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4441", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 21, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“越是这样想的人，遇到喜欢的男人时就会变得越黏人喔～”", "text_idx": 206, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1555", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 22, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“才不会。”", "text_idx": 201, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4442", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 23, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“好吧。反正我也对那家伙以外的男人没兴趣。”", "text_idx": 194, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1556", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 24, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我决定一辈子单身了～”", "text_idx": 199, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1557", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 25, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 174, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4443", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 26, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……但是，好像不是迷信呢。”", "text_idx": 175, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4444", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 27, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯嗯，什么？”", "text_idx": 189, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1558", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 28, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“女人恋爱时会变漂亮的传言。”", "text_idx": 193, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4445", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 29, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“有吗？”", "text_idx": 203, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1559", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“也好啦，无所谓。”", "text_idx": 182, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4446", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 31, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“干嘛啦，一个人擅自得出结论。”", "text_idx": 197, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1560", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不是什么好话所以我就不说了。好了好了，那我也决定单身吧。”", "text_idx": 177, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4447", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 33, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“不过啊……”", "text_idx": 180, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1561", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嗯？”", "text_idx": 190, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4448", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 35, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“如果出现了能让爱理喜欢上的男人……”", "text_idx": 195, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1562", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 36, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“那家伙岂不是世界上最帅最强的男朋友？”", "text_idx": 212, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1563", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 37, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 174, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4449", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 38, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“你是不是被恋爱冲昏脑袋了？怎么可能有那种男人。”", "text_idx": 185, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4450", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 39, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“这么肯定啊。”", "text_idx": 209, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "纱凪", "alt_speaker_idx": 217, "voice": "sn1564", "char_id": "紗凪"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 40, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“当然肯定。”", "text_idx": 198, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4451", "char_id": "愛理"}]}
{"script": "scenario_miu_route02_19.txt", "scene": "*start", "row": 41, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“因为我绝对不会谈恋爱的。”", "text_idx": 192, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 215, "voice": "ar4452", "char_id": "愛理"}]}
