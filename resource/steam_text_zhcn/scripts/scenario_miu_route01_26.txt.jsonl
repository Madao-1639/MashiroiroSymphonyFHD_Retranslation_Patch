{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 0, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……葛格，你好憔悴。”", "text_idx": 239, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 341, "voice": "sk1297", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 1, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是、是吗？”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 2, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“昨天发生什么事了吗？”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 341, "voice": "sk1298", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 3, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“不是……”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 4, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "其实，发生了无法对别人说起的事。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 5, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "可以说是出乎意料吧。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 6, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "没想到美羽学姐的那个模样……", "text_idx": 343, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 7, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一想起这件事，我直到天亮都没睡着。", "text_idx": 305, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 8, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看起来憔悴也是这个理由。", "text_idx": 349, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 9, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……葛格，你脸好红。”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 341, "voice": "sk1299", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我、我什么都没有看到啦！”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 11, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 341, "voice": "sk1300", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 12, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "只是和樱乃聊天都这副德行，我好害怕跟美羽学姐见面时的自己。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 13, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我现在得想办法保持平常心……", "text_idx": 334, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 14, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊……”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1186", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 15, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;“唔啊！？”", "text_idx": 6, "plain": "“唔啊！？”", "plain_idx": 258, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 16, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我做了最差劲的反应。", "text_idx": 332, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 17, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "应该说，根本不可能保持平常心啦。", "text_idx": 323, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 18, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……早、早安。”", "text_idx": 237, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1187", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“早上好！”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 20, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥，你破音了。”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "樱乃", "alt_speaker_idx": 341, "voice": "sk1301", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“喉、喉咙好像有点怪怪的，咳嗯！”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 22, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我轻咳一声，尽量和学姐保持距离。", "text_idx": 336, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 23, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“是空气太干燥了吗……新吾君，你还好吗？”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1188", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“！？”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 25, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她一口气缩短距离，直视着我的脸。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 26, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "学姐的香气飘到我的鼻尖。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 27, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "昨天的画面仿佛又要浮现在脑海，我连忙别开视线。", "text_idx": 339, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 28, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“把窗户打开通风一下吧？”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1189", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 29, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊、这样就好了没关系！”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 30, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“是吗？”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1190", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 31, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唔……”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 32, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "每次和学姐对上眼神，我就说不出话来。", "text_idx": 342, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 33, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "意识过头了吧我……", "text_idx": 326, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 34, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“……我去看外面的兔子。”", "text_idx": 235, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 341, "voice": "sk1302", "char_id": "桜乃"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“好，慢走。”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 36, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我面带笑容目送樱乃离开。", "text_idx": 337, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 37, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1191", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但我突然意识到，现在变成和美羽学姐两人独处了。", "text_idx": 312, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "和平常不同，我想不到任何可以聊的话题。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 40, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“今、今天天气真好呢。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1192", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 41, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“就是说啊。”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 42, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我们各自做着不同的工作，声音中的情绪莫名高亢。", "text_idx": 331, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 43, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "然后，立刻就沉默。", "text_idx": 345, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 44, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当美羽学姐背对我时，紧张感才稍微缓解。", "text_idx": 325, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "真的得想想办法才行，这个状况……", "text_idx": 350, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 46, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我也不希望跟学姐之间气氛一直这么尴尬。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 47, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“新吾君，那个啊。”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1193", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%123;“唔哇啊────！？”", "text_idx": 5, "plain": "“唔哇啊────！？”", "plain_idx": 256, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 49, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1194", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突如其来的重播让我整个人惊慌失措。", "text_idx": 351, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 51, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不行了，连幻觉都……", "text_idx": 309, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 52, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“你没事吧，新吾君？”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1195", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 53, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊、没事，抱歉……”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 54, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "即使重播结束，我依然没办法直视学姐的脸。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 55, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我甚至开始觉得社团教室的空气变得稀薄。", "text_idx": 335, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 56, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……那个，昨天抱歉喔。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1196", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸……”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 58, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我想跟猫咪们一起洗澡……但是朵萌和花铃却到处乱跑……”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 28, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1197", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 59, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“然后追它们的时候跟新吾君撞个正着，我吓了一跳，连遮挡都忘记了……”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 34, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1198", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我、我才要说对不起。”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 61, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我对自己的嘴笨绝望到怀疑起自己是不是日本人了。", "text_idx": 333, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 62, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然此时的状况我也只能道歉。", "text_idx": 359, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 63, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“对了，这个。你忘记拿手机了对吧？”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1199", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 64, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“掉在我房间里……”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1200", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“谢、谢谢你！”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 66, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“我、我完全没有乱看喔！”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1201", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 67, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“乱看别人的手机太差劲了，而且新吾君跟女孩子传很多邮件也是你的自由。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 35, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1202", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 68, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“看了也没什么有趣的。跟我传邮件的异性，也就只有樱乃而已。”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 69, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……是这样啊，太好了。”", "text_idx": 238, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1203", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欸？”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 71, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“啊啊、我在说什么啊。不是那样的，我不是那个意思！”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1204", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 72, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以为美羽学姐很冷静，但此时的她看起来相当混乱。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 73, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“真的很抱歉喔。昨天让你看到了不想看的东西……”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1205", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 74, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我、我什么都没看到喔！因为昨天的记忆我几乎都不记得了。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 75, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“感觉很讨厌吧。看到那种干瘪的模样……”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1206", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 76, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“怎么会！你一点也不干瘪！”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 77, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "隔着衣服看起来，想像不出学姐的胸部原来那么大，肌肤又白又透亮。", "text_idx": 360, "plain": null, "plain_idx": null, "len": 31, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然日本人大部分是屁股比较大的葫芦型身材，但学姐却不是那样。", "text_idx": 358, "plain": null, "plain_idx": null, "len": 30, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 79, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的身材虽然娇小，但该凸的地方都有凸非常匀称……", "text_idx": 319, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 80, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“……新吾君果然看到了。”", "text_idx": 236, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1207", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 81, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊啊、不是的！我没有看，那是我的妄想！”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 82, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "现在不是冷静分析学姐身材的时候了。", "text_idx": 347, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不过事到如今，还说自己没有看也太假了。", "text_idx": 310, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 84, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……对不起，我不会再说谎了。”", "text_idx": 232, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 85, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那个……我看到了。”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 86, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "看得还挺清楚。这句就不要说出来了吧。", "text_idx": 348, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 87, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不是那个问题吗？", "text_idx": 308, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 88, "speaker": "みう", "flag": 64, "pages": [{"page": 0, "text": "“唔唔，早知道就多练练腹肌了……”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "美羽", "alt_speaker_idx": 356, "voice": "mu1208", "char_id": "みう"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 89, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "……不是那个问题吧？", "text_idx": 303, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 90, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“唉……”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 91, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "好绝望。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 92, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "对用手机挑战了一次能否用念力显影的自己。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 93, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "突然全裸是不行的吧？那是一种对理性的直接攻击啊。", "text_idx": 352, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 94, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "而且对方还是那个美羽学姐。", "text_idx": 357, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 95, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "一般来说绝对遥不可及的高岭之花。", "text_idx": 306, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 96, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "不对，现在也还是那样。所以我才会看了那个人的裸体后挑战起念写啊。", "text_idx": 307, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 97, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……身为人类，我大概完蛋了。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 98, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "当我开始这样自言自语时，已经是末期了。", "text_idx": 324, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 99, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“唉……”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1259", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 100, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“嗯？怎么了，叹那么大口气……”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 101, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我以为找到同伴，但是她的表情看起来没有半点烦恼的样子。", "text_idx": 329, "plain": null, "plain_idx": null, "len": 27, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 102, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“我这么幸福是可以的吗……”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1260", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 103, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“发生什么好事了吗？”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 104, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“嗯。昨天跟新吾一起洗澡了♪”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1261", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 105, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "%164;“噗！？”", "text_idx": 7, "plain": "“噗！？”", "plain_idx": 268, "len": 5, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 106, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……我先说清楚，是猫咪新吾喔！”", "text_idx": 234, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1262", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 107, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“这、这个我知道啦。”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 108, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "但内心还是动摇了。", "text_idx": 311, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 109, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“泡在热水里的新吾好可爱喔～”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1263", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 110, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“用那种没有我就活不下去的眼神看着我喔！”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1264", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 111, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“真是的～我才是没有新吾就活不下去了呢。”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1265", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 112, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“什么嘛。看你们聊得这么热闹，居然是对瓜生君告白？”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "爱理", "alt_speaker_idx": 346, "voice": "ar4333", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 113, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“才、才不是！我说的是猫咪新吾！”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1266", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 114, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“喔……”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 346, "voice": "ar4334", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 115, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……干嘛啦，哼什么哼。”", "text_idx": 233, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1267", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 116, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 231, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 346, "voice": "ar4335", "char_id": "愛理"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 117, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“什么事？”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 338, "voice": null, "char_id": null}]}
