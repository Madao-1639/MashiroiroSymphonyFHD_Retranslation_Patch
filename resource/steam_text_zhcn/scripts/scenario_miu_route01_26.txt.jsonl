{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 120, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“爱理，你没事吧？从刚才就尽说一些意义不明的话。”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1268", "char_id": "紗凪"}]}
