{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 122, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“……？”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1269", "char_id": "紗凪"}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 123, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学耸了耸肩，我跟纱凪互看一眼。", "text_idx": 344, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_miu_route01_26.txt", "scene": "*start", "row": 124, "speaker": "紗凪", "flag": 64, "pages": [{"page": 0, "text": "“你不要看我啦，好恶心。”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "纱凪", "alt_speaker_idx": 354, "voice": "sn1270", "char_id": "紗凪"}]}
