{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 0, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“瓜生君。”", "text_idx": 298, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5527", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 1, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "就在我收拾书包准备回家时，濑名同学走到我的座位旁。", "text_idx": 318, "plain": null, "plain_idx": null, "len": 25, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 2, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“今天能来吗？”", "text_idx": 248, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 3, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我打算过去。”", "text_idx": 259, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5528", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 4, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道了，可以等我一下吗？我尽快收拾好。”", "text_idx": 274, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 5, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“不用急没关系。”", "text_idx": 243, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5529", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 6, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“我会晚一点才去你家打扰。”", "text_idx": 273, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5530", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 7, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“有什么事吗？”", "text_idx": 284, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 8, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“对。被学园长叫去了。”", "text_idx": 266, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5531", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 9, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的表情有点不悦。", "text_idx": 317, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 10, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“是那件事？”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 11, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "合并终止的谣言还没有平息。", "text_idx": 313, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 12, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“就是那件事。虽然已经没有能做的、该做的事了，算是报告一下吧。”", "text_idx": 268, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5532", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 13, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“久等了，濑名同学。”", "text_idx": 244, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "隼太", "alt_speaker_idx": 331, "voice": "ht1143", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 14, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“隼太也一起啊，那我也去比较好吗？”", "text_idx": 312, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 15, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“今天只是报告而已，新吾不用来也没关系吧。”", "text_idx": 247, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "隼太", "alt_speaker_idx": 331, "voice": "ht1144", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 16, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我知道了，有什么就打电话给我。”", "text_idx": 275, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 17, "speaker": "隼太", "flag": 64, "pages": [{"page": 0, "text": "“好，那就再见啦。”", "text_idx": 264, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "隼太", "alt_speaker_idx": 331, "voice": "ht1145", "char_id": "隼太"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 18, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“再见，瓜生君。”", "text_idx": 250, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5533", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 19, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“啊，嗯嗯。”", "text_idx": 257, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 20, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "我目送他们两人离开教室。", "text_idx": 320, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 21, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“…………”", "text_idx": 240, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 22, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“哥哥。”", "text_idx": 254, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3142", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 23, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "樱乃来到我的教室。", "text_idx": 326, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 24, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“濑名同学有事去找学园长。”", "text_idx": 293, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 25, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我收到邮件了。”", "text_idx": 260, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3143", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 26, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“……她真是无懈可击呢。”", "text_idx": 241, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 27, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“所以想说今天就先回去。”", "text_idx": 276, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3144", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 28, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“也对，那我们走吧。”", "text_idx": 246, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 29, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“欢迎，爱理。”", "text_idx": 290, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3145", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 30, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“打扰了。”", "text_idx": 277, "plain": null, "plain_idx": null, "len": 6, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5534", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 31, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“要吃饭？洗澡？还是──”", "text_idx": 300, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3146", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 32, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“当然是用功准备考试。”", "text_idx": 270, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5535", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 33, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“啊唔……不愧是爱理，回答得这么干脆。”", "text_idx": 255, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3147", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 34, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这是当然的吧？因为我又不是来玩的。”", "text_idx": 308, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5536", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 35, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“欢迎，比我预料的还早呢。”", "text_idx": 289, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 36, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是啊。”", "text_idx": 279, "plain": null, "plain_idx": null, "len": 5, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5537", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 37, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她的表情有一瞬间出现苦涩。", "text_idx": 316, "plain": null, "plain_idx": null, "len": 13, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 38, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "大概是发生什么事了。", "text_idx": 314, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 39, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "虽然有点在意，但是现在樱乃也在。", "text_idx": 330, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 40, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那今天就请多指教了。”", "text_idx": 309, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 41, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“拜托了……爱理老师的私人教学。”", "text_idx": 278, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3148", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 42, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“别这样说啦，听起来好邪恶的感觉。”", "text_idx": 251, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5538", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 43, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理，红茶可以吗？”", "text_idx": 297, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3149", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 44, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谢谢你，樱乃。”", "text_idx": 303, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5539", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 45, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "接过樱乃端来的杯子，她喝了一口，然后吁了一口气。", "text_idx": 321, "plain": null, "plain_idx": null, "len": 24, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 46, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“当老师很累？”", "text_idx": 271, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3150", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 47, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“啊，不，不是那样的。”", "text_idx": 256, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5540", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 48, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“该不会……那件事怎么了吗？”", "text_idx": 302, "plain": null, "plain_idx": null, "len": 15, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 49, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“有点。还有……一些其他的事。”", "text_idx": 288, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5541", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 50, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "放下杯子，她来回看了看我跟樱乃。", "text_idx": 322, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 51, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“是那件事？”", "text_idx": 283, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3151", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 52, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“反正完全传开了我就说吧，合并终止的事。”", "text_idx": 252, "plain": null, "plain_idx": null, "len": 21, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5542", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 53, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“嗯，我也听说了，合并要终止。”", "text_idx": 258, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3152", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 54, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是啊，传得大家都知道了。”", "text_idx": 281, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5543", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 55, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“有什么新的动向吗？”", "text_idx": 286, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 56, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这个嘛，她什么都没说，所以好像没什么改变。”", "text_idx": 306, "plain": null, "plain_idx": null, "len": 23, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5544", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 57, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那濑名同学的叹气就是……其他的事？”", "text_idx": 311, "plain": null, "plain_idx": null, "len": 19, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 58, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好。”", "text_idx": 262, "plain": null, "plain_idx": null, "len": 4, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5545", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 59, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“好像是看不下去学生们被谣言影响而心浮气躁，所以请我提醒他们注意一下。”", "text_idx": 263, "plain": null, "plain_idx": null, "len": 36, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5546", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 60, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“那是学园长说的？”", "text_idx": 310, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 61, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是资深的老师们。”", "text_idx": 282, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5547", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 62, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“学园长就对那种情况本来就不会多说什么，甚至可以说积极过头……”", "text_idx": 265, "plain": null, "plain_idx": null, "len": 32, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5548", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 63, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“结果就出问题了？”", "text_idx": 299, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 64, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“也不到问题的程度。只是有些烦人的老师觉得这样漫无纪律。”", "text_idx": 245, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5549", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 65, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“毕竟结女是有历史的女子学校呢。”", "text_idx": 291, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 66, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“对从以前就在的老师们来说，合并造成的缺点比较大。”", "text_idx": 267, "plain": null, "plain_idx": null, "len": 26, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 67, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“是啊。老实说我一开始也那么想。”", "text_idx": 280, "plain": null, "plain_idx": null, "len": 17, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5550", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 68, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理，对哥哥摆出冰块一样的态度。”", "text_idx": 295, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3153", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 69, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这个……抱歉。”", "text_idx": 305, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5551", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 70, "speaker": "新吾", "flag": 64, "pages": [{"page": 0, "text": "“我不介意喔，我想这是理所当然的反应。”", "text_idx": 272, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "新吾", "alt_speaker_idx": 323, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 71, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“……如果瓜生君不是这种个性，或许我现在也是同样的态度。”", "text_idx": 242, "plain": null, "plain_idx": null, "len": 29, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5552", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 72, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理，现在融化了？”", "text_idx": 296, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3154", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 73, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“这个形容有点那个呢……至少说‘和解’吧。”", "text_idx": 307, "plain": null, "plain_idx": null, "len": 22, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5553", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 74, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“没什么融化的感觉。”", "text_idx": 292, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3155", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 75, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“有什么关系，融化的话就不妙了吧？”", "text_idx": 285, "plain": null, "plain_idx": null, "len": 18, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5554", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 76, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学笑了笑。", "text_idx": 327, "plain": null, "plain_idx": null, "len": 8, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 77, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“多谢招待，很好喝。”", "text_idx": 261, "plain": null, "plain_idx": null, "len": 11, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5555", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 78, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "她放下空了的杯子。", "text_idx": 315, "plain": null, "plain_idx": null, "len": 9, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 79, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“要续杯吗？”", "text_idx": 301, "plain": null, "plain_idx": null, "len": 7, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3156", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 80, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“谢谢，但是不用了。反正还有一点时间。”", "text_idx": 304, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5556", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 81, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“有时间的话，可以喝点什么吧？”", "text_idx": 287, "plain": null, "plain_idx": null, "len": 16, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3157", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 82, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“哎呀，你以为我是为了什么才来这里的？”", "text_idx": 253, "plain": null, "plain_idx": null, "len": 20, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5557", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 83, "speaker": null, "flag": 64, "pages": [{"page": 0, "text": "濑名同学笑着这样说。", "text_idx": 328, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": null, "alt_speaker_idx": null, "voice": null, "char_id": null}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 84, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“再多用功一下吧。”", "text_idx": 249, "plain": null, "plain_idx": null, "len": 10, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5558", "char_id": "愛理"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 85, "speaker": "桜乃", "flag": 64, "pages": [{"page": 0, "text": "“爱理老师的课后辅导。”", "text_idx": 294, "plain": null, "plain_idx": null, "len": 12, "alt_speaker": "樱乃", "alt_speaker_idx": 325, "voice": "sk3158", "char_id": "桜乃"}]}
{"script": "scenario_sakuno_route02_06.txt", "scene": "*start", "row": 86, "speaker": "愛理", "flag": 64, "pages": [{"page": 0, "text": "“就说不要用那个说法了嘛！”", "text_idx": 269, "plain": null, "plain_idx": null, "len": 14, "alt_speaker": "爱理", "alt_speaker_idx": 329, "voice": "ar5559", "char_id": "愛理"}]}
