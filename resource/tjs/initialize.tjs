// リビジョン名付きパッチファイル自動検索 （※ Initialize.tjs コンパイル前提なので注意）
@if (INITIALIZE_PATCH_AUTOREV) // >0:一番大きいもののみ登録 / <0:小さい順からすべて登録
try {
	var all = @if (INITIALIZE_PATCH_AUTOREV < 0) 1| @endif 0;
	var path = System.arcPath;
	var list = Storages.dirlist(path);
	var found, rev = -1, rex = /^patch@r([1-9][0-9]*)\.xp3$/; // @!#$%&'`+-=^~_,;()[]{}
	for (var i = list.count-1; i >= 0; --i) {
		var item = ((string)list[i]).toLowerCase();
		if (rex.test(item)) {
			var mrev = +rex.matches[1];
			if (all) {
				found = [] if (found === void);
				found.add([ mrev, item ]);
			} else if (mrev > rev) {
				found = item;
				rev = mrev;
			}
		}
	}
	if (found !== void) {
		var currev = -1, revfile = "currev.ini"; // [XXX] pacing system depends
		if (Storages.isExistentStorage(revfile)) try {
			currev = +Scripts.evalStorage(revfile);
		} catch {}
		if (found instanceof "Array") {
			found.sort(function (a,b) { return a[0] < b[0]; });
		} else {
			found = [ [ rev, found ] ];
		}
		for (var i = 0; i < found.count; i++) {
			var ref = found[i];
			if (ref[0] > currev) {
				var file = ref[1];
				
				Storages.addAutoPath(path + file + ">");
				Debug.notice("*** autorev patch: " + file);
			}
		}
	}
} catch {}
@endif

// パッチ適用後の追加処理(Storages.tjsなどで登録することを想定
{
	for (var cnt = patch_aftercall.count, i = 0; i < cnt; ++i) {
		var func = patch_aftercall[i];
		if (func instanceof "Function") func();
	}
	delete global.patch_aftercall; // 消す
}

