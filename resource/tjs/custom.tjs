	"uistand.tjs",
	);

//------------------------------

@set (UIDS_DISABLE_SNAPSHOT=1) // スクリーンショット機能は未使用
{
	var dmmcloud = "dmmcloud.tjs";
	if (System.getArgument("-dmmcloud") == "yes") {
		if (Storages.isExistentStorage(dmmcloud)) {
			try {
				KAGLoadScript(dmmcloud);
			} catch (e) {
				var text = e ? e.message : "unknown";
				System.inform(@"Internal error: ${text}");
				System.exit(1);
			}
		} else {
			System.inform(@"Internal error: ${dmmcloud} not found.");
			System.exit(1);
		}
	}
}

function checkDMMCloud() { return typeof global.DMMCloud == "Object"; }


@if (APPEND_EXTENTION)
SetupAppendData();
@endif
