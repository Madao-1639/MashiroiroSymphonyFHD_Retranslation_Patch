	//								// バージョン情報表示文字に関する設定
top:		140,					// 文字列を表示する y座標位置
shadow:		false,					// 影ありなし
shadowcolor:0x000000,				// 影色
edge:		true,					// フチありなし
edgecolor:	0xFFFFFF,				// フチ色
color:		0x0000AA,				// フォント色
size:		12,						// フォントサイズ
align:		"center",				// 文字アラインメント
face:		"NotoSansCJKBl",		// フォント名
pitch:		0,

vermenufmt: "(ver${ver})",
vermenucut: " /",
	// 表示フォーマット
versionstring:"「${global.System.title}」version ${GetRevisionString.version}",
versionfade:0, // フェード時間
	];
