	return 0;
});

// リビジョン取得
function GetRevisionString(fmt, norev = debugWindowEnabled ? "${GetRevisionString.unknown}" : void) {
	var rev = "currev.ini", patch = "currev_patch.ini", chk = Storages.isExistentStorage;
	if (chk(rev)) try {
		var file = chk(patch) ? patch : rev;
		var currev = Scripts.evalStorage(file);
		Debug.notice("*** Revision: "+currev);
		return fmt.sprintf(currev);
	} catch {}
	return (norev != "") ? fmt.sprintf(norev) : void;
	function _static_ {}
	property version { getter {
		if (typeof GetRevisionString._static_.version != "undefined") {
			return GetRevisionString._static_.version;
		}
		var ver;
		if (typeof global.software_version != "undefined") {
			/**/ver = (string)global.software_version;
			if (ver.indexOf("${") >= 0) {
				ver = global.software_version = applyInlineStringVariableExtract(ver, global);
			}
		}
		return (GetRevisionString._static_.version = ver);
	} }
	property unknown { getter {
		if (typeof GetRevisionString._static_.unknown != "undefined") {
			return GetRevisionString._static_.unknown;
		}
		var rev = "XXX";
		// [XXX]現在のリビジョンを動的に取得（デバッグ中・未パックのみ）
		if (Storages.isExistentStorage(System.exePath+".svn/format")) try {
			Scripts.execStorage(System.exePath+"tools/svnbin/svnclient.tjs") if (typeof global.SvnClient == "undefined");

			//var wcver = SvnClient.GetWorkingCopyVersion(System.exePath);
			//if (wcver == "") throw new Exception("unknown working copy version.");
			//var svnpath = System.exePath + "tools/svnbin/format" + wcver + "/svn.exe";
			//if (!Storages.isExistentStorage(svnpath)) throw new Exception("svn.exe not found:"+svnpath);
			var svnclient = new SvnClient(); //svnpath);
			var info = svnclient.info(System.exePath+"data/");
			invalidate svnclient;
			/**/rev = info.Revision;
			if (rev != "") rev+="?";
		} catch {}
		return (GetRevisionString._static_.unknown = rev);
	} }
}

