// -----------------------------
// KAG標準メニューの差し替え

function KAGWindow_createMenus()
{
	if (typeof global.SystemAction != "Object" ) {
		global.SystemAction = this.systemActionInstance = new global.SystemActionClass(this);
		add(systemActionInstance);
	}

	// この関数は MainWindow クラスのオブジェクトのコンテキスト上で実行されます

	// メニュー項目を生成
	(global.KAGWindow_createMyMenus incontextof this)();

	// ファンクションキーを更新
	resetCaptionFunctionKeys(this);

	// SystemArgument系メニューの更新
	if (typeof global.sysArgMenuNameList == "Object") {
		var t= global.sysArgMenuNameList;
		var args = [], info = global.SystemArgumentInfo;
		for (var i = 0; i < t.count; i++) {
			var tag = t[i], menu;
			if (info[tag] !== void && (menu = info[tag].menu) != "" &&
				typeof   this[menu] == "Object") {
				args.add(this[menu]);
			}
		}
		updateSysArgMenuItem(args*);
	}
	updateFullScrZoomMenu(fullScrResMenu);
}

// -----------------------------
// ヘルプテキスト表示

var BrowsFiles = %[ index: [ "brows_conf.ks", "brows_help.ks", "helpover.ks"  ] ];
function openBrowsWindow(tag, name="index", w=620, h=440, parent=global.kag) {
	if (typeof global.BrowsWindow == "undefined") {
		KAGLoadScript("browswindow.tjs");
	}
	var win = new BrowsWindow(name, w, h, parent);
	win.open(tag, BrowsFiles[ name]);
	invalidate win;
}
KAGWindow.onHelpIndexMenuItemClick = function { openBrowsWindow(); } incontextof global;

&System.openURL = function(url, *) {
	if (url != "") {
		if (kag.callHook("onSystemOpenURL", url, *)) return;
		SystemAction._window();
		System.shellExecute(...);
	}
} incontextof global;

// ---------------------------------------------------------
// 基本機能メソッド
// ---------------------------------------------------------

class loadTrigger extends AsyncTrigger {
	var loadNumber, layer;
	function loadTrigger() {
		super.AsyncTrigger(this.load, "");
		mode = atmAtIdle;
		cached = true;
		cancel();
	}
	function finalize() {
		deleteLayer();
		super.finalize(...);
	}
	function load() {
		var reset = false;
		switch (typeof loadNumber) {
		case "void":    break;
		case "Object":
			if (loadNumber) {
				try { recollection(loadNumber); }
				catch (e) {
					System.inform(e.message);
					reset = true;
				}
			} else {
				prepare() if (!layer || !layer.visible);
				fadein(true);
			}
			break;
		case "Integer":
			prepare();
			reset = !kag.loadBookMark(loadNumber);
			if (!reset) fadein();
			else deleteLayer();
			break;
		case "String":
			prepare();
			var sel = customLoadHook(loadNumber, fadein);
			if (sel) fadein();
			else if (sel === void) {
				reset = true;
				deleteLayer();
			}
			break;
		default:   reset = true; break;
		}
		if (typeof global.SystemHook != "undefined")
			/**/   global.SystemHook.exec("loadinit.done", loadNumber); // 直実行なので .ks のフックは実行できないことに注意
		loadNumber = void;
		kag.setMenuAccessibleAll();
		kag.goToStart() if (reset);
	}
	function recollection(dic) {
		var fade = SystemConfig.recollectionFadeInStart;
		prepare() if fade;
		kag.startRecollection(dic);
		kag.insertTag("syshook", %[ name: "scenemode.view.start" ]) if (typeof global.SystemHook != "undefined"); // フック
		global.startRecollectionHook() if (typeof global.startRecollectionHook == "Object");
		if (dic.skipto != "") {
			kag.skipToLabel(true, dic.skipto);
			if (fade) {
				var hook = this.onSkipToLabelStop;
				kag.removeHook("onSkipToLabelStop", hook);
				kag.addHook   ("onSkipToLabelStop", hook);
			}
		} else {
			fadein(true) if fade;
		}
	}
	function onSkipToLabelStop {
		kag.removeHook("onSkipToLabelStop", this.onSkipToLabelStop);
		fadein();
	}
	function prepare(vis) {
		deleteLayer();
		layer = new Layer(kag, kag.uibase);
		with (layer) {
			.name = "load trigger";
			.visible = false;
			.setImageSize(kag.exWidth, kag.exHeight);
			.setSizeToImageSize();
//			.fillRect(0, 0, .width, .height, 0xFF000000);
			.type = ltOpaque;
			if (kag.isD3D) {
				kag.captureSnapshot(layer, kag.exWidth, kag.exHeight, false);
			} else {
				.piledCopy(0, 0, kag.fore.base, 0, 0, .width, .height);
			}
			.absolute = 10000000;
			.hitType = htProvince;
			if (vis) {
				.opacity = 255;
				.visible = true;
			}
		}
	}
	function fadein(nowait) {
		if (layer && isvalid layer) {
			layer.opacity = 255;
			layer.visible = true;
			kag.beginAction(layer, %[ opacity: %[ handler: MoveAction, start:255, value:0, time:300 ] ], onActionCompleted, nowait);
			kag.insertFastTag("wact", %[target:layer]) if (!nowait);
		}
	}
	function onActionCompleted() {
//		kag.onActionCompleted(...);
		deleteLayer();
	}
	function deleteLayer() {
		invalidate layer if (layer !== void && isvalid layer);
		layer = void;
	}
	function goBackHistory() {
		kag.goBackHistory(false);
		return true;
	}
	function goBackTitle() {
		SystemHook.kagCurrent(%[name:"title"]); // [XXX]
		kag.goToStart();
		return false;
	}
	function endRecollection() {
		kag.endRecollection();
		return false;
	}
	function loadEmergency {
		var resume = kag.getBookMarkFileNameBySystem("emergency");
		var ret, err;
		try {
			ret = kag.loadBookMarkFromFile(resume);
		} catch (e) {
			ret = false;
		}
		if (!ret) {
			err = GetSystemConfigItem("EmergencyRebootFailed", "復帰用データのロードに失敗しました。通常処理で起動します。");
			ret = goBackTitle();
		}
		Storages_deleteFile(resume);
		if (err != "") System.inform(err);
		return ret;
	}
	var loadHooks = %[
		/**/prev:            %[ callback:goBackHistory,   loadinit:'*noclearhistory'  ],
		/**/title:           %[ callback:goBackTitle,     loadinit:'*gobacktitle'     ],
		/**/endrecollection: %[ callback:endRecollection, loadinit:'*endrecollection' ],
		/**/emergency:       %[ callback:loadEmergency,   loadinit:'*emergencyreboot' ],
		];
	function getLoadHookInfo(tag, param) {
		var info = (typeof tag == "String" && tag != "" && loadHooks[tag] !== void) ? loadHooks[tag] : void;
		if (param == "") return info ? info : %[];
		return info ? info[param] : void;
	}
	function isNoclearHistory(tag) { // obsoleted
		return getLoadHookInfo(tag, "noclearhist");
	}
	function getLoadInitTarget(tag) {
		var info = getLoadHookInfo(tag);
		return info.loadinit != "" ? info.loadinit : info.noclearhist ? '*noclearhistory' : '';
	}
	function customLoadHook(tag) {
		var cb= getLoadHookInfo(tag, "callback");
		return (cb !== void) ? cb() : void;
	}
	function trigger() {
		var cb= getLoadHookInfo(loadNumber, "ontrigger");
		if (cb && cb()) return; // for trigger block
		return super.trigger(...);
	}
}
loadTrigger.instance = new loadTrigger();
function doLoad() { global.loadTrigger.instance.trigger(); }
function doLoadPrepare() {
	var inst = loadTrigger.instance;
	inst.prepare(true);
}
function doLoadFadeIn() {
	var inst = loadTrigger.instance;
	inst.loadNumber = null;
	inst.trigger();
}
function setCustomLoadHook(name, callback, loadinit, ontrigger) {
	var inst = loadTrigger.instance;
	inst.loadHooks[name] = %[ callback:callback, loadinit:loadinit, ontrigger:ontrigger ];
}

function loadFunction(work)
{
	var inst = loadTrigger.instance;
	// 誤動作防止
	kag.nextRecordHistory = false;
	// 進行を止めないために必要
	kag.closeDialog();
	inst.loadNumber = work;
	kag.process('loadinit.ks', inst.getLoadInitTarget(work), true, true);
	inst.loadNumber = work;
}

function saveFunction(work)
{
	return kag.saveBookMark(work);
}

function qloadFunction(num)
{
	if (typeof num == "Integer") {
		var data = kag.readBookMark(num, true);
		if (!kag.isValidBookMarkData(data, true, false)) {
			kag.callHook("onBookMarkLoadFailed", num, true);
			return false;
		}
	}
	loadFunction(...);
	global.qsaveNotify.show("q_loaded") if (typeof global.qsaveNotify !== 'undefined');
	return true;
}

function qsaveFunction()
{
	var ret = saveFunction(...);
	global.qsaveNotify.show("q_saved")  if (ret && typeof global.qsaveNotify !== 'undefined');
	kag.freeSnapshot();
	if (!ret) {
		function num(r) { return r; }
		kag.callHook("onBookMarkSaveFailed", num(...), true);
	}
	return ret;
}


// ---------------------------------------------------------
// キーバインド
// ---------------------------------------------------------

//        VK_? : 素の      VK_?
// "S_" + VK_? : Shift   + VK_?
// "C_" + VK_? : Control + VK_?
// "A_" + VK_? : Alt     + VK_?
// 複数同時指定の場合は SCA_ の順
// "*"  + VK_? : モディファイア無関係で VK_?
var kagCustomizedKeys = %[
	// ファンクションキー機能一覧
	VK_F1 => "about",							// F1: ヘルプ(About)
	VK_F2 => "save",							// F2: セーブ
	VK_F3 => "load",							// F3: ロード
	VK_F4 => "screen",							// F4: 画面切り替え(kag.toggleScreenMenuItem.shortcut に Alt+Enter が指定してあるので上書き時は注意）
	VK_F5 => "backlog", VK_PRIOR => "backlog",	// F5, PageUp: バックログ
	VK_F6 => "auto",							// F6: オート
	VK_F7 => "skip",							// F7: スキップ
	VK_F8 => "option",							// F8: オプション画面
	VK_F11=> "qsave",							// F11: クイックセーブ
	VK_F12=> "qload",							// F12: クイックロード

	// 吉里吉里機能キー抑制一覧
	"*" + #'F' => "none", // 次の選択肢/未読まで進む
	"*" + #'B' => "none", // 前に戻る
	"*" + #'A' => "none", // オート
	"*" + #'S' => "none", // セーブ
	"*" + #'L' => "none", // ロード
	"*" + #'R' => "none", // バックログ
	"S_" + VK_UP => "none", // バックログ

	"A_" + VK_LEFT  => "none", // 前のラベルへ戻る
	"A_" + VK_RIGHT => "none", // 次のラベルへ進む

	"S_" + VK_BACK => "none", // 直前に戻る
	];

// ファンクションキーに関するバインド（メニューショートカット表示用）
var updateCaptionFunctionKeys = %[];
function resetCaptionFunctionKeys(kag) {
	var ucfk = global.updateCaptionFunctionKeys;
	var kck  = global.kagCustomizedKeys;

	(Dictionary.clear incontextof ucfk)();
	if (!kag.callHook("onResetCaptionFunctionKeys", ucfk, kck)) {
		for (var i = 0; i < 12; i++) {
			var key = kck[VK_F1+i];
			ucfk[key] = "F"+(i+1) if (key != "" && key != "none");
		}
	}
	KAGWindow_updateMenus(kag, ucfk);
}

// キー入力の横取り
function keyFunc(key, shift)
{
	var tag, mod = "";
	mod += "S" if (shift & ssShift);
	mod += "C" if (shift & ssCtrl);
	mod += "A" if (shift & ssAlt);
	mod += "_" if (mod != "");

	try {
		tag = kagCustomizedKeys[mod + key];
		tag = kagCustomizedKeys["*" + key] if (tag == "");
	} catch {}
	if (tag != "") {
		if (tag == "none") return true;
		// タグの先頭が @ の場合はリピート有効
		if (tag.charAt(0) == "@") tag = tag.substr(1);
		else if (shift & ssRepeat) return true;

		if (typeof SystemAction[tag] != "undefined")
			return SystemAction[tag]([ tag, key, shift ]);

		var exp = kagCustomizedKeys["!" + tag];
		switch (typeof exp) {
		case "Object": return exp(key, shift);
		case "String": Scripts.eval(exp); return true;
		}
	}

	return false;
}

// ---------------------------------------------------------
// ボタンに文字を書く
// ---------------------------------------------------------
function drawButtonCaptionWithAlign(button, ox, oy, pos, caption, *)
{
	pos = 5 if (!pos); // default = center

	// 文字のサイズを得る
	var cw = button.font.getTextWidth( caption);
	var ch = button.font.getTextHeight(caption);
	var w = button.width, h = button.height;

	if (     pos === 2 || pos === 5 || pos === 8) ox += (w - cw) >> 1; // h-center
	else if (pos === 3 || pos === 6 || pos === 9) ox += (w - cw);      // right
	if (     pos === 4 || pos === 5 || pos === 6) oy += (h - ch) >> 1; // v-center
	else if (pos === 1 || pos === 2 || pos === 3) oy += (h - ch);      // bottom

	var dt = button.drawText, max = button.imageWidth;
	for (var n = 0; n < max; n+=w) dt(ox+n, oy, caption, *);
}
function drawButtonCaption(button, ox, oy, caption, *)
{
	return drawButtonCaptionWithAlign(button, ox, oy,, caption, *);
}

// ---------------------------------------------------------
// Array要素をランダムに選択
// ---------------------------------------------------------
function getRandomSE(elm) {
	var array = [], orig = elm.array;
	orig = Scripts.eval(orig) if (typeof orig == "String");
	array.assign(orig);
	// 存在しないファイルは除外する
	for (var i = 0; i < array.count; i++) {
		array[i] = void if (!(Storages.isExistentStorage(array[i]+".ogg") ||
							  Storages.isExistentStorage(array[i]+".opus") ||
							  Storages.isExistentStorage(array[i]+".wav")));
	}
	array.remove(void, true);
	if (array.count === 0) return;
	var buf = (elm.buf !== void) ? +elm.buf : kag.numSEBuffers;
	var rnd = array[(int)(defaultRandomGenerator.random() * array.count)];
	return %[ buf: buf, storage: rnd ];
}
function playRandomSE(elm) {
//	dm("playRandomSE", rnd, array.count);
	var e = getRandomSE(elm);
	kag.se[+e.buf].play(e) if (e !== void);
}

// Math.RandomGenerator インスタンス
var defaultRandomGeneratorInstance = void;
property defaultRandomGenerator { getter {
	if (defaultRandomGeneratorInstance === void)
		defaultRandomGeneratorInstance = new Math.RandomGenerator();
	return defaultRandomGeneratorInstance;
}}

// ---------------------------------------------------------
// 再帰的にDictionaryを表示
// ---------------------------------------------------------

function StructToString(dic, level = 0, add = 2) {
	var ret = "";
	if (typeof dic !== "Object" || !(dic instanceof "Dictionary")) return ret;
	var items = [];
	items.assign(dic);
	for (var i = 0; i < items.count; i+=2) {
		var key = items[i], val = items[i+1];
		ret += " ".repeat(level) + key + ": ";
		if (typeof val === "Object") {
			if (val instanceof "Array") {
				ret += "[ " + val.join(", ") + " ]\n";
				continue;
			} else if (val instanceof "Dictionary") {
				ret += "%[\n" + StructToString(val, level + add, add);
				ret += " ".repeat(level) + "]\n";
				continue;
			}
		}
		val = "void" if (val === void);
		ret += val + "\n";
	}
	return ret;
}


// ---------------------------------------------------------
// AfterInit で呼び出されるコールバックを登録
// ---------------------------------------------------------

var afterInitCallback = [], kagHookEntries = [];
// 単純なコールバックを登録
function addAfterInitCallback(func, kagcontext) {
	afterInitCallback.add(%[mode:"callback", callback:func, kagcontext:kagcontext]);
}
// KAGのハンドラを登録する
function addKagHandler(handle, func, kagcontext, excommand) {
	afterInitCallback.add(%[mode:"handler", handle:handle, func:func, kagcontext:kagcontext]);
	if (excommand !== void) EntryEnvinfoExCommand(%[ handle => excommand ]);
}
// kag.addHookを登録する
function addKagHookCallback(handle, func, kagcontext) {
	kagHookEntries.add(%[ handle:handle, func:func, kagcontext:kagcontext]);
}
// システムマクロ登録処理 // addKagSystemMacro("[call storage='xxxx.ks' target='*macro']", ...);
function addKagSystemMacro(texts*) {
	// cf. first.ks
	SystemConfig.systemMacroTexts = [] if SystemConfig.systemMacroTexts === void;
	SystemConfig.systemMacroTexts.push(texts*);
}

// コールバック関数のコンテキストを決定
function getInitCallbackFunction(cb, sel, ctx) {
	if (!cb || typeof cb != "Object") return function {};
	var func;
	switch (typeof sel) {
	case "void":   func = cb; break;
	case "Object": func = cb incontextof sel; break;
	default:       func = +sel ? (cb incontextof ctx) : (cb incontextof global); break;
	}
	return func;
}
// kagのフックを登録する
function KAGWindow_config_override() {
	for (var i = 0, cnt = kagHookEntries.count; i < cnt; i++)
		with (kagHookEntries[i]) addHook(.handle, getInitCallbackFunction(.func, .kagcontext, this));
	callHook("onKAGSetupConfig", this);
	delete global.kagHookEntries;
	global.addKagHookCallback = function {
		Debug.notice("addKagHookCallback(s) were expired.");
	} incontextof global;
}

// コールバック呼び出し
function callAfterInit() {
	for (var i = 0, cnt = afterInitCallback.count; i < cnt; i++) {
		with (afterInitCallback[i]) {
			switch (.mode) {
			case "callback": (getInitCallbackFunction(.callback, .kagcontext, kag))(); break;
			case "handler":
				var func = getInitCallbackFunction(.func, .kagcontext, kag);
				kag.tagHandlers[.handle] = func;
				if (typeof global.SceneParserAddCommand == "Object") {
					SceneParserAddCommand[.handle] = true;
				}
				break;
			}
		}
	}
	delete global.afterInitCallback;
	global.addKagHandler = global.addAfterInitCallback = function {
		Debug.notice("AfterInitCallback(s) were expired.");
	} incontextof global;
}

// ---------------------------------------------------------
// excomand登録

function EntryEnvinfoExCommand(elm) {
	function _static {}
	_static.envinfo = %[] if (typeof _static.envinfo == "undefined");
	(Dictionary.assign incontextof _static.envinfo)(elm, false);
	return;
	function onLoadEnvInfo(envinfo) {
		var ref = EntryEnvinfoExCommand._static;
		if (typeof ref.envinfo == "Object") {
			var m = ref.envinfo;
			envinfo.excommands = %[] if !(envinfo.excommands instanceof "Dictionary");
			(Dictionary.assign incontextof envinfo.excommands)(m, false);
			dm("envinfo merged", getPrint(m)) if (kag.debugLevel >= tkdlVerbose);
		}
	}
}
addKagHookCallback("onLoadEnvInfo", EntryEnvinfoExCommand.onLoadEnvInfo, false);

// ---------------------------------------------------------

// resetModeChangedをrestoreFlagsのフックに登録
addKagHookCallback("onAfterRestoreFlags", function {
	resetModeChanged();
}, false);

// BGMを更新するタグ（同じ曲ならそのまま）
addKagHandler("updatebgm", function(elm) {
	var r = 0;
	with (bgm)
		if (.inFading || .playingStorage.toUpperCase() != elm.storage.toUpperCase()) {
			var ref = "playbgm";
			/**/ref = .inFading ? "fadeinbgm" : "xchgbgm" if (elm.exchange);
			dm("updatebgm", ref);
			if (typeof tagHandlers[ref] == "Object") r = tagHandlers[ref](...);
		}
	if (elm.sflag && elm.storage != "") {
		sflags["bgm_"+(elm.storage.toUpperCase())] = true;
	}
	return r;
}, true);

// 高速スキップ用
addKagHandler("fastskip", function(elm) {
	if (skipNoDisp && elm !== void) with (elm) {
		var label = .target, storage = (.storage != "") ? .storage : conductor.curStorage;
		if (label == "") throw new Exception("fastskip: ラベルを指定してください");
		label = label.substring(1) if (label.charAt(0) == "*");
		with (Storages) storage = .chopStorageExt(.extractStorageName(storage));
		var flag = @"trail_${storage}_${label}";
		if (sflags[flag]) return tagHandlers.next(elm);
	}
	return 0;
}, true);

// 画像キャッシュ file=*, file1=*, file2=* ... １からの連続番号で有効
addKagHandler("touch", function(elm) {
	if (elm === void || skipNoDisp) return 0;
	var list = [];
	list.add(elm.file) if (elm.file != "");
	for (var file, i=1; (file = elm["file"+i]) != ""; i++) list.add(file);
	System.touchImages(list, +elm.limit, +elm.timeout) if (list.count > 0);
	return 0;
}, true);

var messageWindowOptions = %[];
// メッセージウィンドウをロードするタグ
addKagHandler("meswinload", function(elmov) {
	var elm = %[];
	with (global) {
		(.Dictionary.assign incontextof elm)(.messageWindowOptions, true);
		(.Dictionary.assign incontextof elm)(elmov, false) if (elmov !== void);
		var sysuiload = tagHandlers.sysuiload;
		if (elm.page != "both") sysuiload(elm);
		else {
			elm.page  = "fore"; sysuiload(elm);
			elm.page  = "back"; sysuiload(elm);
		}
		.resetModeChanged();
	}
	kag.setMenuAccessibleAll();
	return 0;
}, true);
// メッセージウィンドウのデフォルトオプションを設定
addKagHandler("meswinopt", function(elm) {
	with (global) (.Dictionary.assign incontextof .messageWindowOptions)(elm, true);
	// apply設定で事前に設定できるものはしておく
	if (elm.apply) {
		var opt = %[];
		(Dictionary.assign incontextof opt)(messageWindowOptions);
		delete opt.storage; // ui-storage
		delete opt.page;
		if (opt.layer != "") {
			var position = tagHandlers.position;
			opt.page = "fore"; position(opt);
			opt.page = "back"; position(opt);
		}
	}
	return 0;
}, true);
// loadfadeinコール用
addKagHandler("loadfadein", function(elm) {
	if (elm && elm.prepare) doLoadPrepare();
	else doLoadFadeIn();
	return 0;
}, false, COMMAND_SYNC);

addAfterInitCallback(function() {
	with (kag) {
		// ウィンドウサイズのメニューにチェックを入れる
		if (typeof .winResMenu != "undefined") {
			var menu = .winResMenu;
			updateWindowResMenu(menu);
			menu.enabled = .windowedMenuItem.checked;

			// パススルーメニューを更新する
			setDelayedTrigger("updatePassThroughMenuItem", function() {
				updatePassThroughMenuItem(-1);
			} incontextof global, 800);
			updatePassThroughMenuItem(1);
		}
		if (typeof .disableWindowResizeMenuItem != "undefined") {
			/**/   .disableWindowResizeMenuItem.visible = (typeof .registerExEvent != "undefined");
		}
		if (typeof .cancelAutoByClickMenuItem != "undefined")
			/**/   .cancelAutoByClickMenuItem.checked = .cancelAutoWhenClick;

		if (!global.SystemConfig.disableTroubleShootMenuFlatten) {
			var cnt = .videoOverlayModeMenu.children.count;
			resetSysArgRadioMenuParent("troubleShootMenu", "vomstyle");
			if (!global.kirikiriz) {
				resetSysArgRadioMenuParent("troubleShootMenu", "fullscreenmode", cnt+1);
			}
		}
		// 初期状態はIME無効(要WindowEx.dll)
		if (typeof .resetImeContext == "Object" && (SystemConfig.haveEditLayerManager || typeof global.EditLayer.Manager == "Object")) // [XXX] cf. EditLayer.tjs
			/**/   .resetImeContext(false);

		// 画面効果メニューにチェックを入れる
		.updateEffectButton();

		// 未読スキップチェック
		setAllSkip();

		// セーブ・ロード機能制限
		.origCanStore   = .canStore;
		.origCanRestore = .canRestore;
		.canStore   = function() { return origCanStore()   && !inSystemMenu(this); } incontextof kag;
		.canRestore = function() { return origCanRestore() && !inSystemMenu(this); } incontextof kag;

		{ // セーブロード失敗通知ダイアログ表示処理
			var dlg = SystemConfig.bookMarkSaveLoadFailedDialog;
			if (dlg !== void) {
				var failedhook = function (num, isquick) {
					const dlg = this[0], issave = this[1];
					const tag = (isquick ? "q":"") + (issave ? "save" : "load");
					if (dlg instanceof "Class") {
						//dm("failedhook.DialogLayer", num, isquick);
						// 直接生成
						var instance = new dlg(kag, kag.uibase, tag);
						instance.open();
					} else if (dlg instanceof "Dictionary") {
						//dm("failedhook.Dict", num, isquick);
						// 通常ダイアログ
						var text = dlg[tag];
						if (text != "") askYesNo(text, "エラー");
					} else if (dlg instanceof "Function") {
						//dm("failedhook.Func", num, isquick);
						// カスタムフック
						dlg(tag, num);
					}
				};
				.addHook("onBookMarkSaveFailed", failedhook incontextof [ dlg, true  ]);
				.addHook("onBookMarkLoadFailed", failedhook incontextof [ dlg, false ]);
			}
		}

		// SystemConfig.disableDisplayMenuInMoviePlaying = true の時
		// ムービー再生時は画面設定を変更できない
		.onMovieStatusChanged = function(state, id) {
			if (global.SystemConfig.disableDisplayMenuInMoviePlaying) {
				if(typeof this.displayMenu != "undefined")
					this.displayMenu.enabled = !this.isMoviePlaying();
			}
			callHook("onMovieStatusChanged", state, id);
		} incontextof kag;

		// video タグの乗っ取り : volume のデフォルト値を bgmvolume にする
		/* Movie.tjs で対応するようにしたので不要になった
		.origVideoTagHandler = .tagHandlers.video;
		.tagHandlers.video = function(elm) {
			if (typeof elm.volume == "undefined" && !elm.noautovolume)
				elm.volume = (bgmenable && waveenable ? (bgmvolume * wavevolume / 100) : 0);
			return origVideoTagHandler(elm);
		} incontextof kag;
		  */

		// 終了後サウンド再生処理
		// サウンドがなりおわるまで終了遅延させる
		.onCloseYes = function() {
			callHook("onCloseYes");
			var chk = SystemConfig.checkJumpEndKsOnClose;
			if (chk === void) chk = (seenable && sevolume > 0);
			else if (typeof chk == "Object") chk = chk(this);
			if (chk) {
				askOnClose = false; // 再度聞いてこないようにする
				process("end.ks");
			} else {
				shutdown();
			}
		} incontextof kag;

		// キーボードフックを登録
		.keyDownHook.add(keyFunc);

		// スクリーン変更後処理を登録
		setDelayedTrigger("resetScreen", resetScreen);
		.addHook("afterChangeScreenMode", function {
			try {
				invokeDelayedTrigger("resetScreen");
//				systemUpdate("fullscreen");
				updatePassThroughMenuItem();
			} catch {}
		} incontextof global);

		// 画面モード変更フック
		.addHook("onDisplayChangedHook", global.onDisplayChangedHook);

		// リサイズフック処理を登録
		.addHook("onWindowResizeHook", global.onWindowResizeHook);

		// ロード時処理
		.addHook("onBeforeRestoreFlags", global.terminator.invoke);

		// システムセーブエラー時
		.addHook("onSaveSystemVariablesFailed", function {
			try { return loadExMenuInterface() ? global.onSaveSystemVariablesFailed(...) : void; } catch {}
		} incontextof global);

		// フォントフェイス変更
		.addHook("onSetMessageLayerUserFont", function { try { systemUpdate("fontSelect"); } catch {} } incontextof global);

		// 終了確認時にunminimize
		.addHook("onCloseQuery", function {
			try {
				if (isvalid this && currentDialog === void &&
					_minimized && typeof this.showRestore == "Object" &&
					!SystemConfig.noRestoreMinizeOnClose)
				{
					showRestore();
				}
			} catch {}
		} incontextof kag);

		// jumpタグに警告
		.addHook("onConductorJump", function (elm) {
			if (!usingExtraConductor) {
				if (inGameState(this) && !elm.ignorewarn) {
					if (SystemConfig.enableJumpTagHack) { // 強制でjumpをnext相当の機能に置き換える
						tagHandlers.next(elm);
						return true;
					}
					errorCmd("既読情報を正しく保存するためにjumpではなくnextタグを使用してください");
				}
				if (typeof this.skipToLineStop != "undefined" &&
					/**/   this.skipToLineStop !== void) return true; // デバッグスキップ中はjumpを無効
			}
		} incontextof kag);

		.addHook("onHelpAboutMenuItemClicked", function {
			if (aboutDialogConfig) with (aboutDialogConfig) {
				if (.autosize > 0 && .storage != "") {
					var image = getExistImageName(.storage);
					if (image != "") {
						var temp = new Layer(this, temporaryLayer);
						try {
							temp.loadImages(image);
							aboutWidth  = temp.imageWidth;
							aboutHeight = temp.imageHeight;
						} catch {}
						invalidate temp;
					}
					.autosize = -1;
				}
			}
		} incontextof kag);
		
		if (!inXP3archivePacked) {
			// アイコン設定
			try {
				if (typeof global.ENV_IconFile == "String" && global.ENV_IconFile != "" &&
					Storages.isExistentStorage(System.exePath+global.ENV_IconFile) && typeof .setWindowIcon == "Object") {
					var file =                 System.exePath+global.ENV_IconFile;
					.setWindowIcon(file, true) if (!(typeof   Storages.getMD5HashString == "Object" &&
													 ((string)Storages.getMD5HashString(file)).toLowerCase()
													 /**/== "078918631a0f72bd1143de4978e7c370")); // default icon MD5
				}
			} catch {}
		}

		// デバッグ時のみ有効
		if (debugWindowEnabled) {
			// 外部制御フック
			.addHook("onMessageReceivedHook", function(mes) {
				if (SystemConfig.stopSkipOnMessageReceived) {
					SystemConfig.stopSkipOnMessageReceived = false;
					kag.cancelSkip();
				}
				debugMessageReceived(mes.split("|"));
			} incontextof global);
			if (System.getArgument("-sendmessage") != "") {
				SystemConfig.stopSkipOnMessageReceived = true;
				SystemHook.add("first.init", function { skipToStop(); } incontextof kag);
			}
			// ALT+DEL再起動時に強制でイベント停止を解除・再起動メニューをクリック
			if (kag.exEventEnabled) {
				var msg = .WM_SYSKEYDOWN = global.Window.getNotificationNum("SYSKEYDOWN");
				.setMessageHook(true, msg);
				.addHook("onWindowsMessageHook", function (msg, wp, lp) {
					if (msg == WM_SYSKEYDOWN && wp == VK_DELETE) {
						System.eventDisabled = false;
						runOnceDelayedTrigger(function {
							if (isvalid this) menuItemClickByKey("systemRestartMenuItem");
						} incontextof this);
						return true;
					}
				} incontextof kag);
			}
			// デバッグシナリオ開始でセーブ無効解除
			SystemHook.add("execdialog.start", function {
				tempDisableStore(%[]);
				try {
					// [XXX] 回避フラグ
					if (!tf.noresetonexec) with (tagHandlers) {
						.syscover(%[ visible:false ]);
						.stopbgm(%[]);
						.stopse (%[ buf:"all" ]);
					} else {
						delete tf.noresetonexec;
					}
				} catch {} } incontextof kag);
			// 自動ログオープン
			.addHook("onErrorLineHook", function(target, msg, filename, line) {
				entryErrorLogWithTimeStamp(msg, filename, line);
				if (!isvalid this || System.getArgument("-autoerrlogopen") == "no" || target === void ||
					logMode || typeof this.chDebugLogMenuItem != "Object") return;
				onChDebugLogMenuItemClick( chDebugLogMenuItem);
			} incontextof kag);
			// 自動ログ移動
			.addHook("onWindowResizeHook", function {
				if (!isvalid this || !logMode || logPad === void) return;
				initLogPad(true, true) if (System.getArgument("-autoerrlogmove") != "no");
			} incontextof kag);
			.addHook("onChDebugLogMenuItemChanged", function (en) {
				if (typeof this.debugAutoErrorLogMoveMenuItem == "Object") 
					/**/        debugAutoErrorLogMoveMenuItem.enabled = en;
			} incontextof kag);
			.callHook("onChDebugLogMenuItemChanged", .logMode);
			//autoLabelStore用
			.addHook("onAutoLabelStoreHook", function (dic) {
				try { if (dic.text == "") dic.text = historyLayer.currentText; } catch {}
			} incontextof kag);
			.addHook("disableAutoLabelStore", function {
				try { if (!inGameState(this) || (currentStorage == "start.ks" && !world_object.playerWorking)) return true; } catch {}
			} incontextof kag);
			.addHook("onModeChangeHook", function {
				try { selectAutoLabelStoreMenuItem.enabled = backToAutoLabelStoreMenuItem.enabled; } catch {}
			} incontextof kag);
			.addHook("onMoveSizeEndHook", function(win, old) {
				if (System.getArgument("-consolesyncpos") != "yes") return;
				var rect = getWindowRect();
				if (rect === void || old === void || old.window === void) return;
				var ox, oy;
				with (old.window) ox = rect.x-.x, oy = rect.y-.y;
				if (ox != 0 || oy != 0 ) with (Debug.console) {
					var rect = (typeof .getRect == "Object") ? .getRect() : void;
					if (rect !== void) .setPos(rect.x+ox, rect.y+oy);
				}
			} incontextof kag);
			// envStateChecker
			.addHook("onDebugWinVisibleChanged", function (vis) {
				global.SetDebugEnvStateCheckerVisible(vis) if (hasDebugUtil);
			} incontextof global);
			if (._debugwin !== void && ._debugwin.visible && hasDebugUtil) {
				global.SetDebugEnvStateCheckerVisible(true);
			}
			// 保存ラベル有無チェック
			.stableHandlers.add(function {
				if (!usingExtraConductor && inGameState(this)) {
					if (typeof global.world_object == "Object" &&
						/**/   global.world_object.env.transMode) errorCmd("begintrans/endtrans間でクリック待ちになりました");
					if (prevSkipMode !== void) {
						errorCmd("beginskip/endskip間でクリック待ちになりました");
						cancelSkip();
					}
					var esn  = Storages.extractStorageName;
					var last = storeLabelPassedLastStorage;
					var cur  = ((string)conductor.curStorage).toLowerCase();
					if (cur != "" && !inSystemMenuStorages[cur] &&
						((last == "") || (esn(last).toLowerCase() != esn(cur)))) {
						if (typeof global.checkScenarioLabelOnStable != "Object" ||
							/**/  !global.checkScenarioLabelOnStable(cur, last)) {
							errorCmd("保存可能なラベル指定がないシナリオで停止状態になりました");
							storeLabelPassedLastStorage = cur; // 二度目は出さない [XXX]
						}
					}
				}
			} incontextof kag);

			// エンジンバージョン表示
			if (!SystemConfig.disableShowDebugBuildVersionMenu && typeof global.MenuItem == "Object") {
				var kz      = (typeof global.kirikiriz   != "undefined" && kirikiriz);
				var devmode = (typeof global.developMode != "undefined" && developMode);
				var debug   = (System.getArgument("-debug") == "yes");
				var packed  = inXP3archivePacked;
				var tag = kz ? "[KZ]":"(k2)";
				if (debug) tag += "/d";
				tag += ", ";
				var ddev = typeof kag.getDrawDeviceName == "Object" ? kag.getDrawDeviceName() : void;
				if (ddev == "PassThrough" || ddev == "Basic") ddev = "Std";
				else if (ddev == "Default") ddev = "Def";
				if (typeof kag.d3dMode != "undefined" && (kag.d3dMode || kag.d3dMotion)) {
					tag += ddev+"/" if (ddev != "");
					tag += kag.d3dMode ? "D, " : "M, ";
				} else if (ddev != "") tag += ddev+", ";
				tag += devmode ? "DevelopMode" : packed ? "Packed" : "Normal";
				if (Storages.isExistentStorage("currev.ini")) tag += GetRevisionString("Rev%s");
				if (typeof Debug.EngineRev == "Object") try {
					tag += ", EngineRev"+(Debug.EngineRev[0].split(" "))[1];
				} catch {}
				var children;
				if (!packed) {
					var engine = kz?'kirikiri2':'KirikiriZ';
					var exe    = kz?'krkr.eXe' :'krkrZ.exe';
					var candev = devmode || (typeof global.getToolsPath == "Object" && Storages.isExistentStorage(getToolsPath("engine/system/Initialize.tjs")));
					var devtag = devmode ? '.undev' : '.dev';
					var dbgtag = debug   ? '.undbg' : '.dbg';
					children = [
						%[ caption:"&Reboot Menu",  exp:"DebugBuildReboot()" ],
						"-",
						%[ caption:@"switch ${engine} \&Engine",  exp:@"DebugBuildReboot('${exe}')", prop:%[ enabled:Storages.isExistentStorage(System.exePath+exe) ] ],
						%[ caption:(devmode?"disable":"enable") + " \&DevelpMode",    exp:@"DebugBuildReboot('${devtag}')", prop:%[ enabled:candev ] ],
						%[ caption:(debug?"disable":"enable") + " \&TJS debug",       exp:@"DebugBuildReboot('${dbgtag}')" ],
						"-",
						%[ caption:"disable &all Debug tools", exp:"DebugBuildReboot('.nodbg')" ],
						];
				}
				var elm = %[ caption:tag, enabled:!packed, children:children ];
				kag.callHook("onShowDebugBuildVersionMenu", elm);
				with (elm) CreateVersionInfoMenuItem(.caption, .enabled, .children);
			}
			// KAGAutoFlagMenuItemのチェックを更新
			if (typeof global.KAGAutoFlagMenuItem == "Object") {
				/**/          KAGAutoFlagMenuItem.UpdateAll();
			}
		} else if (!SystemConfig.disableShowBuildVersionMenu && typeof global.MenuItem == "Object") {
			SystemHook.add("first.init", function {
				with (aboutDialogConfig) {
					var ver = (string)GetRevisionString.version;
					var fmt = .vermenufmt;
					var cut = .vermenucut, idx;
					if (cut != "" && (idx = ver.indexOf(cut)) >= 0) ver = ver.substr(0,idx).trim();
					if (ver != "") CreateVersionInfoMenuItem(applyInlineStringVariableExtract(fmt, %[ ver:ver ]));
				}
			} incontextof global);
		}
	}
} incontextof global);
function CreateVersionInfoMenuItem(text, enabled=false, children) {
	if (System.getArgument("-vermenu") == "no") return;
	with (kag) {
		var hide = typeof .menuBarHideMenuItem == "Object" ? .menuBarHideMenuItem : null;
		if (typeof global.kirikiriz != "undefined") {
			if (!kirikiriz) .addHook("afterChangeScreenMode", function {
				// [XXX] 吉里吉里2のみ：フルスクリーン切り替え後に再度メニューを右寄せ
				try { debugVersionMenuItem.rightJustify = true; } catch {}
			} incontextof kag);
		}
		var mi = .debugVersionMenuItem = new MenuItem(kag, text);
		if (hide) .menu.insert(mi, hide.index);
		else      .menu.add(mi);
		mi.enabled = enabled;
		if (children) createMenuFromList(kag, mi, children);
		mi.rightJustify = true;
		var hide = typeof kag.menuBarHideMenuItem == "Object" ?  kag.menuBarHideMenuItem : null;
		if (hide) with (hide) {
			/**/.rightJustify = false;
			&   .rightJustify = &mi.rightJustify; // [XXX]プロパティ置き換え
		}
		return mi;
	}
}
function DebugBuildReboot(mode) {
	if (mode == "") return systemReboot(true);
	var opts;
	switch (Storages.extractStorageExt(mode).toLowerCase()) {
	case ".exe":
		&System.exeName = System.exePath+mode;
		break;
	case ".nodbg":
		opts = "-debugwin=no";
		// not break
	case ".undbg":
	case ".dbg":
		System.setArgument("-debug", mode == ".dbg" ? "yes":"no");
		break;
	case ".undev":
		Storages.deleteFile(System.exePath+"develop.txt");
		break;
	case ".dev":
		[].save(System.exePath+"develop.txt");
		break;
	}
	systemReboot(false, opts);
}
// デバッグ時はコンパイルしてロードする
function OndemandCompiledLoad(list*) {
	function proc(file, indev, force) {
		if (indev || force) with (Storages) {
			var src = "_"+file;
			if (force < 0) file = src;
			else if (.isExistentStorage(src)) {
				function gettime(file) {
					with (Storages) {
						var path = .getPlacedPath(file);
						return path != "" ? .getLastModifiedFileTime(path) : -1;
					}
				}
				var srctime = gettime(src);
				var dsttime = gettime(file);
				if (force || srctime > dsttime) {
					dm("### CompileScript", file);
					var tmp = System.dataPath + file;
					var dst = .getPlacedPath(file);
					if (dst == "") dst = System.exePath + "data/main/" + file;
					Scripts.compileStorage(src,  tmp, /*has result*/false, /*debug*/false, /*expression*/false);
					Storages.copyFileNoNormalize(tmp, dst, false);
					Storages.deleteFile(tmp);
				}
			}
		}
		KAGLoadScript(file);
	}

	// コンパイル条件確認
	var compile = System.getArgument("-compile");
	var debug = debugWindowEnabled && !inXP3archivePacked;
	var indev = debug && (typeof global.developMode != "undefined" && developMode);
	var force = debug ? ((compile == "yes") ? true : (compile == "direct") ? -1 : 0) : 0;

	for (var i = 0, cnt = list.count; i < cnt; ++i) {
		var file = list[i];
		if (file != "") proc(file, indev, force);
	}

	if (debug) {
		function compilemenu() {
			var ver = typeof kag.debugVersionMenuItem == "Object" ?
				/**/         kag.debugVersionMenuItem : null;
			if (ver) createMenuFromList(kag, ver, [
				%[  caption:"-", prop:%[ index:5 ] ],
				%[  name:"uiCompileMenuItem", caption:"UI script force compile", exp:"systemReboot(false, '-compile=yes')",    prop:%[ index:6 ] ],
				%[  name:"uiCompileMenuItem", caption:"UI script passthrough",   exp:"systemReboot(false, '-compile=direct')", prop:%[ index:7 ] ]
				]);
		}
		addAfterInitCallback(compilemenu);
	}
}

// aboutダイアログ用
var aboutDialogConfig = %[
title:		"Version Information",		// ウィンドウタイトル
storage:	"aboutdialog",			// 背景画像
