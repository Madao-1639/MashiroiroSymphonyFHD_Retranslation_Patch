{"script": "年明け２月１４日（日）_05.txt", "scene": "*start", "row": 0, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "那之后……", "steam": "……那之後。"}, "length": {"chs": 5, "steam": 6}, "similarity": 0.667}
{"script": "年明け２月１４日（日）_05.txt", "scene": "*start", "row": 1, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "等纱凪缓过劲来能动后……", "steam": "紗凪過了好一會才終於能自由行動……"}, "length": {"chs": 12, "steam": 17}, "similarity": 0.16}
