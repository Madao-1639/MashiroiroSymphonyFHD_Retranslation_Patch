{"script": "年明け２月１４日（日）_05.txt", "scene": "*start", "row": 68, "page": 0, "status": "aligned", "speaker": {"chs": "纱凪", "steam": "紗凪"}, "alt_speaker": {"chs": null, "steam": "紗凪"}, "voice": {"chs": "sn7506", "steam": "sn7506", "equal": true}, "text": {"chs": "「大概还残留着刚才的余韵吧……」", "steam": "「因為還留有餘韻嗎……」"}, "length": {"chs": 16, "steam": 12}, "similarity": 0.1}
{"script": "年明け２月１４日（日）_05.txt", "scene": "*start", "row": 69, "page": 0, "status": "needs_review", "speaker": {"chs": "新吾", "steam": "新吾"}, "alt_speaker": {"chs": null, "steam": "新吾"}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "「……都接吻了，\\n　还能正常地站着哎」", "steam": "「……我吻了妳，但妳還能站著喔。」"}, "length": {"chs": 20, "steam": 17}, "similarity": 0.32}
