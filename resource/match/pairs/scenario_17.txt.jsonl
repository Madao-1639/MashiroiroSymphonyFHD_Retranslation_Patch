{"script": "scenario_17.txt", "scene": "*start", "row": 0, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "然后终于，期中考试开始了。", "steam": "於是，期中考試終於開始了。"}, "length": {"chs": 13, "steam": 13}, "similarity": 0.455}
