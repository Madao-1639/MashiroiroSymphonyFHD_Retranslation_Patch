{"script": "scenario_10.txt", "scene": "*start", "row": 51, "page": 0, "status": "needs_review", "speaker": {"chs": "新吾", "steam": "新吾"}, "alt_speaker": {"chs": null, "steam": "新吾"}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "「不管做多少，工作都没有减少啊……」", "steam": "「不管完成多少，工作都不會減少呢……」"}, "length": {"chs": 18, "steam": 19}, "similarity": 0.593}
{"script": "scenario_10.txt", "scene": "*start", "row": 52, "page": 0, "status": "aligned", "speaker": {"chs": "爱理", "steam": "愛理"}, "alt_speaker": {"chs": null, "steam": "愛理"}, "voice": {"chs": "ar0277", "steam": "ar0277", "equal": true}, "text": {"chs": "「因为咱们班采用了前所未有的形式，\\n　刚开始的时候忙点也没办法」", "steam": "「因為我們班是以至今為止都沒有的形式運作的班級，剛起步這也是沒辦法的。」"}, "length": {"chs": 33, "steam": 36}, "similarity": 0.295}
