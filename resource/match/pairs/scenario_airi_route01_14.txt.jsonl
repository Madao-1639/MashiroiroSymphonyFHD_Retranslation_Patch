{"script": "scenario_airi_route01_14.txt", "scene": "*start", "row": 92, "page": 0, "status": "aligned", "speaker": {"chs": "爱理", "steam": "愛理"}, "alt_speaker": {"chs": null, "steam": "愛理"}, "voice": {"chs": "ar1500", "steam": "ar1500", "equal": true}, "text": {"chs": "「话说回来瓜生，你的父母完全不回家的吗？」", "steam": "「這麼說來，瓜生你的雙親一直沒有回家嗎？」"}, "length": {"chs": 21, "steam": 21}, "similarity": 0.353}
