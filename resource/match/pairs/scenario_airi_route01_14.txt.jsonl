{"script": "scenario_airi_route01_14.txt", "scene": "*start", "row": 0, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "新的一天开始，感觉比起昨天，濑名在我面前更加敞开心扉了。", "steam": "過了一天，感覺瀨名比昨天對我更沒有防備了。"}, "length": {"chs": 28, "steam": 21}, "similarity": 0.455}
