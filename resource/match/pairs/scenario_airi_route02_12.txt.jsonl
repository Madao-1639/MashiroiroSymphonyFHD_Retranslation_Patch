{"script": "scenario_airi_route02_12.txt", "scene": "*start", "row": 0, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "在获得了作为活动基础的\\n我们2-T班同学的同意之后——", "steam": "獲得了活動基礎的２－Ｔ班同學的同意之後──"}, "length": {"chs": 28, "steam": 21}, "similarity": 0.571}
