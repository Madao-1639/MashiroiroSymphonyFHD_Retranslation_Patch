{"script": "scenario_airi_route02_13.txt", "scene": "*start", "row": 56, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "两人从校门回来，\\n正在食堂一边休息着，一边喝点东西。", "steam": "離開了校門口，我們來到學生食堂喝飲料休息。"}, "length": {"chs": 27, "steam": 21}, "similarity": 0.279}
