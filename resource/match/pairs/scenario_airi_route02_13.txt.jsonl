{"script": "scenario_airi_route02_13.txt", "scene": "*start", "row": 48, "page": 0, "status": "aligned", "speaker": {"chs": "爱理", "steam": "愛理"}, "alt_speaker": {"chs": null, "steam": "愛理"}, "voice": {"chs": "ar3203", "steam": "ar3203", "equal": true}, "text": {"chs": "「等……别、别这样说啦……」", "steam": "「什……別、別這樣啦……」"}, "length": {"chs": 14, "steam": 13}, "similarity": 0.267}
