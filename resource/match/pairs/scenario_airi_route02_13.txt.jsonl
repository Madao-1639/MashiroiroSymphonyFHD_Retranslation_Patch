{"script": "scenario_airi_route02_13.txt", "scene": "*start", "row": 64, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "我一边说着，一边整顿着思绪。", "steam": "我漸漸在腦中整理出思緒。"}, "length": {"chs": 14, "steam": 12}, "similarity": 0.261}
