{"script": "scenario_16.txt", "scene": "*start", "row": 12, "page": 0, "status": "aligned", "speaker": {"chs": "兰华", "steam": "蘭華"}, "alt_speaker": {"chs": null, "steam": "蘭華"}, "voice": {"chs": "rk0053", "steam": "rk0053", "equal": true}, "text": {"chs": "『不过，现在你们作为结女校的一员，\\n　就要按我的方针来』", "steam": "『但是既然現在身為結女的一員，就必須遵從我們的理念。』"}, "length": {"chs": 29, "steam": 27}, "similarity": 0.298}
