{"script": "scenario_16.txt", "scene": "*start", "row": 8, "page": 0, "status": "aligned", "speaker": {"chs": "兰华", "steam": "蘭華"}, "alt_speaker": {"chs": null, "steam": "蘭華"}, "voice": {"chs": "rk0051", "steam": "rk0051", "equal": true}, "text": {"chs": "『……行了！\\n　明天开始就是考试了，你们也知道吧？』", "steam": "『……那麼！明天起就是考試，大家都知道吧？』"}, "length": {"chs": 27, "steam": 22}, "similarity": 0.471}
