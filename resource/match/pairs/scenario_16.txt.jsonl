{"script": "scenario_16.txt", "scene": "*start", "row": 0, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "到了考试前最后一天，星期一。", "steam": "考試前最後一天，星期一。"}, "length": {"chs": 14, "steam": 12}, "similarity": 0.727}
