{"script": "scenario_airi_route02_03.txt", "scene": "*start", "row": 44, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "即使是在跟我说话的时候，爱理也是目不转睛地看着手里的题。", "steam": "即使是跟我說話，她的眼神也沒有離開手邊。"}, "length": {"chs": 28, "steam": 20}, "similarity": 0.364}
