{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 0, "page": 0, "status": "needs_review", "speaker": {"chs": null, "steam": null}, "alt_speaker": {"chs": null, "steam": null}, "voice": {"chs": null, "steam": null, "equal": false}, "text": {"chs": "今天是文化日，学校休息。", "steam": "今天是文化之日，放假。"}, "length": {"chs": 12, "steam": 11}, "similarity": 0.632}
