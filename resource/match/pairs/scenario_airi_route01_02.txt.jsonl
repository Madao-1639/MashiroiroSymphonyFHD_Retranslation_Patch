{"script": "scenario_airi_route01_02.txt", "scene": "*start", "row": 90, "page": 0, "status": "aligned", "speaker": {"chs": "樱乃", "steam": "桜乃"}, "alt_speaker": {"chs": null, "steam": "櫻乃"}, "voice": {"chs": "sk0388", "steam": "sk0388", "equal": true}, "text": {"chs": "「哥，就算看了，不实际走一次也搞不明白的」", "steam": "「哥哥，就算看了，不實際去一趟也不知道。」"}, "length": {"chs": 21, "steam": 21}, "similarity": 0.545}
